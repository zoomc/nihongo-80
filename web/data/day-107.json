 "grammar": [
  {
   "id": "G0127",
   "pattern": "〜に違いない",
   "meaning_zh": "一定…；肯定…",
   "connection": "普通形 + に違いない；名词 + に違いない（不加「だ」）",
   "usage": "依据某些迹象做很有把握的推断，语气比「だろう」强。",
   "register_note": "口语书面均可，书面感稍强。",
   "examples": [
    {
     "ja": "隣の家は何日も電気が消えている。家族で旅行に出かけたに違いない。",
     "zh": "隔壁好几天没亮灯，一家人肯定出去旅行了。"
    },
    {
     "ja": "こんなに人が並んでいるんだから、この店のラーメンはおいしいに違いない。",
     "zh": "排这么多人，这家店的拉面一定好吃。"
    },
    {
     "ja": "この手紙の字は、父の字に違いない。",
     "zh": "这封信的字迹肯定是父亲的。"
    }
   ],
   "prerequisites": [
    "G0070"
   ],
   "compare": [
    {
     "id": "G0128",
     "diff": "に違いない 是有根据的推断，に決まっている 更像“明摆着”，语气更硬。"
    }
   ],
   "common_errors": [
    {
     "wrong": "この手紙の字は、父の字だに違いない。",
     "why": "名词直接接「に違いない」，不加「だ」。",
     "fix": "父の字に違いない",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-임에 틀림없다",
   "ko_diff": "韩语「-임에 틀림없다」同样表强推断；但日语名词后不加「だ」，韩语要加「임」，这是最容易出错的地方。",
   "notes": "",
   "tags": [
    "conjecture",
    "emphasis"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0128",
   "pattern": "〜に決まっている",
   "meaning_zh": "必然…；肯定…",
   "connection": "普通形 + に決まっている；名词 + に決まっている",
   "usage": "表示“按理必然如此”，带“这还用说”的强硬语气。",
   "register_note": "口语为主，争论和断定场合常见。",
   "examples": [
    {
     "ja": "練習もしないで試合に出たら、負けるに決まっている。",
     "zh": "不练习就上场比赛，肯定输。"
    },
    {
     "ja": "一人で富士山に登るなんて、お母さんが心配するに決まってるでしょう。",
     "zh": "一个人去爬富士山，妈妈肯定担心。"
    },
    {
     "ja": "そんなうまい話、うそに決まっているよ。",
     "zh": "那么好的事，肯定是骗人的。"
    }
   ],
   "prerequisites": [
    "G0070"
   ],
   "compare": [
    {
