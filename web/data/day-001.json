 "grammar": [
  {
   "id": "G0001",
   "pattern": "N は N です",
   "meaning_zh": "…是…",
   "connection": "名詞 + は + 名詞 + です",
   "usage": "判断句，介绍身份/事物，礼貌体",
   "register_note": "礼貌体判断句，用于自我介绍、说明身份；简体语境用 だ/である。",
   "examples": [
    {
     "ja": "私は学生です。",
     "zh": "我是学生。",
     "vocab_ids": [
      "V0001",
      "V0078"
     ]
    },
    {
     "ja": "これは本です。",
     "zh": "这是书。",
     "vocab_ids": [
      "V0080"
     ]
    }
   ],
   "prerequisites": [],
   "compare": [],
   "common_errors": [
    {
     "wrong": "私は学生だ。",
     "why": "「私は学生だ。」本身是合法的普通体，不是错句；但本题要求礼貌体，所以句末要用 です。需要区分「语法错误」和「语体不匹配」。",
     "fix": "私は学生です。",
     "learner": "zh",
     "register_ack": true
    },
    {
     "wrong": "私は 学生 です（は 读 ha）",
     "why": "主题「は」读 wa 不读 ha，中文母语者常按拼音读成 ha",
     "fix": "私は学生です。（は 读 wa）",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "sentence",
    "copula"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "입니다 / 이에요",
   "ko_diff": "韩语敬语由终结词尾입니다/이에요承担，日语靠です；名词后还须按有无收音选은/는。",
   "ko_pron": "N 와 N 데스"
  },
  {
   "id": "G0261",
   "pattern": "〜か（or）",
   "meaning_zh": "…或…",
   "connection": "名词 + か + 名词",
   "usage": "表示两个以上选项中的选择，可用于陈述或疑问。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "飲み物はコーヒーか紅茶がいいです。",
     "zh": "饮料咖啡或红茶都行。"
    },
    {
     "ja": "土曜日か日曜日に買い物に行きます。",
     "zh": "我星期六或星期天去买东西。"
    },
    {
     "ja": "駅までバスかタクシーで行きます。",
     "zh": "坐公交车或出租车去车站。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0260",
     "diff": "か 表选择，や 表部分列举"
    }
   ],
