 "grammar": [
  {
   "id": "G0209",
   "pattern": "〜予定",
   "meaning_zh": "预定…；计划…",
   "connection": "动词辞书形 + 予定だ；名词 + の + 予定だ",
   "usage": "表示已安排好的日程或计划，语气比つもり更客观。",
   "register_note": "口语与书面通用；商务、通知中常用。",
   "examples": [
    {
     "ja": "来月、大阪に引っ越す予定です。",
     "zh": "下个月我预定搬到大阪。"
    },
    {
     "ja": "会議は三時に終わる予定です。",
     "zh": "会议预定三点结束。"
    },
    {
     "ja": "出発は朝八時の予定です。",
     "zh": "出发时间定在早上八点。"
    }
   ],
   "prerequisites": [
    "G0023",
    "G0006"
   ],
   "compare": [
    {
     "id": "G0208",
     "diff": "予定 是客观日程，つもり 是个人意图"
    }
   ],
   "common_errors": [
    {
     "wrong": "来月、大阪に引っ越すの予定です。",
     "why": "动词接 予定 直接用辞书形，不用 の；名词才用 の",
     "fix": "来月、大阪に引っ越す予定です。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-(으)ㄹ 예정이다",
   "ko_diff": "韩语 예정이다 与 予定 基本对应，但日语 予定 可直接接名词（予定通り），韩语则需 예정대로。",
   "notes": "",
   "tags": [
    "intention",
    "time"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0210",
   "pattern": "〜ことにする",
   "meaning_zh": "决定…",
   "connection": "动词辞书形／动词ない形 + ことにする",
   "usage": "表示说话人自己主动做出决定，强调主观选择。",
   "register_note": "口语与书面通用；「ことにしている」表示习惯性决定。",
   "examples": [
    {
     "ja": "健康のために、毎朝歩くことにした。",
     "zh": "为了健康，我决定每天早上散步。"
    },
    {
     "ja": "高かったので、買わないことにしました。",
     "zh": "因为太贵，我决定不买了。"
    },
    {
     "ja": "もう遅いから、タクシーで帰ることにしよう。",
     "zh": "已经很晚了，就坐出租车回去吧。"
    }
   ],
   "prerequisites": [
    "G0023",
    "G0022"
   ],
   "compare": [
    {
     "id": "G0211",
     "diff": "ことにする 是主观决定，ことになる 是客观结果或他人决定"
    }
   ],
   "common_errors": [
    {
     "wrong": "健康のために、毎朝歩きことにした。",
     "why": "ことにする 前接辞书形，不是ます形去ます",
     "fix": "健康のために、毎朝歩くことにした。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-기로 하다",
   "ko_diff": "韩语 -기로 하다 与 ことにする 对应，但日语 ことにしている 可表持续的习惯，韩语 -기로 하고 있다 较少这样用。",
