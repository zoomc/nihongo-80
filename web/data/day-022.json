 "grammar": [
  {
   "id": "G0269",
   "pattern": "〜より",
   "meaning_zh": "比…",
   "connection": "比较基准（名词或普通形）+ より；优胜的一项可用 は 或 の方が 表明。",
   "usage": "表示比较的基准，常与「の方が」呼应。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "今日はきのうより寒いです。",
     "zh": "今天比昨天冷。"
    },
    {
     "ja": "電車はバスより速いです。",
     "zh": "电车比公交车快。"
    },
    {
     "ja": "兄は父より背が高いです。",
     "zh": "哥哥比父亲高。"
    }
   ],
   "prerequisites": [
    "G0034"
   ],
   "compare": [
    {
     "id": "G0270",
     "diff": "より 标比较基准，の方が 标较优的一方"
    }
   ],
   "common_errors": [
    {
     "wrong": "今日はきのうよりが寒いです。",
     "why": "より 后不加 が",
     "fix": "今日はきのうより寒いです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "보다",
   "ko_diff": "배보다 사과가 싸다 对照 梨よりりんごの方が安い。两种语言都把比较标记放在基准后面；日语可先说主项 りんごは，再说 梨より。",
   "notes": "",
