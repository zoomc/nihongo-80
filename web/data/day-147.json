 "grammar": [
  {
   "id": "G0183",
   "pattern": "〜気味",
   "meaning_zh": "有点…；稍有…迹象",
   "connection": "名词/动词ます形词干 + 気味",
   "usage": "表示已经出现某种轻微、不太好的迹象。",
   "register_note": "口语书面均可，书面偏多。",
   "examples": [
    {
     "ja": "少し風邪気味なので、今日は早めに帰ります。",
     "zh": "有点感冒，今天早点回去。"
    },
    {
     "ja": "最近、仕事が忙しくて疲れ気味だ。",
     "zh": "最近工作忙，有点累。"
    },
    {
     "ja": "人手が足りず、工事は予定より遅れ気味だ。",
     "zh": "人手不足，工程有点滞后。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0182",
     "diff": "気味 是“已有轻微迹象”，がち 是“容易反复出现的倾向”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "少し風邪の気味なので、今日は早めに帰ります。",
     "why": "「気味」直接接名词或动词词干，不加「の」。",
     "fix": "風邪気味なので",
     "learner": "zh"
    }
   ],
