 "grammar": [
  {
   "id": "G0147",
   "pattern": "〜代わりに",
   "meaning_zh": "代替…；作为交换",
   "connection": "动词普通形/い形容词/ナ形容词な/名词の + 代わりに",
   "usage": "表示用一件事替代另一件，或“有失也有得”的补偿关系。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "今日は外で食べる代わりに、家でカレーを作った。",
     "zh": "今天没在外面吃，改在家做了咖喱。"
    },
    {
     "ja": "友達に英語を教える代わりに、ギターを教えてもらっている。",
     "zh": "我教朋友英语，作为交换他教我吉他。"
    },
    {
     "ja": "このアパートは駅から遠い代わりに、家賃が安い。",
     "zh": "这间公寓离车站远，但房租便宜。"
    }
   ],
   "prerequisites": [
    "G0085"
   ],
   "compare": [
    {
     "id": "G0146",
     "diff": "代わりに 可表交换补偿，に代わって 只表顶替某人或某物。"
    }
   ],
   "common_errors": [
    {
     "wrong": "このアパートは駅から遠いの代わりに、家賃が安い。",
     "why": "い形容词直接接「代わりに」，只有名词才加「の」。",
     "fix": "遠い代わりに",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-대신에",
   "ko_diff": "韩语「-대신에」与「代わりに」对应良好；但日语还能表“补偿”，韩语更常说「그 대신」，词性不同。",
   "notes": "",
   "tags": [
    "contrast",
    "relation"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0148",
   "pattern": "〜に従って",
   "meaning_zh": "按照…；随着…",
   "connection": "名词 + に従って；动词辞书形 + に従って",
   "usage": "表示遵照指示、规则，或随着某变化而相应变化。",
   "register_note": "书面语为主，告示和说明文常见。",
   "examples": [
    {
     "ja": "係の人の指示に従って、落ち着いて避難してください。",
     "zh": "请听从工作人员的指示，冷静避难。"
    },
    {
     "ja": "高く登るに従って、気温が下がっていった。",
     "zh": "越往上爬，气温越低。"
    },
    {
     "ja": "町が大きくなるに従って、交通の問題も増えてきた。",
     "zh": "随着城市变大，交通问题也多了起来。"
    }
   ],
   "prerequisites": [
    "G0077"
   ],
   "compare": [
    {
     "id": "G0149",
     "diff": "に従って 偏“遵照、跟随”，につれて 只表“随之变化”，不含遵从义。"
    }
   ],
   "common_errors": [
    {
     "wrong": "係の人の指示によって、落ち着いて避難してください。",
     "why": "遵从指示用「に従って」，「によって」表手段或原因，不能表遵从。",
     "fix": "指示に従って",
     "learner": "zh"
    }
   ],
