 "grammar": [
  {
   "id": "G0137",
   "pattern": "〜さえ",
   "meaning_zh": "连…都…",
   "connection": "名词 + さえ／でさえ／にさえ",
   "usage": "举出极端例子，暗示其他更不用说，多与否定呼应。",
   "register_note": "口语书面均可，书面更常用「すら」。",
   "examples": [
    {
     "ja": "忙しくて、昼ご飯を食べる時間さえなかった。",
     "zh": "忙得连吃午饭的时间都没有。"
    },
    {
     "ja": "こんな簡単な問題は、小学生でさえ解ける。",
     "zh": "这么简单的问题，连小学生都会。"
    },
    {
     "ja": "彼女は親友にさえ本当のことを話さなかった。",
     "zh": "她连最好的朋友都没说实话。"
    }
   ],
   "prerequisites": [
    "G0080"
   ],
   "compare": [
    {
     "id": "G0139",
     "diff": "さえ 举极端例暗示其他，こそ 是“正是…”的强调，方向不同。"
    }
   ],
   "common_errors": [
    {
     "wrong": "忙しくて、昼ご飯を食べる時間がさえなかった。",
     "why": "「さえ」可替换「が」「を」，不能与「が」叠加，应说「時間さえなかった」。",
     "fix": "時間さえなかった",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-조차",
   "ko_diff": "韩语「-조차」多与否定呼应，这点与「さえ」相近；但日语「さえ」还能构成「さえ〜ば」条件句，韩语要用「-기만 하면」。",
   "notes": "",
   "tags": [
    "emphasis"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0138",
   "pattern": "〜さえ〜ば",
   "meaning_zh": "只要…就…",
   "connection": "名词 + さえ + ば形；动词ます形词干 + さえ + すれば；动词て形 + さえ + いれば",
   "usage": "表示只要满足这一条件，其余都不成问题。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "このアプリさえあれば、どこでも日本語の勉強ができる。",
     "zh": "只要有这个应用，在哪儿都能学日语。"
    },
    {
     "ja": "時間さえあれば、もっと旅行に行きたいんですが。",
     "zh": "只要有时间，我还想多去旅行。"
    },
    {
     "ja": "薬を飲んで寝てさえいれば、すぐに治りますよ。",
     "zh": "只要吃了药好好躺着，很快就会好。"
    }
   ],
   "prerequisites": [
    "G0080",
