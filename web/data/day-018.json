   "prerequisites": [
    "G0021"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "本を読みたり 音楽を聞いたり",
     "why": "「たり」接た形，不是ます形词干 読み",
     "fix": "本を読んだり音楽を聞いたりします。",
     "learner": "zh"
    },
    {
     "wrong": "本を読んだり、音楽を聞いたり",
     "why": "句末必须 する 收尾，不能只停在 たり",
     "fix": "…聞いたりします。",
     "learner": "zh"
    }
   ],
