  },
  {
   "id": "G0120",
   "pattern": "〜だけでなく",
   "meaning_zh": "不仅…而且…",
   "connection": "普通形 + だけでなく；な形容词可接词干（上手だけでなく）或 な；名词直接接",
   "usage": "追加事项，后项常用「も」，是口语化的“不仅…而且”。",
   "register_note": "口语书面均可，比「ばかりでなく」随意。",
   "examples": [
    {
     "ja": "この店は料理がおいしいだけでなく、値段も安い。",
     "zh": "这家店不仅菜好吃，价格也便宜。"
    },
    {
     "ja": "地震の後、水だけでなく電気も止まってしまった。",
     "zh": "地震后不仅停水，连电也停了。"
    },
    {
     "ja": "彼女は歌が上手なだけでなく、自分で曲も作っている。",
     "zh": "她不仅唱得好，还自己作曲。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0119",
     "diff": "だけでなく 口语通用，ばかりでなく 更书面、更郑重。"
    }
   ],
   "common_errors": [
    {
     "wrong": "日本語だけなくて、中国語も話します。",
     "why": "并列补充可用「だけでなく」，不能写成「だけなくて」。",
     "fix": "日本語だけでなく、中国語も話します。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
