 "grammar": [
  {
   "id": "G0167",
   "pattern": "〜とすれば / 〜としたら",
   "meaning_zh": "假设…的话",
   "connection": "动词普通形/い形容词/ナ形容词だ/名词だ + とすれば／としたら",
   "usage": "提出一个假设，据此推论结果，多用于设想。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "もし宝くじで一億円当たったとしたら、何に使いますか。",
     "zh": "要是买彩票中了一亿日元，你会怎么花？"
    },
    {
     "ja": "今から出発するとすれば、向こうに着くのは夜の九時ごろになる。",
     "zh": "假设现在出发，到那边大概晚上九点。"
    },
    {
     "ja": "彼の話が本当だとしたら、大変なことになる。",
     "zh": "如果他说的是真的，那可就麻烦了。"
    }
   ],
   "prerequisites": [
    "G0025"
   ],
   "compare": [
    {
     "id": "G0143",
     "diff": "にしても 是让步“即使”，とすれば/としたら 是纯假设“如果”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "彼の話が本当としたら、大変なことになる。",
     "why": "名词、ナ形容词接「としたら」要加「だ」，说「本当だとしたら」。",
     "fix": "本当だとしたら",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-라고 한다면",
   "ko_diff": "韩语「-라고 한다면」偏传闻假设；日语「としたら」只是单纯设想，不含传闻，语气更轻。",
