 "grammar": [
  {
   "id": "G0227",
   "pattern": "〜のに（purpose）",
   "meaning_zh": "用于…；做…需要",
   "connection": "动词辞书形 + のに（用途・所需）；名词 + に",
   "usage": "表示某物的用途，或做某事所需的时间、金钱，常与「便利／かかる」搭配。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "このかばんは旅行に行くのに便利です。",
     "zh": "这个包旅行时很方便。"
    },
    {
     "ja": "家から駅まで歩くのに二十分かかります。",
     "zh": "从家走到车站需要二十分钟。"
    },
    {
     "ja": "引っ越しするのに十万円ぐらいかかった。",
     "zh": "搬家花了大约十万日元。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0232",
     "diff": "のに 接用途或所需，ために 接目的"
    }
   ],
   "common_errors": [
    {
     "wrong": "家から駅まで歩くのに二十分をかかります。",
     "why": "かかる 表示所需时间时用「二十分かかる」，不用 を",
     "fix": "家から駅まで歩くのに二十分かかります。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-는 데",
   "ko_diff": "韩语 -는 데 与用途、所需的 のに 对应（걷는 데 20분 걸린다）；日语 のに 与转折的 のに 同形，韩语则用 데 区分。",
   "notes": "",
   "tags": [
    "purpose"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0228",
   "pattern": "〜ので",
   "meaning_zh": "因为…；由于…",
   "connection": "动词普通形／い形容词 + ので；な形容词+な／名词+な + ので",
   "usage": "表示客观原因，语气比から柔和，常用于说明情况或道歉。",
   "register_note": "口语与书面通用；比から礼貌、客观。",
   "examples": [
    {
     "ja": "頭が痛いので、今日は早く帰ります。",
     "zh": "我头疼，今天早点回去。"
    },
    {
     "ja": "明日はテストなので、今夜は勉強します。",
     "zh": "明天有考试，今晚要学习。"
    },
    {
     "ja": "道がこんでいたので、少し遅れました。",
     "zh": "路上很堵，所以稍微迟到了。"
    }
   ],
   "prerequisites": [
    "G0023",
    "G0037"
   ],
   "compare": [
