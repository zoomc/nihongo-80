 "grammar": [
  {
   "id": "G0159",
   "pattern": "〜たって / 〜だって",
   "meaning_zh": "即使…也…（口语）",
   "connection": "动词た形 + って；い形容词词干 + くたって；ナ形容词/名词 + だって",
   "usage": "口语中表“即使…也没关系、也没用”，是「ても」的口语形式。",
   "register_note": "仅限口语，正式场合用「ても」。",
   "examples": [
    {
     "ja": "今から急いだって、もう間に合わないよ。",
     "zh": "现在就算赶也来不及了。"
    },
    {
     "ja": "高くたって、欲しいものは欲しい。",
     "zh": "贵是贵，可想要还是想要。"
    },
    {
     "ja": "いくら便利だって、使い方が分からなければ意味がない。",
     "zh": "再方便，不会用也没意义。"
    }
   ],
   "prerequisites": [
    "G0025"
   ],
   "compare": [
    {
     "id": "G0168",
     "diff": "としても 书面、郑重，たって 是口语缩略，语气随意得多。"
    }
   ],
   "common_errors": [
    {
     "wrong": "いくら便利だっても、使い方が分からなければ意味がない。",
     "why": "「〜だって」本身已含“即使”之意，不能再加「も」。",
     "fix": "便利だって",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-아도",
   "ko_diff": "韩语「-아도/어도」是标准形式，不分书面口语；日语「たって」带明显随意感，正式场合须换「ても」。",
   "notes": "",
   "tags": [
    "concession",
    "casual"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0160",
   "pattern": "〜ないことはない",
   "meaning_zh": "并非不…；也不是不能…",
   "connection": "动词ない形/い形容词くない/ナ形容词でない + ことはない",
   "usage": "双重否定，表“不是完全不行”，但暗示条件或保留态度。",
   "register_note": "口语书面均可，语气委婉。",
   "examples": [
    {
     "ja": "辛い料理は食べられないことはないけど、あまり好きじゃない。",
     "zh": "辣的我并非不能吃，只是不太喜欢。"
    },
    {
     "ja": "今から急げば、間に合わないことはないと思う。",
     "zh": "现在赶紧走的话，也不是赶不上。"
    },
    {
     "ja": "この服、少し派手だけど、似合わないことはないよ。",
     "zh": "这件衣服有点花哨，但也不是不适合你。"
    }
   ],
   "prerequisites": [
    "G0022"
   ],
   "compare": [
    {
     "id": "G0106",
     "diff": "ことはない 表“不必”，ないことはない 是双重否定表“并非不能”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "この服、少し派手だけど、似合わないことはないだよ。",
     "why": "「ない」后面不能接「だ」，应说「ないことはないよ」或「ありません」。",
     "fix": "似合わないことはないよ",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-지 않은 것은 아니다",
