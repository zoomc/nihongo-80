# 部署依赖按需安装（scripts/deploy_cloudflare.sh 会自动 npm install）
deploy/node_modules/
deploy/package-lock.json

# Python 缓存
__pycache__/
*.pyc

# 本地备份与系统文件
data/backups/
.DS_Store

# 运行时学习状态（个人数据；clone 后由 `python3 scripts/nh80.py init` 重建）
data/state.db
data/state.db-wal
data/state.db-shm
sessions/day-*-brief.md
reports/week-*.md

# 事件同步密钥（仅本机，勿提交）
deploy/.sync-key

# v5 构建中间产物（可重跑 scripts/prep_v5.py 生成）
data/build/

# 个人学习状态（由 session_v5.py 生成，不入库）
STATE.md
days/
tasks/
inbox/
data/progress.json

# Local Wrangler emulator and build state
.wrangler/
deploy/.wrangler/

# export_state read-only personal mirrors; generated after init
student/*.json

# Personal macOS TTS output; never publish or commit
data/audio/

# Private cross-agent review context; generated by nh80 study-sync
data/review/

# 明文答案表是本地构建产物（Worker 只用 web/data/grade 的哈希分片），不入库
deploy/worker/src/generated-key.json
