 "grammar": [
  {
   "id": "G0134",
   "pattern": "〜ば〜ほど",
   "meaning_zh": "越…越…",
   "connection": "动词ば形 + 同一动词辞书形 + ほど；い形容词ければ + い形容词 + ほど；ナ形容词なら + ナ形容词な + ほど",
   "usage": "表示随着前项程度加深，后项程度也随之变化。",
   "register_note": "口语书面均可，谚语中常见。",
   "examples": [
    {
     "ja": "日本語は、勉強すればするほど面白くなる。",
     "zh": "日语越学越有意思。"
    },
    {
     "ja": "スマホの画面は大きければ大きいほど見やすいが、持ち歩くのは大変だ。",
     "zh": "手机屏幕越大越容易看，但带着走很麻烦。"
    },
    {
     "ja": "部屋が静かなら静かなほど、よく眠れる。",
     "zh": "房间越安静，睡得越好。"
    }
   ],
   "prerequisites": [
    "G0079"
   ],
   "compare": [
    {
     "id": "G0135",
     "diff": "ほど 单表程度，ば〜ほど 表“程度随之递增”的联动关系。"
    }
   ],
   "common_errors": [
    {
     "wrong": "日本語は、勉強するすればするほど面白くなる。",
     "why": "前项必须用ば形「すれば」，「するすれば」不合法。",
     "fix": "勉強すればするほど",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-면 -ㄹ수록",
   "ko_diff": "韩语「-ㄹ수록」一个形式即可；日语要把同一词重复两次（すればするほど），形式负担更重。",
   "notes": "",
   "tags": [
    "condition",
    "degree",
    "change"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0135",
   "pattern": "〜ほど",
   "meaning_zh": "到了…的程度",
   "connection": "普通形 + ほど；名词 + ほど",
   "usage": "举出极端例子说明程度之高，常与「〜ない」呼应表最高级。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "昨日は、立っていられないほど疲れていた。",
     "zh": "昨天累得站都站不住。"
    },
    {
     "ja": "試験に合格したと聞いて、涙が出るほどうれしかった。",
     "zh": "听说考试合格，高兴得流下眼泪。"
    },
    {
     "ja": "このあたりは、夜になると怖いほど静かだ。",
     "zh": "这一带到了晚上静得让人害怕。"
    }
   ],
   "prerequisites": [
    "G0034"
   ],
   "compare": [
    {
     "id": "G0136",
     "diff": "ほど 偏书面、程度更强，くらい 更口语，还可表“最低限度”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "このあたりは、夜になると怖いなほど静かだ。",
     "why": "い形容词直接接「ほど」，不加「な」。",
     "fix": "怖いほど",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-ㄹ 정도로",
   "ko_diff": "韩语「-ㄹ 정도로」与「ほど」基本对应；但日语「ほど」还用于「〜ほど〜ない」比较句，韩语要用「-만큼」。",
