 "grammar": [
  {
   "id": "G0097",
   "pattern": "〜わけだ",
   "meaning_zh": "难怪…；也就是说…",
   "connection": "普通形 + わけだ；ナ形容词 + な + わけだ；名词 + という + わけだ",
   "usage": "由已知事实推出结论，常与「どうりで」呼应。",
   "register_note": "口语书面皆可；正式文书多说「〜ということだ」。",
   "examples": [
    {
     "ja": "三年も中国に住んでいたんですか。だから中国語が上手なわけですね。",
     "zh": "在中国住了三年啊。难怪你中文这么好。"
    },
    {
     "ja": "窓が全部開いている。どうりで寒いわけだ。",
     "zh": "窗户全开着。难怪这么冷。"
    },
    {
     "ja": "この本は三百ページだから、一日に二十ページ読めば、十五日で読み終わるわけだ。",
     "zh": "这本书三百页，一天读二十页的话，也就是十五天读完。"
    }
   ],
   "prerequisites": [
    "G0023",
    "G0059"
   ],
   "compare": [
    {
     "id": "G0098",
     "diff": "わけではない 是否定推论，わけだ 是肯定推论，方向相反。"
    }
   ],
   "common_errors": [
    {
     "wrong": "窓が全部開いている。どうりで寒いわけだです。",
     "why": "「わけだ」本身已是普通体断定，礼貌说法整体变成「わけです」，不能再叠「です」。",
     "fix": "…寒いわけですね。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-는 셈이다",
   "ko_diff": "韩语「-는 셈이다」侧重“算作某种结果”；日语「わけだ」更强调说话人由事实推导的过程，常带“原来如此”的领悟语气。",
   "notes": "",
   "tags": [
    "reason",
    "result",
    "conjecture"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0098",
   "pattern": "〜わけではない",
   "meaning_zh": "并不是…；并非…",
   "connection": "普通形 + わけではない；ナ形容词 + な + わけではない；名词 + という + わけではない",
   "usage": "部分否定对方的整体判断，常与「別に」「必ずしも」呼应。",
   "register_note": "口语书面均可；口语常说「わけじゃない」。",
   "examples": [
    {
     "ja": "料理が嫌いなわけではないが、毎日作る時間がない。",
     "zh": "我不是讨厌做饭，只是每天没时间做。"
    },
    {
     "ja": "値段が高ければおいしいというわけではない。",
     "zh": "贵并不等于好吃。"
    },
    {
     "ja": "全然分からないわけではありませんが、もう少しゆっくり話していただけますか。",
     "zh": "也不是完全听不懂，能请您再说慢一点吗？"
    }
   ],
   "prerequisites": [
    "G0023",
    "G0053"
   ],
   "compare": [
    {
     "id": "G0097",
     "diff": "わけだ 表肯定推论，わけではない 表部分否定，常用来修正对方的过度概括。"
    }
   ],
   "common_errors": [
