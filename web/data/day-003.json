 "grammar": [
  {
   "id": "G0004",
   "pattern": "N も",
   "meaning_zh": "…也…",
   "connection": "名詞 + も（替代 は/が/を）",
   "usage": "表同类追加；替代格助词，不与 は 叠加",
   "register_note": "も 口语书面通用；强调「也」时替代 は/が，不与 は 叠加。",
   "examples": [
    {
     "ja": "私も学生です。",
     "zh": "我也是学生。",
     "vocab_ids": [
      "V0001",
      "V0078"
     ]
    }
   ],
   "prerequisites": [
    "G0001"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "私はも学生です。",
     "why": "「も」本身已含「也」，要替换 は，不能 は+も 并存",
     "fix": "私も学生です。",
     "learner": "zh"
    },
    {
     "wrong": "私を学生です。",
     "why": "误把 も 写成 を；「也」不是宾语标记",
     "fix": "私も学生です。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "particle"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "needs_review",
   "provenance": "self_reviewed",
   "ko_equiv": "도",
   "ko_diff": "韩语 도 和日语 も 都可表示追加，常替换主格或宾格助词；叠加其他助词须按具体语境判断。"
  },
  {
   "id": "G0005",
   "pattern": "これ / それ / あれ / どれ は N です",
   "meaning_zh": "这/那/那是…",
   "connection": "指示代名词 + は + 名詞 + です",
   "usage": "コソアド 指示词：近称/中称/远称/疑问",
   "notes": "は 提示已知主题、が 标记新信息焦点。普通问「这是书吗」用 これは本ですか；若语境是「（不是那个，而是）这个是书吗」，これが本ですか 也合法，只是焦点不同。",
   "register_note": "指示词疑问句日常会话高频；は 提示主题，が 标记焦点。",
   "examples": [
    {
     "ja": "これは本です。",
     "zh": "这是书。",
     "vocab_ids": [
      "V0080"
     ]
    },
    {
     "ja": "それはいくらですか。",
     "zh": "那个多少钱？",
     "vocab_ids": [
      "V0020"
     ]
    }
   ],
   "prerequisites": [
    "G0001"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "これ は 本です（分写）",
     "why": "指示词后主题助词 は 不能空格分开写",
     "fix": "これは本です。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "particle",
    "demonstrative"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "이것 / 그것 / 저것 / 어느 것",
   "ko_diff": "韩语指示三分与日语相同，但修饰名词要用이/그/저且与것分写；日语可直接连体。"
  }
 ],
