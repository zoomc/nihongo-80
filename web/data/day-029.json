  {
   "id": "G0270",
   "pattern": "〜の方が〜より",
   "meaning_zh": "…比…更…",
   "connection": "名词 + の方が + 名词 + より + 形容词",
   "usage": "明确指出两者中较优或程度更高的一方，より 引出比较基准。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "犬の方が猫より好きです。",
     "zh": "我更喜欢狗，而不是猫。"
    },
    {
     "ja": "東京の方が大阪より人が多いです。",
     "zh": "东京比大阪人多。"
    },
    {
     "ja": "夏より冬の方が好きです。",
     "zh": "比起夏天，我更喜欢冬天。"
    }
   ],
   "prerequisites": [
    "G0034"
   ],
