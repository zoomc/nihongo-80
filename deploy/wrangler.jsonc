{
  // Nihongo 80：Worker + 静态资源一起由 `wrangler deploy` 发布（复用 zoomlab-web 模式）。
  // 无 KV / Workers AI / 自定义域名 / cron / 账号 ID；D1 为**可选**绑定（不绑也能上线，接口降级为 503）。
  // 本文件不含任何真实账号 ID、数据库 ID、域名或密钥。
  // D1 已于 2026-11-07 创建（nihongo80, APAC），只存网页原始作答事件；
  // 已于 2026-11-06 实际部署：production=https://nihongo80.cmjfire.workers.dev，
  // preview=https://nihongo80-preview.cmjfire.workers.dev（使用本机已有 wrangler OAuth 登录态）。
  // html_handling:"none" 让 .html 路径不被 307 规范化，SW 预缓存与本地一致；/ 由 Worker 转发 index.html。
  //
  // 事件同步（可选，docs/CLOUDFLARE.md「事件同步」一节）需要的两步：
  //   1) npx wrangler d1 create nihongo80 / nihongo80-preview，把各自 database_id 填到对应段；
  //   2) 对两个库分别执行 migrations/0001_events.sql、0002_session_payload.sql、
  //      0003_personal_budget.sql、0004_study.sql（npx wrangler d1 migrations apply DB --remote）。
  //   两个库都在 Workers Free 的 10 个 D1 免费额度内，不产生额外费用。
  // 拉取密钥用 secret 管理，**不要**写进本文件：
  //   npx wrangler secret put NH80_SYNC_KEY
  //   npx wrangler secret put NH80_SYNC_KEY --env preview
  // 不创建 D1 / 不配置密钥时，静态站行为与 v3 完全一致（优雅降级）。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nihongo80",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-11-06",
  "workers_dev": true,
  "assets": {
    // 相对本配置文件（deploy/）解析：deploy/../web 即项目根的 web/。
    "directory": "../web",
    "binding": "ASSETS",
    // 由 build_site.py 生成 web/404.html；未命中静态资源时用它返回 404。
    "not_found_handling": "404-page",
    // 关闭 .html 自动 307 规范化：线上 /day-NNN.html 与本地路径完全一致，
    // 否则 Service Worker 预缓存 80 个页面时会遇到重定向，影响离线可用。
    "html_handling": "none",
    // 仅放行 /api/* 与 /health 进 Worker，其余直接走静态资源。
    "run_worker_first": ["/", "/api/*", "/health"]
  },
  // 生产事件表；移除本段则 Worker 以 no_db 503 优雅降级，静态站照常可用。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nihongo80",
      "database_id": "9845dbf3-a470-4718-b474-b96e7b0e6223",
      // 迁移文件目录：`npx wrangler d1 migrations apply nihongo80 --remote`
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": false },
  "env": {
    "preview": {
      // 独立 Worker、无 cron、无自定义域名；D1 同样为可选绑定。
      "name": "nihongo80-preview",
      "workers_dev": true,
      "assets": {
        "directory": "../web",
        "binding": "ASSETS",
        "not_found_handling": "404-page",
        // 关闭 .html 自动 307 规范化：线上 /day-NNN.html 与本地路径完全一致，
        // 否则 Service Worker 预缓存 80 个页面时会遇到重定向，影响离线可用。
        "html_handling": "none",
        "run_worker_first": ["/", "/api/*", "/health"]
      },
      // 预览环境绑定独立的 `nihongo80-preview` 库，三段 migration 已 --remote 应用。
      // 与生产库完全隔离：preview 上的冒烟/测试事件不会写入生产 events 表。
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nihongo80-preview",
          "database_id": "7b4c50be-9b93-4f65-b994-a2aec0d97380",
          "migrations_dir": "migrations"
        }
      ],
      "observability": { "enabled": false }
    }
  }
}
