 "grammar": [
  {
   "id": "G0265",
   "pattern": "〜まで（until）",
   "meaning_zh": "到…为止；直到…",
   "connection": "名词 + まで（终点）",
   "usage": "表示时间或空间的终点，常与「から」呼应。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "昼休みは1時までです。",
     "zh": "午休到一点为止。"
    },
    {
     "ja": "駅までいっしょに行きましょう。",
     "zh": "我们一起去车站吧。"
    },
    {
     "ja": "きのうは夜11時まで勉強しました。",
     "zh": "昨天我学习到晚上十一点。"
    }
   ],
   "prerequisites": [
    "G0013"
   ],
   "compare": [
    {
     "id": "G0264",
     "diff": "まで 表终点，から 表起点"
    }
   ],
   "common_errors": [
    {
     "wrong": "昼休みは1時までからです。",
     "why": "终点用 まで，不能与 から 叠用",
     "fix": "昼休みは1時までです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "까지",
   "ko_diff": "韩语 까지 与 まで 对应，时间和空间都可用；日语 まで 还可表程度界限（駅まで歩く），韩语 까지 同样可延伸。",
   "notes": "",
