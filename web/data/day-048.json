 "grammar": [
  {
   "id": "G0191",
   "pattern": "〜てくださる / 〜ていただく",
   "meaning_zh": "（尊长）为我做…；蒙…为我做",
   "connection": "动词て形 + くださる／いただく（尊敬语／谦让语）",
   "usage": "长辈或上级为自己做事时，用くださる表尊敬，用いただく表谦逊。",
   "register_note": "正式场合、商务与书面语；日常对平辈不用。",
   "examples": [
    {
     "ja": "先生が私の作文を直してくださいました。",
     "zh": "老师为我修改了作文。"
    },
    {
     "ja": "ホテルの方に、おいしい店を教えていただきました。",
     "zh": "酒店的工作人员告诉我一家好吃的店。"
    },
    {
     "ja": "今日は来ていただいて、ありがとうございました。",
     "zh": "今天承蒙您光临，非常感谢。"
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [
    {
     "id": "G0189",
     "diff": "くださる 是くれる 的尊敬语"
    },
    {
     "id": "G0190",
     "diff": "いただく 是もらう 的谦让语"
    }
   ],
   "common_errors": [
    {
     "wrong": "先生が私の作文を直していただきました。",
     "why": "いただく 的主语是接受者「私」，不能以「先生が」作主语",
     "fix": "先生に私の作文を直していただきました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아/어 주시다",
   "ko_diff": "韩语用 -아/어 주시다 表尊敬，但没有与 いただく 完全对应的谦让动词；日语通过动词授受区分尊敬与谦让，韩语主要靠敬语尾。",
   "notes": "",
   "tags": [
    "giving-receiving",
    "honorific",
    "humble"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0192",
   "pattern": "〜ていく",
   "meaning_zh": "…去；从现在起继续…",
   "connection": "动词て形 + いく（ていく）",
   "usage": "表示动作由近及远，或某种变化从现在向未来持续。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "雨が降りそうだから、傘を持っていきます。",
     "zh": "好像要下雨，我带伞去。"
    },
    {
     "ja": "これからもっと寒くなっていくでしょう。",
     "zh": "今后大概会越来越冷吧。"
    },
    {
     "ja": "時間があるなら、お茶を飲んでいきませんか。",
     "zh": "有时间的话，喝杯茶再走好吗？"
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [
    {
     "id": "G0193",
     "diff": "ていく 指向未来或远去，てくる 指向过去或靠近"
    }
   ],
   "common_errors": [
    {
     "wrong": "時間があるなら、お茶を飲んでいくませんか。",
     "why": "「いく」的礼貌否定是「いきません」，不能结合成「いくません」",
     "fix": "時間があるなら、お茶を飲んでいきませんか。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아/어 가다",
   "ko_diff": "韩语 -아/어 가다 也表远离或持续，但日语 ていく 还常表示变化向未来展开，韩语更多用 -아/어 질 것이다 等复合表达。",
   "notes": "",
