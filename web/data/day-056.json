 "grammar": [
  {
   "id": "G0207",
   "pattern": "〜中",
   "meaning_zh": "正在…中；整个…；全…",
   "connection": "名词 + 中（ちゅう／じゅう）",
   "usage": "读 ちゅう 表示正在进行的活动，读 じゅう 表示整个范围或期间。",
   "register_note": "口语与书面通用；读音不同意义不同。",
   "examples": [
    {
     "ja": "父は今、電話中です。",
     "zh": "父亲现在正在打电话。"
    },
    {
     "ja": "昨日は一日中雨が降っていた。",
     "zh": "昨天一整天都在下雨。"
    },
    {
     "ja": "この歌は世界中で知られている。",
     "zh": "这首歌全世界都知道。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0199",
     "diff": "中 附在名词后表期间或范围，間 是独立的期间名词"
    }
   ],
   "common_errors": [
    {
     "wrong": "父は今、電話の中です。",
     "why": "表示正在打电话用「電話中」，不是「電話の中」",
     "fix": "父は今、電話中です。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-중 / -내내",
   "ko_diff": "韩语 -중 对应 ちゅう（회의 중），-내내 对应 じゅう（하루 종일）；日语同一个汉字两种读法，韩语用不同词尾区分。",
