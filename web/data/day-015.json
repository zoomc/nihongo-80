 "grammar": [
  {
   "id": "G0030",
   "pattern": "～ながら",
   "meaning_zh": "一边…一边…",
   "connection": "動詞ます形（去ます） + ながら",
   "usage": "同一主语同时进行两动作，主动作在后半句",
   "register_note": "ながら 偏书面叙述，口语也用但较生硬。",
   "examples": [
    {
     "ja": "音楽を聞きながら勉強します。",
     "zh": "边听音乐边学习。",
     "vocab_ids": [
      "V0100",
      "V0115",
      "V0082"
     ]
    }
   ],
   "prerequisites": [
    "G0019"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "聞いてながら 勉強します。",
     "why": "「ながら」接ます形词干（聞き），不接て形",
     "fix": "聞きながら勉強します。",
     "learner": "zh"
    },
    {
     "wrong": "音楽を聞きながら、音楽を聞きます。",
     "why": "主从句动作不能重复同一件事",
     "fix": "音楽を聞きながら勉強します。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "simultaneous"
   ],
   "source_ids": [
