 "grammar": [
  {
   "id": "G0074",
   "pattern": "V辞書形 + ため(に) / 普通形・N の + ため(に)",
   "meaning_zh": "为了…（目的）／因为…、由于…（原因）",
   "connection": "目的：意志动词 辞書形 + ため(に)；原因：普通形（多为 た形/ている/ない）或 名詞 + の + ため(に)",
   "usage": "目的句后项须是意志动作；原因句多接客观、非意志结果（事故・遅刻等），偏书面/正式，に 可省",
   "register_note": "ために 偏正式书面，口语表目的常用 ように。",
   "examples": [
    {
     "ja": "日本語を勉強するために、日本に来ました。",
     "zh": "为了学日语来了日本。",
     "vocab_ids": [
      "V0081",
      "V0082",
      "V0104"
     ]
    },
    {
     "ja": "渋滞のために、会議に遅れました。",
     "zh": "因为堵车，开会迟到了。",
     "vocab_ids": [
      "V0255",
      "V0244",
      "V0165"
     ]
    }
   ],
   "prerequisites": [
    "G0023",
    "G0021",
    "G0037"
   ],
   "compare": [
    {
     "id": "G0037",
     "diff": "から/ので 偏主观/口语原因；ため(に) 偏客观、书面、正式（新闻/公告多用）"
    },
    {
     "id": "G0064",
     "diff": "ようにする 是「努力做到某状态」；ために 是「为达成目的而做后项」"
    }
   ],
   "common_errors": [
    {
     "wrong": "日本語を勉強したために、来ました。",
     "why": "目的用 辞书形 勉強する；た形 变成「因为学了日语」原因义，中文「为了」直译用过去式错",
     "fix": "日本語を勉強するために来ました。",
     "learner": "zh"
    },
    {
     "wrong": "事故ため、電車が止まりました。",
     "why": "名词接 ため 要加 の：事故のため；中文「因事故」直译漏 の 错",
     "fix": "事故のため、電車が止まりました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "plain-form",
    "purpose",
    "cause",
    "formal"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-기 위해(서) / -때문에",
   "ko_diff": "韩语目的用기 위해(서)，原因用때문에；日语ために两义同形，须靠后项判断。"
  },
  {
   "id": "G0075",
   "pattern": "普通形 + のに（な形・名詞 は 〜な のに）",
   "meaning_zh": "明明…却…；…却（意外、不满、遗憾）",
   "connection": "動詞・い形 普通形 + のに；な形・名詞 + な + のに；后项是与预期相反的结果",
   "usage": "逆接，带说话人意外/责备/遗憾情绪；比 が/けど 情绪强",
   "register_note": "のに 口语情绪强，书面叙事也用。",
   "examples": [
    {
     "ja": "たくさん勉強したのに、合格できませんでした。",
     "zh": "明明学了很多却没考上。",
     "vocab_ids": [
      "V0082",
      "V0111"
     ]
    },
    {
     "ja": "今日は日曜日なのに、仕事に行きます。",
     "zh": "明明是周日却要去上班。",
     "vocab_ids": [
      "V0037",
      "V0085",
      "V0103"
     ]
    }
   ],
   "prerequisites": [
    "G0023",
    "G0016",
    "G0037"
   ],
   "compare": [
    {
     "id": "G0037",
     "diff": "から/ので 是顺接原因（因为…所以）；のに 是逆接转折（虽然…却），方向相反"
    }
   ],
   "common_errors": [
    {
     "wrong": "高いのにを買いました。",
     "why": "「のに」后不再接 を 等格助词提示前项；中文「虽然贵」直译叠加助词错",
     "fix": "高いのに買いました。",
     "learner": "zh"
    },
    {
     "wrong": "日曜日だのに、働きます。",
     "why": "名词/な形 接 のに 用 な（日曜日なのに），不用 だ；中文「是周日却」直译保留 だ 错",
     "fix": "日曜日なのに、働きます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "plain-form",
    "concession",
    "contrast",
    "emotion"
   ],
