 "listening": false,
 "grammar": [
  {
   "id": "G0028",
   "pattern": "～て から",
   "meaning_zh": "…之后（再）…",
   "connection": "動詞て形 + から",
   "usage": "强调动作先后顺序；「〜た から」是原因，形近义异",
   "register_note": "てから 日常会话常用，书面叙事也可。",
   "examples": [
    {
     "ja": "ご飯を食べてから、学校へ行きます。",
     "zh": "吃完饭后去学校。",
     "vocab_ids": [
      "V0051",
      "V0101",
      "V0039",
      "V0103"
     ]
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "ご飯を食べたから、学校へ行きます。",
     "why": "「〜たから」是“因为”；表示“先…再…”要用 てから。",
     "fix": "ご飯を食べてから、学校へ行きます。",
     "learner": "zh"
    },
    {
     "wrong": "食べるから、行きます。",
     "why": "から 前面接普通形是原因；表顺序必须用 て形＋から。",
     "fix": "食べてから、行きます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "sequence"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-고 나서 / -(으)ㄴ 후에",
   "ko_diff": "韩语고 나서强调先后，후에偏「之后」；日语てから强调先做这个再，语气更强。",
   "ko_pron": "～테 카라"
  },
  {
   "id": "G0029",
   "pattern": "～て も いい / ～て は いけない",
   "meaning_zh": "可以…／不许…",
   "connection": "動詞て形 + も いい（です）／+ は いけない",
   "usage": "许可与禁止；疑问 〜てもいいですか 是请求许可",
   "register_note": "てもいい/てはいけない 口语通用；正式规则用 てもよろしい/てはなりません。",
   "examples": [
    {
     "ja": "この本を読んでもいいですか。",
     "zh": "可以读这本书吗？",
     "vocab_ids": [
      "V0080",
      "V0113"
     ]
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "読んでも いけません",
     "why": "许可是 てもいい，禁止是 てはいけない，两组搭配固定，不能混着用。",
     "fix": "読んではいけません。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "permission",
    "prohibition"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "needs_review",
   "provenance": "self_reviewed",
   "ko_equiv": "-아/어도 되다 / -(으)면 안 되다",
   "ko_diff": "찍어도 돼요 对应 撮ってもいいです，찍으면 안 돼요 对应 撮ってはいけません。想问「可以吗」时说 撮ってもいいですか。",
   "ko_pron": "～테 모 이이 / ～테 와 이케나이"
  },
  {
   "id": "G0030",
   "pattern": "～ながら",
   "meaning_zh": "一边…一边…",
   "connection": "動詞ます形（去ます） + ながら",
   "usage": "同一主体同时做两件事，ながら 前是伴随动作，后面是主要动作。",
   "register_note": "ながら 偏书面叙述，口语也用但较生硬。",
   "examples": [
    {
     "ja": "音楽を聞きながら勉強します。",
     "zh": "边听音乐边学习。",
     "vocab_ids": [
      "V0100",
      "V0115",
      "V0082"
     ]
    }
   ],
   "prerequisites": [
    "G0019"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "聞いてながら 勉強します。",
     "why": "ながら 接ます形词干（聞きながら），不接て形。",
     "fix": "聞きながら勉強します。",
     "learner": "zh"
    },
    {
     "wrong": "音楽を聞きながら、音楽を聞きます。",
     "why": "前后两个动作要不同：一边听音乐一边做别的事，不是再听一次音乐。",
     "fix": "音楽を聞きながら勉強します。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
