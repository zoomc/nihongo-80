      "V0101"
     ]
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [
    {
     "id": "G0051",
     "diff": "〜ている 是「持续/状态」补助；〜てみる/しまう/おく 是另一组补助用法"
    }
   ],
   "common_errors": [
    {
     "wrong": "ご飯を食べて あります",
     "why": "“正在吃”用 食べている。てある 是“人为做好留在那”，如 窓が開けてある。",
     "fix": "ご飯を食べています。",
     "learner": "zh"
    },
    {
     "wrong": "食べって います。",
     "why": "食べる 的て形是 食べて，一段动词不走促音便。",
     "fix": "食べています。",
     "learner": "zh"
    }
   ],
