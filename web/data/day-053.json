 "grammar": [
  {
   "id": "G0201",
   "pattern": "〜そうだ（hearsay）",
   "meaning_zh": "听说…；据说…",
   "connection": "动词普通形／い形容词 + そうだ；な形容词・名词 + だ + そうだ",
   "usage": "转述从别处听来的信息，信息来源用「〜によると」提示。",
   "register_note": "口语与书面通用；书面常作「〜そうである」。",
   "examples": [
    {
     "ja": "天気予報では、明日は雪が降るそうです。",
     "zh": "天气预报说明天会下雪。"
    },
    {
     "ja": "駅前の本屋は来月なくなるそうだ。",
     "zh": "听说车站前的书店下个月要关门。"
    },
    {
     "ja": "リンさんのお兄さんは医者だそうです。",
     "zh": "听说小林先生的哥哥是医生。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0200",
     "diff": "そうだ（传闻）转述听来的信息，そうだ（样态）凭外观判断"
    }
   ],
   "common_errors": [
    {
     "wrong": "天気予報では、明日は雪が降るだそうです。",
     "why": "动词普通形直接接 そうだ，不用 だ",
     "fix": "天気予報では、明日は雪が降るそうです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-다고 하다",
   "ko_diff": "韩语 -다고 하다 是间接引语，与传闻 そうだ 对应；但日语 そうだ 前接名词要加 だ，韩语则用 -(이)라고 하다。",
   "notes": "",
   "tags": [
    "hearsay"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0202",
   "pattern": "〜らしい（hearsay/conjecture）",
   "meaning_zh": "好像…；据说…",
   "connection": "动词普通形／い形容词／な形容词词干／名词 + らしい",
   "usage": "根据传闻或迹象推断，语气比そうだ更客观、委婉。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "駅の近くに新しいカフェができたらしい。",
     "zh": "车站附近好像新开了一家咖啡店。"
    },
    {
     "ja": "部屋の電気が消えている。もう寝たらしい。",
     "zh": "房间的灯关着，看来他们已经睡了。"
    },
    {
     "ja": "あの店のラーメンはとても有名らしいです。",
     "zh": "听说那家店的拉面很有名。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0203",
     "diff": "らしい 可含传闻，ようだ 偏重眼前证据的推断"
    }
   ],
   "common_errors": [
    {
     "wrong": "あの店のラーメンはとても有名だらしいです。",
     "why": "名词和な形容词直接接 らしい，不加 だ",
     "fix": "あの店のラーメンはとても有名らしいです。",
     "learner": "zh"
    }
   ],
