 "grammar": [
  {
   "id": "G0045",
   "pattern": "～かもしれない / ～でしょう",
   "meaning_zh": "也许…／大概…吧",
   "connection": "普通形 + かもしれない；普通形 + でしょう",
   "usage": "かもしれない 表不确定推测，でしょう 表较有把握的推量/委婉断定",
   "register_note": "かもしれない 口语通用；でしょう 是礼貌推测，正式会话常用。",
   "examples": [
    {
     "ja": "明日は雨かもしれません。",
     "zh": "明天也许下雨。",
     "vocab_ids": [
      "V0024",
      "V0096"
     ]
    },
    {
     "ja": "彼は来るでしょう。",
     "zh": "他大概会来吧。",
     "vocab_ids": [
      "V0074",
      "V0104"
     ]
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "雨でしょう かもしれません",
     "why": "でしょう 与 かもしれない 是两种推测，不叠加",
     "fix": "雨でしょう。／雨かもしれません。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
