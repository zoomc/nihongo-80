 "grammar": [
  {
   "id": "G0254",
   "pattern": "〜に（frequency）",
   "meaning_zh": "每…（几次）",
   "connection": "数量词 + に + 数量词（回数）",
   "usage": "表示在一段时间内做某事的频率，如「一日に二回」。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "一週間に二回、プールで泳ぎます。",
     "zh": "我一周在游泳池游两次。"
    },
    {
     "ja": "母は一日に二回、犬の散歩をします。",
     "zh": "母亲一天遛两次狗。"
    },
    {
     "ja": "一年に一度、家族で旅行します。",
     "zh": "我们一年全家旅行一次。"
    }
   ],
   "prerequisites": [
    "G0009"
   ],
   "compare": [
    {
     "id": "G0250",
     "diff": "频率的 に 接数量词，时点的 に 接时间名词"
    }
   ],
   "common_errors": [
    {
     "wrong": "一週間で二回に、プールで泳ぎます。",
     "why": "频率基准用「一週間に二回」，に 跟在基准期间后",
     "fix": "一週間に二回、プールで泳ぎます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "에（빈도）",
   "ko_diff": "韩语 주에 두 번 与「一週間に二回」对应；但韩语「하루에 두 번」的 에 不可省略，日语 に 在口语中有时可省略。",
   "notes": "",
   "tags": [
