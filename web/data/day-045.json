 "grammar": [
  {
   "id": "G0062",
   "pattern": "V ます形(去ます) + やすい / にくい",
   "meaning_zh": "容易…／难以…",
   "connection": "動詞 ます形 去 ます + やすい・にくい；整体按 い形容詞 变形（読みやすくない／読みやすかった）",
   "usage": "表示做该动作的难易程度（不是能力），主语多用 が；偏客观属性",
   "register_note": "やすい/にくい 口语书面通用，描述属性。",
   "examples": [
    {
     "ja": "この本は読みやすいです。",
     "zh": "这本书好读。",
     "vocab_ids": [
      "V0080",
      "V0113"
     ]
    },
    {
     "ja": "このペンは書きにくいです。",
     "zh": "这支笔不好写。",
     "vocab_ids": [
      "V0112",
      "V0080"
     ]
    }
   ],
   "prerequisites": [
    "G0019",
    "G0015"
   ],
   "compare": [
    {
     "id": "G0024",
     "diff": "可能形 表「有没有能力/条件做」；やすい・にくい 表「客观上容易/难做」"
    },
    {
     "id": "G0039",
     "diff": "〜ことができる 是能力；やすい 是难度/倾向"
    }
   ],
   "common_errors": [
    {
     "wrong": "この本は読むやすいです。",
     "why": "必须接 ます形去ます（読み），不能用辞书形 読む；中文「容易读」直译错",
     "fix": "この本は読みやすいです。",
     "learner": "zh"
    },
    {
     "wrong": "この問題は分かりやすいでした。",
     "why": "やすい 按 い形变形，过去是 やすかった，不是 やすいでした；中文无词尾变化易错",
     "fix": "この問題は分かりやすかったです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "tags": [
    "masu-form",
    "i-adj",
    "difficulty",
    "suffix"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-기 쉽다 / -기 어렵다",
   "ko_diff": "韩语用기 쉽다/어렵다分析形，书面感强；日语やすい/にくい是一体化后缀，更口语。"
  },
  {
   "id": "G0063",
   "pattern": "Vます形(去ます)/い形(去い)/な形词干 + すぎる",
   "meaning_zh": "过于…；…得过头",
   "connection": "動詞ます形去ます、い形容词去 い、な形容词/名词 词干 + すぎる；すぎる 按一段动词变形",
   "usage": "超过适度；な形/名词直接接（静かすぎる／甘すぎる），不加 な；食べすぎる 是复合动词",
   "register_note": "すぎる 口语通用，带主观评价。",
   "examples": [
    {
     "ja": "食べすぎてお腹が痛いです。",
     "zh": "吃多了肚子疼。",
     "vocab_ids": [
      "V0101"
     ]
    },
    {
     "ja": "この靴は高すぎます。",
     "zh": "这鞋太贵了。",
     "vocab_ids": [
      "V0125"
     ]
    }
   ],
   "prerequisites": [
    "G0019",
    "G0015",
    "G0016"
   ],
   "compare": [
    {
     "id": "G0062",
     "diff": "やすい/にくい 表难易；すぎる 表程度过头"
    },
    {
     "id": "G0034",
     "diff": "より/ほうが 是两者比较；すぎる 是超过标准"
    }
   ],
   "common_errors": [
    {
     "wrong": "食べるすぎます。",
     "why": "必须接 ます形去ます（食べ），不能用辞书形；中文「吃太多」直译错",
     "fix": "食べすぎます。",
     "learner": "zh"
    },
    {
