 "grammar": [
  {
   "id": "G0166",
   "pattern": "〜場合（は）",
   "meaning_zh": "在…情况下",
   "connection": "动词普通形/い形容词/ナ形容词な/名词の + 場合（は）",
   "usage": "预设某种情况并说明应对办法，语气客观、正式。",
   "register_note": "书面语为主，通知和规章常用。",
   "examples": [
    {
     "ja": "雨の場合は、試合は中止になります。",
     "zh": "下雨的话，比赛取消。"
    },
    {
     "ja": "カードをなくした場合は、すぐに銀行に連絡してください。",
     "zh": "卡丢了的话，请马上联系银行。"
    },
    {
     "ja": "予約の時間に遅れる場合は、お電話でお知らせください。",
     "zh": "如果会晚于预约时间，请打电话通知我们。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0025",
     "diff": "たら/ば 是日常条件句，場合 更正式，且只用于需要应对的具体情况。"
    }
   ],
   "common_errors": [
    {
     "wrong": "雨場合、試合は中止になります。",
     "why": "名词接「場合」要加「の」，说「雨の場合」。",
     "fix": "雨の場合は",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-는 경우",
   "ko_diff": "韩语「-는 경우」与「場合」对应；但日语「場合」偏书面、用于预设应对，日常口语多用「たら」。",
