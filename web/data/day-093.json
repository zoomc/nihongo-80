 "grammar": [
  {
   "id": "G0098",
   "pattern": "〜わけではない",
   "meaning_zh": "并不是…；并非…",
   "connection": "普通形 + わけではない；ナ形容词 + な + わけではない；名词 + という + わけではない",
   "usage": "部分否定对方的整体判断，常与「別に」「必ずしも」呼应。",
   "register_note": "口语书面均可；口语常说「わけじゃない」。",
   "examples": [
    {
     "ja": "料理が嫌いなわけではないが、毎日作る時間がない。",
     "zh": "我不是讨厌做饭，只是每天没时间做。"
    },
    {
     "ja": "値段が高ければおいしいというわけではない。",
     "zh": "贵并不等于好吃。"
    },
    {
     "ja": "全然分からないわけではありませんが、もう少しゆっくり話していただけますか。",
     "zh": "也不是完全听不懂，能请您再说慢一点吗？"
    }
   ],
   "prerequisites": [
    "G0023",
    "G0053"
   ],
   "compare": [
    {
     "id": "G0097",
     "diff": "わけだ 表肯定推论，わけではない 表部分否定，常用来修正对方的过度概括。"
    }
   ],
   "common_errors": [
    {
     "wrong": "この店は便利わけではないが、駅から近い。",
     "why": "ナ形容词接「わけではない」必须加「な」，「便利わけではない」不合法。",
     "fix": "便利なわけではない",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-는 것은 아니다",
   "ko_diff": "韩语「-는 것은 아니다」也表部分否定，但常缩成「-는 게 아니다」；日语「わけではない」更明确针对“由此推出的结论”。",
   "notes": "",
   "tags": [
    "negation",
    "concession"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0099",
   "pattern": "〜わけがない",
   "meaning_zh": "不可能…；绝不会…",
   "connection": "普通形 + わけがない；ナ形容词 + な + わけがない；名词 + の/な + わけがない",
   "usage": "依据常理强烈否定某种可能性，语气比单纯否定更强。",
   "register_note": "口语书面均可；口语常说「わけない」。",
   "examples": [
    {
     "ja": "こんなに練習したんだから、負けるわけがない。",
     "zh": "练了这么多，不可能输。"
    },
    {
     "ja": "あんなにまじめな人が、約束を忘れるわけがありません。",
     "zh": "那么认真的人，绝不可能忘记约定。"
    },
    {
     "ja": "一日で漢字を百個覚えるなんて、できるわけがないよ。",
     "zh": "一天记一百个汉字？不可能做到。"
    }
   ],
   "prerequisites": [
    "G0023",
    "G0071"
   ],
   "compare": [
    {
     "id": "G0096",
     "diff": "はずがない 是“按理不该”，わけがない 更强调“没道理”，主观性更强。"
    }
   ],
   "common_errors": [
    {
     "wrong": "あんなにまじめな人が約束を忘れるわけがないだった。",
     "why": "「わけがない」的过去形是「わけがなかった」，不能再接「だった」。",
     "fix": "…忘れるわけがなかった。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-ㄹ 리가 없다",
   "ko_diff": "韩语「-ㄹ 리가 없다」与「わけがない」几乎一一对应；但韩语口语常说「-ㄹ 리가 없잖아」反驳，日语习惯前加「そんな」。",
   "notes": "",
