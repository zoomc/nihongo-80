    "refusal",
    "needs_review",
    "polite"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-(으)ㄹ 수도 있다 / -기 어렵다",
   "ko_diff": "韩语ㄹ 수도 있다表恐怕会(坏结果)，委婉拒绝用하기 어렵습니다；かねる的立场限制韩语须另加说明。"
  }
