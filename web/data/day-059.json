 "grammar": [
  {
   "id": "G0213",
   "pattern": "〜れる / 〜られる（passive）",
   "meaning_zh": "被…；遭受…",
   "connection": "五段动词未然形+れる；一段动词未然形+られる；する→される；来る→来られる",
   "usage": "表示被他人施加动作，或事物被处理；受害被动常带困扰语气。",
   "register_note": "口语与书面通用；书面语中被动句更常见。",
   "examples": [
    {
     "ja": "先生に作文をほめられました。",
     "zh": "我的作文受到了老师表扬。"
    },
    {
     "ja": "電車の中で足を踏まれた。",
     "zh": "我在电车里被踩了脚。"
    },
    {
     "ja": "この寺は六百年前に建てられました。",
     "zh": "这座寺庙建于六百年前。"
    }
   ],
   "prerequisites": [
    "G0049"
   ],
   "compare": [
    {
     "id": "G0212",
     "diff": "受身形 表被动，可能形 表能力，注意助词与形式相近"
    }
   ],
   "common_errors": [
    {
     "wrong": "この寺は六百年前に建てらました。",
     "why": "建てる 的受身是「建てられ」，不是「建てら」",
     "fix": "この寺は六百年前に建てられました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "피동 (-이/히/리/기-)",
   "ko_diff": "韩语用被动词尾或 -에 의해，日语用助动词 れる／られる；日语受害被动（足を踏まれた）在韩语中常改用主动句或 -당하다。",
   "notes": "",
   "tags": [
    "voice",
    "conjugation"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0214",
   "pattern": "〜せる / 〜させる",
   "meaning_zh": "让…做；使…做",
   "connection": "五段动词未然形+せる；一段动词未然形+させる；する→させる；来る→来させる",
   "usage": "表示使役，可指命令、允许或放任，视上下文而定。",
   "register_note": "口语与书面通用；使役句的助词常用 を／に。",
   "examples": [
    {
     "ja": "母は毎日弟に野菜を食べさせる。",
     "zh": "母亲每天让弟弟吃蔬菜。"
    },
    {
     "ja": "コーチは毎日、選手たちを走らせた。",
     "zh": "教练每天让选手们跑步。"
    },
    {
     "ja": "息子が行きたいと言ったので、一人で旅行に行かせました。",
     "zh": "儿子说想去，我就让他一个人去旅行了。"
    }
   ],
   "prerequisites": [
    "G0050"
   ],
   "compare": [
    {
     "id": "G0215",
     "diff": "使役 是让别人做，使役受身 是被迫做"
    }
   ],
   "common_errors": [
    {
     "wrong": "母は毎日弟を野菜を食べさせる。",
     "why": "使役对象用 に，不能再用 を 标记同一成分",
     "fix": "母は毎日弟に野菜を食べさせる。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-게 하다",
   "ko_diff": "韩语 -게 하다 与使役对应，但日语使役对象用 に 还是 を 取决于动词；韩语统一用 을/를 或 에게，需按语义判断。",
