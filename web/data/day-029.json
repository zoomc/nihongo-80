 "grammar": [
  {
   "id": "G0269",
   "pattern": "〜より",
   "meaning_zh": "比…",
   "connection": "名词 + より",
   "usage": "表示比较的基准，常与「の方が」呼应。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "今日はきのうより寒いです。",
     "zh": "今天比昨天冷。"
    },
    {
     "ja": "電車はバスより速いです。",
     "zh": "电车比公交车快。"
    },
    {
     "ja": "兄は父より背が高いです。",
     "zh": "哥哥比父亲高。"
    }
   ],
   "prerequisites": [
    "G0034"
   ],
   "compare": [
    {
     "id": "G0270",
     "diff": "より 标比较基准，の方が 标较优的一方"
    }
   ],
   "common_errors": [
    {
     "wrong": "今日はきのうよりが寒いです。",
     "why": "より 后不加 が",
     "fix": "今日はきのうより寒いです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "보다",
   "ko_diff": "韩语 보다 与 より 对应，位置在比较对象后；日语 より 后直接接形容词，韩语 보다 后也直接接，语序相近。",
   "notes": "",
   "tags": [
    "particle",
    "comparison"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0270",
   "pattern": "〜の方が〜より",
   "meaning_zh": "…比…更…",
   "connection": "名词 + の方が + 名词 + より + 形容词",
   "usage": "明确指出两者中较优或程度更高的一方，より 引出比较基准。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "犬の方が猫より好きです。",
     "zh": "我更喜欢狗，而不是猫。"
    },
    {
     "ja": "東京の方が大阪より人が多いです。",
     "zh": "东京比大阪人多。"
    },
    {
     "ja": "夏より冬の方が好きです。",
     "zh": "比起夏天，我更喜欢冬天。"
    }
   ],
   "prerequisites": [
    "G0034"
   ],
   "compare": [
    {
     "id": "G0269",
     "diff": "の方が 指出胜出项，より 只标基准"
    }
   ],
   "common_errors": [
    {
     "wrong": "犬が方が猫より好きです。",
     "why": "需要用「の方が」，不是「が方が」",
     "fix": "犬の方が猫より好きです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "가/이 더 …",
   "ko_diff": "韩语用 이/가 더 表胜出项，보다 表基准；日语「の方が」是固定形式，不能换成 が。",
