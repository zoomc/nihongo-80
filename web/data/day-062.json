     "zh": "已经九点了，快睡吧。"
    },
    {
     "ja": "次の文を読んで、質問に答えなさい。",
     "zh": "读下面的文章，然后回答问题。"
    },
    {
     "ja": "ご飯の前に手を洗いなさい。",
     "zh": "吃饭前要洗手。"
    }
   ],
   "prerequisites": [
