  {
   "id": "G0256",
   "pattern": "〜で（place of action）",
   "meaning_zh": "在…（做某事）",
   "connection": "名词（场所）+ で",
   "usage": "表示动作发生的场所，与存在场所的 に 相对。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "図書館で本を読みます。",
     "zh": "我在图书馆看书。"
    },
    {
     "ja": "きのう、デパートでくつを買いました。",
     "zh": "昨天在百货商店买了鞋。"
    },
    {
     "ja": "駅の前で友達を待ちました。",
     "zh": "我在车站前等朋友。"
    }
   ],
