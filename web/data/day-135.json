 "grammar": [
  {
   "id": "G0174",
   "pattern": "〜わりに / 〜わりには",
   "meaning_zh": "照…来说；相对…而言",
   "connection": "动词普通形/い形容词/ナ形容词な/名词の + わりに（は）",
   "usage": "表示与某程度、数量、条件相比，结果出乎预料。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "この店は値段のわりに、量が多くておいしい。",
     "zh": "这家店相对价格来说，量多又好吃。"
    },
    {
     "ja": "兄はよく食べるわりには、全然太らない。",
     "zh": "哥哥吃得那么多，却完全不胖。"
    },
    {
     "ja": "このホテルは駅から近いわりに、静かでよく眠れた。",
     "zh": "这家宾馆离车站近，却意外地安静，睡得很好。"
    }
   ],
   "prerequisites": [
    "G0082"
   ],
   "compare": [
    {
     "id": "G0142",
     "diff": "わりに 依据比例、程度判断，にしては 依据身份、时间等前提判断。"
    }
   ],
   "common_errors": [
    {
     "wrong": "兄はよく食べるのわりには、全然太らない。",
     "why": "动词直接接「わりに」，只有名词才加「の」。",
     "fix": "よく食べるわりには",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-에 비해서",
   "ko_diff": "韩语没有与「わりに」完全对应的形式，常译成「-에 비해서」或「-치고는」；日语专表“比例上不符预期”。",
