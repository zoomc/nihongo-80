 "grammar": [
  {
   "id": "G0180",
   "pattern": "〜ふりをする",
   "meaning_zh": "假装…",
   "connection": "动词普通形/い形容词/ナ形容词な/名词の + ふりをする",
   "usage": "表示故意做出与实际不符的样子。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "母に呼ばれたが、聞こえないふりをしてゲームを続けた。",
     "zh": "妈妈叫我，我装作没听见继续玩游戏。"
    },
    {
     "ja": "彼は本当は知っているのに、知らないふりをしている。",
     "zh": "他其实知道，却装作不知道。"
    },
    {
     "ja": "電車の中で、寝たふりをして席を譲らない人がいる。",
     "zh": "电车里有人装睡不让座。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0122",
     "diff": "らしい 是“看起来像”，ふりをする 是故意假装，含欺骗意图。"
    }
   ],
   "common_errors": [
    {
     "wrong": "母に呼ばれたが、聞こえないのふりをしてゲームを続けた。",
     "why": "动词、形容词直接接「ふり」，不加「の」。",
     "fix": "聞こえないふりをして",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-는 척하다",
   "ko_diff": "韩语「-는 척하다」与「ふりをする」对应；但日语「ふり」是名词，要用「〜のふり」，韩语直接接「척」。",
