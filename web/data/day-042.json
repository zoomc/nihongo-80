 "grammar": [
  {
   "id": "G0052",
   "pattern": "授受 ～てあげる／てくれる／てもらう",
   "meaning_zh": "给（别人）做…／给（我）做…／请（人）做…",
   "connection": "動詞て形 + あげる／くれる／もらう",
   "usage": "表动作授受与恩惠方向：あげる 我→人、くれる 人→我、もらう 我请人做",
   "register_note": "授受补助动词是口语核心；正式场合需换敬语版 いただく/くださる。",
   "examples": [
    {
     "ja": "私は友達に日本語を教えてあげました。",
     "zh": "我教了朋友日语。",
     "vocab_ids": [
      "V0001",
      "V0076",
      "V0081",
      "V0121"
     ]
    },
    {
     "ja": "友達に日本語を教えてもらいました。",
     "zh": "请朋友教了我日语。",
     "vocab_ids": [
      "V0076",
      "V0081",
      "V0121"
     ]
    }
   ],
   "prerequisites": [
    "G0020",
    "G0009",
    "G0187"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "友達が私に教えてあげました",
     "why": "「别人给我做」用 くれる/てもらう，あげる 方向反了",
     "fix": "友達が私に教えてくれました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "tags": [
    "giving",
    "auxiliary"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "needs_review",
   "provenance": "self_reviewed",
   "ko_equiv": "-아/어 주다 / -아·어 받다",
   "ko_diff": "韩语只用주다(给)与받다(受)，无あげる/くれる/もらう的方向三分；敬语用드리다/주시다。"
  },
  {
   "id": "G0056",
   "pattern": "N が V(他動詞)て ある",
   "meaning_zh": "（人为地）已经…着；事先做好了…",
   "connection": "他動詞て形 + ある；结果状态常用 が；已做好的准备也可用 を（例：本を置いてある）",
   "usage": "表示某人有意为之、结果留存至今的状态，常用于准备已完成；不接自动词",
   "register_note": "てある 偏书面说明状态，口语也用。",
   "examples": [
    {
     "ja": "机の上に本が置いてあります。",
     "zh": "桌上放着书（事先摆好的）。",
     "vocab_ids": [
      "V0080",
      "V0047"
     ]
    },
    {
     "ja": "ホテルの予約がしてあります。",
     "zh": "酒店已经（事先）订好了。",
     "vocab_ids": [
      "V0187",
      "V0092"
     ]
    }
   ],
   "prerequisites": [
    "G0020",
    "G0027"
   ],
   "compare": [
    {
     "id": "G0027",
     "diff": "ている 表进行或自然结果状态（多接自动词）；てある 表人为做完后的结果（接他动词，宾语改 が）"
    }
   ],
   "common_errors": [
    {
     "wrong": "ドアが開いてあります。",
     "why": "「開く」是自动词，自动词不能接 てある（应用 ている）；中文「开着」不区分自他",
     "fix": "ドアが開いています。（人为打开并保持则 開けてあります）",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
