 "grammar": [
  {
   "id": "G0153",
   "pattern": "〜最中に",
   "meaning_zh": "正当…的时候",
   "connection": "动词ている + 最中に；名词 + の + 最中に",
   "usage": "表示某动作正值高潮时另一事突然发生，多含妨碍意味。",
   "register_note": "口语书面均可，语气较郑重。",
   "examples": [
    {
     "ja": "大事な会議の最中に、携帯電話が鳴ってしまった。",
     "zh": "正开重要会议时，手机响了。"
    },
    {
     "ja": "料理をしている最中に、停電になった。",
     "zh": "正做饭时停电了。"
    },
    {
     "ja": "今、試験の最中だから、廊下では静かにしてください。",
     "zh": "现在正在考试，请在走廊保持安静。"
    }
   ],
   "prerequisites": [
    "G0089"
   ],
   "compare": [
    {
     "id": "G0133",
     "diff": "ところに 是“正要、正在时”，最中に 强调“正做到一半”，妨碍感更强。"
    }
   ],
   "common_errors": [
    {
     "wrong": "大事な会議最中に、携帯電話が鳴ってしまった。",
     "why": "「最中」是名词，接名词要加「の」，说「会議の最中に」。",
     "fix": "会議の最中に",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-는 중에",
   "ko_diff": "韩语「-는 중에」只表“进行中”；日语「最中に」还隐含“被打断、扫兴”的语感。",
   "notes": "",
   "tags": [
    "time",
    "simultaneity"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0154",
   "pattern": "〜ついでに",
   "meaning_zh": "顺便…",
   "connection": "动词辞书形/た形 + ついでに；名词 + の + ついでに",
   "usage": "表示利用做某事的机会，顺便再做另一件事。",
   "register_note": "口语为主。",
   "examples": [
    {
     "ja": "郵便局へ行くついでに、この手紙も出してきてくれる？",
     "zh": "你去邮局的话，顺便帮我把这封信寄了好吗？"
    },
    {
     "ja": "京都へ出張したついでに、昔の友達に会ってきた。",
     "zh": "去京都出差时，顺便见了老朋友。"
    },
    {
     "ja": "買い物のついでに、図書館に本を返した。",
     "zh": "买东西时顺便把书还给了图书馆。"
    }
   ],
   "prerequisites": [
    "G0087"
   ],
   "compare": [
    {
     "id": "G0151",
     "diff": "たびに 是“每次必做”，ついでに 是“顺手多做一件”，不具反复性。"
    }
   ],
   "common_errors": [
    {
