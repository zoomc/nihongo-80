  },
  {
   "id": "G0054",
   "pattern": "～おかげで / ～せいで",
   "meaning_zh": "多亏…／都怪…",
   "connection": "名/な形 + の/な + おかげで／せいで；普通形 + おかげで／せいで",
   "usage": "おかげで 表积极原因（多亏），せいで 表消极原因（都怪）；感情色彩固定",
   "register_note": "おかげで/せいで 口语通用；せいで 带负面情绪，正式场合慎用。",
   "examples": [
    {
     "ja": "先生のおかげで、日本語が上手になりました。",
     "zh": "多亏老师，日语变好了。",
     "vocab_ids": [
      "V0079",
      "V0081"
     ]
    },
    {
     "ja": "雨のせいで、行けませんでした。",
     "zh": "都怪下雨，没能去成。",
     "vocab_ids": [
      "V0096",
      "V0103"
     ]
    }
   ],
   "prerequisites": [
    "G0006",
    "G0023"
   ],
   "compare": [],
   "common_errors": [
