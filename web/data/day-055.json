 "grammar": [
  {
   "id": "G0205",
   "pattern": "〜すぎる",
   "meaning_zh": "过于…；…过头",
   "connection": "动词ます形去ます／い形容词去い／な形容词词干 + すぎる",
   "usage": "表示程度超过适当范围，常带负面评价。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "ゆうべ飲みすぎて、頭が痛い。",
     "zh": "昨晚喝多了，头好痛。"
    },
    {
     "ja": "この靴は私には大きすぎます。",
     "zh": "这双鞋对我来说太大了。"
    },
    {
     "ja": "この問題は簡単すぎて、つまらない。",
     "zh": "这道题太简单了，很无聊。"
    }
   ],
