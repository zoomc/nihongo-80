 "grammar": [
  {
   "id": "G0129",
   "pattern": "〜気がする",
   "meaning_zh": "感觉…；总觉得…",
   "connection": "普通形 + 気がする；ナ形容词 + な + 気がする；名词 + の + ような + 気がする",
   "usage": "表达模糊的直觉或主观感觉，把握不大。",
   "register_note": "口语为主，书面也可。",
   "examples": [
    {
     "ja": "この人とは、どこかで会ったことがある気がする。",
     "zh": "总觉得在哪儿见过这个人。"
    },
    {
     "ja": "今日は何か、いいことがありそうな気がする。",
     "zh": "今天总觉得会有好事发生。"
    },
    {
     "ja": "ドアの鍵をかけ忘れたような気がして、家に戻った。",
     "zh": "觉得好像忘了锁门，就回家了一趟。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
