 "grammar": [
  {
   "id": "G0108",
   "pattern": "〜ことになっている",
   "meaning_zh": "规定…；按理…",
   "connection": "动词辞书形/ない形 + ことになっている",
   "usage": "陈述集体规定、既定安排或社会惯例，不由个人意志决定。",
   "register_note": "口语书面均可，通知和规章中常见。",
   "examples": [
    {
     "ja": "この寮では、夜十一時までに戻ることになっている。",
     "zh": "这栋宿舍规定晚上十一点前必须回来。"
    },
    {
     "ja": "来月から大阪の支社で働くことになっています。",
     "zh": "安排我从下个月起去大阪分公司工作。"
    },
    {
     "ja": "図書館の中では、飲み物を飲んではいけないことになっている。",
     "zh": "图书馆规定里面不能喝饮料。"
    }
   ],
   "prerequisites": [
    "G0065"
   ],
   "compare": [
    {
     "id": "G0107",
     "diff": "ことになっている 是外部规定，ことにしている 是自己定的规矩。"
    }
   ],
   "common_errors": [
    {
     "wrong": "この寮では、夜十一時までに戻ることになっているです。",
     "why": "「ことになっている」是普通体，礼貌说法是「ことになっています」。",
     "fix": "戻ることになっています",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-기로 되어 있다",
   "ko_diff": "韩语「-기로 되어 있다」同样表既定安排；但日语还能暗示“规定如此、实际未必”，带距离感，韩语较少这层含义。",
   "notes": "",
   "tags": [
    "decision",
    "obligation"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0109",
   "pattern": "〜こと（instruction）",
   "meaning_zh": "必须…；不得…",
   "connection": "动词辞书形/ない形 + こと（用于告示、规章结句）",
   "usage": "用于书面规章、通知，条列必须做或禁止做的事。",
   "register_note": "仅限书面告示、手册，会话中不用。",
   "examples": [
    {
     "ja": "レポートは、来週の金曜日までに提出すること。",
     "zh": "报告须在下周五前提交。"
    },
    {
     "ja": "図書館の本に、線を引かないこと。",
     "zh": "不得在图书馆的书上画线。"
    },
    {
     "ja": "試験中は、スマホの電源を切っておくこと。",
     "zh": "考试期间须关闭手机电源。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0026",
     "diff": "てください 是口头请求，こと 是书面规章，语气强硬且不面对听话人。"
    }
   ],
   "common_errors": [
    {
     "wrong": "レポートは、来週の金曜日までに提出しますこと。",
     "why": "「こと」结句要求动词辞书形在前，不能嵌入「ます」。",
     "fix": "提出すること。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-할 것",
   "ko_diff": "韩语规章也用「-할 것」，与日语「こと」结句几乎一致；但禁止句韩语用「-하지 말 것」，日语用「ないこと」。",
