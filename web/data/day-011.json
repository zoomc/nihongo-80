 "grammar": [
  {
   "id": "G0020",
   "pattern": "て形",
   "meaning_zh": "动词て形（连接/中顿/请求基础）",
   "connection": "五段音便（って/んで/いて/いで/して）；一段 去る+て；カ変 来て；サ変 して",
   "usage": "表中顿、并列、请求（てください）、进行（ている）等",
   "register_note": "て形口语书面通用，是请求、进行、中顿的基础。",
   "examples": [
    {
     "ja": "本を読んでいます。",
     "zh": "正在读书。",
     "vocab_ids": [
      "V0080",
      "V0113"
     ]
    },
    {
     "ja": "食べてください。",
     "zh": "请吃。",
     "vocab_ids": [
      "V0101"
     ]
    }
   ],
   "prerequisites": [
    "G0019"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "行くて。",
     "why": "「行く」是促音便例外：行って；不是 い音便 行いて",
     "fix": "行って。",
     "learner": "zh"
    },
    {
     "wrong": "食べって。",
     "why": "一段动词去 る + て；促音便只用于五段",
     "fix": "食べて。",
     "learner": "zh"
    },
    {
     "wrong": "飲みて。",
     "why": "む 结尾是拨音便 飲んで，不是 飲みて",
     "fix": "飲んで。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "verb",
    "conjugation"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-고 / -아·어서",
   "ko_diff": "韩语连接词尾按语义分고(并列)、서(顺序/原因)，不能一词尾通吃；日语て形用途更广。"
  },
  {
   "id": "G0021",
   "pattern": "た形（普通过去）",
   "meaning_zh": "动词た形（简体过去）",
   "connection": "て形 的 て/で → た/だ",
   "usage": "简体过去；用于 たり、たことがある、たら 等；ます形过去是 ました（另一套）",
   "register_note": "た形简体用于朋友、日记、书面叙事；对上级用 ました。",
   "examples": [
    {
     "ja": "昨日、映画を見た。",
     "zh": "昨天看了电影。",
