 "grammar": [
  {
   "id": "G0332",
   "pattern": "〜に限って",
   "pattern_kana": "〜にかぎって",
   "meaning_zh": "偏偏…；唯独…不会",
   "ko_equiv": "하필 …때만 / …만은 그럴 리가 없다",
   "connection": "名词 + に限って",
   "usage": "",
   "ko_diff": "「急いでいるときに限って」说讨厌的巧合；「あの人に限ってそんなことはしない」则是坚信唯独这个人不会那样。",
   "examples": [
    {
     "ja": "傘を持っていない日に限って、雨が降るんだよね。",
     "en": "It always rains on exactly the days I don't have an umbrella.",
     "zh": "偏偏没带伞的日子就下雨。"
    },
    {
     "ja": "几帳面な彼に限って、集合時間を忘れるはずがない。",
     "zh": "他那么仔细，唯独他不可能忘记集合时间。"
    }
   ],
   "tags": [
    "limitation",
    "emphasis"
   ],
   "jlpt": "N2",
   "prerequisites": [],
   "compare": [],
   "common_errors": [
    {
     "wrong": "傘を持っていない日に限らず、雨が降る。",
     "why": "「偏偏…」用 に限って；に限らず 是“不限于”。",
     "fix": "傘を持っていない日に限って、雨が降る。",
     "learner": "ko"
    }
   ],
