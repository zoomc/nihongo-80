 "grammar": [
  {
   "id": "G0094",
   "pattern": "Vます形(去ます) + ようがない / ようもない",
   "meaning_zh": "无法…；没有办法…",
   "connection": "動詞ます形去ます + ようがない；する→しようがない；句末 ようがありません",
   "usage": "表示想做但客观上没有手段/方法，不是能力不足；常与「〜たくても」呼应。",
   "examples": [
    {
     "ja": "名前も住所も分からないので、連絡しようがありません。",
     "zh": "姓名和住址都不知道，所以没法联系。",
     "vocab_ids": [
      "V0185"
     ]
    },
    {
     "ja": "電源が入らないので、直しようがありません。",
     "zh": "电源打不开，所以没法修。",
     "vocab_ids": [
      "V0158"
     ]
    }
   ],
   "prerequisites": [
    "G0019",
    "G0022"
   ],
   "compare": [
    {
     "id": "G0024",
     "diff": "可能形 表能力/条件；ようがない 表“根本没有办法/手段”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "名前も分からないので、連絡するようがありません。",
     "why": "ようがない 接ます形去ます（し），不接辞书形；中文“没有办法联系”直译错。",
     "fix": "連絡しようがありません。",
     "learner": "zh"
    },
    {
     "wrong": "電源が入らないので、直すようがないです。",
     "why": "ようがない 接ます形去ます（直し），不接辞书形 直す；「直しようがないです」才是自然形式。",
     "fix": "直しようがありません。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "masu-form",
    "possibility",
    "negative"
   ],
   "register_note": "中性；多用于说明无计可施，不用于礼貌请求。",
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "source_ids": [
    "S000"
   ],
   "ko_equiv": "-(으)ㄹ 방법이 없다",
   "ko_diff": "韩语ㄹ 방법이 없다表无手段，与能力不足的ㄹ 수 없다区分；同日语ようがない与できない之别。"
  },
  {
   "id": "G0095",
   "pattern": "N / Vます形(去ます) + がちだ",
   "meaning_zh": "容易…；往往…（多指不好的倾向）",
   "connection": "名詞 + がちだ；動詞ます形去ます + がちだ；がちな + 名詞",
   "usage": "表示某种（多负面）倾向容易发生；常用「〜がちです／がちな人」。",
   "examples": [
    {
     "ja": "朝は電車が遅れがちです。",
     "zh": "早上电车容易晚点。",
     "vocab_ids": [
      "V0060",
      "V0165"
     ]
    },
    {
     "ja": "忙しい時期は、食事が不規則になりがちです。",
     "zh": "忙碌时期，饮食容易不规律。",
     "vocab_ids": [
      "V0131"
     ]
    }
   ],
   "prerequisites": [
    "G0019",
    "G0023"
   ],
   "compare": [
    {
     "id": "G0063",
     "diff": "すぎる 是“过度”；がち 是“容易发生某倾向”，程度不一定过头。"
    }
   ],
   "common_errors": [
    {
     "wrong": "彼は病気がちなです。",
     "why": "がち 是な形容詞型，接です 用「がちです」，不用「がちなです」；中文“容易生病”直译。",
     "fix": "彼は病気がちです。",
     "learner": "zh"
    },
    {
     "wrong": "朝は電車が遅れがちな。",
     "why": "がちな 后面必须接名词；句末要用 がちだ／がちです。中文“容易晚点”直译成 な 收尾不合法。",
     "fix": "朝は電車が遅れがちです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "noun",
    "masu-form",
    "tendency"
   ],
   "register_note": "中性偏书面；多用于负面倾向。",
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "source_ids": [
    "S000"
   ],
   "ko_equiv": "-기 쉽다 / -는 경향이 있다",
   "ko_diff": "韩语기 쉽다表容易(中性)，负面倾向用는 경향이 있다；日语がちだ多负面，语感更窄。"
  }
