 "grammar": [
  {
   "id": "G0246",
   "pattern": "〜と思う",
   "meaning_zh": "我认为…",
   "connection": "动词普通形／い形容词 + と思う；な形容词・名词 + だ + と思う",
   "usage": "表示说话人的判断或意见，礼貌体用「と思います」缓和语气。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "この映画はきっと人気が出ると思う。",
     "zh": "我觉得这部电影一定会受欢迎。"
    },
    {
     "ja": "彼女は今日は来ないと思います。",
     "zh": "我想她今天不会来。"
    },
    {
     "ja": "日本の電車はとても便利だと思います。",
     "zh": "我觉得日本的电车非常方便。"
    }
   ],
   "prerequisites": [
    "G0036"
   ],
   "compare": [
    {
     "id": "G0240",
     "diff": "と思う 明示说话人判断，だろう 直接推测"
    }
   ],
   "common_errors": [
    {
     "wrong": "この映画はきっと人気が出るだと思う。",
     "why": "动词普通形直接接 と思う，不加 だ",
     "fix": "この映画はきっと人気が出ると思う。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-다고 생각하다",
   "ko_diff": "韩语 -다고 생각하다 与 と思う 对应，但日语 と思う 常省略主语，韩语则常出现 저는；日语疑问句用 と思いますか 更委婉。",
   "notes": "",
