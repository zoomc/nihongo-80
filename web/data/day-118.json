 "grammar": [
  {
   "id": "G0145",
   "pattern": "〜に比べて",
   "meaning_zh": "与…相比",
   "connection": "名词 + に比べて；动词辞书形 + のに比べて",
   "usage": "拿两个对象作比较，指出差异。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "今年の夏は、去年に比べてずいぶん涼しい。",
     "zh": "今年夏天比去年凉快得多。"
    },
    {
     "ja": "都会に比べて、田舎は家賃が安い。",
     "zh": "和城市相比，乡下房租便宜。"
    },
    {
     "ja": "電車で行くのに比べて、車で行くと三十分ほど長くかかる。",
     "zh": "和坐电车去相比，开车要多花三十分钟左右。"
    }
   ],
   "prerequisites": [
    "G0034"
   ],
   "compare": [
    {
     "id": "G0034",
     "diff": "より 是简单的比较基准，に比べて 明示“对比之下”，更强调差异。"
    }
   ],
   "common_errors": [
    {
     "wrong": "今年の夏は、去年を比べてずいぶん涼しい。",
     "why": "比较基准用「に比べて」或「と比べて」，「を比べて」不合法。",
     "fix": "去年に比べて",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-에 비해서",
   "ko_diff": "韩语「-에 비해서」与「に比べて」完全对应；但日语还可用「のに比べて」接动词小句，韩语需名词化。",
   "notes": "",
   "tags": [
    "comparison"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0146",
   "pattern": "〜に代わって",
   "meaning_zh": "代替…；代表…",
   "connection": "名词 + に代わって／に代わり",
   "usage": "表示代替某人或某物承担其角色、功能。",
   "register_note": "书面语为主，正式场合常用。",
   "examples": [
    {
     "ja": "入院中の社長に代わって、副社長があいさつをした。",
     "zh": "副社长代替住院的社长致辞。"
    },
    {
     "ja": "最近は、紙の新聞に代わって、スマホでニュースを読む人が増えている。",
     "zh": "最近用手机看新闻的人多了，取代了纸质报纸。"
    },
    {
     "ja": "父に代わって、私が町内会の会議に出席しました。",
     "zh": "我代替父亲出席了居民会的会议。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0147",
     "diff": "に代わって 是“顶替某人、某物”，代わりに 还可表“作为交换、补偿”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "入院中の社長を代わって、副社長があいさつをした。",
     "why": "固定形式是「に代わって」（代替某人），不能换用「を」。",
     "fix": "社長に代わって",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-를 대신해서",
   "ko_diff": "韩语「-를 대신해서」用宾格「를」，日语必须用「に」，这是最典型的母语干扰点。",
