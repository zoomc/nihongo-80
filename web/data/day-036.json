 "grammar": [
  {
   "id": "G0039",
   "pattern": "～ことが できる",
   "meaning_zh": "会／能…（可能迂说）",
   "connection": "動詞辞書形 + ことが + できる",
   "usage": "表能力/可能；保留原动词的格助词（を），与可能形 G0024 可换",
   "register_note": "ことができる 偏正式书面，口语更常用可能形。",
   "examples": [
    {
     "ja": "日本語を話すことができます。",
     "zh": "会说日语。",
     "vocab_ids": [
      "V0081",
      "V0114"
     ]
    }
   ],
   "prerequisites": [
    "G0023",
    "G0007"
   ],
   "compare": [
    {
     "id": "G0024",
     "diff": "可能形是动词变形；〜ことができる 是辞书形迂说，结构不同但意义近"
    }
   ],
   "common_errors": [
    {
     "wrong": "日本語が話すことができます。",
     "why": "「ことができる」保留原动词宾语 を，不改成 が",
     "fix": "日本語を話すことができます。",
     "learner": "zh"
    },
    {
     "wrong": "話すことが できません（写成 話せことが）",
     "why": "「こと」前必须是辞书形，不能用可能形 話せる",
     "fix": "話すことができます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "tags": [
    "potential"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-(으)ㄹ 수 있다",
   "ko_diff": "韩语与可能形同一表达ㄹ 수 있다，无迂说与形态之分；日语二者可换但接续不同。"
  },
  {
   "id": "G0042",
   "pattern": "～たことが ある",
   "meaning_zh": "（曾经）做过…",
   "connection": "動詞た形 + ことが + ある",
   "usage": "表过去经验；与单纯过去 〜ました 不同，强调「有过这种经历」",
   "register_note": "たことがある 口语通用，谈经历；正式面试也可。",
