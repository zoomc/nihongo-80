 "grammar": [
  {
   "id": "G0168",
   "pattern": "〜としても",
   "meaning_zh": "即使…也…",
   "connection": "动词普通形／い形容词 + としても；名词及な形容词可视表达使用 だとしても 或 としても",
   "usage": "先假定前项成立，再表明后项判断或意志不变。",
   "register_note": "口语书面均可，比「ても」郑重。",
   "examples": [
    {
     "ja": "親に反対されたとしても、私は留学するつもりだ。",
     "zh": "即使父母反对，我也打算留学。"
    },
    {
     "ja": "今からタクシーに乗ったとしても、九時の飛行機には間に合わないだろう。",
     "zh": "就算现在坐出租车，也赶不上九点的飞机吧。"
    },
    {
     "ja": "それが本当だとしても、ほかの人に話すべきではない。",
     "zh": "即使那是真的，也不该告诉别人。"
    }
   ],
   "prerequisites": [
    "G0025"
   ],
   "compare": [
    {
     "id": "G0159",
     "diff": "としても 郑重、可用于书面，たって 是口语缩略形。"
    }
   ],
   "common_errors": [
    {
     "wrong": "雨だとしてもも、行きます。",
     "why": "としても已有も，不再重复。",
     "fix": "雨だとしても、行きます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-다고 해도",
   "ko_diff": "韩语 -다고 해도 可表达让步假设；日语名词或な形容词的形式需结合具体结构，如「本当だとしても」或「本当としても」。",
