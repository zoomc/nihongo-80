 "grammar": [
  {
   "id": "G0061",
   "pattern": "名詞/な形词干 + みたい(だ/な/に)",
   "meaning_zh": "好像…；像…一样（口语推量/比喻）",
   "connection": "名詞 + みたい（不加 の）；な形 词干 + みたい；動詞/い形 普通形 + みたい；みたいな＋名／みたいに＋動",
   "usage": "口语版 〜ようだ（G0044）；比 らしい/そう 更随意；比喻用 まるで…みたい",
   "register_note": "みたい 口语随意，正式书面改用 ようだ。",
   "examples": [
    {
     "ja": "彼は元気じゃないみたいです。",
     "zh": "他好像不太精神。",
     "vocab_ids": [
      "V0074",
      "V0135"
     ]
    },
    {
     "ja": "今日は春みたいに暖かいです。",
     "zh": "今天暖和得像春天。",
     "vocab_ids": [
      "V0023",
      "V0133"
     ]
    }
   ],
   "prerequisites": [
    "G0016",
    "G0023"
   ],
   "compare": [
    {
     "id": "G0044",
     "diff": "ようだ 更书面，名词要接 の ようだ；みたい 是口语，名词直接接"
    },
    {
     "id": "G0043",
     "diff": "そうです 样态是「看上去就要/显得」；みたい 是推量/比喻"
    }
   ],
   "common_errors": [
    {
     "wrong": "彼は学生のみたいです。",
     "why": "名词接 みたい 不加 の（ようだ 才要 の）；中文「像是学生」直译加 の 错",
     "fix": "彼は学生みたいです。",
     "learner": "zh"
    },
    {
     "wrong": "彼女はモデルみたいなきれいです。",
     "why": "修饰动词/形容词用 みたいに，修饰名词用 みたいな；中文「像…一样漂亮」直译错用 みたいな",
     "fix": "彼女はモデルみたいにきれいです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "tags": [
    "inference",
    "similarity",
    "colloquial",
    "na-adj"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-(으)ㄴ 것 같다 / -처럼",
   "ko_diff": "韩语比喻和推测都用같다，口语最常用；日语みたい是ようだ口语版，韩语无正式口语两套。"
  },
  {
   "id": "G0062",
   "pattern": "V ます形(去ます) + やすい / にくい",
   "meaning_zh": "容易…／难以…",
   "connection": "動詞 ます形 去 ます + やすい・にくい；整体按 い形容詞 变形（読みやすくない／読みやすかった）",
   "usage": "表示做该动作的难易程度（不是能力），主语多用 が；偏客观属性",
   "register_note": "やすい/にくい 口语书面通用，描述属性。",
   "examples": [
    {
     "ja": "この本は読みやすいです。",
     "zh": "这本书好读。",
     "vocab_ids": [
      "V0080",
      "V0113"
     ]
    },
    {
     "ja": "このペンは書きにくいです。",
     "zh": "这支笔不好写。",
     "vocab_ids": [
      "V0112",
      "V0080"
     ]
    }
   ],
   "prerequisites": [
    "G0019",
    "G0015"
   ],
   "compare": [
    {
     "id": "G0024",
     "diff": "可能形 表「有没有能力/条件做」；やすい・にくい 表「客观上容易/难做」"
    },
    {
     "id": "G0039",
     "diff": "〜ことができる 是能力；やすい 是难度/倾向"
    }
   ],
   "common_errors": [
    {
     "wrong": "この本は読むやすいです。",
     "why": "必须接 ます形去ます（読み），不能用辞书形 読む；中文「容易读」直译错",
     "fix": "この本は読みやすいです。",
     "learner": "zh"
    },
    {
     "wrong": "この問題は分かりやすいでした。",
     "why": "やすい 按 い形变形，过去是 やすかった，不是 やすいでした；中文无词尾变化易错",
     "fix": "この問題は分かりやすかったです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "tags": [
    "masu-form",
    "i-adj",
    "difficulty",
    "suffix"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-기 쉽다 / -기 어렵다",
   "ko_diff": "韩语用기 쉽다/어렵다分析形，书面感强；日语やすい/にくい是一体化后缀，更口语。"
  }
