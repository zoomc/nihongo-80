 "grammar": [
  {
   "id": "G0236",
   "pattern": "〜てほしい",
   "meaning_zh": "希望（别人）做…",
   "connection": "动词て形 + ほしい；动词ない形 + でほしい",
   "usage": "表示说话人希望他人做某事，动作主体用 に 标记。",
   "register_note": "口语与书面通用；直接对上级使用略显强加，宜婉转。",
   "examples": [
    {
     "ja": "もう少しゆっくり話してほしいです。",
     "zh": "我希望你说得再慢一点。"
    },
    {
     "ja": "この話は誰にも言わないでほしい。",
     "zh": "这件事我希望你不要告诉任何人。"
    },
    {
     "ja": "早く春が来てほしいなあ。",
     "zh": "真希望春天快点来啊。"
    }
   ],
   "prerequisites": [
    "G0020",
    "G0033"
   ],
   "compare": [
    {
     "id": "G0237",
     "diff": "てほしい 是希望别人做，たがる 是别人想做"
    }
   ],
   "common_errors": [
    {
     "wrong": "もう少しゆっくり話すほしいです。",
     "why": "ほしい 前接て形，不是辞书形",
     "fix": "もう少しゆっくり話してほしいです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아/어 주기를 바라다",
   "ko_diff": "韩语 -아/어 주기를 바라다 与 てほしい 对应，但更正式；日语 てほしい 可直接用于日常请求，语气比韩语表达更随意。",
   "notes": "",
   "tags": [
    "desire",
    "request"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0237",
   "pattern": "〜たがる",
   "meaning_zh": "（第三人称）想做…",
   "connection": "动词ます形去ます + たがる",
   "usage": "たがる 通常描述他人表现出的愿望，也可在客观回顾自己的习惯或心理时使用；直接表达当下自己的愿望通常用 たい。",
   "register_note": "口语与书面通用；第一人称愿望用「たい」。",
   "examples": [
    {
     "ja": "子どもたちは外で遊びたがっている。",
     "zh": "孩子们想在室外玩。"
    },
    {
     "ja": "弟はいつも私のゲームをやりたがる。",
     "zh": "弟弟总是想玩我的游戏。"
    },
    {
     "ja": "犬が散歩に行きたがっています。",
     "zh": "狗想出去散步。"
    }
   ],
   "prerequisites": [
    "G0031"
   ],
   "compare": [
    {
     "id": "G0238",
     "diff": "たがる 接动词表想做，がる 接形容词表感觉"
    }
   ],
   "common_errors": [
    {
     "wrong": "弟は遊ぶたがっています。",
     "why": "たがる前用ます形词干「遊び」，不用辞书形「遊ぶ」。",
     "fix": "弟は遊びたがっています。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-고 싶어 하다",
   "ko_diff": "韩语常用 -고 싶어 하다 描述他人表现出的愿望；日语たがる同样关注外显表现，人称选择需结合语境。",
