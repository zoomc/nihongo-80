 "grammar": [
  {
   "id": "G0169",
   "pattern": "〜とか（hearsay）",
   "meaning_zh": "听说…；好像说…",
   "connection": "普通形 + とか（句末，或用「とかで」表原因）",
   "usage": "转述听来的不确定消息，语气比「そうだ」更随意、含糊。",
   "register_note": "口语为主，新闻口语中也见。",
   "examples": [
    {
     "ja": "駅前の本屋、今月で閉店するとか。寂しくなりますね。",
     "zh": "听说车站前的书店这个月就要关门了，真有点寂寞。"
    },
    {
     "ja": "今年の冬は、例年より寒くなるとかいう話だよ。",
     "zh": "听说今年冬天会比往年冷。"
    },
    {
     "ja": "部長は今日、熱があるとかで休んでいます。",
     "zh": "部长今天好像发烧，请假了。"
    }
   ],
   "prerequisites": [
    "G0043"
   ],
   "compare": [
    {
     "id": "G0171",
     "diff": "ということだ 是较确定的转述，とか 更含糊，暗示“听说是这样”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "駅前の本屋、今月で閉店しますとか。",
     "why": "传闻「とか」前接普通形，不用「ます」。",
     "fix": "閉店するとか",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-다고 하던데",
   "ko_diff": "韩语「-다고 하던데」带“听说…”的转述感；日语「とか」还可单纯列举，需靠位置和语调区分。",
   "notes": "",
