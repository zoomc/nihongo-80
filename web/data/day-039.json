 "grammar": [
  {
   "id": "G0214",
   "pattern": "〜せる / 〜させる",
   "meaning_zh": "让…做；使…做",
   "connection": "五段动词未然形+せる；一段动词未然形+させる；する→させる；来る→来させる",
   "usage": "表示使役，可指命令、允许或放任，视上下文而定。",
   "register_note": "口语与书面通用；使役句的助词常用 を／に。",
   "examples": [
    {
     "ja": "母は毎日弟に野菜を食べさせる。",
     "zh": "母亲每天让弟弟吃蔬菜。"
    },
    {
     "ja": "コーチは毎日、選手たちを走らせた。",
     "zh": "教练每天让选手们跑步。"
    },
    {
     "ja": "息子が行きたいと言ったので、一人で旅行に行かせました。",
     "zh": "儿子说想去，我就让他一个人去旅行了。"
    }
   ],
   "prerequisites": [
    "G0050"
   ],
   "compare": [
    {
     "id": "G0215",
     "diff": "使役 是让别人做，使役受身 是被迫做"
    }
   ],
   "common_errors": [
    {
     "wrong": "母は毎日弟を野菜を食べさせる。",
     "why": "使役对象用 に，不能再用 を 标记同一成分",
     "fix": "母は毎日弟に野菜を食べさせる。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-게 하다",
   "ko_diff": "-게 하다 可先理解使役意思。日语要留意助词：让学生读课文用 学生に本を読ませる；「让孩子在外面玩」可说 子供を外で遊ばせる。",
   "notes": "",
   "tags": [
    "voice",
    "conjugation"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜세루 / 〜사세루"
  },
  {
   "id": "G0215",
   "pattern": "〜せられる / 〜させられる",
   "meaning_zh": "被迫做…",
   "connection": "五段词尾变あ段 + せられる（可缩为 される 的词很多，す结尾通常不缩）；一段去 る + させられる；する→させられる；来る→来させられる。",
   "usage": "表示不情愿地被迫做某事，含有受害或无奈的语气。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "子どものころ、母に毎日ピアノを練習させられた。",
     "zh": "小时候母亲每天逼我练钢琴。"
    },
    {
     "ja": "駅で三十分も待たされました。",
     "zh": "我在车站被迫等了三十分钟。"
    },
    {
     "ja": "会社の飲み会で歌を歌わされた。",
     "zh": "公司聚会上我被逼着唱了歌。"
    }
   ],
   "prerequisites": [
    "G0049",
    "G0050"
   ],
   "compare": [
    {
     "id": "G0214",
     "diff": "使役受身 是被迫做，使役 是让别人做"
    }
   ],
   "common_errors": [
    {
     "wrong": "もう一度書き直さされた。",
     "why": "書き直す 的使役是 書き直させる，被迫是 書き直させられる，不缩成 さされる。",
     "fix": "もう一度書き直させられた。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-도록 강요받다 / 억지로 …하게 되다",
   "ko_diff": "억지로 다시 쓰게 됐다 对照 書き直させられた。「書き直す」是 す 结尾，别按 読む→読まされる 的缩约方式造形。",
   "notes": "",
