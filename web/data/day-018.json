 "grammar": [
  {
   "id": "G0257",
   "pattern": "〜で（means）",
   "meaning_zh": "用…；靠…；以…",
   "connection": "名词（工具／手段／语言／材料）+ で",
   "usage": "表示手段、工具、交通方式、语言或材料。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "毎日電車で会社へ行きます。",
     "zh": "每天坐电车去公司。"
    },
    {
     "ja": "はしでご飯を食べます。",
     "zh": "用筷子吃饭。"
    },
    {
     "ja": "日本語で手紙を書きました。",
     "zh": "我用日语写了信。"
    }
   ],
   "prerequisites": [
    "G0010"
   ],
   "compare": [
    {
     "id": "G0256",
     "diff": "同一个 で 还可表动作场所，靠名词性质区分"
    }
   ],
   "common_errors": [
    {
     "wrong": "毎日電車に会社へ行きます。",
     "why": "交通手段用 で，に 表到达点",
     "fix": "毎日電車で会社へ行きます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "로/으로（수단）",
   "ko_diff": "연필로 쓰다／鉛筆で書く，일본어로 말하다／日本語で話す，都是用同一个助词表示工具或手段。",
   "notes": "",
