 "grammar": [
  {
   "id": "G0178",
   "pattern": "〜っけ",
   "meaning_zh": "…来着？（回忆确认）",
   "connection": "动词普通形、名词或句末表达等 + っけ；「だっけ／だったっけ」也常用。口语では「何時からっけ」等の省略もある。",
   "usage": "用于向自己或对方确认记不清的事，带自言自语感。",
   "register_note": "仅限口语，亲近关系。",
   "examples": [
    {
     "ja": "あれ、会議って何時からだっけ？",
     "zh": "咦，会议是几点开始来着？"
    },
    {
     "ja": "すみません、お名前、何とおっしゃいましたっけ。",
     "zh": "不好意思，您贵姓来着？"
    },
    {
     "ja": "子どものころ、よくこの公園で遊んだっけ。",
     "zh": "小时候常在这个公园玩来着。"
    }
   ],
   "prerequisites": [
    "G0021"
   ],
   "compare": [
    {
     "id": "G0045",
     "diff": "でしょう 是推测，っけ 是“记不清、想确认”，功能不同。"
    }
   ],
   "common_errors": [
    {
     "wrong": "会議は何時からだっけです。",
     "why": "口语的 だっけ 已经用在结尾，不再叠加 です。",
     "fix": "会議は何時からだっけ。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "…였지? / …더라?",
   "ko_diff": "몇 시였지? 或 몇 시더라? 都能自然地回想、确认。日语可说 何時だったっけ，也常省成 何時だっけ。",
   "notes": "「何時からっけ」は口语省略として使われる。「何時からだっけ」も自然。",
   "tags": [
    "question",
    "recollection",
    "casual"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "needs_review",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜께"
  },
  {
   "id": "G0179",
   "pattern": "〜ますように",
   "meaning_zh": "但愿…；希望…",
   "connection": "动词礼貌形 + ように（〜ますように／〜ませんように）；也可在前面加 どうか。",
   "usage": "向神佛或命运祈愿，也用于祈盼他人顺利。",
   "register_note": "书面、祈愿场合；日常对话中少见。",
   "examples": [
    {
     "ja": "試験に合格できますように。",
     "zh": "希望考试合格。"
    },
    {
     "ja": "明日の遠足、雨が降りませんように。",
     "zh": "希望明天郊游别下雨。"
    },
    {
     "ja": "家族みんなが元気で過ごせますように。",
     "zh": "愿家人健康平安。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0064",
     "diff": "ようにする 是“设法做到”，ますように 是祈愿，形式相近功能完全不同。"
    }
   ],
   "common_errors": [
    {
     "wrong": "試験に合格できますようにです。",
     "why": "「ますように」已是结句形式，不能再加「です」。",
     "fix": "合格できますように",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-기를 바랍니다",
   "ko_diff": "비가 오지 않기를 可独立作愿望，也可说 비가 오지 않기를 바라요。日语常用 降りませんように 单独结句；注意否定要保留 ません。",
   "notes": "",
   "tags": [
    "wish"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜마스요우니"
  },
  {
   "id": "G0180",
   "pattern": "〜ふりをする",
   "meaning_zh": "假装…",
   "connection": "动词普通形/い形容词/ナ形容词な/名词の + ふりをする",
   "usage": "明知实际情况不同，却故意装成某种样子。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "母に呼ばれたが、聞こえないふりをしてゲームを続けた。",
     "zh": "妈妈叫我，我装作没听见继续玩游戏。"
    },
    {
     "ja": "彼は本当は知っているのに、知らないふりをしている。",
     "zh": "他其实知道，却装作不知道。"
    },
    {
     "ja": "電車の中で、寝たふりをして席を譲らない人がいる。",
     "zh": "电车里有人装睡不让座。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0122",
     "diff": "らしい 是“看起来像”，ふりをする 是故意假装，含欺骗意图。"
    }
   ],
   "common_errors": [
    {
     "wrong": "母に呼ばれたが、聞こえないのふりをしてゲームを続けた。",
     "why": "动词、形容词直接接「ふり」，不加「の」。",
     "fix": "聞こえないふりをして",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-는 척하다",
   "ko_diff": "못 본 척했다 对照 見えないふりをした。动词直接修饰 ふり，只有名词作定语常用 の，如 他人のふり。",
   "notes": "",
