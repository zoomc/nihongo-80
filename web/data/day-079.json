 "grammar": [
  {
   "id": "G0070",
   "pattern": "普通形 + に 違いない",
   "meaning_zh": "一定是…；肯定…（强烈推断）",
   "connection": "動詞・い形 普通形 / 名詞・な形 词干（＋である 可省）+ に違いない；礼貌体 に違いありません",
   "usage": "基于证据的高置信推断，语气比 かもしれない（G0045）强、比 はず（G0053）更带主观断定",
   "register_note": "に違いない 偏书面断定，口语也用；礼貌体为 に違いありません。",
   "examples": [
    {
     "ja": "彼はもう帰ったに違いありません。",
     "zh": "他肯定已经回去了。",
     "vocab_ids": [
      "V0074",
      "V0122"
     ]
    },
    {
     "ja": "この値段は安すぎる。セールに違いない。",
     "zh": "这价格太便宜，肯定是促销。",
     "vocab_ids": [
      "V0125",
      "V0126"
     ]
    }
   ],
   "prerequisites": [
    "G0023",
    "G0053",
    "G0045"
   ],
   "compare": [
    {
     "id": "G0053",
     "diff": "はずだ 是「按理应该（逻辑推断，可能落空）」；に違いない 是「必定」"
    },
    {
     "id": "G0045",
     "diff": "かもしれない 只是「也许」低置信；に違いない 是高置信，方向相反"
    }
   ],
   "common_errors": [
    {
     "wrong": "彼は学生だに違いない。",
     "why": "名词/な形 接 に違いない 一般去掉 だ（或 である）；中文「一定是学生」直译保留 だ 错",
     "fix": "彼は学生に違いない。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "inference",
    "plain-form",
    "certainty"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "needs_review",
   "provenance": "self_reviewed",
   "ko_equiv": "-(으)ㄹ 것이 틀림없다",
   "ko_diff": "韩语用틀림없다、분명하다表强推断，语气偏书面；日常更多用것 같다，弱于に違いない。"
  },
  {
   "id": "G0071",
   "pattern": "普通形 + わけが ない / V辞書形 + わけには いかない",
   "meaning_zh": "不可能…／不能…（わけにはいかない）",
   "connection": "普通形 + わけがない（强烈否定可能性）；辞書形 + わけにはいかない（因情理/规则不能做）",
   "usage": "わけがない 是「绝无可能」；わけにはいかない 是「（道理上）不能这么做」，两形意义不同勿混",
   "register_note": "わけがない/わけにはいかない 偏书面说明，口语也用。",
   "examples": [
    {
     "ja": "彼がそんなことを言うわけがありません。",
     "zh": "他不可能说那种话。",
     "vocab_ids": [
      "V0074",
      "V0114"
     ]
    },
    {
     "ja": "明日試験があるので、遊びに行くわけにはいきません。",
     "zh": "明天有考试，不能去玩。",
     "vocab_ids": [
      "V0024",
      "V0083",
      "V0103"
     ]
    }
   ],
   "prerequisites": [
    "G0023",
    "G0053"
   ],
   "compare": [
    {
     "id": "G0053",
     "diff": "わけではない 是「并非…」部分否定；わけがない 是「绝不可能」全盘否定"
    },
    {
     "id": "G0070",
     "diff": "に違いない 肯定推断；わけがない 否定推断，二者反向"
    }
   ],
   "common_errors": [
    {
     "wrong": "彼が来るわけがないでした。",
     "why": "过去礼貌形可用「わけがありませんでした」，不能说「ないでした」。",
     "fix": "彼が来るわけがありませんでした。",
     "learner": "zh"
    },
    {
     "wrong": "病気だから、休むわけがありません。（想说不能不休息）",
     "why": "「休むわけがない」是否定休息的可能；「不能不休息」要说「休まないわけにはいかない」。",
     "fix": "病気だから、休まないわけにはいきません。",
     "learner": "zh"
    }
   ],
