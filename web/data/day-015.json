 "grammar": [
  {
   "id": "G0030",
   "pattern": "～ながら",
   "meaning_zh": "一边…一边…",
   "connection": "動詞ます形（去ます） + ながら",
   "usage": "同一主语同时进行两动作，主动作在后半句",
   "register_note": "ながら 偏书面叙述，口语也用但较生硬。",
   "examples": [
    {
     "ja": "音楽を聞きながら勉強します。",
     "zh": "边听音乐边学习。",
     "vocab_ids": [
      "V0100",
      "V0115",
      "V0082"
     ]
    }
   ],
   "prerequisites": [
    "G0019"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "聞いてながら 勉強します。",
     "why": "「ながら」接ます形词干（聞き），不接て形",
     "fix": "聞きながら勉強します。",
     "learner": "zh"
    },
    {
     "wrong": "音楽を聞きながら、音楽を聞きます。",
     "why": "主从句动作不能重复同一件事",
     "fix": "音楽を聞きながら勉強します。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "simultaneous"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-(으)면서",
   "ko_diff": "韩语면서要求同一主语且前后动作同时；日语ながら前项多为附带动作，主句在后。"
  },
  {
   "id": "G0031",
   "pattern": "～たい / ～たがる",
   "meaning_zh": "想（做）…／（第三人称）想…",
   "connection": "動詞ます形（去ます） + たい；第三人称 + たがる",
   "usage": "たい 表说话人/第二人称愿望，对象格 を→が 常可换；第三人称用 たがる",
   "register_note": "たい 表说话人愿望，口语常见；第三人称叙述用 たがる。",
