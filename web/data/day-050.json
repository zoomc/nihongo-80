 "grammar": [
  {
   "id": "G0195",
   "pattern": "〜ておく",
   "meaning_zh": "预先…好；…着（保持状态）",
   "connection": "动词て形 + おく（口语缩约 とく）",
   "usage": "表示为将来做准备而提前做某事，或做完后保持该状态。",
   "register_note": "口语与书面通用；「とく」为口语缩约。",
   "examples": [
    {
     "ja": "旅行の前に、ホテルを予約しておきます。",
     "zh": "旅行前我会先把酒店订好。"
    },
    {
     "ja": "パーティーのために、飲み物を冷やしておいた。",
     "zh": "为了聚会，我提前把饮料冰好了。"
    },
    {
     "ja": "エアコンはつけておいてください。",
     "zh": "请让空调一直开着。"
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [
    {
     "id": "G0194",
     "diff": "ておく 是事先准备，てしまう 是完成或遗憾"
    }
   ],
   "common_errors": [
    {
     "wrong": "旅行の前に、ホテルを予約しでおきます。",
     "why": "する 的て形是「して」，不是「しで」",
     "fix": "旅行の前に、ホテルを予約しておきます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아/어 두다",
   "ko_diff": "韩语 -아/어 두다 也表预先做好并保持状态，对应度很高；日语口语缩约 とく 在韩语中没有同类的音变形式。",
   "notes": "",
   "tags": [
    "purpose",
    "state"
   ],
