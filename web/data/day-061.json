 "grammar": [
  {
   "id": "G0217",
   "pattern": "〜(よ)うと思う",
   "meaning_zh": "我想…；打算…",
   "connection": "动词意志形 + と思う／と思っている",
   "usage": "表示说话人正在考虑或已下的决心，持续想法用「と思っている」。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "今年の夏は海に行こうと思っています。",
     "zh": "今年夏天我想去海边。"
    },
    {
     "ja": "明日は早く起きて、公園を走ろうと思う。",
     "zh": "我打算明天早起去公园跑步。"
    },
    {
     "ja": "新しいパソコンを買おうと思ったけど、やめました。",
     "zh": "我本来想买台新电脑，后来放弃了。"
    }
   ],
   "prerequisites": [
    "G0023",
    "G0036"
   ],
   "compare": [
    {
     "id": "G0216",
     "diff": "意志形 直接表提议，(よ)うと思う 表心里的打算"
    }
   ],
   "common_errors": [
    {
     "wrong": "今年の夏は海に行きようと思っています。",
     "why": "行く 是五段动词，意志形是「行こう」，不是「行きよう」",
     "fix": "今年の夏は海に行こうと思っています。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-(으)려고 하다",
   "ko_diff": "韩语 -(으)려고 하다 与 ようと思う 对应；但日语用「と思っている」可表持续的想法，韩语则靠现在时或 고 있다 区分。",
   "notes": "",
   "tags": [
    "intention"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0218",
   "pattern": "〜え / 〜ろ",
   "meaning_zh": "（命令）做！",
   "connection": "五段动词词尾改え段；一段动词去る+ろ；する→しろ；来る→来い",
   "usage": "表示强烈的命令，语气粗鲁，多用于男性或紧急场合。",
   "register_note": "粗俗／男性口语；对上级和陌生人不使用。",
   "examples": [
    {
     "ja": "早く起きろ！遅刻するぞ。",
     "zh": "快起来！要迟到了！"
    },
    {
     "ja": "危ない！止まれ！",
     "zh": "危险！停下！"
    },
    {
     "ja": "がんばれ！あと少しだ！",
     "zh": "加油！就差一点了！"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0220",
     "diff": "命令形 粗鲁直白，なさい 是长辈对晚辈的指示"
    }
   ],
   "common_errors": [
    {
     "wrong": "危ない！止まりろ！",
     "why": "止まる 的命令形是「止まれ」，不是「止まりろ」",
     "fix": "危ない！止まれ！",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아/어라",
   "ko_diff": "韩语 -아/어라 与命令形对应，但韩语还有 -(으)세요 等礼貌命令；日语命令形语气更硬，且来る 的命令形是特殊形「来い」。",
