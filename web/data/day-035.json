 "grammar": [
  {
   "id": "G0199",
   "pattern": "〜間 / 〜間に",
   "meaning_zh": "在…期间；在…期间内",
   "connection": "动词ている形／动词辞书形／名词+の + 間（に）",
   "usage": "「間」表示整段时间持续，「間に」表示在这段时间内的某一时点。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "夏休みの間、祖父の家にいました。",
     "zh": "暑假期间我住在爷爷家。"
    },
    {
     "ja": "母が寝ている間に、部屋を掃除した。",
     "zh": "趁母亲睡觉时，我打扫了房间。"
    },
    {
     "ja": "電車を待っている間、ずっと本を読んでいた。",
     "zh": "等电车的时候，我一直在看书。"
    }
   ],
   "prerequisites": [
    "G0027",
    "G0006"
   ],
   "compare": [
    {
     "id": "G0198",
     "diff": "間 指整段期间，ときに 指某一时点"
    }
   ],
   "common_errors": [
    {
     "wrong": "母が寝ている間で、部屋を掃除した。",
     "why": "表示时间段用 間，不能用 間で",
     "fix": "母が寝ている間に、部屋を掃除した。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-는 동안",
   "ko_diff": "留守の間に来た 是外出期间发生了一次事，对照 집을 비운 동안에 왔다。留守の間ずっと待っていた 则覆盖那段时间的一个持续动作。",
   "notes": "",
   "tags": [
    "time",
    "simultaneity"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "pattern_kana": "〜あいだ / 〜あいだに",
   "ko_pron": "〜아이다 / 〜아이다니"
  },
  {
   "id": "G0200",
   "pattern": "〜そうだ（appearance）",
   "meaning_zh": "看起来…；好像要…",
   "connection": "动词ます形去ます／い形容词去い／な形容词词干 + そうだ",
   "usage": "根据眼前所见推测外观或即将发生的变化，不能用于传闻。",
   "register_note": "口语与书面通用；不能直接接名词。",
   "examples": [
    {
     "ja": "そのカレー、辛そうだね。",
     "zh": "那个咖喱看起来好辣啊。"
    },
    {
     "ja": "空が暗いですね。雨が降りそうです。",
     "zh": "天好暗，好像要下雨了。"
    },
    {
     "ja": "久しぶりに会った祖父は元気そうだった。",
     "zh": "好久不见的爷爷看起来很健康。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0201",
     "diff": "そうだ（样态）凭外观判断，そうだ（传闻）转述听来的信息"
    }
   ],
   "common_errors": [
    {
     "wrong": "空が暗いですね。雨が降りるそうです。",
     "why": "降る 是五段动词，接 そうだ 要用ます形去ます「降り」，不是「降りる」",
     "fix": "空が暗いですね。雨が降りそうです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아/어 보이다",
   "ko_diff": "韩语 -아/어 보이다 表外观，但与日语 そうだ 不同，不能用于「即将发生」的预测；那种场合韩语用 -(으)ㄹ 것 같다。",
   "notes": "",
