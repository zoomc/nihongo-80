 "grammar": [
  {
   "id": "G0234",
   "pattern": "〜ようにする",
   "meaning_zh": "尽量…；设法做到…",
   "connection": "动词辞书形／动词ない形 + ようにする",
   "usage": "表示有意识地努力维持某种做法或状态，常与「ている」表习惯。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "毎日野菜を食べるようにしています。",
     "zh": "我尽量每天都吃蔬菜。"
    },
    {
     "ja": "これからは遅刻しないようにします。",
     "zh": "今后我会注意不再迟到。"
    },
    {
     "ja": "寝る前にスマホを見ないようにしている。",
     "zh": "我尽量睡前不看手机。"
    }
   ],
   "prerequisites": [
    "G0064"
   ],
   "compare": [
    {
     "id": "G0235",
     "diff": "ようにする 是主观努力，ようになる 是状态自然变化"
    }
   ],
   "common_errors": [
    {
     "wrong": "毎日野菜を食べるようにしっています。",
     "why": "ようにする 的持续形是「ようにしている」，不是「しっている」",
     "fix": "毎日野菜を食べるようにしています。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-도록 하다",
   "ko_diff": "韩语 -도록 하다 与 ようにする 对应，但韩语还常用 -기로 하다 表决定；日语 ようにする 强调持续的努力，不含「决定」义。",
