  {
   "id": "G0312",
   "pattern": "〜次第だ / 〜次第で",
   "pattern_kana": "〜しだいだ / 〜しだいで",
   "meaning_zh": "取决于…",
   "ko_equiv": "…에 달려 있다 / …에 따라",
   "connection": "名词 + 次第だ / 名词 + 次第で / 名词 + 次第では",
   "usage": "",
   "ko_diff": "「努力次第だ」说结果取决于某因素，「努力次第で」说明该因素会怎样影响后项。「決まり次第」才是“一确定就”。",
   "examples": [
    {
     "ja": "合格できるかどうかは、これからの努力次第だ。",
     "en": "Whether you pass depends on your efforts from now on.",
     "zh": "能否通过考试，取决于接下来的努力。"
    },
    {
     "ja": "天気次第で、明日の予定を変えるかもしれない。",
     "en": "Depending on the weather, we may change tomorrow's plans.",
     "zh": "明天的安排可能会视天气而调整。"
    }
   ],
