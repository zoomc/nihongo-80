 "grammar": [
  {
   "id": "G0054",
   "pattern": "～おかげで / ～せいで",
   "meaning_zh": "多亏…／都怪…",
   "connection": "名/な形 + の/な + おかげで／せいで；普通形 + おかげで／せいで",
   "usage": "おかげで 通常表达对好结果的感谢，也可反讽；せいで 常用于不理想结果，不应脱离语境机械判定。",
   "register_note": "おかげで/せいで 口语通用；せいで 带负面情绪，正式场合慎用。",
   "examples": [
    {
     "ja": "先生のおかげで、日本語が上手になりました。",
     "zh": "多亏老师，日语变好了。",
     "vocab_ids": [
      "V0079",
      "V0081"
     ]
    },
    {
     "ja": "雨のせいで、行けませんでした。",
     "zh": "都怪下雨，没能去成。",
     "vocab_ids": [
      "V0096",
      "V0103"
     ]
    }
   ],
   "prerequisites": [
    "G0006",
    "G0023"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "先生のおかげで（漏 の）",
     "why": "名词后接 おかげで 要加 の：先生のおかげで",
     "fix": "先生のおかげで…",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "reason"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "needs_review",
   "provenance": "self_reviewed",
   "ko_equiv": "-덕분에 / -때문에",
   "ko_diff": "韩语 덕분에 通常表示多亏，也可反讽；때문에 可用于中性原因。日语 せいで 常带不满或归因。"
  },
  {
   "id": "G0055",
   "pattern": "～によって / ～について / ～にとって",
   "meaning_zh": "因…而异／关于…／对…来说",
   "connection": "名詞 + によって／について／にとって",
   "usage": "によって 表「因…而不同/依据/手段被动」、について「关于」、にとって「对…而言（评价）」",
   "notes": "によって/について/にとって 三者的细微语感与部分教材归类待二次核实；例句与释义按通用辞书用法给出。",
   "register_note": "によって/について/にとって 偏正式书面，口语也用 について。",
   "examples": [
    {
     "ja": "人によって意見が違います。",
     "zh": "意见因人而异。",
     "vocab_ids": [
