 "grammar": [
  {
   "id": "G0157",
   "pattern": "〜たとたん / 〜たとたんに",
   "meaning_zh": "刚一…就…",
   "connection": "动词た形 + とたん（に）",
   "usage": "表示前项刚发生，后项就出乎意料地出现。",
   "register_note": "口语书面均可，后项多为说话人意外的事。",
   "examples": [
    {
     "ja": "立ち上がったとたんに、めまいがした。",
     "zh": "刚一起身就头晕。"
    },
    {
     "ja": "家を出たとたん、雨が降り出した。",
     "zh": "刚一出门就下起雨来。"
    },
    {
     "ja": "その歌手がステージに現れたとたん、会場から大きな拍手が起こった。",
     "zh": "那位歌手刚一登台，会场就响起热烈掌声。"
    }
   ],
   "prerequisites": [
    "G0021"
   ],
   "compare": [
    {
     "id": "G0163",
     "diff": "てはじめて 是“做了之后才明白”，たとたん 是“刚一…就发生”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "家を出るとたん、雨が降り出した。",
     "why": "「とたん」前接た形「出た」，「出るとたん」不合法。",
     "fix": "家を出たとたん",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-자마자",
   "ko_diff": "韩语「-자마자」只表紧接发生；日语「とたん」还要求后项是意外、非意志的事，不能接自己的有意动作。",
   "notes": "",
   "tags": [
    "time",
    "sequence",
    "surprise"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0158",
   "pattern": "〜たら〜た",
   "meaning_zh": "…了之后发现…",
   "connection": "动词た形 + ら … た形",
   "usage": "表示做前项之后，发现后项出乎意料的事实。",
   "register_note": "口语为主，叙述体验时常用。",
   "examples": [
    {
     "ja": "窓を開けたら、外は一面の雪だった。",
     "zh": "打开窗户一看，外面一片雪白。"
    },
    {
     "ja": "久しぶりに実家に帰ったら、近所に大きなマンションが建っていた。",
     "zh": "好久没回老家，回去一看附近盖起了高楼。"
    },
    {
     "ja": "かばんの中を探してみたら、なくしたと思っていた鍵が出てきた。",
     "zh": "翻包找了一下，以为丢了的钥匙出来了。"
    }
   ],
   "prerequisites": [
    "G0025"
   ],
   "compare": [
    {
     "id": "G0157",
     "diff": "たら〜た 是“做了之后发现”，たとたん 强调“瞬间同时”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "窓を開けるたら、外は一面の雪だった。",
     "why": "「たら」接た形「開けた」，「開けるたら」不合法。",
     "fix": "窓を開けたら",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-았더니",
   "ko_diff": "韩语「-았더니」正好对应“做了之后发现”；但日语「たら」还兼表条件，需靠后半句的过去时和发现语气判断。",
