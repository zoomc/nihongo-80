 "grammar": [
  {
   "id": "G0148",
   "pattern": "〜に従って",
   "meaning_zh": "按照…；随着…",
   "connection": "名词 + に従って；动词辞书形 + に従って",
   "usage": "表示遵照指示、规则，或随着某变化而相应变化。",
   "register_note": "书面语为主，告示和说明文常见。",
   "examples": [
    {
     "ja": "係の人の指示に従って、落ち着いて避難してください。",
     "zh": "请听从工作人员的指示，冷静避难。"
    },
    {
     "ja": "高く登るに従って、気温が下がっていった。",
     "zh": "越往上爬，气温越低。"
    },
    {
     "ja": "町が大きくなるに従って、交通の問題も増えてきた。",
     "zh": "随着城市变大，交通问题也多了起来。"
    }
   ],
   "prerequisites": [
    "G0077"
   ],
   "compare": [
    {
     "id": "G0149",
     "diff": "に従って 偏“遵照、跟随”，につれて 只表“随之变化”，不含遵从义。"
    }
   ],
   "common_errors": [
    {
     "wrong": "係の人の指示に従いて、落ち着いて避難してください。",
     "why": "「従う」的て形是「従って」，「従いて」不是合法变形。另：「〜によって」也可表「依据/按照」，如「校則によって決める」，并非不能用于依据指示，不应一律判错。",
     "fix": "指示に従って",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-에 따라서",
   "ko_diff": "韩语「-에 따라서」兼表“依照”和“随着”；日语分成「に従って」与「につれて」，需要区分。",
   "notes": "",
   "tags": [
    "relation",
    "change"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0149",
   "pattern": "〜につれて",
   "meaning_zh": "随着…",
   "connection": "动词辞书形/名词 + につれて",
   "usage": "表示前项变化推进，后项也随之自然变化，多为客观趋势。",
   "register_note": "书面语为主。",
   "examples": [
    {
     "ja": "年をとるにつれて、朝早く目が覚めるようになった。",
     "zh": "随着年龄增长，早上很早就醒了。"
    },
    {
     "ja": "日本での生活に慣れるにつれて、友達も増えていった。",
     "zh": "随着适应日本的生活，朋友也多了起来。"
    },
    {
     "ja": "時間がたつにつれて、その事故のことは忘れられていった。",
     "zh": "随着时间流逝，那起事故渐渐被遗忘。"
    }
   ],
   "prerequisites": [
    "G0077"
   ],
   "compare": [
    {
     "id": "G0150",
     "diff": "につれて 只表随之变化，とともに 还能表“一起、同时”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "年をとったにつれて、朝早く目が覚めるようになった。",
     "why": "「につれて」前接辞书形表同时变化，不能接た形。",
     "fix": "年をとるにつれて",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-에 따라",
   "ko_diff": "韩语「-에 따라」同时承担“依照”和“随着”；日语「につれて」只表随之变化，前后都须是变化性表达。",
