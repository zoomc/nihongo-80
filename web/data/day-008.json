   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "普通否定：本は高いないです。",
     "why": "い形容词否定：词尾 い 改成 く，再加 ない（高い→高くない）。いい 特殊，变 よくない。",
     "fix": "本は高くないです。",
     "learner": "zh"
    },
    {
     "wrong": "昨日は寒いでした。",
     "why": "い形容词的过去是 〜かった（寒かった）；でした 只给名词和な形容词用。",
     "fix": "昨日は寒かったです。",
     "learner": "zh"
    }
   ],
