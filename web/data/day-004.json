     ]
    }
   ],
   "prerequisites": [
    "G0001"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "私は本です。",
     "why": "该用 の 表所属却用 は；中文「我的书」直译成「我 是 书」",
     "fix": "私の本です。",
     "learner": "zh"
    },
    {
     "wrong": "静かな の 部屋",
     "why": "な形容词连体用 な，不叠加 の",
     "fix": "静かな部屋",
     "learner": "zh"
    }
   ],
