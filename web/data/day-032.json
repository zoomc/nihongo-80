 "grammar": [
  {
   "id": "G0275",
   "pattern": "〜ではありません / 〜じゃない",
   "meaning_zh": "不是…",
   "connection": "名词／な形容词 + ではありません（礼貌）／じゃない（普通）",
   "usage": "否定判断句，礼貌体用 ではありません，口语用 じゃない。",
   "register_note": "ではありません 礼貌正式；じゃない 口语。",
   "examples": [
    {
     "ja": "私は先生ではありません。学生です。",
     "zh": "我不是老师，是学生。"
    },
    {
     "ja": "今日は休みじゃない。",
     "zh": "今天不是休息日。"
    },
    {
     "ja": "この町はあまりにぎやかではありません。",
     "zh": "这个镇不太热闹。"
    }
   ],
   "prerequisites": [
    "G0002"
   ],
   "compare": [
    {
     "id": "G0273",
     "diff": "ではありません 是否定礼貌体，です 是肯定礼貌体"
    }
   ],
   "common_errors": [
    {
     "wrong": "私は先生ではありませんだ。",
     "why": "ではありません 已是完整否定，不能再加 だ",
     "fix": "私は先生ではありません。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "아니다 / 아닙니다",
   "ko_diff": "韩语 아니다 是独立形容词，需接 이/가（학생이 아닙니다）；日语 ではありません 直接接名词，不用助词，这是常见差异。",
   "notes": "",
   "tags": [
    "copula",
    "negation"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0276",
   "pattern": "〜でした",
   "meaning_zh": "（过去）是…",
   "connection": "名词／な形容词 + でした",
   "usage": "礼貌体的过去判断，表示过去的状态或身份。",
   "register_note": "礼貌体；普通体用「だった」。",
   "examples": [
    {
     "ja": "きのうは私の誕生日でした。",
     "zh": "昨天是我的生日。"
    },
    {
     "ja": "子どものころ、野菜がきらいでした。",
     "zh": "我小时候讨厌蔬菜。"
    },
    {
     "ja": "テストはかんたんでした。",
     "zh": "考试很简单。"
    }
   ],
   "prerequisites": [
    "G0003"
   ],
   "compare": [
    {
     "id": "G0273",
     "diff": "でした 是过去礼貌体，です 是现在礼貌体"
    }
   ],
   "common_errors": [
    {
     "wrong": "きのうは私の誕生日ですでした。",
     "why": "です 与 でした 不能叠用",
     "fix": "きのうは私の誕生日でした。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "이었습니다 / 였습니다",
   "ko_diff": "韩语过去礼貌体 이었습니다/였습니다 随收音变化，日语 でした 形式固定；い形容词过去用 かったです，韩语则用过去时制。",
