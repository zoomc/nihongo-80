 "grammar": [
  {
   "id": "G0173",
   "pattern": "〜というより",
   "meaning_zh": "与其说…不如说…",
   "connection": "动词普通形/い形容词/ナ形容词/名词 + というより",
   "usage": "修正前面的说法，指出后项表达更准确。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "今日は涼しいというより、寒いくらいだ。",
     "zh": "今天说凉快，不如说有点冷。"
    },
    {
     "ja": "彼女は友達というより、家族のような存在だ。",
     "zh": "她与其说是朋友，不如说像家人。"
    },
    {
     "ja": "それは意見というより、ただの文句だよ。",
     "zh": "那与其说是意见，不如说只是抱怨。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0142",
     "diff": "にしては 是“照…来说不符预期”，というより 是“换个更准确的说法”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "今日は涼しいより、寒いくらいだ。",
     "why": "固定形式是「というより」，不能省成「より」。",
     "fix": "涼しいというより",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-라기보다",
   "ko_diff": "韩语「-라기보다」与「というより」对应；但日语名词后不加「だ」，韩语要按有无收音变形，形式更复杂。",
