 "grammar": [
  {
   "id": "G0233",
   "pattern": "〜ように（purpose）",
   "meaning_zh": "为了…；以便…",
   "connection": "动词辞书形／动词ない形 + ように",
   "usage": "表示为了使某种状态实现，前接多为非意志动词或可能形。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "後ろの人にも聞こえるように、大きな声で話してください。",
     "zh": "请大声说，好让后面的人也听得见。"
    },
    {
     "ja": "忘れないように、手にメモを書いた。",
     "zh": "为了不忘，我把笔记写在手上。"
    },
    {
     "ja": "かぜをひかないように、暖かくして寝てください。",
     "zh": "睡觉时请保暖，别感冒了。"
    }
   ],
   "prerequisites": [
    "G0023",
    "G0022"
   ],
   "compare": [
    {
     "id": "G0232",
     "diff": "ように 多接非意志状态，ために 接意志动词"
    }
   ],
   "common_errors": [
    {
     "wrong": "後ろの人にも聞こえるために、大きな声で話してください。",
     "why": "聞こえる 是非意志动词，不能接 ために，要用 ように",
     "fix": "後ろの人にも聞こえるように、大きな声で話してください。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-도록",
   "ko_diff": "-도록 可帮助理解目的。像 忘れないように／잊지 않도록、聞こえるように／들리도록，强调让某个状态实现；有意执行的直接目标常用 ために。",
   "notes": "",
   "tags": [
    "purpose"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜요우니"
  },
  {
   "id": "G0235",
   "pattern": "〜ようになる",
   "meaning_zh": "变得能…；开始…",
   "connection": "动词辞书形／动词ない形 + ようになる",
   "usage": "表示能力、习惯或状态经过变化达到新阶段。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "練習して、自転車に乗れるようになりました。",
     "zh": "练习之后，我学会骑自行车了。"
    },
    {
     "ja": "日本に来てから、朝ご飯を食べるようになった。",
     "zh": "来日本以后，我开始吃早饭了。"
    },
    {
     "ja": "赤ちゃんが少しずつ話せるようになってきた。",
     "zh": "我家宝宝渐渐会说话了。"
    }
   ],
   "prerequisites": [
    "G0048"
   ],
   "compare": [
    {
     "id": "G0234",
     "diff": "ようになる 是状态变化，ようにする 是主观努力"
    }
   ],
   "common_errors": [
    {
     "wrong": "日本に来てから、朝ご飯を食べるようにになった。",
     "why": "ようになる 前接辞书形直接连接，不用「に」",
     "fix": "日本に来てから、朝ご飯を食べるようになった。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-게 되다",
   "ko_diff": "韩语 -게 되다 与 ようになる 对应度很高，但日语常用可能形+ようになる表能力变化，韩语则直接用 -게 되다。",
   "notes": "",
   "tags": [
    "change",
