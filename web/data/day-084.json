 "listening": false,
 "grammar": [
  {
   "id": "G0169",
   "pattern": "〜とか（hearsay）",
   "meaning_zh": "听说…；好像说…",
   "connection": "普通形 + とか（句末，或用「とかで」表原因）",
   "usage": "转述听来的不确定消息，语气比「そうだ」更随意、含糊。",
   "register_note": "口语为主，新闻口语中也见。",
   "examples": [
    {
     "ja": "駅前の本屋、今月で閉店するとか。寂しくなりますね。",
     "zh": "听说车站前的书店这个月就要关门了，真有点寂寞。"
    },
    {
     "ja": "今年の冬は、例年より寒くなるとかいう話だよ。",
     "zh": "听说今年冬天会比往年冷。"
    },
    {
     "ja": "部長は今日、熱があるとかで休んでいます。",
     "zh": "部长今天好像发烧，请假了。"
    }
   ],
   "prerequisites": [
    "G0043"
   ],
   "compare": [
    {
     "id": "G0171",
     "diff": "ということだ 是较确定的转述，とか 更含糊，暗示“听说是这样”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "駅前の本屋、今月で閉店しますとか。",
     "why": "传闻「とか」前接普通形，不用「ます」。",
     "fix": "閉店するとか",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-다고 하던데",
   "ko_diff": "옮긴다던데 对照 引っ越すとか，适合转述还没证实的消息。句中的 本とか雑誌とか 则是用 とか 举例。",
   "notes": "",
   "tags": [
    "hearsay",
    "casual"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜토카"
  },
  {
   "id": "G0170",
   "pattern": "〜って",
   "meaning_zh": "说是…；所谓…",
   "connection": "普通形 + って；名词 + って（表话题）",
   "usage": "口语引用、转述传闻，或提出话题加以说明。",
   "register_note": "仅限口语。",
   "examples": [
    {
     "ja": "彼女、今日は来られないって。",
     "zh": "她说今天来不了。"
    },
    {
     "ja": "駅前に新しいカフェができたんだって。行ってみない？",
     "zh": "听说车站前开了家新咖啡店，去看看？"
    },
    {
     "ja": "「ふろしき」って何ですか。",
     "zh": "“风吕敷”是什么？"
    }
   ],
   "prerequisites": [
    "G0012"
   ],
   "compare": [
    {
     "id": "G0171",
     "diff": "ということだ 是书面的正式转述，って 是口语缩略，语气随意。"
    }
   ],
   "common_errors": [
    {
     "wrong": "彼女、今日は来られないだって。",
     "why": "「って」直接接普通形「来られない」，不能加「だ」。",
     "fix": "来られないって",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-대",
   "ko_diff": "韩语「-대」是口语转述缩略，与「って」很像；但日语「って」还能当话题助词（「〜って何？」），韩语要用「-는」。",
   "notes": "",
   "tags": [
    "quotation",
    "hearsay",
    "casual"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜떼"
  },
  {
   "id": "G0171",
   "pattern": "〜ということだ",
   "meaning_zh": "据说…；也就是说…",
   "connection": "普通形 + ということだ",
   "usage": "转述听到的消息，或把前项归结为“也就是说…”。",
   "register_note": "口语书面均可，书面更常见。",
   "examples": [
    {
     "ja": "駅員さんの話では、事故のため電車は一時間ほど止まるということです。",
     "zh": "据站务员说，因为事故电车要停一小时左右。"
    },
    {
     "ja": "「申し込みは明日までです。」「じゃあ、今日中に書類を準備しなければならないということですね。」",
     "zh": "“申请截止到明天。”“也就是说今天必须把材料准备好。”"
    },
    {
     "ja": "全員が賛成したということは、この計画で進めてもいいということだ。",
     "zh": "大家都赞成，也就是说可以按这个方案推进。"
    }
   ],
   "prerequisites": [
    "G0036"
   ],
   "compare": [
    {
     "id": "G0169",
     "diff": "ということだ 更确定、更正式，とか 更含糊随意。"
    }
   ],
   "common_errors": [
    {
     "wrong": "電車は一時間ほど止まるというです。",
     "why": "「というです」不是合法形式，转述要用「ということだ／ということです」。",
     "fix": "止まるということです",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-다고 한다 / …라는 뜻이다",
   "ko_diff": "传闻用 -다고 한다，例如 列車は遅れるということだ。概括意义可用 …라는 뜻이다，日本语常在前面说 つまり。",
   "notes": "",
   "tags": [
    "hearsay",
    "result"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
