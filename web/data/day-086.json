 "grammar": [
  {
   "id": "G0084",
   "pattern": "V ます形(去ます) + 得る / V ない形(去ない) + ざるを 得ない",
   "meaning_zh": "可能…、会有…／不得不…",
   "connection": "動詞 ます形 去 ます + 得る（读 うる／える，否定 得ない えない）；動詞 ない形 去 ない + ざるを得ない（する→せざるを得ない 例外）",
   "usage": "得る 表客观可能性（あり得る）；ざるを得ない 表「别无选择只好…」，书面",
   "register_note": "得る/ざるを得ない 偏正式书面，口语少用。",
   "examples": [
    {
     "ja": "その可能性もあり得ます。",
     "zh": "那种可能性也存在。",
     "vocab_ids": [
      "V0212",
      "V0108"
     ]
    },
    {
     "ja": "電車が止まったので、歩いて帰らざるを得ませんでした。",
     "zh": "电车停了，只好走路回去。",
     "vocab_ids": [
      "V0060",
      "V0122"
     ]
    }
   ],
   "prerequisites": [
    "G0019",
    "G0022",
    "G0024"
   ],
   "compare": [
    {
     "id": "G0024",
     "diff": "可能形 表主语的能力/条件；得る 表「客观上可能存在/发生」，多用于 あり得る"
    },
    {
     "id": "G0046",
     "diff": "なければならない 是一般义务；ざるを得ない 强调「虽不情愿但别无选择」"
    }
   ],
   "common_errors": [
    {
     "wrong": "起こる得る",
     "why": "得る 接 ます形去ます（起こり得る），不接辞书形；中文「可能发生」直译错",
     "fix": "起こり得ます／起こり得る",
     "learner": "zh"
    },
    {
     "wrong": "するざるを得ない",
     "why": "サ変「する」接 ざる 要变 せ（せざるを得ない），不是 し/する；中文「不得不做」按原形推错",
     "fix": "せざるを得ません",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "masu-form",
    "nai-form",
    "possibility",
    "obligation",
    "formal"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-(으)ㄹ 수 있다 / -지 않을 수 없다",
   "ko_diff": "韩语可能用ㄹ 수 있다，不得不的用지 않을 수 없다或해야 한다；ざるを得ない更书面。"
  },
  {
   "id": "G0085",
   "pattern": "普通形 + 一方(で) / 反面 / 代わりに",
   "meaning_zh": "一方面…另一方面…／…但另一方面／取而代之、作为交换",
   "connection": "動詞・い形普通形／な形容词 + な／名词 + である + 一方(で)・反面；名詞 + の／普通形 + 代わりに",
   "usage": "一方で 并列同一事物的两面（可同褒贬）；反面 强调「反面/弊端」；代わりに 是替代或交换条件",
   "register_note": "一方で/反面/代わりに 偏书面议论，口语也用 代わりに。",
   "examples": [
    {
     "ja": "この仕事は給料が高い一方で、残業も多いです。",
     "zh": "这工作工资高，另一方面加班也多。",
     "vocab_ids": [
      "V0085",
      "V0246",
      "V0245",
      "V0125"
     ]
    },
    {
     "ja": "便利な反面、費用がかかります。",
     "zh": "方便是方便，反面花费也高。",
     "vocab_ids": [
      "V0137",
      "V0021"
     ]
    }
   ],
   "prerequisites": [
    "G0023",
    "G0016",
    "G0037"
   ],
   "compare": [
    {
     "id": "G0075",
     "diff": "のに 是逆接转折（意外/不满）；一方で/反面 是并列两面，不含意外情绪"
    },
    {
     "id": "G0037",
     "diff": "から/ので 因果顺接；一方で 是并列对照，不表因果"
    }
   ],
   "common_errors": [
    {
     "wrong": "便利だ一方で、費用がかかります。",
     "why": "な形/名词 接 一方で 用 便利な／である，不用 だ；中文「方便一方面」直译保留 だ 错",
     "fix": "便利な一方で、費用がかかります。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "plain-form",
    "contrast",
    "conjunction",
    "formal"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "needs_review",
   "provenance": "self_reviewed",
   "ko_equiv": "-는 한편 / -반면에 / -대신에",
   "ko_diff": "韩语는 한편表一方面、반면에表相反、대신에表代替，与日语三形对应整齐，반면对比更强。"
  }
