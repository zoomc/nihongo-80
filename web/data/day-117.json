 "grammar": [
  {
   "id": "G0146",
   "pattern": "〜に代わって",
   "meaning_zh": "代替…；代表…",
   "connection": "名词 + に代わって／に代わり",
   "usage": "表示代替某人或某物承担其角色、功能。",
   "register_note": "书面语为主，正式场合常用。",
   "examples": [
    {
     "ja": "入院中の社長に代わって、副社長があいさつをした。",
     "zh": "副社长代替住院的社长致辞。"
    },
    {
     "ja": "最近は、紙の新聞に代わって、スマホでニュースを読む人が増えている。",
     "zh": "最近用手机看新闻的人多了，取代了纸质报纸。"
    },
    {
     "ja": "父に代わって、私が町内会の会議に出席しました。",
     "zh": "我代替父亲出席了居民会的会议。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0147",
     "diff": "に代わって 是“顶替某人、某物”，代わりに 还可表“作为交换、补偿”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "入院中の社長を代わって、副社長があいさつをした。",
     "why": "固定形式是「に代わって」（代替某人），不能换用「を」。",
     "fix": "社長に代わって",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-를 대신해서",
   "ko_diff": "韩语「-를 대신해서」用宾格「를」，日语必须用「に」，这是最典型的母语干扰点。",
   "notes": "",
   "tags": [
    "relation",
    "change"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0147",
   "pattern": "〜代わりに",
   "meaning_zh": "代替…；作为交换",
   "connection": "动词普通形/い形容词/ナ形容词な/名词の + 代わりに",
   "usage": "表示用一件事替代另一件，或“有失也有得”的补偿关系。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "今日は外で食べる代わりに、家でカレーを作った。",
     "zh": "今天没在外面吃，改在家做了咖喱。"
    },
    {
     "ja": "友達に英語を教える代わりに、ギターを教えてもらっている。",
     "zh": "我教朋友英语，作为交换他教我吉他。"
    },
    {
     "ja": "このアパートは駅から遠い代わりに、家賃が安い。",
     "zh": "这间公寓离车站远，但房租便宜。"
    }
   ],
   "prerequisites": [
    "G0085"
   ],
   "compare": [
    {
     "id": "G0146",
     "diff": "代わりに 可表交换补偿，に代わって 只表顶替某人或某物。"
    }
   ],
   "common_errors": [
    {
     "wrong": "このアパートは駅から遠いの代わりに、家賃が安い。",
     "why": "い形容词直接接「代わりに」，只有名词才加「の」。",
     "fix": "遠い代わりに",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-대신에",
   "ko_diff": "韩语「-대신에」与「代わりに」对应良好；但日语还能表“补偿”，韩语更常说「그 대신」，词性不同。",
   "notes": "",
