 "grammar": [
  {
   "id": "G0064",
   "pattern": "V辞書形 / Vない形 + ように する",
   "meaning_zh": "努力做到…／设法不…（有意识地做）",
   "connection": "動詞 辞書形／ない形 + ように + する；する 按 サ変 变形（ようにしています／ようにした）",
   "usage": "ようにする 表有意识地努力或安排；ようになる 常侧重变化结果，但变化也可能来自努力。",
   "register_note": "ようにする 口语书面通用，表努力或习惯。",
   "examples": [
    {
     "ja": "毎日野菜を食べるようにしています。",
     "zh": "我尽量每天吃蔬菜。",
     "vocab_ids": [
      "V0029",
      "V0057",
      "V0101"
     ]
    },
    {
     "ja": "寝る前にスマホを見ないようにしています。",
     "zh": "睡前尽量不看手机。",
     "vocab_ids": [
      "V0105",
      "V0049",
      "V0027"
     ]
    }
   ],
   "prerequisites": [
    "G0023",
    "G0022",
    "G0048"
   ],
   "compare": [
    {
     "id": "G0048",
     "diff": "ようになる 是「（自然而然）变得…」；ようにする 是「有意识地做到…」"
    },
    {
     "id": "G0035",
     "diff": "〜に する 是把…变成/选成；ようにする 是努力做到某动作"
    }
   ],
   "common_errors": [
    {
     "wrong": "毎日走るようになりました。",
     "why": "想表达「我坚持每天跑步」应用 ようにする（意志努力）；ようになる 是自然变化，中文「坚持」直译易混",
     "fix": "毎日走るようにしています。",
     "learner": "zh"
    },
    {
     "wrong": "遅刻するようにしてください。",
     "why": "「请别迟到」须用 ない形 遅刻しないように；中文「请做到…」直译用肯定形意思反了",
     "fix": "遅刻しないようにしてください。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "plain-form",
    "nai-form",
    "effort",
    "habit"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "needs_review",
   "provenance": "self_reviewed",
   "ko_equiv": "-도록 하다",
   "ko_diff": "韩语 -도록 하다 可表努力或指示；日语ようにする可用于自己的安排，也可用于要求他人注意。"
  },
  {
   "id": "G0065",
   "pattern": "V辞書形/Vない形 + ことに する / なる",
   "meaning_zh": "（自己）决定…／（结果）定为…、将要…",
   "connection": "動詞 普通形 + ことに + する（主观决定）/ なる（客观决定、自然结果）；する・なる 可变形",
   "usage": "ことにする 侧重决定，ことになる 侧重结果或安排；后者也可用于共同决定或自己的决定以客观方式叙述。",
   "register_note": "ことにする/なる 口语书面通用，注意决定来自本人还是外部。",
   "examples": [
    {
     "ja": "禁煙することにしました。",
     "zh": "我决定戒烟了。",
     "vocab_ids": [
      "V0161"
     ]
    },
    {
     "ja": "来月から転勤することになりました。",
     "zh": "定下下个月起调职了。",
     "vocab_ids": [
      "V0030",
      "V0243"
     ]
    }
   ],
   "prerequisites": [
    "G0023",
    "G0022",
    "G0035"
   ],
   "compare": [
    {
     "id": "G0064",
     "diff": "ようにする 是持续努力/习惯；ことにする 是一次性「做出决定」"
    },
    {
     "id": "G0035",
     "diff": "〜に する 是把…变成/选成；ことにする 是「决定做某动作」"
    }
   ],
   "common_errors": [
    {
     "wrong": "禁煙することになりました。（自己决定时）",
     "why": "自己下的决定用 ことにする；ことになる 是外部/客观决定，中文「我决定」直译易错",
     "fix": "禁煙することにしました。",
