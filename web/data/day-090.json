 "grammar": [
  {
   "id": "G0088",
   "pattern": "V辞書形 / Vない形 / い形 / な形な + うちに",
   "meaning_zh": "趁着…；在…期间（不知不觉）…",
   "connection": "動詞辞書形 + うちに；動詞ない形 + ないうちに；い形 + うちに；な形 + なうちに；名詞 + のうちに",
   "usage": "表示在前项状态持续期间做后项；「〜ないうちに」=趁还没…；也可表示不知不觉发生变化。",
   "examples": [
    {
     "ja": "若いうちに、いろいろな経験をしたほうがいいです。",
     "zh": "趁年轻应该多积累各种经验。",
     "vocab_ids": [
      "V0211"
     ]
    },
    {
     "ja": "忘れないうちに、メモしてください。",
     "zh": "趁还没忘，请记下来。",
     "vocab_ids": [
      "V0152"
     ]
    }
   ],
   "prerequisites": [
    "G0022",
    "G0019"
   ],
   "compare": [
    {
     "id": "G0030",
     "diff": "ながら 是同时进行两个动作；うちに 是趁某状态尚未改变时做后项。"
    }
   ],
   "common_errors": [
    {
     "wrong": "暗いないうちに、帰りましょう。",
     "why": "い形「暗い」的否定是「暗くない」，不能直接加 ない；中文“还没黑”直译错。",
     "fix": "暗くならないうちに、帰りましょう。",
     "learner": "zh"
    },
    {
     "wrong": "若いのうちに、経験を積みましょう。",
     "why": "い形后接 うちに 不加 の；の 只接名词。",
     "fix": "若いうちに、経験を積みましょう。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "plain-form",
    "time",
    "change"
   ],
   "register_note": "口语常用；后项多为建议/意志/变化。",
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "source_ids": [
    "S000"
   ],
   "ko_equiv": "-는 동안에 / -기 전에",
   "ko_diff": "韩语는 동안表期间，기 전에表趁还没；日语うちに还含不知不觉变化，韩语须用는 사이에。"
  },
  {
   "id": "G0089",
   "pattern": "Nの / Vている + 最中に（だ）",
   "meaning_zh": "正在…的时候（突然…）",
   "connection": "名詞 + の + 最中に；動詞ている + 最中に；句末可 最中だ",
   "usage": "强调某动作/状态正进行到一半时，发生了另一件事，后项常是打扰或意外。",
   "examples": [
    {
     "ja": "会議の最中に、電話が鳴りました。",
     "zh": "正在开会时电话响了。",
     "vocab_ids": [
      "V0244",
      "V0089"
     ]
    },
    {
     "ja": "ご飯の最中に、突然停電しました。",
     "zh": "正吃饭时突然停电了。",
     "vocab_ids": [
      "V0051",
      "V0336"
     ]
    }
   ],
   "prerequisites": [
    "G0027",
    "G0006"
   ],
   "compare": [
    {
     "id": "G0027",
     "diff": "ている 只表进行；最中に 强调“正做到一半”且后项打断。"
    }
   ],
   "common_errors": [
    {
     "wrong": "会議の最中を、電話が鳴りました。",
     "why": "最中 后接时间点用 に，不用 を；中文“在会议中”直译成 を。",
     "fix": "会議の最中に、電話が鳴りました。",
     "learner": "zh"
    },
    {
     "wrong": "会議の最中にで、電話が鳴りました。",
     "why": "最中に 后不接 で；中文“在…当中”直译加 で。",
     "fix": "会議の最中に、電話が鳴りました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "time",
    "interruption",
    "noun"
   ],
   "register_note": "中性；后项多为突发事件。",
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "source_ids": [
