 "grammar": [
  {
   "id": "G0105",
   "pattern": "〜ことだ",
   "meaning_zh": "最好…；应该…",
   "connection": "动词辞书形/ない形 + ことだ",
   "usage": "给对方提忠告，指出“这样做最好”，比「べきだ」柔和。",
   "register_note": "口语书面均可，多用于上对下或建议。",
   "examples": [
    {
     "ja": "日本語が上手になりたいなら、毎日少しずつでも話すことだ。",
     "zh": "想把日语学好，就该每天多少说一点。"
    },
    {
     "ja": "風邪を早く治したければ、無理をしないでゆっくり休むことです。",
     "zh": "想快点治好感冒，最好别勉强，好好休息。"
    },
    {
     "ja": "人の話は最後までよく聞くことだ。",
     "zh": "别人的话要听到最后。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0102",
     "diff": "ことだ 是正面建议“该这样做”，ものではない 是反面劝诫“不该这样做”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "毎日少しずつ話すことだです。",
     "why": "「ことだ」本身是断定形式，礼貌说法是「ことです」，不能叠加「です」。",
     "fix": "話すことです",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-는 것이다",
   "ko_diff": "韩语建议多用「-는 게 좋다」；日语「ことだ」更简短、更像训示，主语常省略，语气略强。",
   "notes": "",
   "tags": [
    "advice"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0106",
   "pattern": "〜ことはない",
   "meaning_zh": "不必…；用不着…",
   "connection": "动词辞书形 + ことはない",
   "usage": "告诉对方没有某种必要，常用来安慰。",
   "register_note": "口语书面均可，语气平和。",
   "examples": [
    {
     "ja": "簡単な手術ですから、そんなに心配することはありませんよ。",
     "zh": "只是个小手术，不必那么担心。"
    },
    {
     "ja": "駅までは歩いて五分だから、タクシーを使うことはない。",
     "zh": "到车站走路五分钟，用不着打车。"
    },
    {
     "ja": "一回失敗したくらいで、あきらめることはないよ。",
     "zh": "只失败了一次，没必要放弃。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0047",
     "diff": "なくてもいい 是“不做也行”，ことはない 是“没有那个必要”，更强调劝慰。"
    }
   ],
   "common_errors": [
    {
     "wrong": "そんなに心配しことはありません。",
     "why": "「ことはない」前接辞书形「心配する」，不能接ます形词干「心配し」。",
     "fix": "心配することはありません",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-ㄹ 필요는 없다",
   "ko_diff": "韩语「-ㄹ 필요는 없다」直译“没有必要”；日语「ことはない」还隐含“你想多了”的安慰，语气更主观。",
   "notes": "",
