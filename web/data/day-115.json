 "grammar": [
  {
   "id": "G0139",
   "pattern": "〜こそ",
   "meaning_zh": "正是…；才是…",
   "connection": "名词 + こそ（可加「が」成「こそが」）",
   "usage": "强烈提示焦点，表“正是这个，不是别的”。",
   "register_note": "口语书面均可，常出现在致辞和标语。",
   "examples": [
    {
     "ja": "「いつもありがとう。」「いえ、こちらこそ。」",
     "zh": "“一直谢谢你。”“不，我才是。”"
    },
    {
     "ja": "今年こそ、たばこをやめるつもりだ。",
     "zh": "今年我一定要把烟戒掉。"
    },
    {
     "ja": "毎日の小さな努力こそが、大きな成功につながる。",
     "zh": "正是每天的小努力带来了巨大的成功。"
    }
   ],
   "prerequisites": [
    "G0080"
   ],
   "compare": [
    {
     "id": "G0137",
     "diff": "こそ 提示焦点，さえ 举极端例，二者虽都表强调但功能不同。"
    }
   ],
   "common_errors": [
    {
