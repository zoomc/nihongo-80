 "grammar": [
  {
   "id": "G0265",
   "pattern": "〜まで（until）",
   "meaning_zh": "到…为止；直到…",
   "connection": "名词 + まで（终点）",
   "usage": "表示时间或空间的终点，常与「から」呼应。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "昼休みは1時までです。",
     "zh": "午休到一点为止。"
    },
    {
     "ja": "駅までいっしょに行きましょう。",
     "zh": "我们一起去车站吧。"
    },
    {
     "ja": "きのうは夜11時まで勉強しました。",
     "zh": "昨天我学习到晚上十一点。"
    }
   ],
   "prerequisites": [
    "G0013"
   ],
   "compare": [
    {
     "id": "G0264",
     "diff": "まで 表终点，から 表起点"
    }
   ],
   "common_errors": [
    {
     "wrong": "昼休みは1時までからです。",
     "why": "终点用 まで，不能与 から 叠用",
     "fix": "昼休みは1時までです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "까지",
   "ko_diff": "韩语 까지 与 まで 对应，时间和空间都可用；日语 まで 还可表程度界限（駅まで歩く），韩语 까지 同样可延伸。",
   "notes": "",
   "tags": [
    "particle",
    "time",
    "range"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0266",
   "pattern": "〜か（question）",
   "meaning_zh": "…吗？（疑问）",
   "connection": "句子（礼貌体／普通体）+ か",
   "usage": "在句末加か构成疑问，实际语调会随语境、句型和说话方式变化。",
   "register_note": "口语与书面通用；普通体疑问多用升调，不加 か。",
   "examples": [
    {
     "ja": "これはあなたのかばんですか。",
     "zh": "这是你的包吗？"
    },
    {
     "ja": "朝ご飯を食べましたか。",
     "zh": "你吃早饭了吗？"
    },
    {
     "ja": "トイレはどこですか。",
     "zh": "洗手间在哪里？"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0244",
     "diff": "か 构成直接疑问，かどうか 是嵌入疑问"
    }
   ],
   "common_errors": [
    {
     "wrong": "朝ご飯を食べましたかです。",
     "why": "疑问助词 か 后不能再加 です",
     "fix": "朝ご飯を食べましたか。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "-까? / -니?",
   "ko_diff": "韩语可用疑问词尾或语调构成疑问；日语礼貌体常加か，语调也会随交际语境变化。",
