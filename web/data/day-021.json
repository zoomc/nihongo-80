  },
  {
   "id": "G0253",
   "pattern": "〜に（indirect object）",
   "meaning_zh": "向…（动作的对象）",
   "connection": "名词（人）+ に",
   "usage": "表示动作的接受者或对象，常与言う、貸す、電話する等搭配。",
   "register_note": "口语与书面通用；口语可用「〜に」代替「〜に対して」。",
   "examples": [
    {
     "ja": "母に手紙を書きます。",
     "zh": "我要给母亲写信。"
    },
    {
     "ja": "妹に本を貸しました。",
     "zh": "我把书借给了妹妹。"
    },
    {
     "ja": "友達に電話をかけました。",
     "zh": "我给朋友打了电话。"
    }
   ],
   "prerequisites": [
    "G0009"
   ],
   "compare": [
    {
     "id": "G0252",
     "diff": "に 可表对象，也可表存在场所，依动词判断"
    }
   ],
   "common_errors": [
    {
     "wrong": "母を手紙を書きます。",
     "why": "信的收件人用 に，を 只能标一个宾语",
     "fix": "母に手紙を書きます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "에게（대상）",
   "ko_diff": "韩语对人用 에게/한테，对物用 에；日语统一用 に，需根据动词和名词性质判断是对象还是场所。",
