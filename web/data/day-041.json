 "grammar": [
  {
   "id": "G0051",
   "pattern": "～てみる / ～てしまう / ～ておく",
   "meaning_zh": "试着…／…完了／事先…",
   "connection": "動詞て形 + みる／しまう／おく",
   "usage": "补助动词：てみる 尝试、てしまう 完了/遗憾、ておく 事先准备",
   "register_note": "てみる/てしまう/ておく 口语高频；てしまう 口语常缩成 ちゃう。",
   "examples": [
    {
     "ja": "この料理を食べてみます。",
     "zh": "尝尝这道菜。",
     "vocab_ids": [
      "V0059",
      "V0101"
     ]
    },
    {
     "ja": "本を読んでしまいました。",
     "zh": "把书看完了。",
     "vocab_ids": [
      "V0080",
      "V0113"
     ]
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "食べてみる（写成 食べみる）",
     "why": "补助动词前必须 て形，漏 て 错",
     "fix": "食べてみます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "tags": [
    "auxiliary"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "needs_review",
   "provenance": "self_reviewed",
   "ko_equiv": "-아/어 보다 / -아·어 버리다 / -아·어 두다",
   "ko_diff": "韩语分别用보다(尝试)、버리다(完了/遗憾)、두다(预先)，与日语三形基本对应。"
  },
  {
   "id": "G0187",
   "pattern": "あげる / くれる / もらう",
   "meaning_zh": "给…；别人给我…；从…得到",
   "connection": "给予者 は/が 接受者 に 物 を あげる；给予者 が 我方 に 物 を くれる；接受者 は 给予者 に/から 物 を もらう",
   "usage": "按给与方向和视角选择：我给别人用あげる，别人给我用くれる，我收到用もらう。",
   "register_note": "口语与书面通用；对长辈给予用「さしあげる」，从长辈处得到用「いただく」。",
   "examples": [
    {
     "ja": "私は弟に古いゲームをあげた。",
     "zh": "我把旧的游戏机给了弟弟。"
    },
    {
     "ja": "姉が誕生日にかわいいかばんをくれました。",
     "zh": "姐姐在我生日时送了我一个可爱的包。"
    },
    {
     "ja": "友達から旅行のおみやげをもらった。",
     "zh": "我收到了朋友旅行带回来的特产。"
    }
   ],
   "prerequisites": [
    "G0009",
    "G0008"
   ],
   "compare": [
    {
     "id": "G0188",
     "diff": "あげる 是物品的授受，てあげる 是动作的授受"
    },
    {
     "id": "G0189",
     "diff": "くれる 的给予者是他人，接受者是我方"
    }
   ],
   "common_errors": [
    {
     "wrong": "私は弟に古いゲームをくれた。",
     "why": "くれる 的给予者必须是他人，不能是「私」；我给别人要用 あげる",
     "fix": "私は弟に古いゲームをあげた。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "주다 / 받다",
