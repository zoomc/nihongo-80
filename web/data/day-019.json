 "grammar": [
  {
   "id": "G0248",
   "pattern": "〜が（subject）",
   "meaning_zh": "…是主语；提示新信息",
   "connection": "名词 + が",
   "usage": "指出动作主体或新信息，疑问词作主语时必须用 が。",
   "register_note": "口语与书面通用；书面语中 が 的连接用法更多。",
   "examples": [
    {
     "ja": "雨が降っています。",
     "zh": "下雨了。"
    },
    {
     "ja": "だれが窓を開けましたか。",
     "zh": "谁打开了窗户？"
    },
    {
     "ja": "私が行きます。",
     "zh": "我去。"
    }
   ],
   "prerequisites": [
    "G0007"
   ],
   "compare": [
    {
     "id": "G0247",
     "diff": "が 提示新信息或焦点，は 提示已知主题"
    }
   ],
   "common_errors": [
    {
     "wrong": "だれは窓を開けましたか。",
     "why": "疑问词作主语必须用 が，不能用 は",
     "fix": "だれが窓を開けましたか。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "이/가（주어·신정보）",
   "ko_diff": "韩语 이/가 同样标新信息主语；日语疑问词主语强制用 が，韩语疑问词后也强制 이/가，这点相近，差别在日语 は 的对比用法更重。",
   "notes": "",
   "tags": [
    "particle"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
