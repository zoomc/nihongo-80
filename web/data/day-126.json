 "grammar": [
  {
   "id": "G0164",
   "pattern": "〜てばかりいる",
   "meaning_zh": "老是…；一味…",
   "connection": "动词て形 + ばかりいる",
   "usage": "表示反复做同一件事，含批评或不满。",
   "register_note": "口语为主。",
   "examples": [
    {
     "ja": "弟は休みの日、ゲームをしてばかりいる。",
     "zh": "弟弟一放假就光玩游戏。"
    },
    {
     "ja": "泣いてばかりいないで、どうしたのか話してごらん。",
     "zh": "别光哭，说说到底怎么了。"
    },
    {
     "ja": "休みの間、寝てばかりいたら、かえって疲れてしまった。",
     "zh": "假期光睡觉，反倒更累了。"
    }
   ],
   "prerequisites": [
    "G0068"
   ],
   "compare": [
    {
     "id": "G0068",
     "diff": "ばかり 可接名词、数量表限定，てばかりいる 专表反复做某动作且含责难。"
    }
   ],
   "common_errors": [
    {
     "wrong": "弟は休みの日、ゲームをするばかりいる。",
     "why": "「ばかりいる」前接て形「して」，不能用辞书形。",
     "fix": "ゲームをしてばかりいる",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-기만 하다",
   "ko_diff": "韩语「-기만 하다」只表“只做某事”，不带褒贬；日语「てばかりいる」几乎总含批评。",
   "notes": "",
   "tags": [
    "tendency",
    "criticism",
    "limitation"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0165",
   "pattern": "〜ばいい",
   "meaning_zh": "…就行；…才好",
   "connection": "动词ば形 + いい；い形容词ければ + いい",
   "usage": "表“这样做就够了”的建议，或用「ばいいのに」表遗憾、愿望。",
   "register_note": "口语为主。",
   "examples": [
    {
     "ja": "「この書類、どこに出せばいいですか。」「二階の受付に出してください。」",
     "zh": "“这份文件交到哪里好？”“请交到二楼前台。”"
    },
    {
     "ja": "分からないことがあったら、遠慮しないで私に聞けばいいよ。",
     "zh": "有不懂的尽管问我，不用客气。"
    },
    {
     "ja": "明日、雨が降らなければいいんだけど。",
     "zh": "明天要是不下雨就好了。"
    }
   ],
   "prerequisites": [
    "G0025"
   ],
   "compare": [
    {
     "id": "G0105",
     "diff": "ことだ 是较强的忠告，ばいい 更轻，只指出“这样做即可”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "分からないことがあったら、遠慮しないで私に聞くばいいよ。",
     "why": "「ばいい」前接ば形「聞けば」，辞书形加「ば」不合法。",
     "fix": "聞けばいいよ",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-면 된다",
   "ko_diff": "韩语「-면 된다」与「ばいい」对应；但日语「ばいいのに」可表惋惜、责备，韩语要用「-면 좋을 텐데」。",
