 "grammar": [
  {
   "id": "G0160",
   "pattern": "〜ないことはない",
   "meaning_zh": "并非不…；也不是不能…",
   "connection": "动词ない形/い形容词くない/ナ形容词でない + ことはない",
   "usage": "双重否定，表“不是完全不行”，但暗示条件或保留态度。",
   "register_note": "口语书面均可，语气委婉。",
   "examples": [
    {
     "ja": "辛い料理は食べられないことはないけど、あまり好きじゃない。",
     "zh": "辣的我并非不能吃，只是不太喜欢。"
    },
    {
     "ja": "今から急げば、間に合わないことはないと思う。",
     "zh": "现在赶紧走的话，也不是赶不上。"
    },
    {
     "ja": "この服、少し派手だけど、似合わないことはないよ。",
     "zh": "这件衣服有点花哨，但也不是不适合你。"
    }
   ],
   "prerequisites": [
    "G0022"
   ],
   "compare": [
    {
     "id": "G0106",
     "diff": "ことはない 表“不必”，ないことはない 是双重否定表“并非不能”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "この服、少し派手だけど、似合わないことはないだよ。",
     "why": "「ない」后面不能接「だ」，应说「ないことはないよ」或「ありません」。",
     "fix": "似合わないことはないよ",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-지 않은 것은 아니다",
   "ko_diff": "韩语「-지 않은 것은 아니다」与日语结构几乎一致；但日语常省略后半句留白，韩语一般要把话说完整。",
   "notes": "",
   "tags": [
    "negation",
    "possibility"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0161",
   "pattern": "〜てしょうがない / 〜てしかたがない",
   "meaning_zh": "…得不得了",
   "connection": "动词て形/い形容词くて/ナ形容词で + しょうがない（しかたがない）",
   "usage": "表某种感觉或情绪强烈到无法抑制，多用于生理、心理感受。",
   "register_note": "口语为主，「しかたがない」稍正式。",
   "examples": [
    {
     "ja": "昨日あまり寝ていないので、眠くてしょうがない。",
     "zh": "昨晚几乎没睡，困得不行。"
    },
    {
     "ja": "来週の旅行が楽しみでしかたがない。",
     "zh": "对下周的旅行期待得不得了。"
    },
    {
     "ja": "一人暮らしを始めたばかりのころは、家族のことが気になってしかたがなかった。",
     "zh": "刚开始一个人住时，特别惦记家人。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0162",
     "diff": "てしょうがない 偏口语、适用范围广，てたまらない 程度更强、更书面。"
    }
   ],
   "common_errors": [
    {
     "wrong": "昨日あまり寝ていないので、眠いでしょうがない。",
     "why": "い形容词接「しょうがない」要用「〜くて」，「眠いで」不合法。",
     "fix": "眠くてしょうがない",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-아서 견딜 수 없다",
   "ko_diff": "韩语「-아서 견딜 수 없다」偏“难以忍受”的强烈表达；日语「てしょうがない」也可用于轻微感受，程度可轻可重。",
