 "grammar": [
  {
   "id": "G0238",
   "pattern": "〜がる",
   "meaning_zh": "（第三人称）显得…；表现出…",
   "connection": "い形容词去い／な形容词词干 + がる",
   "usage": "把形容词变成动词，表示他人表现出的感觉或欲求。",
   "register_note": "口语与书面通用；第一人称不用。",
   "examples": [
    {
     "ja": "妹は暗い所を怖がる。",
     "zh": "妹妹怕黑的地方。"
    },
    {
     "ja": "祖母は孫に会えなくて寂しがっている。",
     "zh": "奶奶见不到孙子，感到很寂寞。"
    },
    {
     "ja": "息子は新しい自転車をほしがっている。",
     "zh": "儿子想要一辆新自行车。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0237",
     "diff": "がる 接形容词表第三人的感觉，たがる 接动词表想做"
    }
   ],
   "common_errors": [
    {
     "wrong": "妹は暗い所を怖いがります。",
     "why": "い形容词接がる时去掉词尾い，怖い变为怖がる。",
     "fix": "妹は暗い所を怖がります。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아/어 하다",
   "ko_diff": "韩语可用 -아/어 하다 描述他人表现出的情绪，如 무서워하다；日语がる通常描述外显表现，也可客观回顾自己的倾向。",
   "notes": "",
   "tags": [
    "emotion",
    "appearance"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "needs_review",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0239",
   "pattern": "〜かもしれない",
   "meaning_zh": "也许…；可能…",
   "connection": "动词普通形／い形容词／な形容词／名词 + かもしれない",
   "usage": "表示不确定的推测，可能性低于だろう。",
   "register_note": "口语与书面通用；礼貌体「かもしれません」。",
   "examples": [
    {
     "ja": "午後から雨が降るかもしれません。",
     "zh": "下午可能会下雨。"
    },
    {
     "ja": "かぎがない。電車の中で落としたかもしれない。",
     "zh": "钥匙不见了，可能掉在电车上了。"
    },
    {
     "ja": "その話は本当かもしれない。",
     "zh": "那个说法可能是真的。"
    }
   ],
   "prerequisites": [
    "G0045"
   ],
   "compare": [
    {
     "id": "G0240",
     "diff": "かもしれない 把握较小，だろう 把握较大"
    }
   ],
   "common_errors": [
    {
     "wrong": "午後から雨が降るかもません。",
     "why": "かもしれない 的礼貌形是「かもしれません」",
     "fix": "午後から雨が降るかもしれません。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-(으)ㄹ지도 모르다",
   "ko_diff": "韩语 -(으)ㄹ지도 모르다 与 かもしれない 对应，但韩语字面含「不知道」，语气更不确定；日语 かもしれない 可直接表推测。",
