     "zh": "他不仅工作，还经常帮忙做家务。",
     "vocab_ids": [
      "V0085",
      "V0151"
     ]
    }
   ],
   "prerequisites": [
    "G0023",
    "G0019"
   ],
   "compare": [
    {
     "id": "G0080",
     "diff": "さえ 是“连…都”，强调极端；ばかりか 是“不仅…还…”，追加。"
    }
   ],
   "common_errors": [
    {
