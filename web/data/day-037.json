 "grammar": [
  {
   "id": "G0206",
   "pattern": "〜方",
   "meaning_zh": "…的方法；…的方式",
   "connection": "动词ます形去ます + 方（かた）",
   "usage": "把动作名词化，表示做某事的方法，常与「使い方／読み方」搭配。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "この機械の使い方を教えてください。",
     "zh": "请告诉我这台机器的使用方法。"
    },
    {
     "ja": "この漢字の読み方が分かりません。",
     "zh": "我不知道这个汉字怎么读。"
    },
    {
     "ja": "祖母においしいみそ汁の作り方を習った。",
     "zh": "我跟奶奶学了做味噌汤的方法。"
    }
   ],
   "prerequisites": [
    "G0019"
   ],
   "compare": [
    {
     "id": "G0212",
     "diff": "方 表做法，可能形 表能力"
    }
   ],
   "common_errors": [
    {
     "wrong": "この機械を使い方を教えてください。",
     "why": "「使い方」是名词短语，前面的名词要用 の 连接，不能同时保留 を",
     "fix": "この機械の使い方を教えてください。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-는 방법",
   "ko_diff": "쓰는 방법 对照 書き方。「写汉字的方法」整句是 漢字の書き方，动词变成复合名词后，原来的对象 漢字 用 の 连接。",
   "notes": "",
   "tags": [
    "manner",
    "nominalization"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
