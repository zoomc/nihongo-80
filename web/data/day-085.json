 "grammar": [
  {
   "id": "G0172",
   "pattern": "〜というのは",
   "meaning_zh": "所谓…；是因为…",
   "connection": "名词/句子 + というのは",
   "usage": "提出一个词或现象加以解释，或引出理由。",
   "register_note": "口语书面均可，说明性文章常见。",
   "examples": [
    {
     "ja": "「割り勘」というのは、食事代などを参加者で分けて払うことです。",
     "zh": "所谓「割り勘」，就是一起参加的人分摊饭钱等费用。"
    },
    {
     "ja": "一人で海外に住むというのは、思ったより大変なことだ。",
     "zh": "一个人住在国外，比想象中更难。"
    },
    {
     "ja": "来週の旅行には行けなくなった。というのは、急に出張が入ったからだ。",
     "zh": "下周的旅行我去不了了，因为突然要出差。"
    }
   ],
   "prerequisites": [
    "G0036"
   ],
   "compare": [
    {
     "id": "G0116",
     "diff": "について 是“关于”某话题，というのは 是“所谓…”并要给出定义或理由。"
    }
   ],
   "common_errors": [
    {
     "wrong": "「割り勘」というは、参加者で代金を分けて払うことです。",
     "why": "解释某个名称时用「……というのは」，の 将引用部分名词化。",
     "fix": "「割り勘」というのは、参加者で代金を分けて払うことです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-라는 것은",
   "ko_diff": "韩语「-라는 것은」表定义时与「というのは」对应；但日语还能在句末引出理由，韩语要用「왜냐하면」。",
   "notes": "",
   "tags": [
    "topic",
    "quotation"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
