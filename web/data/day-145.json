 "grammar": [
  {
   "id": "G0181",
   "pattern": "〜向き / 〜向け",
   "meaning_zh": "适合…；面向…",
   "connection": "名词 + 向き（だ/の）；名词 + 向け（だ/の/に）",
   "usage": "「向き」表“适合某类人”，「向け」表“以某类人为对象制作”。",
   "register_note": "口语书面均可，商品说明常见。",
   "examples": [
    {
