 "grammar": [
  {
   "id": "G0176",
   "pattern": "〜から〜にかけて",
   "meaning_zh": "从…到…期间",
   "connection": "名词 + から + 名词 + にかけて",
   "usage": "表示时间或空间上大致的范围，边界较模糊。",
   "register_note": "书面语为主，天气预报和报道常见。",
   "examples": [
    {
     "ja": "今夜から明日の朝にかけて、強い雨が降るでしょう。",
     "zh": "今晚到明天早上预计会有强降雨。"
    },
    {
     "ja": "関東から東北にかけての広い地域で、強い揺れが観測された。",
     "zh": "从关东到东北的广大地区观测到了强烈摇晃。"
    },
    {
     "ja": "この花は、三月から四月にかけてきれいに咲く。",
     "zh": "这种花从三月到四月开得很美。"
    }
   ],
   "prerequisites": [
    "G0013"
   ],
   "compare": [
    {
     "id": "G0013",
     "diff": "から〜まで 边界明确，から〜にかけて 范围模糊、偏书面。"
    }
   ],
   "common_errors": [
    {
     "wrong": "今夜から明日の朝までにかけて、強い雨が降るでしょう。",
     "why": "「から〜にかけて」中间不再用「まで」，两种句式不能混用。",
     "fix": "今夜から明日の朝にかけて",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-에서 -에 걸쳐",
   "ko_diff": "韩语「-에서 -에 걸쳐」与「から〜にかけて」对应，都偏书面；日语中间不能插「まで」。",
