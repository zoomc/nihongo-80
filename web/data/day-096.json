 "grammar": [
  {
   "id": "G0101",
   "pattern": "〜ものだ",
   "meaning_zh": "本来就…；应当…；过去常…",
   "connection": "动词辞书形/た形 + ものだ；い形容词 + ものだ；ナ形容词 + な + ものだ",
   "usage": "讲普遍规律或应当如此，也用「た形 + ものだ」回忆过去。",
   "register_note": "略带说教或感慨，书面口语皆可。",
   "examples": [
    {
     "ja": "子どものころは、この川でよく泳いだものだ。",
     "zh": "小时候常在这条河里游泳。"
    },
    {
     "ja": "新しい環境に慣れるには、時間がかかるものだ。",
     "zh": "适应新环境本来就需要时间。"
    },
    {
     "ja": "目上の人には敬語を使うものだ。",
     "zh": "对长辈本来就该用敬语。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0068",
     "diff": "ばかり 表反复或限定，ものだ（た形）表怀旧回忆，语气更感慨。"
    }
   ],
   "common_errors": [
    {
     "wrong": "この辺りは、夜になると静かものだ。",
     "why": "ナ形容词接「ものだ」要加「な」，「静かものだ」不合法。",
     "fix": "静かなものだ",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-는 법이다",
   "ko_diff": "韩语「-는 법이다」只表“理应如此”；日语「ものだ」还能用た形表“过去常常”，对应韩语「-곤 했다」，分工不同。",
   "notes": "",
   "tags": [
    "recollection",
