 "grammar": [
  {
   "id": "G0141",
   "pattern": "〜にとって",
   "meaning_zh": "对…来说",
   "connection": "名词 + にとって；名词 + にとっての + 名词",
   "usage": "表示从某人或某组织的立场看待某事的价值或影响。",
   "register_note": "口语书面均可，评论和致辞常见。",
   "examples": [
    {
     "ja": "私にとって、家族は何よりも大切なものです。",
     "zh": "对我来说，家人比什么都重要。"
    },
    {
     "ja": "このあたりの坂道は、お年寄りにとってはかなり大変だ。",
     "zh": "这一带的坡道对老年人来说相当吃力。"
    },
    {
     "ja": "留学は、彼にとっていい経験になったようだ。",
     "zh": "留学对他来说似乎是一段好经历。"
    }
   ],
   "prerequisites": [
    "G0055"
   ],
   "compare": [
    {
     "id": "G0115",
     "diff": "にとって 表立场，に対して 表对象或对比。"
    }
   ],
   "common_errors": [
    {
     "wrong": "私をとって、家族は何よりも大切なものです。",
     "why": "固定形式是「にとって」，不能换成「をとって」（那是“拿我来…”的意思）。",
     "fix": "私にとって",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-에게 있어서",
   "ko_diff": "韩语「-에게 있어서」同样表立场，但较长、偏书面；日语「にとって」口语也常用，后项多接评价性表达。",
   "notes": "",
   "tags": [
    "standpoint"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0142",
   "pattern": "〜にしては",
   "meaning_zh": "照…来说；以…而言",
   "connection": "动词普通形／名词 + にしては；名词化的 の + にしては 也可用",
   "usage": "表示实际情况与从前提推想的预期不符，含意外感。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "初めて作ったにしては、このケーキはよくできている。",
     "zh": "第一次做来说，这个蛋糕做得相当好。"
    },
    {
     "ja": "彼は小学生にしては、ずいぶん難しい言葉を知っている。",
     "zh": "他作为小学生知道不少难词。"
    },
    {
     "ja": "十月にしては、今日はずいぶん暑いね。",
     "zh": "都十月了，今天可真热。"
    }
   ],
   "prerequisites": [
    "G0082"
   ],
   "compare": [
    {
     "id": "G0174",
     "diff": "にしては 依“身份、时间”等前提判断，わりに 依“程度、数量”比例判断。"
    }
   ],
   "common_errors": [
    {
     "wrong": "初めてのにしてはは上手です。",
     "why": "にしては已有は，不叠加第二个は。",
     "fix": "初めてにしては上手です。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-치고는",
   "ko_diff": "韩语「-치고는」与「にしては」几乎一一对应，都含“出乎预料”；但日语多接身份、时间名词。",
