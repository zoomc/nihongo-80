 "grammar": [
  {
   "id": "G0264",
   "pattern": "〜から（from）",
   "meaning_zh": "从…（起点）",
   "connection": "名词 + から（起点）",
   "usage": "表示时间或场所的起点，常与「まで」呼应。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "授業は9時からです。",
     "zh": "课从九点开始。"
    },
    {
     "ja": "学校から駅まで歩きます。",
     "zh": "我从学校走到车站。"
    },
    {
     "ja": "私はブラジルから来ました。",
     "zh": "我来自巴西。"
    }
   ],
   "prerequisites": [
    "G0013"
   ],
   "compare": [
    {
     "id": "G0265",
     "diff": "から 表起点，まで 表终点"
    }
   ],
   "common_errors": [
    {
     "wrong": "学校から駅までに歩きます。",
     "why": "まで 表终点，后接动词时不再加 に",
     "fix": "学校から駅まで歩きます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "부터 / 에서",
   "ko_diff": "韩语时间起点用 부터，场所起点用 에서；日语 から 两者通用，范围更宽。",
   "notes": "",
