# 部署依赖按需安装（scripts/deploy_cloudflare.sh 会自动 npm install）
deploy/node_modules/
deploy/package-lock.json

# Python 缓存
__pycache__/
*.pyc

# 本地备份与系统文件
data/backups/
.DS_Store

