 "grammar": [
  {
   "id": "G0240",
   "pattern": "〜だろう",
   "meaning_zh": "大概…吧",
   "connection": "动词普通形／い形容词／な形容词／名词 + だろう",
   "usage": "表示说话人的推测，把握较大，口语常用。",
   "register_note": "普通体；礼貌体用「でしょう」。",
   "examples": [
    {
     "ja": "明日はたぶん晴れるだろう。",
     "zh": "明天大概会晴吧。"
    },
    {
     "ja": "彼女はもう家に着いただろう。",
     "zh": "她大概已经到家了吧。"
    },
    {
     "ja": "この問題は子どもには難しいだろうと思います。",
     "zh": "我觉得这个问题对孩子来说大概太难了。"
    }
   ],
   "prerequisites": [
    "G0045"
   ],
   "compare": [
    {
     "id": "G0239",
     "diff": "だろう 把握较大，かもしれない 把握较小"
    }
   ],
   "common_errors": [
    {
     "wrong": "明日はたぶん晴れるでしょうだ。",
     "why": "でしょう 已是礼貌断定，不能再加 だ",
     "fix": "明日はたぶん晴れるでしょう。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-(으)ㄹ 것이다 / -겠다",
   "ko_diff": "韩语 -(으)ㄹ 것이다 与 だろう 对应，-겠다 更偏主观意志或推测；日语 だろう 只表推测，不表意志。",
   "notes": "",
   "tags": [
    "conjecture"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0243",
   "pattern": "〜んです / 〜のです",
   "meaning_zh": "（解释）是…的；因为…",
   "connection": "动词普通形／い形容词 + んです；な形容词+な／名词+な + んです",
   "usage": "用于说明原因、补充背景，或向对方寻求解释，口语色彩强。",
   "register_note": "口语；书面用「のです／のである」。",
   "examples": [
    {
     "ja": "どうしたんですか。顔色が悪いですよ。",
     "zh": "怎么了？你脸色不太好。"
    },
    {
     "ja": "すみません、遅れました。電車が止まっていたんです。",
     "zh": "对不起我迟到了，因为电车停运了。"
    },
    {
     "ja": "日本語で手紙を書きたいんですが、手伝ってくれませんか。",
     "zh": "我想用日语写封信，你能帮我吗？"
    }
   ],
   "prerequisites": [
    "G0059"
   ],
   "compare": [
    {
     "id": "G0228",
     "diff": "んです 是会话中的解释说明，ので 是客观原因连接"
    }
   ],
   "common_errors": [
    {
     "wrong": "電車が止まっていたのだです。",
     "why": "のだ 接礼貌体是「のです」，不能作「のだです」",
     "fix": "電車が止まっていたんです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-ㄴ/는 것이다 / -거든요",
   "ko_diff": "韩语 -거든요 与 んです 的解释语气接近，但日语 んです 还可用于提问求解释；韩语 거든요 只用于陈述。",
