 "grammar": [
  {
   "id": "G0104",
   "pattern": "〜ものだから / 〜もので",
   "meaning_zh": "因为…；由于…",
   "connection": "普通形 + ものだから；ナ形容词 + な + ものだから；名词 + な + ものだから",
   "usage": "为解释或道歉而强调原因，理由多为客观情况。",
   "register_note": "口语为主；「もので」更书面、更委婉。",
   "examples": [
    {
     "ja": "道がすごく混んでいたものだから、約束の時間に間に合わなかった。",
     "zh": "路上堵得厉害，所以没能赶上约定的时间。"
    },
    {
     "ja": "すみません、急いでいたもので、書類を持ってくるのを忘れてしまいました。",
     "zh": "对不起，我当时赶时间，忘了带文件。"
    },
    {
     "ja": "初めての海外旅行だったものだから、見るものすべてが珍しかった。",
     "zh": "那是第一次出国旅行，看到什么都觉得新鲜。"
    }
   ],
   "prerequisites": [
    "G0091"
   ],
   "compare": [
    {
     "id": "G0037",
     "diff": "から/ので 是普通因果，ものだから 带明显的辩解、道歉语气。"
    }
   ],
   "common_errors": [
    {
     "wrong": "教室が静かものだから、つい眠くなった。",
     "why": "ナ形容词接「ものだから」要加「な」，「静かものだから」不合法。",
     "fix": "静かなものだから",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-는 통에",
   "ko_diff": "韩语「-는 통에」多引出坏结果；日语「ものだから」不限好坏，重点在“说明并求得谅解”，语气更软。",
   "notes": "",
   "tags": [
    "reason"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0105",
   "pattern": "〜ことだ",
   "meaning_zh": "最好…；应该…",
   "connection": "动词辞书形/ない形 + ことだ",
   "usage": "给对方提忠告，指出“这样做最好”，比「べきだ」柔和。",
   "register_note": "口语书面均可，多用于上对下或建议。",
   "examples": [
    {
     "ja": "日本語が上手になりたいなら、毎日少しずつでも話すことだ。",
     "zh": "想把日语学好，就该每天多少说一点。"
    },
    {
     "ja": "風邪を早く治したければ、無理をしないでゆっくり休むことです。",
     "zh": "想快点治好感冒，最好别勉强，好好休息。"
    },
    {
     "ja": "人の話は最後までよく聞くことだ。",
     "zh": "别人的话要听到最后。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0102",
     "diff": "ことだ 是正面建议“该这样做”，ものではない 是反面劝诫“不该这样做”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "毎日少しずつ話すことだです。",
     "why": "「ことだ」本身是断定形式，礼貌说法是「ことです」，不能叠加「です」。",
     "fix": "話すことです",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-는 것이다",
   "ko_diff": "韩语建议多用「-는 게 좋다」；日语「ことだ」更简短、更像训示，主语常省略，语气略强。",
   "notes": "",
