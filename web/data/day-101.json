 "grammar": [
  {
   "id": "G0111",
   "pattern": "〜ようとする",
   "meaning_zh": "想要…；正要…",
   "connection": "动词意志形 + とする（否定形：ようとしない）",
   "usage": "表示尝试做某动作，或动作即将发生的瞬间。",
   "register_note": "口语书面均可；「ようとしない」常含批评。",
   "examples": [
    {
     "ja": "ドアを開けようとしたが、鍵がかかっていて開かなかった。",
     "zh": "我想开门，但锁着打不开。"
    },
    {
     "ja": "家を出ようとしたとき、急に雨が降り出した。",
     "zh": "正要出门时，突然下起雨来。"
    },
    {
     "ja": "弟は何度注意しても、部屋を片付けようとしない。",
     "zh": "弟弟不管怎么提醒，都不肯收拾房间。"
    }
   ],
   "prerequisites": [
    "G0067"
   ],
   "compare": [
    {
     "id": "G0064",
     "diff": "ようにする 是“设法养成”，ようとする 是“试图做、即将做”，动作性更强。"
    }
   ],
   "common_errors": [
    {
     "wrong": "ドアを開けますようとしたが、鍵がかかっていた。",
     "why": "「ようとする」前接意志形「開けよう」，不能插入「ます」。",
     "fix": "開けようとした",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-려고 하다",
   "ko_diff": "韩语「-려고 하다」也表意图，但“正要…的瞬间”日语说「ようとしたとき」，韩语多用「-려던 참에」，形式不同。",
   "notes": "",
   "tags": [
    "attempt",
    "intention"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0112",
   "pattern": "〜そうにない / 〜そうもない",
   "meaning_zh": "看样子不会…；不像会…",
   "connection": "动词ます形词干 + そうにない／そうもない",
   "usage": "从现状判断某事难以实现，是样态「そうだ」的否定。",
   "register_note": "口语书面均可；「そうもない」更书面。",
   "examples": [
    {
     "ja": "この雨は、夕方までやみそうにない。",
     "zh": "这场雨看样子到傍晚也停不了。"
    },
    {
     "ja": "仕事が多すぎて、今日中には終わりそうもない。",
     "zh": "工作太多，今天之内看样子做不完。"
    },
    {
     "ja": "こんなにたくさんの料理、二人では食べきれそうにないね。",
     "zh": "这么多菜，两个人看样子吃不完。"
    }
   ],
   "prerequisites": [
    "G0043"
   ],
   "compare": [
    {
     "id": "G0045",
     "diff": "かもしれない 是可能性推测，そうにない 是凭外观判断“不会”，方向相反。"
    }
   ],
   "common_errors": [
    {
     "wrong": "この雨は、夕方までやむそうにない。",
     "why": "「そうにない」前接ます形词干「やみ」，「やむそう」不是合法形式。",
     "fix": "やみそうにない",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-ㄹ 것 같지 않다",
   "ko_diff": "韩语没有专门对应，常说「-ㄹ 것 같지 않다」；日语「そうにない」依据眼前迹象，主观判断色彩更强。",
