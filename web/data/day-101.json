 "grammar": [
  {
   "id": "G0114",
   "pattern": "〜一方で",
   "meaning_zh": "一方面…；同时…",
   "connection": "普通形 + 一方で；ナ形容词 + な + 一方で；名词 + である + 一方で",
   "usage": "并列同一事物的两个侧面，或表两件事同时进行。",
   "register_note": "书面语为主，论述文常用。",
   "examples": [
    {
     "ja": "インターネットは便利な一方で、危険な面もある。",
     "zh": "互联网很方便，另一方面也有危险的一面。"
    },
    {
     "ja": "この会社は給料が高い一方で、休みがとても少ない。",
     "zh": "这家公司工资高，但休假很少。"
    },
    {
     "ja": "彼女は会社で働く一方で、夜は大学院に通っている。",
     "zh": "她一边在公司上班，晚上一边读研究生。"
    }
   ],
   "prerequisites": [
    "G0085"
   ],
   "compare": [
    {
     "id": "G0113",
     "diff": "一方だ 是单向变化，一方で 是对比两面或并行两事。"
    }
   ],
   "common_errors": [
    {
     "wrong": "インターネットは便利だ一方で、危険な面もある。",
     "why": "ナ形容词接「一方で」要用「な」，「便利だ一方で」不合法。",
     "fix": "便利な一方で",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-는 반면에",
   "ko_diff": "韩语「-는 반면에」只表对比；日语「一方で」还能表“同时进行的两件事”，范围更宽。",
   "notes": "",
   "tags": [
    "contrast",
    "simultaneity"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0115",
   "pattern": "〜に対して",
   "meaning_zh": "对…；与…相对",
   "connection": "名词 + に対して；动词/い形容词/ナ形容词 + な + のに対して",
   "usage": "表动作或态度的对象，也用于前后对比。",
   "register_note": "口语书面均可，对比用法偏书面。",
   "examples": [
    {
     "ja": "お客様に対して、そんな言い方をしてはいけない。",
     "zh": "对客人不能那么说话。"
    },
    {
     "ja": "新しい税金に対する反対の声が高まっている。",
     "zh": "反对新税的声音越来越大。"
    },
    {
     "ja": "東京は晴れているのに対して、大阪は朝から大雨だ。",
     "zh": "东京是晴天，而大阪从早上就下大雨。"
    }
   ],
   "prerequisites": [
    "G0076"
   ],
   "compare": [
    {
     "id": "G0141",
     "diff": "に対して 表对象或对比，にとって 表“从某人立场看”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "東京は晴れているに対して、大阪は朝から大雨だ。",
     "why": "动词、形容词小句后接对比的「に対して」要用「のに対して」，不能直接接。",
     "fix": "晴れているのに対して",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-에 대해서",
   "ko_diff": "韩语「-에 대해서」只表对象；日语「に対して」还常用于前后对比，相当于韩语「-는 반면」，用法更广。",
