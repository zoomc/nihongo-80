 "grammar": [
  {
   "id": "G0242",
   "pattern": "〜はずがない",
   "meaning_zh": "不可能…；不会…",
   "connection": "动词普通形／い形容词 + はずがない；な形容词+な／名词+の + はずがない",
   "usage": "根据理由强烈否定某种可能性，语气比「ない」更主观。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "あんなにまじめな人がうそをつくはずがない。",
     "zh": "那么认真的人不可能说谎。"
    },
    {
     "ja": "今日は日曜日だから、銀行が開いているはずがない。",
     "zh": "今天是星期天，银行不可能开门。"
    },
    {
     "ja": "かぎはちゃんとかけたから、ドアが開いているはずがない。",
     "zh": "我明明锁好了，门不可能开着。"
    }
   ],
   "prerequisites": [
    "G0096"
   ],
   "compare": [
    {
     "id": "G0241",
     "diff": "はずがない 是强烈否定，はずだ 是理应如此"
    }
   ],
   "common_errors": [
    {
     "wrong": "彼が来るはずがないません。",
     "why": "「ない」不与「ません」直接叠加。",
     "fix": "彼が来るはずがありません。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-(으)ㄹ 리가 없다",
   "ko_diff": "韩语 -(으)ㄹ 리가 없다 与 はずがない 对应度很高，都表根据理由的强烈否定；语序上韩语「리가」在前，日语「はず」在后。",
   "notes": "",
   "tags": [
    "conjecture",
    "negation"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "needs_review",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0243",
   "pattern": "〜んです / 〜のです",
   "meaning_zh": "（解释）是…的；因为…",
   "connection": "动词普通形／い形容词 + んです；な形容词+な／名词+な + んです",
   "usage": "用于说明原因、补充背景，或向对方寻求解释，口语色彩强。",
   "register_note": "口语；书面用「のです／のである」。",
   "examples": [
    {
     "ja": "どうしたんですか。顔色が悪いですよ。",
     "zh": "怎么了？你脸色不太好。"
    },
    {
     "ja": "すみません、遅れました。電車が止まっていたんです。",
     "zh": "对不起我迟到了，因为电车停运了。"
    },
    {
     "ja": "日本語で手紙を書きたいんですが、手伝ってくれませんか。",
     "zh": "我想用日语写封信，你能帮我吗？"
    }
   ],
   "prerequisites": [
    "G0059"
   ],
   "compare": [
    {
     "id": "G0228",
     "diff": "んです 是会话中的解释说明，ので 是客观原因连接"
    }
   ],
   "common_errors": [
    {
     "wrong": "電車が止まっていたのだです。",
     "why": "のだ 接礼貌体是「のです」，不能作「のだです」",
     "fix": "電車が止まっていたんです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-ㄴ/는 것이다 / -거든요",
   "ko_diff": "韩语 -거든요 与 んです 的解释语气接近，但日语 んです 还可用于提问求解释；韩语 거든요 只用于陈述。",
