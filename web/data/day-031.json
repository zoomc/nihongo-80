 "grammar": [
  {
   "id": "G0273",
   "pattern": "〜です",
   "meaning_zh": "是…（礼貌断定）",
   "connection": "名词／な形容词 + です；い形容词 + です",
   "usage": "礼貌体判断句，用于陈述身份、状态或性质。",
   "register_note": "礼貌体；日常会话与正式场合通用。",
   "examples": [
    {
     "ja": "私はマリアです。",
     "zh": "我是玛丽亚。"
    },
    {
     "ja": "今日は月曜日です。",
     "zh": "今天是星期一。"
    },
    {
     "ja": "この部屋はとても静かです。",
     "zh": "这个房间非常安静。"
    }
   ],
   "prerequisites": [
    "G0001"
   ],
   "compare": [
    {
     "id": "G0274",
     "diff": "です 是礼貌体，だ 是普通体"
    }
   ],
   "common_errors": [
    {
