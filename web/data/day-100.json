 "grammar": [
  {
   "id": "G0109",
   "pattern": "〜こと（instruction）",
   "meaning_zh": "必须…；不得…",
   "connection": "动词辞书形/ない形 + こと（用于告示、规章结句）",
   "usage": "用于书面规章、通知，条列必须做或禁止做的事。",
   "register_note": "仅限书面告示、手册，会话中不用。",
   "examples": [
    {
     "ja": "レポートは、来週の金曜日までに提出すること。",
     "zh": "报告须在下周五前提交。"
    },
    {
     "ja": "図書館の本に、線を引かないこと。",
     "zh": "不得在图书馆的书上画线。"
    },
    {
     "ja": "試験中は、スマホの電源を切っておくこと。",
     "zh": "考试期间须关闭手机电源。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0026",
     "diff": "てください 是口头请求，こと 是书面规章，语气强硬且不面对听话人。"
    }
   ],
   "common_errors": [
    {
     "wrong": "レポートは、来週の金曜日までに提出しますこと。",
     "why": "「こと」结句要求动词辞书形在前，不能嵌入「ます」。",
     "fix": "提出すること。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-할 것",
   "ko_diff": "韩语规章也用「-할 것」，与日语「こと」结句几乎一致；但禁止句韩语用「-하지 말 것」，日语用「ないこと」。",
   "notes": "",
   "tags": [
    "command",
    "written",
    "obligation"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0110",
   "pattern": "〜ように言う / 〜ように頼む",
   "meaning_zh": "让…做；转告…",
   "connection": "动词辞书形/ない形 + ように言う／ように頼む／ように伝える",
   "usage": "转述委托、命令或指示的内容，常用于间接引语。",
   "register_note": "口语书面均可，商务邮件中「〜ようにお伝えください」很常见。",
   "examples": [
    {
     "ja": "医者に、お酒を飲みすぎないように言われた。",
     "zh": "医生嘱咐我别喝太多酒。"
    },
    {
     "ja": "隣の部屋の人に、夜は音楽の音を小さくするように頼んだ。",
     "zh": "我请隔壁房间的人晚上把音乐关小。"
    },
    {
     "ja": "山下さんに、明日の会議に遅れないように伝えてください。",
     "zh": "请转告山下先生明天开会不要迟到。"
    }
   ],
   "prerequisites": [
    "G0012",
    "G0064"
   ],
   "compare": [
    {
     "id": "G0036",
     "diff": "と言う 是直接引用原话，ように言う 只转述要求的内容。"
    }
   ],
   "common_errors": [
    {
     "wrong": "医者に、お酒を飲みすぎませんように言われた。",
     "why": "转述请求或指示用「〜ないように」；「〜ませんように」是祈愿，不能作引用内容。",
     "fix": "飲みすぎないように言われた",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-라고 말하다",
   "ko_diff": "韩语引用用「-라고」，需按词类换「-으라고/-라고」；日语统一用「ように」，不随词类变化，容易漏掉「に」。",
