 "grammar": [
  {
   "id": "G0024",
   "pattern": "可能形",
   "meaning_zh": "能／会…（动词可能形）",
   "connection": "五段 う段→え段+る；一段 去る+られる；カ変 来られる；サ変 できる",
   "usage": "表能力/可能；对象助词常由 を 变 が（日本語が話せる）",
   "register_note": "可能形口语书面通用；正式场合也可换 ことができる。",
   "examples": [
    {
     "ja": "日本語が話せます。",
     "zh": "会说日语。",
     "vocab_ids": [
      "V0081",
      "V0114"
     ]
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0039",
     "diff": "可能形是动词变形；〜ことができる 是「辞书形+ことが+できる」的迂说，结构不同"
    }
   ],
   "common_errors": [
    {
     "wrong": "話せできます。",
     "why": "可能形后不能再叠加 できる（双重可能）",
     "fix": "話せます。",
     "learner": "zh"
    }
   ],
