 "grammar": [
  {
   "id": "G0162",
   "pattern": "〜てたまらない",
   "meaning_zh": "…得受不了；非常…",
   "connection": "动词て形/い形容词くて/ナ形容词で + たまらない",
   "usage": "表某种感情或感觉强烈到难以忍受，书面感比「しょうがない」强。",
   "register_note": "口语书面均可，文章中也常见。",
   "examples": [
    {
     "ja": "この部屋はエアコンがなくて、暑くてたまらない。",
     "zh": "这个房间没空调，热得受不了。"
    },
    {
     "ja": "三年ぶりに国の家族に会えるので、うれしくてたまらない。",
     "zh": "三年没见家人，高兴得不得了。"
    },
    {
     "ja": "試合に負けたのが悔しくてたまらなかった。",
     "zh": "比赛输了，懊悔得不行。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0161",
     "diff": "てたまらない 程度更重、更书面，てしょうがない 更口语、可用于轻微感受。"
    }
   ],
   "common_errors": [
    {
     "wrong": "この部屋はエアコンがなくて、暑いでたまらない。",
     "why": "い形容词接「たまらない」要用「〜くて」，「暑いで」不合法。",
     "fix": "暑くてたまらない",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-아서 못 견디다",
   "ko_diff": "韩语表达强烈感受常用「정말 -다」或「-아서 못 견디다」；日语「てたまらない」是固定句型，不能自由替换。",
   "notes": "",
   "tags": [
    "emotion",
    "degree"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0163",
   "pattern": "〜てはじめて",
   "meaning_zh": "只有…之后才…",
   "connection": "动词て形 + はじめて",
   "usage": "表示经历前项之后，才第一次认识到后项。",
   "register_note": "书面语为主，感想文和演讲常见。",
   "examples": [
    {
     "ja": "病気になってはじめて、健康のありがたさが分かった。",
     "zh": "生病之后，才懂得健康的可贵。"
    },
    {
     "ja": "一人で暮らしてはじめて、親の苦労が分かった。",
     "zh": "一个人生活之后，才明白父母的辛苦。"
    },
    {
     "ja": "実際に使ってみてはじめて、この機械の便利さに気づいた。",
     "zh": "实际用过之后，才发现这台机器多方便。"
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [
    {
     "id": "G0157",
     "diff": "てはじめて 是“之后才明白”，たとたん 是“刚一…就”，时间关系相反。"
    }
   ],
   "common_errors": [
    {
     "wrong": "病気になったはじめて、健康のありがたさが分かった。",
     "why": "「はじめて」前接て形「なって」，不能接た形。",
     "fix": "病気になってはじめて",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-고 나서야",
   "ko_diff": "韩语「-고 나서야」与「てはじめて」对应，都强调“之后才”；但日语后项多为“明白、懂得”类动词。",
