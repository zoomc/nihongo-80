 "grammar": [
  {
   "id": "G0127",
   "pattern": "〜に違いない",
   "meaning_zh": "一定…；肯定…",
   "connection": "普通形 + に違いない；名词 + に違いない（不加「だ」）",
   "usage": "依据某些迹象做很有把握的推断，语气比「だろう」强。",
   "register_note": "口语书面均可，书面感稍强。",
   "examples": [
    {
     "ja": "隣の家は何日も電気が消えている。家族で旅行に出かけたに違いない。",
     "zh": "隔壁好几天没亮灯，一家人肯定出去旅行了。"
    },
    {
     "ja": "こんなに人が並んでいるんだから、この店のラーメンはおいしいに違いない。",
     "zh": "排这么多人，这家店的拉面一定好吃。"
    },
    {
     "ja": "この手紙の字は、父の字に違いない。",
     "zh": "这封信的字迹肯定是父亲的。"
    }
   ],
   "prerequisites": [
    "G0070"
   ],
   "compare": [
    {
     "id": "G0128",
     "diff": "に違いない 是有根据的推断，に決まっている 更像“明摆着”，语气更硬。"
    }
   ],
   "common_errors": [
    {
     "wrong": "この手紙の字は、父の字だに違いない。",
     "why": "名词直接接「に違いない」，不加「だ」。",
     "fix": "父の字に違いない",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
