 "grammar": [
  {
   "id": "G0110",
   "pattern": "〜ように言う / 〜ように頼む",
   "meaning_zh": "让…做；转告…",
   "connection": "动词辞书形/ない形 + ように言う／ように頼む／ように伝える",
   "usage": "转述委托、命令或指示的内容，常用于间接引语。",
   "register_note": "口语书面均可，商务邮件中「〜ようにお伝えください」很常见。",
   "examples": [
    {
     "ja": "医者に、お酒を飲みすぎないように言われた。",
     "zh": "医生嘱咐我别喝太多酒。"
    },
    {
     "ja": "隣の部屋の人に、夜は音楽の音を小さくするように頼んだ。",
     "zh": "我请隔壁房间的人晚上把音乐关小。"
    },
    {
     "ja": "山下さんに、明日の会議に遅れないように伝えてください。",
     "zh": "请转告山下先生明天开会不要迟到。"
    }
   ],
   "prerequisites": [
    "G0012",
    "G0064"
   ],
   "compare": [
    {
     "id": "G0036",
     "diff": "と言う 是直接引用原话，ように言う 只转述要求的内容。"
    }
   ],
   "common_errors": [
    {
     "wrong": "医者に、お酒を飲みすぎませんように言われた。",
     "why": "转述请求或指示用「〜ないように」；「〜ませんように」是祈愿，不能作引用内容。",
     "fix": "飲みすぎないように言われた",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-라고 말하다",
   "ko_diff": "韩语引用用「-라고」，需按词类换「-으라고/-라고」；日语统一用「ように」，不随词类变化，容易漏掉「に」。",
   "notes": "",
   "tags": [
    "request",
    "command",
    "quotation"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0111",
   "pattern": "〜ようとする",
   "meaning_zh": "想要…；正要…",
   "connection": "动词意志形 + とする（否定形：ようとしない）",
   "usage": "表示尝试做某动作，或动作即将发生的瞬间。",
   "register_note": "口语书面均可；「ようとしない」常含批评。",
   "examples": [
    {
     "ja": "ドアを開けようとしたが、鍵がかかっていて開かなかった。",
     "zh": "我想开门，但锁着打不开。"
    },
    {
     "ja": "家を出ようとしたとき、急に雨が降り出した。",
     "zh": "正要出门时，突然下起雨来。"
    },
    {
     "ja": "弟は何度注意しても、部屋を片付けようとしない。",
     "zh": "弟弟不管怎么提醒，都不肯收拾房间。"
    }
   ],
   "prerequisites": [
    "G0067"
   ],
   "compare": [
    {
     "id": "G0064",
     "diff": "ようにする 是“设法养成”，ようとする 是“试图做、即将做”，动作性更强。"
    }
   ],
   "common_errors": [
    {
     "wrong": "ドアを開けますようとしたが、鍵がかかっていた。",
     "why": "「ようとする」前接意志形「開けよう」，不能插入「ます」。",
     "fix": "開けようとした",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-려고 하다",
   "ko_diff": "韩语「-려고 하다」也表意图，但“正要…的瞬间”日语说「ようとしたとき」，韩语多用「-려던 참에」，形式不同。",
