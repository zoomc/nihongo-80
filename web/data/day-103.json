 "grammar": [
  {
   "id": "G0115",
   "pattern": "〜に対して",
   "meaning_zh": "对…；与…相对",
   "connection": "名词 + に対して；动词/い形容词/ナ形容词 + な + のに対して",
   "usage": "表动作或态度的对象，也用于前后对比。",
   "register_note": "口语书面均可，对比用法偏书面。",
   "examples": [
    {
     "ja": "お客様に対して、そんな言い方をしてはいけない。",
     "zh": "对客人不能那么说话。"
    },
    {
     "ja": "新しい税金に対する反対の声が高まっている。",
     "zh": "反对新税的声音越来越大。"
    },
    {
     "ja": "東京は晴れているのに対して、大阪は朝から大雨だ。",
     "zh": "东京是晴天，而大阪从早上就下大雨。"
    }
   ],
   "prerequisites": [
    "G0076"
   ],
   "compare": [
    {
     "id": "G0141",
     "diff": "に対して 表对象或对比，にとって 表“从某人立场看”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "東京は晴れているに対して、大阪は朝から大雨だ。",
     "why": "动词、形容词小句后接对比的「に対して」要用「のに対して」，不能直接接。",
     "fix": "晴れているのに対して",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-에 대해서",
   "ko_diff": "韩语「-에 대해서」只表对象；日语「に対して」还常用于前后对比，相当于韩语「-는 반면」，用法更广。",
   "notes": "",
   "tags": [
    "relation",
    "contrast"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0116",
   "pattern": "〜について",
   "meaning_zh": "关于…",
   "connection": "名词 + について；名词 + についての + 名词",
   "usage": "指出谈话、思考或调查的主题。",
   "register_note": "口语书面均可，比「に関して」日常。",
   "examples": [
    {
     "ja": "今日の授業では、日本の食文化について話し合いました。",
     "zh": "今天的课上我们讨论了日本饮食文化。"
    },
    {
     "ja": "新しい商品についての質問は、こちらのメールアドレスまでお送りください。",
     "zh": "关于新产品的疑问请发到这个邮箱。"
    },
    {
     "ja": "その事件について、警察はまだ何も発表していない。",
     "zh": "关于那起事件，警方还没有任何发布。"
    }
   ],
   "prerequisites": [
    "G0055"
   ],
   "compare": [
    {
     "id": "G0144",
     "diff": "について 日常通用，に関して 更正式、更书面。"
    }
   ],
   "common_errors": [
    {
     "wrong": "今日の授業では、日本の食文化をについて話し合いました。",
     "why": "「について」本身已含助词功能，不能再叠「を」。",
     "fix": "食文化について",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
