 "grammar": [
  {
   "id": "G0225",
   "pattern": "〜ても / 〜でも",
   "meaning_zh": "即使…也…",
   "connection": "动词て形+も；い形容词去い+くても；な形容词・名词+でも",
   "usage": "表示让步条件，前项成立也不影响后项结论。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "雨が降っても、試合はあります。",
     "zh": "即使下雨，比赛也照常进行。"
    },
    {
     "ja": "いくら練習しても、なかなか上手になりません。",
     "zh": "无论怎么练习，就是不见进步。"
    },
    {
     "ja": "日曜日でも、この店は開いています。",
     "zh": "即使是星期天，这家店也开着。"
    }
   ],
   "prerequisites": [
    "G0020",
    "G0029"
   ],
   "compare": [
    {
     "id": "G0226",
     "diff": "ても 是让步条件，のに 含出乎意料的不满"
    }
   ],
   "common_errors": [
    {
     "wrong": "日曜日ても、この店は開いています。",
     "why": "名词要用「でも」，不能直接接 ても",
     "fix": "日曜日でも、この店は開いています。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아/어도",
   "ko_diff": "韩语 -아/어도 与 ても 对应，但日语名词和な形容词用 でも，接续随词性变化；韩语则统一接词干。",
   "notes": "",
   "tags": [
    "concession",
    "condition"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0226",
   "pattern": "〜のに（although）",
   "meaning_zh": "明明…却…",
   "connection": "动词普通形／い形容词 + のに；な形容词+な／名词+な + のに",
   "usage": "表示与预期相反，带有意外、不满或惋惜的语气。",
   "register_note": "口语与书面通用；语气主观，正式报告少用。",
   "examples": [
    {
     "ja": "一生懸命勉強したのに、試験に落ちてしまった。",
     "zh": "我明明拼命学习了，考试却没通过。"
    },
    {
     "ja": "日曜日なのに、会社に行かなければならない。",
     "zh": "明明是星期天，却必须去公司。"
    },
    {
     "ja": "約束したのに、彼は来なかった。",
     "zh": "他明明答应了，却没有来。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0231",
     "diff": "のに 含不满与意外，けど 只是中性转折"
    }
   ],
   "common_errors": [
    {
     "wrong": "日曜日ののに、会社に行かなければならない。",
     "why": "名词接 のに 直接加 な，不用 の",
     "fix": "日曜日なのに、会社に行かなければならない。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-는데도",
   "ko_diff": "韩语 -는데도 与 のに 对应，同样带不满；但日语 のに 还可用于句末表遗憾，韩语 -는데도 不能单独结句。",
   "notes": "",
