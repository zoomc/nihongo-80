 "grammar": [
  {
   "id": "G0123",
   "pattern": "〜っぽい",
   "meaning_zh": "有点…；容易…；带…色",
   "connection": "名词/动词ます形词干/い形容词词干 + っぽい",
   "usage": "口语中表“带有某种倾向或感觉”，多含轻微负面评价。",
   "register_note": "口语为主，正式文章少用。",
   "examples": [
    {
     "ja": "この服はちょっと子どもっぽいから、別のにしよう。",
     "zh": "这件衣服有点孩子气，换一件吧。"
    },
    {
     "ja": "最近忘れっぽくなって、困っている。",
     "zh": "最近变得容易忘事，很苦恼。"
    },
    {
     "ja": "あの白っぽいビルが、新しい市役所です。",
     "zh": "那栋发白的楼就是新市政府。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0122",
     "diff": "らしい 是“够格、典型”，っぽい 是“有点那个味道”，评价更轻、更口语。"
    }
   ],
   "common_errors": [
    {
     "wrong": "この服はちょっと子どものっぽいから、別のにしよう。",
     "why": "「っぽい」直接接名词，不加「の」。",
     "fix": "子どもっぽい",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-스럽다",
   "ko_diff": "韩语「-스럽다」多带正面或中性色彩；日语「っぽい」常含“不够纯正”的轻微贬义，语气更随意。",
   "notes": "",
   "tags": [
    "appearance",
    "tendency",
    "casual"
   ],
