 "grammar": [
  {
   "id": "G0182",
   "pattern": "〜がち",
   "meaning_zh": "容易…；动不动就…",
   "connection": "动词ます形词干/名词 + がち",
   "usage": "表示容易出现某种不太好的倾向，多含消极评价。",
   "register_note": "书面语为主，报道中常见。",
   "examples": [
    {
     "ja": "冬になると、つい家にこもりがちになる。",
     "zh": "一到冬天，就容易闷在家里。"
    },
    {
     "ja": "娘は小さいころ病気がちだったが、今はとても元気だ。",
     "zh": "女儿小时候常生病，现在很健康。"
    },
    {
     "ja": "一人暮らしだと、野菜が不足しがちです。",
     "zh": "一个人生活，容易蔬菜摄入不足。"
    }
   ],
   "prerequisites": [
    "G0095"
   ],
   "compare": [
    {
     "id": "G0183",
     "diff": "がち 是“容易出现的倾向”，気味 是“已经有了一点那种迹象”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "冬になると、つい家にこもるがちになる。",
     "why": "「がち」前接ます形词干「こもり」，不能接辞书形。",
     "fix": "こもりがちになる",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-기 쉽다",
   "ko_diff": "韩语「-기 쉽다」中性，好坏都可用；日语「がち」几乎只用于消极倾向，且偏书面。",
