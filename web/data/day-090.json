 "grammar": [
  {
   "id": "G0092",
   "pattern": "普通形 + からこそ",
   "meaning_zh": "正因为…才…",
   "connection": "動詞・い形 普通形 + からこそ；な形・名詞 + だ + からこそ",
   "usage": "强调前项是后项成立的关键原因，常与「〜のだ／〜のです」呼应。",
   "examples": [
    {
     "ja": "好きだからこそ、厳しく言うのです。",
     "zh": "正因为喜欢，才严格地说。",
     "vocab_ids": [
      "V0134"
     ]
    },
    {
     "ja": "忙しいからこそ、時間の使い方を考える必要があります。",
     "zh": "正因为忙，才需要思考如何使用时间。",
     "vocab_ids": [
      "V0131",
      "V0027"
     ]
    }
   ],
   "prerequisites": [
    "G0037"
   ],
   "compare": [
    {
     "id": "G0037",
     "diff": "から 是普通原因；からこそ 强调“正是这个原因”，后项多带解释/主张。"
    }
   ],
   "common_errors": [
    {
     "wrong": "好きだからこそで、続けられます。",
     "why": "からこそ 后不接 で；中文“正因为喜欢”直译加 で。",
     "fix": "好きだからこそ、続けられます。",
     "learner": "zh"
    },
    {
     "wrong": "好きだこそ、続けられます。",
     "why": "からこそ 不能省 から；中文“正因为”只取“こそ”错。",
     "fix": "好きだからこそ、続けられます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "plain-form",
    "reason",
    "emphasis"
   ],
   "register_note": "中性偏书面，口语也可；后项常是说话人的判断/解释。",
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "source_ids": [
    "S000"
   ],
   "ko_equiv": "-니까 / -기 때문에야말로",
   "ko_diff": "韩语强调正因为用니까加야말로，或기 때문이다；无单一固定形，须组合表达。"
  },
  {
   "id": "G0093",
   "pattern": "N / 普通形 + ばかりか",
   "meaning_zh": "不仅…而且…",
   "connection": "名詞 + ばかりか；動詞・い形 普通形 + ばかりか；な形・名詞 + な/である + ばかりか",
   "usage": "前项已成立，后项进一步追加，常与「も／まで」呼应；后项多比前项程度更高。",
   "examples": [
    {
     "ja": "この店は安いばかりか、味も美味しいです。",
     "zh": "这家店不仅便宜，味道也好。",
     "vocab_ids": [
      "V0126",
      "V0130"
     ]
    },
    {
