 "grammar": [
  {
   "id": "G0231",
   "pattern": "〜けど / 〜けれども",
   "meaning_zh": "但是…；虽然…",
   "connection": "句子普通形 + けど／けれども（礼貌体可直接接）",
   "usage": "表示转折，或用来缓和语气、引出请求与铺垫。",
   "register_note": "けど 口语；けれども 较正式。",
   "examples": [
    {
     "ja": "この店は高いけど、おいしい。",
     "zh": "这家店贵，但很好吃。"
    },
    {
     "ja": "すみません、駅に行きたいんですけど、どう行けばいいですか。",
     "zh": "不好意思，我想去车站，请问怎么走？"
    },
    {
     "ja": "何度も電話したけれども、誰も出なかった。",
     "zh": "我打了好几次电话，但没人接。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
