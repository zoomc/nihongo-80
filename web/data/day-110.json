 "grammar": [
  {
   "id": "G0120",
   "pattern": "〜だけでなく",
   "meaning_zh": "不仅…而且…",
   "connection": "普通形 + だけでなく；な形容词可接词干（上手だけでなく）或 な；名词直接接",
   "usage": "追加事项，后项常用「も」，是口语化的“不仅…而且”。",
   "register_note": "口语书面均可，比「ばかりでなく」随意。",
   "examples": [
    {
     "ja": "この店は料理がおいしいだけでなく、値段も安い。",
     "zh": "这家店不仅菜好吃，价格也便宜。"
    },
    {
     "ja": "地震の後、水だけでなく電気も止まってしまった。",
     "zh": "地震后不仅停水，连电也停了。"
    },
    {
     "ja": "彼女は歌が上手なだけでなく、自分で曲も作っている。",
     "zh": "她不仅唱得好，还自己作曲。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0119",
     "diff": "だけでなく 口语通用，ばかりでなく 更书面、更郑重。"
    }
   ],
   "common_errors": [
    {
     "wrong": "日本語だけなくて、中国語も話します。",
     "why": "并列补充可用「だけでなく」，不能写成「だけなくて」。",
     "fix": "日本語だけでなく、中国語も話します。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-뿐만 아니라",
   "ko_diff": "韩语「-뿐만 아니라」也可表示追加；日语な形容词既可见词干直接接「だけでなく」，也可用「なだけでなく」，应按实际表达判断。",
   "notes": "",
   "tags": [
    "addition"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "needs_review",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0133",
   "pattern": "〜ところに / 〜ところへ / 〜ところを",
   "meaning_zh": "正当…的时候",
   "connection": "动词辞书形/ている/た形 + ところに／ところへ／ところを",
   "usage": "表示某动作正要发生或正在进行时，被另一事打断。",
   "register_note": "口语书面均可；「ところを」多接被动，表“被撞见”。",
   "examples": [
    {
     "ja": "出かけようとしているところに、友達から電話がかかってきた。",
     "zh": "正要出门时，朋友打来了电话。"
    },
    {
     "ja": "みんなで君の話をしているところへ、ちょうど君が来た。",
     "zh": "我们正说你呢，你就来了。"
    },
    {
     "ja": "授業中にスマホを見ているところを、先生に見られてしまった。",
     "zh": "上课看手机被老师看见了。"
    }
   ],
   "prerequisites": [
    "G0069"
   ],
   "compare": [
    {
     "id": "G0069",
     "diff": "ところだ 结句表时态阶段，ところに/を 是接续成分，引出打断的事。"
    }
   ],
   "common_errors": [
    {
     "wrong": "出かけるのところに、友達から電話がかかってきた。",
     "why": "「ところ」前接动词时不能加「の」，「のところ」只接名词。",
     "fix": "出かけるところに",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-려는 참에",
   "ko_diff": "韩语常用「-려는 참에」表“正要做时”；日语按「に/へ/を」区分打断方式，韩语没有这种分工。",
