 "grammar": [
  {
   "id": "G0028",
   "pattern": "～て から",
   "meaning_zh": "…之后（再）…",
   "connection": "動詞て形 + から",
   "usage": "强调动作先后顺序；「〜た から」是原因，形近义异",
   "register_note": "てから 日常会话常用，书面叙事也可。",
   "examples": [
    {
     "ja": "ご飯を食べてから、学校へ行きます。",
     "zh": "吃完饭后去学校。",
     "vocab_ids": [
      "V0051",
      "V0101",
      "V0039",
      "V0103"
     ]
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "ご飯を食べたから、学校へ行きます。（想表顺序）",
     "why": "「〜たから」表原因理由；先后顺序用 てから",
     "fix": "ご飯を食べてから、学校へ行きます。",
     "learner": "zh"
    },
    {
     "wrong": "食べるから、行きます。",
     "why": "「から」前接普通形是原因；顺序须用 て形+から",
     "fix": "食べてから、行きます。",
     "learner": "zh"
    }
   ],
