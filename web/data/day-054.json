 "grammar": [
  {
   "id": "G0203",
   "pattern": "〜ようだ",
   "meaning_zh": "好像…；似乎…",
   "connection": "动词普通形／い形容词 + ようだ；な形容词+な／名词+の + ようだ",
   "usage": "根据所见所闻的证据做较有把握的推断，也可用于委婉断定。",
   "register_note": "口语与书面通用；口语常用「みたい」。",
   "examples": [
    {
     "ja": "誰もいないようですね。",
     "zh": "好像没有人呢。"
    },
    {
     "ja": "かぜをひいたようで、朝からのどが痛い。",
     "zh": "我好像感冒了，从早上起喉咙就痛。"
    },
    {
     "ja": "外は寒いようだ。みんなコートを着ている。",
     "zh": "外面好像很冷，大家都穿着大衣。"
    }
   ],
   "prerequisites": [
    "G0023",
    "G0006"
   ],
   "compare": [
    {
     "id": "G0204",
     "diff": "ようだ 较正式，みたい 是口语形式"
    }
   ],
   "common_errors": [
    {
     "wrong": "外は寒いようだです。",
     "why": "ようだ 已是普通形断定，接礼貌体应说「ようです」，不能加 です",
     "fix": "外は寒いようです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-(으)ㄴ/는 것 같다",
   "ko_diff": "韩语 것 같다 与 ようだ 对应，但日语 ようだ 还常用于比喻和委婉断定；韩语 것 같다 的推测语气更单一。",
   "notes": "",
