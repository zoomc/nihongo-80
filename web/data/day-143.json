     "zh": "希望考试合格。"
    },
    {
     "ja": "明日の遠足、雨が降りませんように。",
     "zh": "希望明天郊游别下雨。"
    },
    {
     "ja": "家族みんなが元気で過ごせますように。",
     "zh": "愿家人健康平安。"
    }
   ],
   "prerequisites": [],
