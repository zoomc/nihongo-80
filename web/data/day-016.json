 "grammar": [
  {
   "id": "G0032",
   "pattern": "～ましょう / ～ませんか",
   "meaning_zh": "（一起）…吧／要不要…？",
   "connection": "動詞ます形（去ます） + ましょう／ませんか",
   "usage": "ましょう 表提议/意志；ませんか 是委婉邀约",
   "register_note": "ましょう/ませんか 是礼貌提议，通用；对上级用 ませんか 更稳妥。",
   "examples": [
    {
     "ja": "一緒に映画を見ませんか。",
     "zh": "一起看电影好吗？",
     "vocab_ids": [
      "V0099",
      "V0105"
     ]
    },
    {
     "ja": "そろそろ帰りましょう。",
     "zh": "差不多回去吧。",
     "vocab_ids": [
      "V0122"
     ]
    }
   ],
   "prerequisites": [
    "G0019"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "映画を見るましょう。",
     "why": "「ましょう」前接ます形词干（見），不接辞书形 見る",
     "fix": "映画を見ましょう。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "invitation"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "needs_review",
   "provenance": "self_reviewed",
   "ko_equiv": "-(으)ㅂ시다 / -(으)ㄹ래요?",
   "ko_diff": "韩语提议用ㅂ시다，邀约用ㄹ래요；对长辈ㅂ시다不礼貌，须换ㄹ까요。"
  },
  {
   "id": "G0033",
   "pattern": "～が ほしい",
   "meaning_zh": "想要（某物）",
   "connection": "名詞 + が + ほしい（です）",
   "usage": "表说话人想要某物；对象用 が，不是 を；第三人称用 ほしがる",
   "register_note": "ほしい 口语常见；正式请求可用 いただきたい。",
   "examples": [
    {
     "ja": "新しいパソコンがほしいです。",
     "zh": "想要新电脑。",
     "vocab_ids": [
      "V0129",
      "V0088"
     ]
    }
   ],
   "prerequisites": [
    "G0007"
   ],
   "compare": [
    {
     "id": "G0031",
     "diff": "ほしい 想要「物」+が；たい 想要「做动作」，两者对象不同"
    }
   ],
   "common_errors": [
    {
     "wrong": "パソコンを ほしいです。",
     "why": "「ほしい」对象格用 が；中文「想要(某物)」是动宾，直译成 を 错",
     "fix": "パソコンがほしいです。",
     "learner": "zh"
    },
    {
     "wrong": "ほしいだ。",
     "why": "「ほしい」い形容词型，结句用 です",
     "fix": "ほしいです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "desire"
   ],
   "source_ids": [
