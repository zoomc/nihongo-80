 "grammar": [
  {
   "id": "G0336",
   "pattern": "〜に越したことはない",
   "pattern_kana": "〜にこしたことはない",
   "meaning_zh": "最好还是…",
   "ko_equiv": "…하면 더 좋다 / …하는 게 상책이다",
   "connection": "动词普通形／い形容词／な形容词词干／名词＋に越したことはない",
   "usage": "",
   "ko_diff": "这是说风险更小或更理想，未必是硬要求。「早いに越したことはない」相当于“能早一点最好”。",
   "examples": [
    {
     "ja": "どんなに健康でも、定期的に検診を受けるに越したことはない。",
     "en": "No matter how healthy you are, it's best to get regular checkups.",
     "zh": "哪怕身体再好，也最好定期体检。"
    },
    {
     "ja": "旅行の荷物は、軽いに越したことはない。",
     "en": "When you travel, the lighter your luggage, the better.",
     "zh": "旅行的行李还是轻一点好。"
    }
   ],
   "tags": [
    "advice",
    "suggestion"
   ],
   "jlpt": "N2",
   "prerequisites": [],
   "compare": [],
   "common_errors": [
