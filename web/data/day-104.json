 "grammar": [
  {
   "id": "G0121",
   "pattern": "〜も〜ば〜も",
   "meaning_zh": "既…又…；也…也…",
   "connection": "名词 + も + ば形 + 名词 + も；名词 + も + い形容词ければ + 名词 + も",
   "usage": "并举两个并存的事实，含“两者都有”的语气。",
   "register_note": "书面语色彩，谚语和评述中常见。",
   "examples": [
    {
     "ja": "彼女は歌も歌えば、ピアノも弾く。",
     "zh": "她既会唱歌，也会弹钢琴。"
    },
    {
     "ja": "この町には、海もあれば山もある。",
     "zh": "这个镇子有海也有山。"
    },
    {
     "ja": "人生には、いいときもあれば悪いときもある。",
     "zh": "人生既有好时候，也有坏时候。"
    }
   ],
   "prerequisites": [
    "G0025"
   ],
   "compare": [
    {
     "id": "G0119",
     "diff": "も〜ば〜も 是并列两个事实，ばかりでなく 是层层追加、后项更进一层。"
    }
   ],
   "common_errors": [
    {
     "wrong": "彼女は歌も歌うば、ピアノも弾く。",
     "why": "前项必须用ば形「歌えば」，「歌うば」不合法。",
     "fix": "歌も歌えば",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-기도 하고 -기도 하다",
   "ko_diff": "韩语「-기도 하고 -기도 하다」只并列；日语「も〜ば〜も」用ば形连接，书面感更强，前半须是完整谓语。",
   "notes": "",
   "tags": [
    "addition"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0122",
   "pattern": "〜らしい（typical of）",
   "meaning_zh": "像…样的；典型的…",
   "connection": "名词 + らしい（らしくない 表“不像”）",
   "usage": "表示某事物充分具备应有的特征，或“不愧为…”。",
   "register_note": "口语书面均可；「らしくない」常带批评。",
   "examples": [
    {
     "ja": "今日は春らしい暖かい一日だった。",
     "zh": "今天是很有春意的一个暖和日子。"
    },
    {
     "ja": "文句ばかり言うなんて、君らしくないね。",
     "zh": "老是抱怨，真不像你。"
    },
    {
     "ja": "もっと学生らしい服装で来てください。",
     "zh": "请穿得更像个学生一点来。"
    }
   ],
   "prerequisites": [
    "G0044"
   ],
   "compare": [
    {
     "id": "G0044",
     "diff": "らしい 表传闻时接普通形，表“典型”时直接接名词，靠上下文区分。"
    }
   ],
   "common_errors": [
    {
     "wrong": "もっと学生らしいの服装で来てください。",
     "why": "「らしい」直接修饰名词，不加「の」。",
     "fix": "学生らしい服装",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-다운",
   "ko_diff": "韩语「-다운」同样表“符合其本色”；但日语「らしい」还有传闻用法，韩语传闻用「-라고 한다」，不会混淆。",
