 "grammar": [
  {
   "id": "G0035",
   "pattern": "～に なる / ～く なる / ～に する",
   "meaning_zh": "变成…／使…变得…",
   "connection": "名詞/な形 + に + なる；い形 + く + なる；他动词 〜に/く する",
   "usage": "なる 自动词表自然变化，する 他动词表人为改变",
   "register_note": "なる/する 口语书面通用，分别表自然变化与人为改变。",
   "examples": [
    {
     "ja": "彼は医者になりました。",
     "zh": "他当上医生了。",
     "vocab_ids": [
      "V0074",
      "V0087"
     ]
    },
    {
     "ja": "部屋が静かになりました。",
     "zh": "房间变安静了。",
     "vocab_ids": [
      "V0045",
      "V0136"
     ]
    }
   ],
   "prerequisites": [
    "G0009",
    "G0015",
    "G0016"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "部屋を静かになりました。",
     "why": "「なる」是自动词，主体用 が；人为改变才用 を+する",
     "fix": "部屋が静かになりました。／部屋を静かにしました。",
     "learner": "zh"
    },
    {
     "wrong": "寒いに なりました",
     "why": "い形容词变化用 〜くなる，な形容词/名词才用 〜になる",
     "fix": "寒くなりました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "tags": [
    "change",
    "transitivity"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-아/어지다 / -게 하다",
   "ko_diff": "韩语变化用아/어지다，人为改变用게 하다；无日语なる/する的自动他动对立。"
  },
  {
   "id": "G0036",
   "pattern": "～と 思う / ～と 言う",
   "meaning_zh": "觉得…／说「…」",
   "connection": "普通形从句 + と + 思う／言う",
   "usage": "引用助词 と；从句用普通形，不用 です/ます",
   "register_note": "と思う/言う 口语常用；正式引用可用 と申す/と述べる。",
   "examples": [
    {
     "ja": "明日は雨だと思います。",
     "zh": "我觉得明天会下雨。",
     "vocab_ids": [
      "V0024",
      "V0096"
     ]
    },
    {
     "ja": "彼は行きたくないと言いました。",
     "zh": "他说不想去。",
     "vocab_ids": [
      "V0074",
      "V0103"
     ]
    }
   ],
   "prerequisites": [
    "G0012",
    "G0023"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "明日は雨です と思います。",
     "why": "「です」不能直接接「と思います」（引用从句要用普通体）。应说「明日は雨だと思います」。这不是 です 本身错，而是嵌在引用从句里的语体不对。",
     "fix": "明日は雨だと思います。",
     "learner": "zh",
     "register_ack": true
    },
    {
     "wrong": "明日は雨だ 思います。",
     "why": "引用内容必须加 と",
     "fix": "明日は雨だと思います。",
     "learner": "zh"
    }
   ],
