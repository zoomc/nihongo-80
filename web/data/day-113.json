 "grammar": [
  {
   "id": "G0138",
   "pattern": "〜さえ〜ば",
   "meaning_zh": "只要…就…",
   "connection": "名词 + さえ + ば形；动词ます形词干 + さえ + すれば；动词て形 + さえ + いれば",
   "usage": "表示只要满足这一条件，其余都不成问题。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "このアプリさえあれば、どこでも日本語の勉強ができる。",
     "zh": "只要有这个应用，在哪儿都能学日语。"
    },
    {
     "ja": "時間さえあれば、もっと旅行に行きたいんですが。",
     "zh": "只要有时间，我还想多去旅行。"
    },
    {
     "ja": "薬を飲んで寝てさえいれば、すぐに治りますよ。",
     "zh": "只要吃了药好好躺着，很快就会好。"
    }
   ],
   "prerequisites": [
    "G0080",
    "G0025"
   ],
   "compare": [
    {
     "id": "G0137",
     "diff": "さえ 单举极端例，さえ〜ば 构成“只要…就”的条件句。"
    }
   ],
   "common_errors": [
    {
     "wrong": "このアプリさえあってば、どこでも日本語の勉強ができる。",
     "why": "「さえ」后要接ば形「あれば」，「あってば」不合法。",
     "fix": "さえあれば",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-기만 하면",
   "ko_diff": "韩语「-기만 하면」与「さえ〜ば」对应；但日语「さえ」位置固定在各成分后，韩语统一贴在动词后，语序处理不同。",
   "notes": "",
   "tags": [
    "condition",
    "emphasis"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0139",
   "pattern": "〜こそ",
   "meaning_zh": "正是…；才是…",
   "connection": "名词 + こそ（可加「が」成「こそが」）",
   "usage": "强烈提示焦点，表“正是这个，不是别的”。",
   "register_note": "口语书面均可，常出现在致辞和标语。",
   "examples": [
    {
     "ja": "「いつもありがとう。」「いえ、こちらこそ。」",
     "zh": "“一直谢谢你。”“不，我才是。”"
    },
    {
     "ja": "今年こそ、たばこをやめるつもりだ。",
     "zh": "今年我一定要把烟戒掉。"
    },
    {
     "ja": "毎日の小さな努力こそが、大きな成功につながる。",
     "zh": "正是每天的小努力带来了巨大的成功。"
    }
   ],
   "prerequisites": [
    "G0080"
   ],
   "compare": [
    {
     "id": "G0137",
     "diff": "こそ 提示焦点，さえ 举极端例，二者虽都表强调但功能不同。"
    }
   ],
   "common_errors": [
    {
     "wrong": "毎日の小さな努力をこそが、大きな成功につながる。",
     "why": "「こそ」可与「が」连用成「こそが」，但不能叠在「を」后再接「が」。",
     "fix": "努力こそが",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-야말로",
   "ko_diff": "韩语「-야말로」与「こそ」几乎一致；但日语「こちらこそ」已成固定寒暄，韩语对应「저야말로」，礼貌度需注意。",
   "notes": "",
