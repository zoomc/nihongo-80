 "grammar": [
  {
   "id": "G0129",
   "pattern": "〜気がする",
   "meaning_zh": "感觉…；总觉得…",
   "connection": "普通形 + 気がする；ナ形容词 + な + 気がする；名词 + の + ような + 気がする",
   "usage": "表达模糊的直觉或主观感觉，把握不大。",
   "register_note": "口语为主，书面也可。",
   "examples": [
    {
     "ja": "この人とは、どこかで会ったことがある気がする。",
     "zh": "总觉得在哪儿见过这个人。"
    },
    {
     "ja": "今日は何か、いいことがありそうな気がする。",
     "zh": "今天总觉得会有好事发生。"
    },
    {
     "ja": "ドアの鍵をかけ忘れたような気がして、家に戻った。",
     "zh": "觉得好像忘了锁门，就回家了一趟。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0045",
     "diff": "かもしれない 是客观可能性判断，気がする 只是主观感觉，依据更弱。"
    }
   ],
   "common_errors": [
    {
     "wrong": "今日は何か変気がする。",
     "why": "ナ形容词接「気がする」要加「な」，「変気がする」不合法。",
     "fix": "変な気がする",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-ㄴ 기분이 들다",
   "ko_diff": "韩语「-ㄴ 기분이 들다」偏情绪感受；日语「気がする」还能用于记忆和判断的模糊确信，范围更广。",
   "notes": "",
   "tags": [
    "conjecture",
    "emotion"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0130",
   "pattern": "〜ずに",
   "meaning_zh": "不…就…；没…而…",
   "connection": "动词ない形词干 + ずに（する→せずに）",
   "usage": "表示在不做某动作的状态下做另一动作，书面色彩强。",
   "register_note": "书面语为主，口语多说「ないで」。",
   "examples": [
    {
     "ja": "けさは朝ご飯を食べずに家を出た。",
     "zh": "今天早上没吃早饭就出门了。"
    },
    {
     "ja": "辞書を使わずに、この新聞記事が読めますか。",
     "zh": "你能不用词典读懂这篇报道吗？"
    },
    {
     "ja": "彼は誰にも相談せずに、会社を辞めてしまった。",
     "zh": "他没跟任何人商量就辞职了。"
    }
   ],
   "prerequisites": [
    "G0022"
   ],
   "compare": [
    {
     "id": "G0020",
     "diff": "ないで 是口语形式，ずに 更书面；する 要变「せずに」。"
    }
   ],
   "common_errors": [
    {
     "wrong": "彼は誰にも相談しずに、会社を辞めてしまった。",
     "why": "「する」的「ずに」形式是「せずに」，「しずに」不合法。",
     "fix": "相談せずに",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-지 않고",
   "ko_diff": "韩语「-지 않고」不分书面口语；日语「ずに」限书面正式，「ないで」才是口语，需按文体选择。",
