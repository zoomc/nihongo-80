   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "部屋を静かになりました。",
     "why": "なる 是自动词，变化的主体用 が；“把房间弄安静”是人为改变，才用 を＋する。",
     "fix": "部屋が静かになりました。／部屋を静かにしました。",
     "learner": "zh"
    },
    {
     "wrong": "寒いに なりました",
     "why": "い形容词变“变得…”用 〜くなる（寒くなる）；になる 给名词和な形容词。",
     "fix": "寒くなりました。",
     "learner": "zh"
    }
   ],
