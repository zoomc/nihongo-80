 "grammar": [
  {
   "id": "G0193",
   "pattern": "〜てくる",
   "meaning_zh": "…来；一直…到现在；开始…",
   "connection": "动词て形 + くる（てくる）",
   "usage": "表示动作由远及近，或变化从过去累积到现在、开始出现。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "ちょっとコンビニに行ってきます。",
     "zh": "我去一下便利店就回来。"
    },
    {
     "ja": "日本語が少しずつ分かってきた。",
     "zh": "我渐渐能听懂日语了。"
    },
    {
     "ja": "おなかがすいてきた。",
     "zh": "我开始觉得饿了。"
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [
    {
     "id": "G0192",
     "diff": "てくる 指向说话人方向或至今的变化，ていく 指向未来或远去"
    }
   ],
   "common_errors": [
    {
     "wrong": "ちょっとコンビニに行ってきります。",
     "why": "「くる」的礼貌形是「きます」，不是「きります」",
     "fix": "ちょっとコンビニに行ってきます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아/어 오다",
   "ko_diff": "韩语 -아/어 오다 表靠近或持续至今，与 てくる 相近；但日语 てくる 还可表「顺路做某事再回来」，韩语需用 다녀오다 等动词。",
   "notes": "",
   "tags": [
    "change",
    "sequence"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0194",
   "pattern": "〜てしまう / 〜ちゃう",
   "meaning_zh": "…完了；不小心…；结果…",
   "connection": "动词て形 + しまう（口语缩约 ちゃう／じゃう）",
   "usage": "表示动作彻底完成，或对意外、遗憾的结果带有惋惜语气。",
   "register_note": "「しまう」口语书面均可；「ちゃう」限口语。",
   "examples": [
    {
     "ja": "電車に傘を忘れてしまいました。",
     "zh": "我把伞忘在电车上了。"
    },
    {
     "ja": "この本はおもしろくて、一晩で読んでしまった。",
     "zh": "这本书太有趣，我一晚上就读完了。"
    },
    {
     "ja": "あ、ケーキを全部食べちゃった。",
     "zh": "啊，我把蛋糕全吃光了。"
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [
    {
     "id": "G0195",
     "diff": "てしまう 强调完成或遗憾，ておく 强调预先准备"
    }
   ],
   "common_errors": [
    {
     "wrong": "電車に傘を忘れでしまいました。",
     "why": "忘れる 的て形是「忘れて」，不是「忘れで」",
     "fix": "電車に傘を忘れてしまいました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
