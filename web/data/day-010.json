     ]
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "読みてください。",
     "why": "読む 的て形是 読んで（拨音便），不是 読みて。",
     "fix": "読んでください。",
     "learner": "zh"
    },
    {
     "wrong": "読んでください です。",
     "why": "ください 已经是请求说法，后面不用再加 です。",
     "fix": "読んでください。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "request"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-아/어 주세요",
   "ko_diff": "-아/어 주세요 和 てください 都能直接提出请求；想更委婉可用 -아/어 주시겠어요? 对照 ていただけますか。",
   "ko_pron": "～테 쿠다사이"
  },
  {
   "id": "G0027",
   "pattern": "～て いる",
   "meaning_zh": "正在…／…着（结果状态）",
   "connection": "動詞て形 + いる",
   "usage": "进行、反复、结果状态；自动词他动词结果不同",
   "register_note": "ている 口语书面通用，进行与结果状态都常见。",
   "examples": [
    {
     "ja": "今、ご飯を食べています。",
     "zh": "正在吃饭。",
     "vocab_ids": [
      "V0022",
