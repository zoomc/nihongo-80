   "ko_pron": "〜사에〜바"
  },
  {
   "id": "G0139",
   "pattern": "〜こそ",
   "meaning_zh": "正是…；才是…",
   "connection": "名词 + こそ（可加「が」成「こそが」）",
   "usage": "突出焦点，常带「正是这一项」「这一次一定」的语气。",
   "register_note": "口语书面均可，常出现在致辞和标语。",
   "examples": [
    {
     "ja": "「いつもありがとう。」「いえ、こちらこそ。」",
     "zh": "“一直谢谢你。”“不，我才是。”"
    },
    {
     "ja": "今年こそ、たばこをやめるつもりだ。",
     "zh": "今年我一定要把烟戒掉。"
    },
    {
     "ja": "毎日の小さな努力こそが、大きな成功につながる。",
     "zh": "正是每天的小努力带来了巨大的成功。"
    }
   ],
   "prerequisites": [
    "G0080"
   ],
   "compare": [
    {
     "id": "G0137",
     "diff": "こそ 提示焦点，さえ 举极端例，二者虽都表强调但功能不同。"
    }
   ],
   "common_errors": [
    {
     "wrong": "毎日の小さな努力をこそが、大きな成功につながる。",
     "why": "こそ 可以和 が 连用，但不能叠在 を 后面再接 が。",
     "fix": "努力こそが",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-야말로",
   "ko_diff": "韩语「-야말로」与「こそ」几乎一致；但日语「こちらこそ」已成固定寒暄，韩语对应「저야말로」，礼貌度需注意。",
