 "grammar": [
  {
   "id": "G0043",
   "pattern": "～そうです（样态／传闻）",
   "meaning_zh": "看起来…／听说…",
   "connection": "样态：ます形词干/い形去い/な形词干 + そう；传闻：普通形 + そうです",
   "usage": "样态表肉眼推断，传闻表转述；两者接续不同，意义完全不同",
   "register_note": "そうだ 样态口语常见，传闻用法偏书面报道。",
   "examples": [
    {
     "ja": "雨が降りそうです。",
     "zh": "看起来要下雨。",
     "vocab_ids": [
      "V0096",
      "V0118"
     ]
    },
    {
     "ja": "明日は雨だそうです。",
     "zh": "听说明天有雨。",
     "vocab_ids": [
      "V0024",
      "V0096"
     ]
    }
   ],
   "prerequisites": [
    "G0019",
    "G0023"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "おいしいそうです（想表样态）",
     "why": "い形容词样态是 おいしそう（去 い）；おいしいそう 是传闻「听说好吃」",
     "fix": "おいしそうです。",
     "learner": "zh"
    },
    {
     "wrong": "雨だ 降りそうです",
     "why": "样态接ます形词干「降り」，不能接 雨だ",
     "fix": "雨が降りそうです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "tags": [
    "appearance",
    "hearsay"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-아/어 보이다 / -다고 하다",
   "ko_diff": "韩语样态用아/어 보이다，传闻用다고 하다，形态完全不同；日语そうだ须按接续分辨。"
  },
  {
   "id": "G0044",
   "pattern": "～ようだ / ～らしい",
   "meaning_zh": "好像…／似乎…（推测）",
   "connection": "普通形 + ようだ／らしい（名 + の + ようだ）",
   "usage": "ようだ 偏主观直感，らしい 偏传闻/典型特征；名词接 ようだ 要加 の",
   "register_note": "ようだ 偏书面或郑重，口语常用 みたい（G0061）。",
   "examples": [
