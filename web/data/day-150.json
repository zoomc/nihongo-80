 "grammar": [
  {
   "id": "G0186",
   "pattern": "〜かける",
   "meaning_zh": "…了一半；刚要…",
   "connection": "动词ます形词干 + かける；动词ます形词干 + かけの + 名词",
   "usage": "表动作做到一半或刚开始就中断。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "読みかけの本が、机の上に置いてある。",
     "zh": "桌上放着一本读到一半的书。"
    },
    {
     "ja": "彼女は何か言いかけたが、そのまま黙ってしまった。",
     "zh": "她话说到一半，又沉默了。"
    },
    {
     "ja": "この花は枯れかけていたが、水をやったら元気になった。",
     "zh": "这花本来有点枯萎，浇了水就精神了。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0185",
     "diff": "切る 表彻底做完，かける 表只做了一半，完成度相反。"
    }
   ],
   "common_errors": [
    {
     "wrong": "読みかけるの本が、机の上に置いてある。",
     "why": "修饰名词要用「〜かけの」，「かけるの」不合法。",
     "fix": "読みかけの本",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-다 말다",
   "ko_diff": "韩语「-다 말다」表“做到一半就停”，与「かける」对应；但日语还能表“刚开始、眼看要”，韩语要用「-려다」，含义更宽。",
