 "grammar": [
  {
   "id": "G0096",
   "pattern": "普通形 + はずがない",
   "meaning_zh": "不可能…；理应不会…",
   "connection": "動詞・い形普通形 + はずがない；な形容詞 + な／名詞 + の + はずがない",
   "usage": "根据事实/常识强烈否定某可能性；比单纯「ない」更有推断依据。",
   "examples": [
    {
     "ja": "彼が約束を忘れるはずがありません。",
     "zh": "他不可能忘记约定。",
     "vocab_ids": [
      "V0175",
      "V0152"
     ]
    },
    {
     "ja": "電車が止まっているので、今到着するはずがありません。",
     "zh": "电车停了，现在不可能到达。",
     "vocab_ids": [
      "V0060",
      "V0312"
     ]
    }
   ],
   "prerequisites": [
    "G0053",
    "G0023"
   ],
   "compare": [
    {
     "id": "G0053",
     "diff": "はずだ 是“应该会”；はずがない 是其强否定。"
    },
    {
     "id": "G0071",
     "diff": "わけがない 近义，但 はずがない 更强调“按情理推断”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "彼が来るはずがないでした。",
     "why": "はずがない 是现在否定，过去用「はずがありませんでした／はずがなかったです」；ないでした 不合法。",
     "fix": "彼が来るはずがありませんでした。",
     "learner": "zh"
    },
    {
     "wrong": "彼が来るはずがなくです。",
     "why": "なくです 不合法；否定句末用 ありません／ない。",
     "fix": "彼が来るはずがありません。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "plain-form",
    "inference",
    "negative"
   ],
   "register_note": "中性；口语也可「はずない」，书面用「はずがない」。",
   "review_status": "needs_review",
   "provenance": "self_reviewed",
   "source_ids": [
    "S000"
   ],
   "ko_equiv": "-(으)ㄹ 리가 없다",
   "ko_diff": "韩语ㄹ 리가 없다表绝不可能，推断依据强；与单纯否定안不同，同日语はずがない。"
  },
  {
   "id": "G0097",
   "pattern": "〜わけだ",
   "meaning_zh": "难怪…；也就是说…",
   "connection": "普通形 + わけだ；ナ形容词 + な + わけだ；名词 + という + わけだ",
   "usage": "由已知事实推出结论，常与「どうりで」呼应。",
   "register_note": "口语书面皆可；正式文书多说「〜ということだ」。",
   "examples": [
    {
     "ja": "三年も中国に住んでいたんですか。だから中国語が上手なわけですね。",
     "zh": "在中国住了三年啊。难怪你中文这么好。"
    },
    {
     "ja": "窓が全部開いている。どうりで寒いわけだ。",
     "zh": "窗户全开着。难怪这么冷。"
    },
    {
     "ja": "この本は三百ページだから、一日に二十ページ読めば、十五日で読み終わるわけだ。",
     "zh": "这本书三百页，一天读二十页的话，也就是十五天读完。"
    }
   ],
   "prerequisites": [
    "G0023",
    "G0059"
   ],
   "compare": [
    {
     "id": "G0098",
     "diff": "わけではない 是否定推论，わけだ 是肯定推论，方向相反。"
    }
   ],
   "common_errors": [
    {
     "wrong": "窓が全部開いている。どうりで寒いわけだです。",
     "why": "「わけだ」本身已是普通体断定，礼貌说法整体变成「わけです」，不能再叠「です」。",
     "fix": "…寒いわけですね。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-는 셈이다",
   "ko_diff": "韩语「-는 셈이다」侧重“算作某种结果”；日语「わけだ」更强调说话人由事实推导的过程，常带“原来如此”的领悟语气。",
