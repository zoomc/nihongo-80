  {
   "id": "G0124",
   "pattern": "〜的",
   "meaning_zh": "…上的；…式的",
   "connection": "名词 + 的な + 名词；名词 + 的に + 动词",
   "usage": "把名词转成形容词性，表性质、领域或立场。",
