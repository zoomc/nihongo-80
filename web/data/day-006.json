      "V0103"
     ]
    }
   ],
   "prerequisites": [
    "G0009"
   ],
   "compare": [
    {
     "id": "G0009",
     "diff": "へ 强调朝向，に 强调到达/归着；两者可换但语感不同"
    }
   ],
   "common_errors": [
    {
     "wrong": "学校へ 行きます（へ 读 he）",
     "why": "助词「へ」在此读 e，不读罗马字 he；中文无此音便",
     "fix": "学校へ行きます。（へ 读 e）",
     "learner": "zh"
    },
    {
     "wrong": "学校を 行きます。",
     "why": "移动方向用 へ/に，を 是宾语或经过",
