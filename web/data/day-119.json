 "grammar": [
  {
   "id": "G0150",
   "pattern": "〜とともに",
   "meaning_zh": "与…一起；随着…",
   "connection": "名词 + とともに；动词辞书形 + とともに",
   "usage": "表示共同进行，或两件事同时、相应地发生。",
   "register_note": "书面语为主，正式文章和致辞常用。",
   "examples": [
    {
     "ja": "社長は、社員とともに新しい工場の完成を喜んだ。",
     "zh": "社长和员工一起为新工厂落成而高兴。"
    },
    {
     "ja": "経済の発展とともに、人々の生活も大きく変わった。",
     "zh": "随着经济发展，人们的生活也发生了巨大变化。"
    },
    {
     "ja": "ベルが鳴るとともに、学生たちは教室を飛び出した。",
     "zh": "铃声一响，学生们就冲出了教室。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0149",
     "diff": "とともに 可表“共同、同时”，につれて 只表程度随之变化。"
    }
   ],
   "common_errors": [
    {
     "wrong": "ベルが鳴ったとともに、学生たちは教室を飛び出した。",
     "why": "「とともに」表同时发生接辞书形，不接た形。",
     "fix": "ベルが鳴るとともに",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-와 함께",
   "ko_diff": "韩语「-와 함께」只表“一起”；日语「とともに」还能表“随着、同时”，韩语后者要用「-에 따라」。",
   "notes": "",
   "tags": [
    "simultaneity",
    "change",
    "formal"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0151",
   "pattern": "〜たびに",
   "meaning_zh": "每当…就…",
   "connection": "动词辞书形 + たびに；名词 + の + たびに",
   "usage": "表示每次发生前项，后项也随之发生。",
   "register_note": "口语书面均可，书面感稍强。",
   "examples": [
    {
     "ja": "この写真を見るたびに、大学時代を思い出す。",
     "zh": "每次看到这张照片，就想起大学时代。"
    },
    {
     "ja": "姉は出張のたびに、お土産を買ってきてくれる。",
     "zh": "姐姐每次出差都会给我带特产。"
    },
    {
     "ja": "この川は、大雨が降るたびにあふれて、道が通れなくなる。",
     "zh": "这条河每次下大雨都会泛滥，路都过不去。"
    }
   ],
   "prerequisites": [
    "G0086"
   ],
   "compare": [
    {
     "id": "G0152",
     "diff": "たびに 强调“每次发生都…”，ごとに 还可表等间隔、逐个。"
    }
   ],
   "common_errors": [
    {
     "wrong": "この写真を見たたびに、大学時代を思い出す。",
     "why": "「たびに」前接辞书形（或名词+の），不接た形。",
     "fix": "見るたびに",
     "learner": "zh"
    }
   ],
