 "grammar": [
  {
   "id": "G0227",
   "pattern": "〜のに（purpose）",
   "meaning_zh": "用于…；做…需要",
   "connection": "动词辞书形 + のに（用途・所需）；名词 + に",
   "usage": "表示某物的用途，或做某事所需的时间、金钱，常与「便利／かかる」搭配。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "このかばんは旅行に行くのに便利です。",
     "zh": "这个包旅行时很方便。"
    },
    {
     "ja": "家から駅まで歩くのに二十分かかります。",
     "zh": "从家走到车站需要二十分钟。"
    },
    {
     "ja": "引っ越しするのに十万円ぐらいかかった。",
     "zh": "搬家花了大约十万日元。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0232",
     "diff": "のに 接用途或所需，ために 接目的"
    }
   ],
   "common_errors": [
    {
     "wrong": "家から駅まで歩くのに二十分をかかります。",
     "why": "かかる 表示所需时间时用「二十分かかる」，不用 を",
     "fix": "家から駅まで歩くのに二十分かかります。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-는 데",
   "ko_diff": "韩语 -는 데 与用途、所需的 のに 对应（걷는 데 20분 걸린다）；日语 のに 与转折的 のに 同形，韩语则用 데 区分。",
   "notes": "",
   "tags": [
    "purpose"
   ],
