 "grammar": [
  {
   "id": "G0179",
   "pattern": "〜ますように",
   "meaning_zh": "但愿…；希望…",
   "connection": "动词ます形词干 + ように（ませんように 表否定祈愿）",
   "usage": "向神佛或命运祈愿，也用于祈盼他人顺利。",
   "register_note": "书面、祈愿场合；日常对话中少见。",
   "examples": [
    {
     "ja": "試験に合格できますように。",
     "zh": "希望考试合格。"
    },
    {
     "ja": "明日の遠足、雨が降りませんように。",
     "zh": "希望明天郊游别下雨。"
    },
    {
     "ja": "家族みんなが元気で過ごせますように。",
     "zh": "愿家人健康平安。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0064",
     "diff": "ようにする 是“设法做到”，ますように 是祈愿，形式相近功能完全不同。"
    }
   ],
   "common_errors": [
    {
     "wrong": "試験に合格できますようにです。",
     "why": "「ますように」已是结句形式，不能再加「です」。",
     "fix": "合格できますように",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-기를 바랍니다",
   "ko_diff": "韩语祈愿用「-기를 바랍니다」，需有完整主句；日语「ますように」可单独成句，主语省略，形式更短。",
