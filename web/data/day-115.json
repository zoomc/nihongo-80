 "grammar": [
  {
   "id": "G0142",
   "pattern": "〜にしては",
   "meaning_zh": "照…来说；以…而言",
   "connection": "动词普通形／名词 + にしては；名词化的 の + にしては 也可用",
   "usage": "表示实际情况与从前提推想的预期不符，含意外感。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "初めて作ったにしては、このケーキはよくできている。",
     "zh": "第一次做来说，这个蛋糕做得相当好。"
    },
    {
     "ja": "彼は小学生にしては、ずいぶん難しい言葉を知っている。",
     "zh": "他作为小学生知道不少难词。"
    },
    {
     "ja": "十月にしては、今日はずいぶん暑いね。",
     "zh": "都十月了，今天可真热。"
    }
   ],
   "prerequisites": [
    "G0082"
   ],
   "compare": [
    {
     "id": "G0174",
     "diff": "にしては 依“身份、时间”等前提判断，わりに 依“程度、数量”比例判断。"
    }
   ],
   "common_errors": [
    {
     "wrong": "初めてのにしてはは上手です。",
     "why": "にしては已有は，不叠加第二个は。",
     "fix": "初めてにしては上手です。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-치고는",
   "ko_diff": "韩语「-치고는」与「にしては」几乎一一对应，都含“出乎预料”；但日语多接身份、时间名词。",
   "notes": "",
   "tags": [
    "contrast",
    "concession"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "needs_review",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0143",
   "pattern": "〜にしても",
   "meaning_zh": "即使…；就算是…",
   "connection": "动词普通形／名词 + にしても；名词化的 の + にしても 也可用",
   "usage": "先承认前项成立，再指出后项仍不受影响，含不满或让步。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "忙しかったにしても、電話一本ぐらいできたでしょう。",
     "zh": "就算再忙，至少也能打个电话吧。"
    },
    {
     "ja": "冗談にしても、そんな言い方はひどいよ。",
     "zh": "就算是开玩笑，那种说法也太过分了。"
    },
    {
     "ja": "引っ越すにしても、来年の春以降になると思います。",
     "zh": "就算要搬家，我想也要等到明年春天以后。"
    }
   ],
   "prerequisites": [
    "G0025"
   ],
   "compare": [
    {
     "id": "G0168",
     "diff": "としても 是纯粹的“即使”，にしても 常带“就算…也该…”的责备。"
    }
   ],
   "common_errors": [
    {
     "wrong": "雨にしてもも、出かけます。",
     "why": "にしても已有も，不叠加第二个も。",
     "fix": "雨にしても、出かけます。",
     "learner": "zh"
    }
   ],
