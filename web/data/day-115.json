 "grammar": [
  {
   "id": "G0139",
   "pattern": "〜こそ",
   "meaning_zh": "正是…；才是…",
   "connection": "名词 + こそ（可加「が」成「こそが」）",
   "usage": "强烈提示焦点，表“正是这个，不是别的”。",
   "register_note": "口语书面均可，常出现在致辞和标语。",
   "examples": [
    {
     "ja": "「いつもありがとう。」「いえ、こちらこそ。」",
     "zh": "“一直谢谢你。”“不，我才是。”"
    },
    {
     "ja": "今年こそ、たばこをやめるつもりだ。",
     "zh": "今年我一定要把烟戒掉。"
    },
    {
     "ja": "毎日の小さな努力こそが、大きな成功につながる。",
     "zh": "正是每天的小努力带来了巨大的成功。"
    }
   ],
   "prerequisites": [
    "G0080"
   ],
   "compare": [
    {
     "id": "G0137",
     "diff": "こそ 提示焦点，さえ 举极端例，二者虽都表强调但功能不同。"
    }
   ],
   "common_errors": [
    {
     "wrong": "毎日の小さな努力をこそが、大きな成功につながる。",
     "why": "「こそ」可与「が」连用成「こそが」，但不能叠在「を」后再接「が」。",
     "fix": "努力こそが",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-야말로",
   "ko_diff": "韩语「-야말로」与「こそ」几乎一致；但日语「こちらこそ」已成固定寒暄，韩语对应「저야말로」，礼貌度需注意。",
   "notes": "",
   "tags": [
    "emphasis"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0140",
   "pattern": "〜として",
   "meaning_zh": "作为…；以…身份",
   "connection": "名词 + として；名词 + としての + 名词",
   "usage": "表示身份、资格、立场或名义。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "兄は、エンジニアとしてアメリカの会社で働いている。",
     "zh": "哥哥作为工程师在美国公司工作。"
    },
    {
     "ja": "この町は、温泉地として有名です。",
     "zh": "这个镇作为温泉地很有名。"
    },
    {
     "ja": "社会人としての責任を持って行動してください。",
     "zh": "请以社会人的责任感行事。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0141",
     "diff": "として 表身份资格，にとって 表“从某人角度看”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "兄は、エンジニアのとしてアメリカの会社で働いている。",
     "why": "「として」直接接名词，不加「の」；修饰名词时才用「としての」。",
     "fix": "エンジニアとして",
     "learner": "zh"
    }
   ],
