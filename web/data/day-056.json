  {
   "id": "G0208",
   "pattern": "〜つもり",
   "meaning_zh": "打算…；计划…",
   "connection": "动词辞书形／动词ない形 + つもりだ",
   "usage": "表示说话人已形成的意图，否定形表示不打算做。",
   "register_note": "口语与书面通用；疑问句可用于询问对方打算。",
   "examples": [
    {
     "ja": "夏休みは北海道を旅行するつもりです。",
     "zh": "暑假我打算去北海道旅行。"
    },
    {
     "ja": "今日はお酒を飲まないつもりです。",
     "zh": "今天我不打算喝酒。"
    },
    {
     "ja": "大学を出たら、どうするつもりですか。",
     "zh": "大学毕业后你打算做什么？"
    }
   ],
   "prerequisites": [
    "G0023",
    "G0022"
   ],
   "compare": [
    {
     "id": "G0209",
     "diff": "つもり 是个人意图，予定 是已定好的日程"
    }
   ],
   "common_errors": [
    {
     "wrong": "夏休みは北海道を旅行しつもりです。",
     "why": "つもり 前接辞书形，不是ます形去ます",
     "fix": "夏休みは北海道を旅行するつもりです。",
     "learner": "zh"
    }
   ],
