 "listening": false,
 "grammar": [
  {
   "id": "G0117",
   "pattern": "〜によって / 〜による",
   "meaning_zh": "由…；由于…；因…而异",
   "connection": "名词 + によって；名词 + による + 名词",
   "usage": "表被动句的动作主体、原因手段，或“依…而不同”。",
   "register_note": "书面语为主，正式文章常用。",
   "examples": [
    {
     "ja": "この橋は、有名な建築家によって設計された。",
     "zh": "这座桥是由著名建筑师设计的。"
    },
    {
     "ja": "台風による被害は、まだ正確には分かっていない。",
     "zh": "台风造成的损失还没有准确查明。"
    },
    {
     "ja": "国によって、食事のマナーはずいぶん違う。",
     "zh": "餐桌礼仪因国家不同而差别很大。"
    }
   ],
   "prerequisites": [
    "G0055"
   ],
   "compare": [
    {
     "id": "G0118",
     "diff": "によって 表主体、原因或依据，によると 只表传闻来源。"
    }
   ],
   "common_errors": [
    {
     "wrong": "台風によるの被害は大きかった。",
     "why": "说 による被害 或 によっての被害，不要说 によるの被害。",
     "fix": "台風による被害は大きかった。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "…에 따라 / … 때문에 / …에 의해",
   "ko_diff": "역에 따라 다르다 对照 駅によって違う；비 때문에 지연되다 对照 雨によって遅れる；被动句中的行为者还可对应 …에 의해。",
   "notes": "",
   "tags": [
    "means",
    "reason",
    "voice"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "needs_review",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜니요떼 / 〜니요루"
  },
  {
   "id": "G0118",
   "pattern": "〜によると / 〜によれば",
   "meaning_zh": "据…说",
   "connection": "来源（名词） + によると／によれば，后面陈述该来源提供的信息。",
   "usage": "引出消息来源，句末接「そうだ／らしい／ということだ」。",
   "register_note": "口语书面均可，「によれば」更书面。",
   "examples": [
    {
     "ja": "天気予報によると、週末は大雪になるそうだ。",
     "zh": "据天气预报，周末会下大雪。"
    },
    {
     "ja": "ニュースによれば、事故の原因はまだ分かっていないらしい。",
     "zh": "据新闻说，事故原因似乎还不清楚。"
    },
    {
     "ja": "姉の話によると、あのレストランは予約がないと入れないということだ。",
     "zh": "听姐姐说，那家餐厅不预约进不去。"
    }
   ],
   "prerequisites": [
    "G0043"
   ],
   "compare": [
    {
     "id": "G0117",
     "diff": "によると 引出传闻来源，によって 表主体、原因或依据。"
    }
   ],
   "common_errors": [
    {
     "wrong": "天気予報によって、週末は大雪になるそうだ。",
     "why": "消息来源用 によると／によれば；によって 是手段或原因。",
     "fix": "天気予報によると",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-에 따르면",
   "ko_diff": "일기 예보에 따르면 对照 天気予報によると。后句常用 そうだ、とのことだ，也可用陈述句报告客观数据，无须每次都添传闻句末。",
   "notes": "",
   "tags": [
    "hearsay"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜니요루토 / 〜니요레바"
  },
  {
   "id": "G0119",
   "pattern": "〜ばかりでなく",
   "meaning_zh": "不仅…而且…",
   "connection": "普通形 + ばかりでなく；ナ形容词 + な + ばかりでなく；名词 + ばかりでなく",
   "usage": "追加同类或更高层次的事项，后项多带「も」。",
   "register_note": "书面语色彩，演讲和文章中常见。",
   "examples": [
    {
     "ja": "この映画は子どもばかりでなく、大人も楽しめる。",
     "zh": "这部电影不仅孩子爱看，大人也能享受。"
    },
    {
     "ja": "新しいスマホは画面が大きいばかりでなく、電池も長持ちする。",
     "zh": "新手机不仅屏幕大，电池也耐用。"
    },
    {
     "ja": "運動は体にいいばかりでなく、ストレスを減らす効果もある。",
     "zh": "运动不仅对身体好，还有减压的效果。"
    }
   ],
   "prerequisites": [
    "G0093"
   ],
   "compare": [
    {
     "id": "G0120",
     "diff": "ばかりでなく 与 だけでなく 意思相近，前者更书面、更郑重。"
    }
   ],
   "common_errors": [
    {
     "wrong": "新しいスマホは画面が大きばかりでなく、電池も長持ちする。",
     "why": "い形容词要保留词尾 い：大きいばかりでなく。",
     "fix": "画面が大きいばかりでなく",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-뿐만 아니라",
   "ko_diff": "韩语「-뿐만 아니라」与日语几乎完全对应；但日语后项习惯加「も」，韩语可省，容易漏掉「も」。",
   "notes": "",
