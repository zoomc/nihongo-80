  {
   "id": "G0181",
   "pattern": "〜向き / 〜向け",
   "meaning_zh": "适合…；面向…",
   "connection": "名词 + 向き（だ／の／な）；名词 + 向け（だ／の／に）",
   "usage": "「向き」表“适合某类人”，「向け」表“以某类人为对象制作”。",
   "register_note": "口语书面均可，商品说明常见。",
   "examples": [
    {
     "ja": "この料理は作り方が簡単なので、初心者向きだ。",
     "zh": "这道菜做法简单，适合初学者。"
    },
    {
     "ja": "この雑誌は、若い女性向けに作られている。",
     "zh": "这本杂志是面向年轻女性制作的。"
    },
    {
     "ja": "子ども向けの番組だが、大人が見ても十分楽しめる。",
     "zh": "这是给孩子看的节目，大人看也很有趣。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0140",
     "diff": "として 表身份资格，向け 表“以…为对象”，都接名词但功能不同。"
    }
   ],
   "common_errors": [
    {
     "wrong": "これは初心者向きのな本です。",
     "why": "名词前可用「向きの」或「向きな」，不叠用「のな」。",
     "fix": "これは初心者向きの本です。",
     "learner": "zh"
    }
   ],
