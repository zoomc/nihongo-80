 "grammar": [
  {
   "id": "G0252",
   "pattern": "〜に（place of existence）",
   "meaning_zh": "在…（存在场所）",
   "connection": "名词（场所）+ に + ある／いる",
   "usage": "表示人或物存在的场所，有生命用 いる，其余用 ある。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "机の上に辞書があります。",
     "zh": "桌子上有一本词典。"
    },
    {
     "ja": "姉は東京に住んでいます。",
     "zh": "姐姐住在东京。"
    },
    {
     "ja": "猫は今どこにいますか。",
     "zh": "猫现在在哪里？"
    }
   ],
   "prerequisites": [
    "G0014"
   ],
   "compare": [
    {
     "id": "G0256",
     "diff": "に 表存在场所，で 表动作发生场所"
    }
   ],
   "common_errors": [
    {
     "wrong": "机の上で辞書があります。",
     "why": "存在句的场所用 に，で 表动作发生场所",
     "fix": "机の上に辞書があります。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "에（존재 장소）",
   "ko_diff": "韩语 에 表存在场所，与 に 对应；但韩语 있다 不区分有无生命，日语必须区分 ある／いる。",
