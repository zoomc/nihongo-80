 "grammar": [
  {
   "id": "G0007",
   "pattern": "が（主语／新信息／存在主体）",
   "meaning_zh": "…（主语/新信息/存在主体/能力对象）",
   "connection": "名詞 + が + 動詞／形容詞",
   "usage": "表主语、新信息、疑问词主语、存在主体、能力/好恶对象",
   "register_note": "が 口语书面通用；疑问词作主语时必须用 が。",
   "examples": [
    {
     "ja": "猫がいます。",
     "zh": "有猫。",
     "vocab_ids": [
      "V0098"
     ]
    },
    {
     "ja": "誰が来ますか。",
     "zh": "谁来？",
     "vocab_ids": [
      "V0104"
     ]
    }
   ],
   "prerequisites": [
    "G0001"
   ],
   "compare": [
    {
     "id": "G0001",
     "diff": "は 提示主题/旧信息，が 提示主语/新信息/排他"
    }
   ],
   "common_errors": [
    {
     "wrong": "私がは学生です。",
     "why": "は 提示主题，が 标出新信息，两个不能同时用。自我介绍说 私は学生です；回答“谁是学生”才说 私が学生です。",
     "fix": "私は学生です。",
     "learner": "zh"
    },
    {
     "wrong": "猫をいます。",
     "why": "人或动物“存在”用 が＋います，不能用宾格 を。",
     "fix": "猫がいます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "particle"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "이/가",
   "ko_diff": "이/가 与 が 都能聚焦是谁、是什么，也能标存在主体。自我介绍通常先定话题，用 저는／私は；回应「谁是学生」时可用 제가／私が。",
   "ko_pron": "가"
  },
  {
   "id": "G0008",
   "pattern": "を（宾语／移动经过）",
   "meaning_zh": "把…（标宾语）",
   "connection": "名词 + を + 他动词（对象）；场所 + を + 移动动词（路线或离开的起点）",
   "usage": "标动作直接宾语；也表移动经过的场所（空を飛ぶ）",
   "register_note": "を 口语书面通用；移动经过用法偏书面描写。",
   "examples": [
    {
     "ja": "ご飯を食べます。",
     "zh": "吃饭。",
     "vocab_ids": [
      "V0051",
      "V0101"
     ]
    }
   ],
   "prerequisites": [
    "G0001"
   ],
   "compare": [
    {
     "id": "G0009",
     "diff": "を 标动作对象，に 标归着点/时点；「去学校」易混成 学校を行く"
    }
   ],
   "common_errors": [
    {
     "wrong": "公園が通ります。",
     "why": "通る（穿过）这类移动动词，经过的路线用 を。它虽然是自动词，也照样接 を。",
     "fix": "公園を通ります。",
     "learner": "zh"
    },
    {
     "wrong": "学校を 行きます。",
     "why": "行く 表方向用 に／へ；を 只表示“穿过、经过”，如 道を歩く。",
     "fix": "学校へ行きます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "particle"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "을/를",
   "ko_diff": "ご飯を食べる 对应 밥을 먹다，公園を通る 对应 공원을 지나가다。公園で遊ぶ 对应 공원에서 놀다，此时公园是动作发生的场所。",
   "ko_pron": "오"
  },
  {
   "id": "G0009",
   "pattern": "に（时点／归着点／存在场所／对象）",
   "meaning_zh": "在／于／向…",
   "connection": "名詞 + に",
   "usage": "表时间点、动作归着点、存在场所、动作对象",
   "register_note": "に 多义，口语书面通用，需按动词搭配记忆。",
   "examples": [
    {
     "ja": "七時に起きます。",
     "zh": "七点起床。",
     "vocab_ids": [
      "V0015",
      "V0119"
     ]
    },
    {
     "ja": "学校に行きます。",
     "zh": "去学校。",
     "vocab_ids": [
      "V0039",
      "V0103"
     ]
    }
   ],
   "prerequisites": [
    "G0001"
   ],
   "compare": [
    {
     "id": "G0010",
     "diff": "に 表存在/归着点，で 表动作发生的场所；「在图書館学习」用 で 不用 に"
    }
   ],
   "common_errors": [
    {
     "wrong": "七時で起きます。",
     "why": "具体时间点（七時、三時）后面用 に。今日、毎朝 这类相对时间通常不加。",
     "fix": "七時に起きます。",
     "learner": "zh"
    },
    {
     "wrong": "学校に 勉強します。",
     "why": "动作发生的地点用 で；に 只表示“存在在哪”或“到达哪”。",
     "fix": "学校で勉強します。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "particle"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "에 / 에게",
   "ko_diff": "七時に起きる 对应 일곱 시에 일어나다；部屋にいる 对应 방에 있다；友達に送る 对应 친구에게 보낸다。日语多用同一个 に。",
   "ko_pron": "니"
  }
