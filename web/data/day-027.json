 "grammar": [
  {
   "id": "G0043",
   "pattern": "～そうです（样态／传闻）",
   "meaning_zh": "看起来…／听说…",
   "connection": "样态：ます形词干/い形去い/な形词干 + そう；传闻：普通形 + そうです",
   "usage": "样态表肉眼推断，传闻表转述；两者接续不同，意义完全不同",
   "register_note": "そうだ 样态口语常见，传闻用法偏书面报道。",
   "examples": [
    {
     "ja": "雨が降りそうです。",
     "zh": "看起来要下雨。",
     "vocab_ids": [
      "V0096",
      "V0118"
     ]
    },
    {
     "ja": "明日は雨だそうです。",
     "zh": "听说明天有雨。",
     "vocab_ids": [
      "V0024",
      "V0096"
     ]
    }
   ],
   "prerequisites": [
    "G0019",
    "G0023"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "おいしいそうです",
     "why": "い形容词表“看起来…”要去掉词尾 い：おいしそう。留着 い 就变成传闻“听说好吃”。",
     "fix": "おいしそうです。",
     "learner": "zh"
    },
    {
     "wrong": "雨だ 降りそうです",
     "why": "样态接ます形词干（降りそう），前面用 雨が，不用 雨だ。",
     "fix": "雨が降りそうです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "tags": [
    "appearance",
