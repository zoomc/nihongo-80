 "grammar": [
  {
   "id": "G0215",
   "pattern": "〜せられる / 〜させられる",
   "meaning_zh": "被迫做…",
   "connection": "五段动词未然形 + せられる（部分动词常缩约为 される）；一段动词未然形 + させられる",
   "usage": "表示不情愿地被迫做某事，含有受害或无奈的语气。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "子どものころ、母に毎日ピアノを練習させられた。",
     "zh": "小时候母亲每天逼我练钢琴。"
    },
    {
     "ja": "駅で三十分も待たされました。",
     "zh": "我在车站被迫等了三十分钟。"
    },
    {
     "ja": "会社の飲み会で歌を歌わされた。",
     "zh": "公司聚会上我被逼着唱了歌。"
    }
   ],
   "prerequisites": [
    "G0049",
    "G0050"
   ],
   "compare": [
    {
     "id": "G0214",
     "diff": "使役受身 是被迫做，使役 是让别人做"
    }
   ],
   "common_errors": [
    {
     "wrong": "母に野菜を食べさせられますた。",
     "why": "礼貌过去形为「食べさせられました」。",
     "fix": "母に野菜を食べさせられました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-게 시킴을 당하다",
   "ko_diff": "韩语没有专门的使役被动词尾，通常说 -하도록 강요받다 或 -게 되다；日语有固定的使役受身活用，语气更强调被迫。",
   "notes": "",
   "tags": [
    "voice",
    "conjugation"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "needs_review",
