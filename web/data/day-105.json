 "grammar": [
  {
   "id": "G0295",
   "pattern": "〜ものか",
   "pattern_kana": "",
   "meaning_zh": "绝不会…",
   "ko_equiv": "할 리가 있나 / 절대로 안 하겠다",
   "connection": "动词辞书形／い形容词＋ものか；な形容词＋な＋ものか",
   "usage": "",
   "ko_diff": "强烈反问用来否定或拒绝，口语也说「もんか」。「二度と行くものか」对应「다시는 가나 봐라」。",
   "examples": [
    {
     "ja": "あんな失礼な店には、二度と行くものか。",
     "en": "No way am I ever going to that rude shop again.",
     "zh": "那家店那么无礼，我绝不会再去。"
    },
    {
     "ja": "一度や二度失敗したくらいで、諦めるもんか。",
     "en": "As if I'd give up just because I failed once or twice.",
     "zh": "我怎么可能因为失败了一两次就放弃？"
    }
   ],
   "tags": [
    "negation",
    "emphasis",
    "emotion"
   ],
   "jlpt": "N2",
   "prerequisites": [],
   "compare": [],
   "common_errors": [
    {
     "wrong": "あんな店には二度と行かないものか。",
     "why": "ものか 本身已表强烈否定，前面用肯定形 行くものか，不要再加 ない。",
     "fix": "あんな店には二度と行くものか。",
     "learner": "ko"
    }
   ],
   "source_ids": [],
   "source_ref": "mono-ka",
   "review_status": "ai_draft",
   "provenance": "openjlpt_adapted",
   "ko_pron": "〜모노카"
  },
  {
   "id": "G0296",
   "pattern": "〜ものなら",
   "pattern_kana": "",
   "meaning_zh": "如果能…的话",
   "ko_equiv": "할 수만 있다면",
   "connection": "动词可能形＋ものなら",
   "usage": "",
   "ko_diff": "表达难以实现的愿望时，先把日语动词改成可能形，如 行く→行ける。另有「失敗しようものなら」的不同构式，表示一旦发生就会有严重后果。",
   "examples": [
    {
     "ja": "できるものなら、学生時代に戻ってもう一度やり直したい。",
     "en": "If only I could, I'd go back to my student days and do it all over again.",
     "zh": "如果真有可能，我想回到学生时代从头再来一次。"
    },
    {
     "ja": "行けるものなら行きたいが、その日はどうしても仕事を休めない。",
     "en": "I'd go if I could, but I just can't take that day off work.",
     "zh": "要是去得了我也想去，可那天实在没法请假。"
    }
   ],
   "tags": [
    "condition",
    "wish"
   ],
   "jlpt": "N2",
   "prerequisites": [],
   "compare": [],
   "common_errors": [
    {
     "wrong": "行くものなら行きたい",
     "why": "「如果能去」要用可能形：行けるものなら。",
     "fix": "行けるものなら行きたい",
     "learner": "ko"
    }
   ],
   "source_ids": [],
   "source_ref": "mono-nara",
   "review_status": "ai_draft",
   "provenance": "openjlpt_adapted",
   "ko_pron": "〜모노나라"
  }
 ],
