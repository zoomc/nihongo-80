 "listening": false,
 "grammar": [
  {
   "id": "G0010",
   "pattern": "で（动作场所／手段／材料／原因）",
   "meaning_zh": "在…／用…／因为…",
   "connection": "名詞 + で",
   "usage": "表动作场所、手段/工具/交通、材料、原因",
   "register_note": "で 口语书面通用，表场所、手段、材料、原因。",
   "examples": [
    {
     "ja": "図書館で勉強します。",
     "zh": "在图书馆学习。",
     "vocab_ids": [
      "V0044",
      "V0082"
     ]
    },
    {
     "ja": "電車で行きます。",
     "zh": "坐电车去。",
     "vocab_ids": [
      "V0060",
      "V0103"
     ]
    }
   ],
   "prerequisites": [
    "G0001"
   ],
   "compare": [
    {
     "id": "G0009",
     "diff": "で 强调「在此做某事」，に 强调「存在于此/到达于此」"
    }
   ],
   "common_errors": [
    {
     "wrong": "図書館に勉強します。",
     "why": "“在图书馆学习”是动作地点，用 で。说“图书馆里有书”才用 に。",
     "fix": "図書館で勉強します。",
     "learner": "zh"
    },
    {
     "wrong": "電車を 行きます。",
     "why": "交通工具用 で（電車で行く）；乗る 才用 に（電車に乗る）。",
     "fix": "電車で行きます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "particle"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "에서 / (으)로",
   "ko_diff": "도서관에서 공부하다 的 에서 和 자전거로 가다 的 로 在日语都用 で。存在地点换成 に：図書館に本がある。",
   "ko_pron": "데"
  },
  {
   "id": "G0011",
   "pattern": "へ（移动方向）",
   "meaning_zh": "往／向…",
   "connection": "名詞 + へ + 移動動詞",
   "usage": "表移动方向，读 e 不读 he；侧重方向，に 侧重到达点",
   "register_note": "へ 偏书面或郑重，口语更多用 に。",
   "examples": [
    {
     "ja": "明日、学校へ行きます。",
     "zh": "明天去学校。",
     "vocab_ids": [
      "V0024",
      "V0039",
      "V0103"
     ]
    }
   ],
   "prerequisites": [
    "G0009"
   ],
   "compare": [
    {
     "id": "G0009",
     "diff": "へ 强调朝向，に 强调到达/归着；两者可换但语感不同"
    }
   ],
   "common_errors": [
    {
     "wrong": "学校へ 行きます（へ 读 he）",
     "why": "助词「へ」读 e，不读 he。句子里看到 へ，就当“诶”读。",
     "fix": "学校へ行きます。（へ 读 e）",
     "learner": "zh"
    },
    {
     "wrong": "学校を 行きます。",
     "why": "方向用 へ／に；を 是宾语或经过，不能表方向。",
     "fix": "学校へ行きます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "particle"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "(으)로",
   "ko_diff": "東へ進む 对应 동쪽으로 가다。方向助词 へ 写法固定、这里读 e；在 行く 等动词前也可用 に，突出目的地。",
   "pattern_kana": "〜え",
   "ko_pron": "〜에"
  },
  {
   "id": "G0012",
   "pattern": "と（并列／共同／引用）",
   "meaning_zh": "和…／与…（一起）；「…」地",
   "connection": "名詞 + と + 名詞／動詞；引用从句 + と + 思う/言う",
   "usage": "完全并列、共同动作对象、引用内容",
   "register_note": "と 表并列、共同、引用，口语书面通用。",
   "examples": [
    {
     "ja": "友達と映画を見ます。",
     "zh": "和朋友看电影。",
     "vocab_ids": [
      "V0076",
      "V0099",
      "V0105"
     ]
    }
   ],
   "prerequisites": [
    "G0001"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "友達とに映画を見ます。",
     "why": "“和朋友一起”只用 と，不加 に。友達も 是“朋友也”，意思变了。",
     "fix": "友達と映画を見ます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "particle"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "needs_review",
   "provenance": "self_reviewed",
   "ko_equiv": "와/과 / 하고 / (이)라고",
   "ko_diff": "并列可对照 와/과、하고，共同动作可对照 하고 함께。引述时韩语按句型选 -다고、-(이)라고、-냐고 等，日语引述的标记是 と。",
   "ko_pron": "토"
  }
