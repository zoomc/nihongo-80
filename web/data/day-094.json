 "grammar": [
  {
   "id": "G0100",
   "pattern": "〜わけにはいかない",
   "meaning_zh": "不能…；不便…",
   "connection": "动词辞书形 + わけにはいかない；动词ない形 + わけにはいかない",
   "usage": "因社会常识、道义或立场而不能做某事，与能力无关。",
   "register_note": "口语书面均可；商务场合常用「わけにはまいりません」。",
   "examples": [
    {
     "ja": "明日は大事な会議があるから、休むわけにはいかない。",
     "zh": "明天有重要会议，不能请假。"
    },
    {
     "ja": "友達に頼まれたことだから、断るわけにはいかなかった。",
     "zh": "是朋友托付的事，不好拒绝。"
    },
    {
     "ja": "招待されたのだから、パーティーに行かないわけにはいかない。",
     "zh": "既然被邀请了，就不能不去参加。"
    }
   ],
   "prerequisites": [
    "G0071"
   ],
   "compare": [
    {
     "id": "G0099",
     "diff": "わけがない 是“不可能”，わけにはいかない 是“想做/该做却不能做”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "明日は大事な会議があるから、休まわけにはいかない。",
     "why": "「わけにはいかない」前接辞书形「休む」或ない形「休まない」，「休ま」不是合法形式。",
     "fix": "休むわけにはいかない",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-ㄹ 수는 없다",
   "ko_diff": "韩语「-ㄹ 수는 없다」偏“能力或情况不允许”；日语「わけにはいかない」强调社会道义上的“不能”，含无奈。",
   "notes": "",
   "tags": [
    "prohibition",
    "obligation"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0101",
   "pattern": "〜ものだ",
   "meaning_zh": "本来就…；应当…；过去常…",
   "connection": "动词辞书形/た形 + ものだ；い形容词 + ものだ；ナ形容词 + な + ものだ",
   "usage": "讲普遍规律或应当如此，也用「た形 + ものだ」回忆过去。",
   "register_note": "略带说教或感慨，书面口语皆可。",
   "examples": [
    {
     "ja": "子どものころは、この川でよく泳いだものだ。",
     "zh": "小时候常在这条河里游泳。"
    },
    {
     "ja": "新しい環境に慣れるには、時間がかかるものだ。",
     "zh": "适应新环境本来就需要时间。"
    },
    {
     "ja": "目上の人には敬語を使うものだ。",
     "zh": "对长辈本来就该用敬语。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0068",
     "diff": "ばかり 表反复或限定，ものだ（た形）表怀旧回忆，语气更感慨。"
    }
   ],
   "common_errors": [
