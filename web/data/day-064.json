 "grammar": [
  {
   "id": "G0223",
   "pattern": "〜なら",
   "meaning_zh": "如果是…的话",
   "connection": "动词普通形／い形容词／な形容词／名词 + なら",
   "usage": "承接对方已知或提到的话题，就此事给出判断、建议或条件。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "京都へ行くなら、秋がいいですよ。",
     "zh": "如果你要去京都，秋天最合适。"
    },
    {
     "ja": "パソコンのことなら、兄に聞くといいよ。",
     "zh": "电脑方面的事，问我哥哥就好。"
    },
    {
     "ja": "そんなに眠いなら、今日は早く寝たら？",
     "zh": "那么困的话，今天早点睡怎么样？"
    }
   ],
   "prerequisites": [
    "G0025"
   ],
   "compare": [
    {
     "id": "G0221",
     "diff": "なら 承接已知话题，ば 是一般假定"
    }
   ],
   "common_errors": [
    {
     "wrong": "京都へ行くなれば、秋がいいですよ。",
     "why": "なら 前接普通形，动词不用「なれば」",
     "fix": "京都へ行くなら、秋がいいですよ。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-(이)라면 / -다면",
   "ko_diff": "韩语 -(이)라면 与名词搭配，-다면 与动词、形容词搭配；日语 なら 前接形式不随词性变化，接续更简单。",
   "notes": "",
   "tags": [
    "condition",
    "topic"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0224",
   "pattern": "〜と（conditional）",
   "meaning_zh": "一…就…；如果…就…",
   "connection": "动词辞书形／ない形／い形容词 + と；な形容词・名词 + だ + と",
