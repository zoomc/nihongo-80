     "zh": "暑假我要去北海道。"
    },
    {
     "ja": "来週、国へ帰ります。",
     "zh": "下周回国。"
    },
    {
     "ja": "どこへ行きますか。",
     "zh": "你去哪里？"
    }
   ],
   "prerequisites": [
    "G0011"
   ],
