 "grammar": [
  {
   "id": "G0066",
   "pattern": "V辞書形 / Vない形 + ことが ある",
   "meaning_zh": "有时会…／有时不…（泛指倾向）",
   "connection": "動詞 辞書形／ない形 + ことが ある；ある 可变形（ことがあります／あった）",
   "usage": "表示偶尔发生、有时会那样；与 〜たことがある（G0042，曾经做过）时态语义都不同",
   "register_note": "ことがある 口语书面通用，表偶尔发生。",
   "examples": [
    {
     "ja": "忙しくて、昼ご飯を忘れることがあります。",
     "zh": "忙起来有时会忘了吃午饭。",
     "vocab_ids": [
      "V0131",
      "V0152"
     ]
    },
    {
     "ja": "彼はたまに遅刻することがあります。",
     "zh": "他偶尔会迟到。",
     "vocab_ids": [
      "V0074",
      "V0165"
     ]
    }
   ],
   "prerequisites": [
    "G0023",
    "G0022",
    "G0042"
   ],
   "compare": [
    {
     "id": "G0042",
     "diff": "〜たことがある 是「曾经做过（至今为止的经验）」用 た形；〜ことがある 是「有时会（习惯/倾向）」用 辞书形"
    }
   ],
   "common_errors": [
    {
     "wrong": "北海道へ行ったことがあります。（想说有时会去）",
     "why": "「有时会去」须用 辞书形 行くことがある；たことがある 是「去过」，中文「有时」直译易混",
     "fix": "北海道へ行くことがあります。",
     "learner": "zh"
    },
    {
     "wrong": "忘れることがありますでした。",
     "why": "「あります」已含礼貌体，不能再叠 でした；中文无时态变化易堆敬体",
     "fix": "忘れることがありました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "plain-form",
    "habit",
    "experience"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-곤 하다 / -기도 하다",
   "ko_diff": "韩语곤 하다表过去反复习惯，기도 하다表有时；日语ことがある现在形表偶尔，时态限制不同。"
  },
  {
   "id": "G0067",
   "pattern": "V意志形 + と 思う / と する",
   "meaning_zh": "打算…／正要…、试图…",
   "connection": "動詞 意志形（五段 お段+う／一段 よう／する→しよう／来る→こよう）+ と 思う／と する",
   "usage": "(よ)うと思う 表说话人打算（现在/将来）；(よ)うとする 表正要开始做或尝试做",
   "register_note": "ようと思う/とする 口语书面通用，表打算或正要。",
   "examples": [
    {
     "ja": "日曜日は映画を見ようと思っています。",
     "zh": "周日打算看电影。",
     "vocab_ids": [
      "V0037",
      "V0099",
      "V0105"
     ]
    },
    {
     "ja": "出かけようとしたら、雨が降ってきました。",
     "zh": "正要出门时下起雨来了。",
     "vocab_ids": [
      "V0103",
      "V0118",
      "V0096"
     ]
    }
   ],
   "prerequisites": [
    "G0023",
    "G0036",
    "G0032"
   ],
   "compare": [
    {
     "id": "G0036",
     "diff": "〜と 思う 引用「觉得/认为」；〜(よ)うと思う 引用的是自己的「打算」"
    },
    {
     "id": "G0032",
     "diff": "〜ましょう 是邀对方一起做；〜(よ)うと思う 是自己内心的打算"
    }
   ],
   "common_errors": [
    {
     "wrong": "映画を見ると思います。",
     "why": "「打算看」须用意志形 見よう；用辞书形 見る 变成「觉得会看」，中文「想看」直译错",
     "fix": "映画を見ようと思います。",
     "learner": "zh"
    },
    {
     "wrong": "きようと思っています。",
     "why": "カ変「来る」意志形是 こよう，不是 きよう；中文按字形推读音错",
     "fix": "こようと思っています。",
     "learner": "zh"
    }
   ],
