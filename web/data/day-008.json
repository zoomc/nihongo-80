  {
   "id": "G0020",
   "pattern": "て形",
   "meaning_zh": "动词て形（连接/中顿/请求基础）",
   "connection": "五段：词尾 う／つ／る→って，む／ぶ／ぬ→んで，く→いて，ぐ→いで，す→して，行く→行って；一段去 る + て；来る→来て（きて），する→して。",
   "usage": "表中顿、并列、请求（てください）、进行（ている）等",
   "register_note": "て形口语书面通用，是请求、进行、中顿的基础。",
   "examples": [
    {
     "ja": "本を読んでいます。",
     "zh": "正在读书。",
     "vocab_ids": [
      "V0080",
      "V0113"
     ]
    },
    {
     "ja": "食べてください。",
     "zh": "请吃。",
     "vocab_ids": [
      "V0101"
     ]
    }
   ],
   "prerequisites": [
    "G0019"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "名前を書きてください。",
     "why": "書く 的て形是 書いて（く→いて）；行く 是唯一例外，变 行って。",
     "fix": "名前を書いてください。",
     "learner": "zh"
    },
    {
     "wrong": "食べって。",
     "why": "一段动词去掉 る 直接加 て（食べて）；促音便（って）只给五段用。",
     "fix": "食べて。",
     "learner": "zh"
    },
    {
     "wrong": "飲みて。",
     "why": "む／ぶ／ぬ 结尾变拨音便：飲む→飲んで，不是 飲みて。",
     "fix": "飲んで。",
     "learner": "zh"
    }
   ],
