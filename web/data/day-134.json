 "grammar": [
  {
   "id": "G0170",
   "pattern": "〜って",
   "meaning_zh": "说是…；所谓…",
   "connection": "普通形 + って；名词 + って（表话题）",
   "usage": "口语引用、转述传闻，或提出话题加以说明。",
   "register_note": "仅限口语。",
   "examples": [
    {
     "ja": "彼女、今日は来られないって。",
     "zh": "她说今天来不了。"
    },
    {
     "ja": "駅前に新しいカフェができたんだって。行ってみない？",
     "zh": "听说车站前开了家新咖啡店，去看看？"
    },
    {
     "ja": "「ふろしき」って何ですか。",
     "zh": "“风吕敷”是什么？"
    }
   ],
   "prerequisites": [
    "G0012"
   ],
   "compare": [
    {
     "id": "G0171",
     "diff": "ということだ 是书面的正式转述，って 是口语缩略，语气随意。"
    }
   ],
   "common_errors": [
    {
     "wrong": "彼女、今日は来られないだって。",
     "why": "「って」直接接普通形「来られない」，不能加「だ」。",
     "fix": "来られないって",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-대",
   "ko_diff": "韩语「-대」是口语转述缩略，与「って」很像；但日语「って」还能当话题助词（「〜って何？」），韩语要用「-는」。",
