  },
  {
   "id": "G0204",
   "pattern": "〜みたい",
   "meaning_zh": "好像…；像…一样",
   "connection": "动词普通形／い形容词／な形容词词干／名词 + みたいだ（口语）",
   "usage": "口语中根据迹象推测，或表示比喻、举例。",
   "register_note": "口语；正式场合用「ようだ」。",
   "examples": [
    {
     "ja": "隣の部屋に誰か来たみたい。",
     "zh": "隔壁房间好像有人来了。"
    },
    {
     "ja": "今日の彼女は元気がないみたいだね。",
     "zh": "她今天好像没什么精神。"
    },
    {
     "ja": "このケーキ、お店のケーキみたい！",
     "zh": "这个蛋糕简直像店里卖的一样！"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
