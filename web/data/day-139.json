 "grammar": [
  {
   "id": "G0178",
   "pattern": "〜っけ",
   "meaning_zh": "…来着？（回忆确认）",
   "connection": "动词普通形、名词或句末表达等 + っけ；「だっけ／だったっけ」也常用。口语では「何時からっけ」等の省略もある。",
   "usage": "用于向自己或对方确认记不清的事，带自言自语感。",
   "register_note": "仅限口语，亲近关系。",
   "examples": [
    {
     "ja": "あれ、会議って何時からだっけ？",
     "zh": "咦，会议是几点开始来着？"
    },
    {
     "ja": "すみません、お名前、何とおっしゃいましたっけ。",
     "zh": "不好意思，您贵姓来着？"
    },
    {
     "ja": "子どものころ、よくこの公園で遊んだっけ。",
     "zh": "小时候常在这个公园玩来着。"
    }
   ],
   "prerequisites": [
    "G0021"
   ],
   "compare": [
    {
     "id": "G0045",
     "diff": "でしょう 是推测，っけ 是“记不清、想确认”，功能不同。"
    }
   ],
   "common_errors": [
    {
     "wrong": "会議は何時からだっけです。",
     "why": "口语的「だっけ」已经用于句末，不再叠加です。",
     "fix": "会議は何時からだっけ。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-였지?",
   "ko_diff": "韩语没有专门的回忆确认句尾，常用「-였지?」；日语「っけ」还可用た形回忆过去，韩语要靠「-곤 했지」补足。",
   "notes": "「何時からっけ」は口语省略として使われる。「何時からだっけ」も自然。",
   "tags": [
    "question",
    "recollection",
    "casual"
   ],
