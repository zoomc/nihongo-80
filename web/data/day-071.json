 "listening": false,
 "grammar": [
  {
   "id": "G0132",
   "pattern": "〜うちに",
   "meaning_zh": "趁着…；在…过程中",
   "connection": "动词辞书形/ている/ない形 + うちに；い形容词 + うちに；ナ形容词 + な + うちに；名词 + の + うちに",
   "usage": "表示在某状态持续期间做某事，或期间不知不觉发生变化。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "若いうちに、いろいろな国を旅行したほうがいい。",
     "zh": "趁年轻多去几个国家旅行比较好。"
    },
    {
     "ja": "スープが冷めないうちに、どうぞ召し上がってください。",
     "zh": "请趁汤还没凉快喝吧。"
    },
    {
     "ja": "音楽を聞いているうちに、いつの間にか眠ってしまった。",
     "zh": "听着音乐，不知不觉就睡着了。"
    }
   ],
   "prerequisites": [
    "G0088"
   ],
   "compare": [
    {
     "id": "G0131",
     "diff": "うちに 强调“期限之前”或“不知不觉”，まま 强调状态原样不变。"
    }
   ],
   "common_errors": [
    {
     "wrong": "若いのうちに、いろいろな国を旅行したほうがいい。",
     "why": "い形容词直接接 うちに，不加 の。",
     "fix": "若いうちに",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "…하는 동안에 / …하기 전에 / …할 때 얼른",
   "ko_diff": "韩语「-는 동안에」只表时间范围；日语「うちに」还含“趁还没变、赶在期限前”的语感。",
   "notes": "",
   "tags": [
    "time",
    "simultaneity"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜우치니"
  },
  {
   "id": "G0133",
   "pattern": "〜ところに / 〜ところへ / 〜ところを",
   "meaning_zh": "正当…的时候",
   "connection": "动词辞书形/ている/た形 + ところに／ところへ／ところを",
   "usage": "表示某动作正要发生或正在进行时，被另一事打断。",
   "register_note": "口语书面均可；「ところを」多接被动，表“被撞见”。",
   "examples": [
    {
     "ja": "出かけようとしているところに、友達から電話がかかってきた。",
     "zh": "正要出门时，朋友打来了电话。"
    },
    {
     "ja": "みんなで君の話をしているところへ、ちょうど君が来た。",
     "zh": "我们正说你呢，你就来了。"
    },
    {
     "ja": "授業中にスマホを見ているところを、先生に見られてしまった。",
     "zh": "上课看手机被老师看见了。"
    }
   ],
   "prerequisites": [
    "G0069"
   ],
   "compare": [
    {
     "id": "G0069",
     "diff": "ところだ 结句表时态阶段，ところに/を 是接续成分，引出打断的事。"
    }
   ],
   "common_errors": [
    {
     "wrong": "出かけるのところに、友達から電話がかかってきた。",
     "why": "ところ 前接动词不加 の；のところ 只接名词。",
     "fix": "出かけるところに",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "…하려는 참에 / …하는 장면을",
   "ko_diff": "出かけるところに電話が来た 可对照 나가려는 참에 전화가 왔다。盗んでいるところを見られた 则是 훔치는 모습을 들켰다，由 を 标出被看见的场面。",
   "notes": "",
   "tags": [
    "time"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜토코로니 / 〜토코로헤 / 〜토코로오"
  },
  {
   "id": "G0134",
   "pattern": "〜ば〜ほど",
   "meaning_zh": "越…越…",
   "connection": "动词ば形 + 同一动词辞书形 + ほど；い形容词ければ + い形容词 + ほど；ナ形容词なら + ナ形容词な + ほど",
   "usage": "表示随着前项程度加深，后项程度也随之变化。",
   "register_note": "口语书面均可，谚语中常见。",
   "examples": [
    {
     "ja": "日本語は、勉強すればするほど面白くなる。",
     "zh": "日语越学越有意思。"
    },
    {
     "ja": "スマホの画面は大きければ大きいほど見やすいが、持ち歩くのは大変だ。",
     "zh": "手机屏幕越大越容易看，但带着走很麻烦。"
    },
    {
     "ja": "部屋が静かなら静かなほど、よく眠れる。",
     "zh": "房间越安静，睡得越好。"
    }
   ],
   "prerequisites": [
    "G0079"
   ],
   "compare": [
    {
     "id": "G0135",
     "diff": "ほど 单表程度，ば〜ほど 表“程度随之递增”的联动关系。"
    }
   ],
   "common_errors": [
    {
     "wrong": "日本語は、勉強するすればするほど面白くなる。",
     "why": "前项用ば形 すれば，するすれば 不成立。",
     "fix": "勉強すればするほど",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-면 -ㄹ수록",
   "ko_diff": "-을수록 一次就能表达「越…越…」。日语可用 すればするほど，也可只用 するほど。前一种结构更便于看清同一动作反复套用。",
   "notes": "",
