 "grammar": [
  {
   "id": "G0171",
   "pattern": "〜ということだ",
   "meaning_zh": "据说…；也就是说…",
   "connection": "普通形 + ということだ",
   "usage": "转述听到的消息，或把前项归结为“也就是说…”。",
   "register_note": "口语书面均可，书面更常见。",
   "examples": [
    {
     "ja": "駅員さんの話では、事故のため電車は一時間ほど止まるということです。",
     "zh": "据站务员说，因为事故电车要停一小时左右。"
    },
    {
     "ja": "「申し込みは明日までです。」「じゃあ、今日中に書類を準備しなければならないということですね。」",
     "zh": "“申请截止到明天。”“也就是说今天必须把材料准备好。”"
    },
    {
     "ja": "全員が賛成したということは、この計画で進めてもいいということだ。",
     "zh": "大家都赞成，也就是说可以按这个方案推进。"
    }
   ],
   "prerequisites": [
    "G0036"
   ],
   "compare": [
    {
     "id": "G0169",
     "diff": "ということだ 更确定、更正式，とか 更含糊随意。"
    }
   ],
   "common_errors": [
    {
     "wrong": "電車は一時間ほど止まるというです。",
     "why": "「というです」不是合法形式，转述要用「ということだ／ということです」。",
     "fix": "止まるということです",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-다는 것이다",
   "ko_diff": "韩语「-다는 것이다」与「ということだ」对应；但日语同一形式兼表传闻和“也就是说”，韩语要靠不同形式区分。",
