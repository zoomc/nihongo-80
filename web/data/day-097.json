 "grammar": [
  {
   "id": "G0103",
   "pattern": "〜もの / 〜もん",
   "meaning_zh": "因为…嘛（撒娇辩解）",
   "connection": "普通形 + もの／もん（多与「だって」呼应）",
   "usage": "口语中为自己辩解或撒娇，孩子和女性用得较多。",
   "register_note": "仅限亲密的日常口语，正式场合不用。",
   "examples": [
    {
     "ja": "「どうして食べないの？」「だって、ピーマン嫌いなんだもん。」",
     "zh": "“怎么不吃？”“因为我不喜欢青椒嘛。”"
    },
    {
     "ja": "一人で行けるよ。もう子どもじゃないもん。",
     "zh": "我一个人能去，我已经不是小孩了嘛。"
    },
    {
     "ja": "ケーキ、全部食べちゃった。だって、すごくおいしかったんだもん。",
     "zh": "蛋糕我全吃光了。因为实在太好吃了嘛。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0091",
     "diff": "ものだから 是较完整的说明理由，もん 更短、更撒娇，多用于辩解。"
    }
   ],
   "common_errors": [
    {
     "wrong": "本日は欠席いたします。熱があるもんですから。",
     "why": "「もん」是亲昵撒娇的口语辩解，正式致歉场合语体明显不符。",
     "fix": "熱がございますので、欠席いたします。",
     "learner": "zh",
     "register_ack": true
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-니까(요)",
   "ko_diff": "韩语「-니까(요)」只表原因，不带撒娇色彩；日语「もん」几乎总带“我也有苦衷”的辩解语气，只用于亲近关系。",
   "notes": "",
   "tags": [
    "reason",
    "casual"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0104",
   "pattern": "〜ものだから / 〜もので",
   "meaning_zh": "因为…；由于…",
   "connection": "普通形 + ものだから；ナ形容词 + な + ものだから；名词 + な + ものだから",
   "usage": "为解释或道歉而强调原因，理由多为客观情况。",
   "register_note": "口语为主；「もので」更书面、更委婉。",
   "examples": [
    {
     "ja": "道がすごく混んでいたものだから、約束の時間に間に合わなかった。",
     "zh": "路上堵得厉害，所以没能赶上约定的时间。"
    },
    {
     "ja": "すみません、急いでいたもので、書類を持ってくるのを忘れてしまいました。",
     "zh": "对不起，我当时赶时间，忘了带文件。"
    },
    {
     "ja": "初めての海外旅行だったものだから、見るものすべてが珍しかった。",
     "zh": "那是第一次出国旅行，看到什么都觉得新鲜。"
    }
   ],
   "prerequisites": [
    "G0091"
   ],
   "compare": [
    {
     "id": "G0037",
     "diff": "から/ので 是普通因果，ものだから 带明显的辩解、道歉语气。"
    }
   ],
   "common_errors": [
    {
     "wrong": "教室が静かものだから、つい眠くなった。",
     "why": "ナ形容词接「ものだから」要加「な」，「静かものだから」不合法。",
     "fix": "静かなものだから",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-는 통에",
   "ko_diff": "韩语「-는 통에」多引出坏结果；日语「ものだから」不限好坏，重点在“说明并求得谅解”，语气更软。",
