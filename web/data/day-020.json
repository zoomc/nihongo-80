 "grammar": [
  {
   "id": "G0250",
   "pattern": "〜に（time）",
   "meaning_zh": "在…（某时点）",
   "connection": "名词（时间）+ に",
   "usage": "表示动作发生的具体时点，常与年月日、星期、时刻搭配。",
   "register_note": "口语与书面通用；「今日／明日／毎日」等相对时间后不加 に。",
   "examples": [
    {
     "ja": "毎朝7時に起きます。",
     "zh": "每天早上七点起床。"
    },
    {
     "ja": "日曜日に友達と会います。",
     "zh": "星期天和朋友见面。"
    },
    {
     "ja": "8月に国へ帰ります。",
     "zh": "八月回国。"
    }
   ],
   "prerequisites": [
    "G0009"
   ],
   "compare": [
    {
     "id": "G0251",
     "diff": "に 表时点或到达点，へ 强调方向"
    }
   ],
   "common_errors": [
    {
     "wrong": "明日に友達と会います。",
     "why": "「明日」等相对时间词后一般不加 に",
     "fix": "明日、友達と会います。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "에（시간）",
   "ko_diff": "韩语 에 与 に 对应，但韩语「내일」后也可加 에；日语相对时间词后一般不加 に，需注意。",
