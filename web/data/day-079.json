 "grammar": [
  {
   "id": "G0155",
   "pattern": "〜おかげで",
   "meaning_zh": "多亏…；托…的福",
   "connection": "动词普通形/い形容词/ナ形容词な/名词の + おかげで",
   "usage": "表示因某原因得到好结果，含感谢语气。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "先輩が手伝ってくれたおかげで、仕事が早く終わった。",
     "zh": "多亏前辈帮忙，工作很快就做完了。"
    },
    {
     "ja": "薬が効いたおかげで、熱が下がった。",
     "zh": "多亏药效，烧退了。"
    },
    {
     "ja": "駅が近いおかげで、雨の日も楽に通勤できる。",
     "zh": "幸好离车站近，下雨天通勤也轻松。"
    }
   ],
   "prerequisites": [
    "G0054"
   ],
   "compare": [
    {
     "id": "G0156",
     "diff": "おかげで 引出好结果并表感谢，せいで 引出坏结果并含责备。"
    }
   ],
   "common_errors": [
    {
     "wrong": "駅が近いのおかげで、雨の日も楽に通勤できる。",
     "why": "い形容词直接接「おかげで」，只有名词才加「の」。",
     "fix": "駅が近いおかげで",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-덕분에",
   "ko_diff": "덕분에 和 おかげで 通常都表示受益，如 덕분에 무사히 도착했어요／おかげで無事に着きました。语境明确时两者也能反讽。",
   "notes": "",
   "tags": [
    "reason",
    "result",
    "emotion"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜오카게데"
  },
  {
   "id": "G0156",
   "pattern": "〜せいで",
   "meaning_zh": "都怪…；因为…",
   "connection": "动词普通形/い形容词/ナ形容词な/名词の + せいで",
   "usage": "表示因某原因导致坏结果，常含责备或推卸语气。",
   "register_note": "口语为主，正式场合少用。",
   "examples": [
    {
     "ja": "電車が遅れたせいで、面接に遅刻してしまった。",
     "zh": "因为电车晚点，面试迟到了。"
    },
    {
     "ja": "夜中に犬がうるさかったせいで、ほとんど眠れなかった。",
     "zh": "都怪半夜狗叫得厉害，几乎没睡着。"
    },
    {
     "ja": "私が道を間違えたせいで、みんなを待たせてしまった。",
     "zh": "是我带错路，让大家等了很久。"
    }
   ],
   "prerequisites": [
    "G0054"
   ],
   "compare": [
    {
     "id": "G0155",
     "diff": "せいで 只引坏结果、含责难，おかげで 引好结果、含感谢。"
    }
   ],
   "common_errors": [
    {
     "wrong": "電車が遅れたのせいで、面接に遅刻してしまった。",
     "why": "动词直接接「せいで」，只有名词才加「の」。",
     "fix": "遅れたせいで",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-때문에",
   "ko_diff": "韩语「-때문에」中性，好坏结果都可用；日语「せいで」专用于坏结果并带责难，不能随便替换「おかげで」。",
   "notes": "",
   "tags": [
    "reason",
    "result",
    "criticism"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜세이데"
  },
  {
   "id": "G0157",
   "pattern": "〜たとたん / 〜たとたんに",
   "meaning_zh": "刚一…就…",
   "connection": "动词た形 + とたん（に）",
   "usage": "表示前项刚发生，后项就出乎意料地出现。",
   "register_note": "口语书面均可，后项多为说话人意外的事。",
   "examples": [
    {
     "ja": "立ち上がったとたんに、めまいがした。",
     "zh": "刚一起身就头晕。"
    },
    {
     "ja": "家を出たとたん、雨が降り出した。",
     "zh": "刚一出门就下起雨来。"
    },
    {
     "ja": "その歌手がステージに現れたとたん、会場から大きな拍手が起こった。",
     "zh": "那位歌手刚一登台，会场就响起热烈掌声。"
    }
   ],
   "prerequisites": [
    "G0021"
   ],
   "compare": [
    {
     "id": "G0163",
     "diff": "てはじめて 是“做了之后才明白”，たとたん 是“刚一…就发生”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "家を出るとたん、雨が降り出した。",
     "why": "「とたん」前接た形「出た」，「出るとたん」不合法。",
     "fix": "家を出たとたん",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-자마자",
   "ko_diff": "韩语「-자마자」只表紧接发生；日语「とたん」还要求后项是意外、非意志的事，不能接自己的有意动作。",
