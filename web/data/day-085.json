    "formal",
    "source"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-에 근거해 / -을 바탕으로 / -대로",
   "ko_diff": "韩语에 근거해表依据、을 바탕으로表以…为基础、대로表按照，与日语三形基本对应。"
  },
  {
   "id": "G0079",
   "pattern": "V ば形 + 同一動詞 辞書形 + ほど",
   "meaning_zh": "越…越…",
   "connection": "動詞 条件形(ば) + 同じ動詞 辞書形 + ほど；い形 ければ＋い形＋ほど；な形 なら＋な形＋ほど",
   "usage": "前后同词重复，表成正比变化；常与 ますます 呼应",
   "register_note": "ば…ほど 偏书面说明，口语也用。",
   "examples": [
    {
