 "grammar": [
  {
   "id": "G0241",
   "pattern": "〜はずだ",
   "meaning_zh": "应该…；按理说…",
   "connection": "动词普通形／い形容词 + はずだ；な形容词+な／名词+の + はずだ",
   "usage": "根据事实或逻辑推断理应如此，语气较有把握。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "荷物は明日届くはずです。",
     "zh": "包裹应该明天到。"
    },
    {
     "ja": "彼は十年もアメリカに住んでいたから、英語が上手なはずだ。",
     "zh": "他在美国住了十年，英语应该很好。"
    },
    {
     "ja": "おかしいな。かぎはここに置いたはずなのに。",
     "zh": "奇怪，我明明把钥匙放在这里的。"
    }
   ],
   "prerequisites": [
    "G0053"
   ],
   "compare": [
    {
     "id": "G0242",
     "diff": "はずだ 是理应如此，はずがない 是绝不可能"
    }
   ],
   "common_errors": [
    {
     "wrong": "彼は十年もアメリカに住んでいたから、英語が上手のはずだ。",
     "why": "な形容词接 はずだ 要用「な」，不是「の」",
     "fix": "彼は十年もアメリカに住んでいたから、英語が上手なはずだ。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-(으)ㄹ 것이다",
   "ko_diff": "韩语 -(으)ㄹ 것이다 既可表推测也可表意志，日语 はずだ 只表基于根据的推断，不含意志；两者不能完全对应。",
   "notes": "",
   "tags": [
    "conjecture"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0096",
   "pattern": "普通形 + はずがない",
   "meaning_zh": "不可能…；理应不会…",
   "connection": "動詞・い形普通形 + はずがない；な形容詞 + な／名詞 + の + はずがない",
   "usage": "根据事实/常识强烈否定某可能性；比单纯「ない」更有推断依据。",
   "examples": [
    {
     "ja": "彼が約束を忘れるはずがありません。",
     "zh": "他不可能忘记约定。",
     "vocab_ids": [
      "V0175",
      "V0152"
     ]
    },
    {
     "ja": "電車が止まっているので、今到着するはずがありません。",
     "zh": "电车停了，现在不可能到达。",
     "vocab_ids": [
      "V0060",
      "V0312"
     ]
    }
   ],
   "prerequisites": [
    "G0053",
    "G0023"
   ],
   "compare": [
    {
     "id": "G0053",
     "diff": "はずだ 是“应该会”；はずがない 是其强否定。"
    },
    {
     "id": "G0071",
     "diff": "わけがない 近义，但 はずがない 更强调“按情理推断”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "彼が来るはずがないでした。",
     "why": "はずがない 是现在否定，过去用「はずがありませんでした／はずがなかったです」；ないでした 不合法。",
     "fix": "彼が来るはずがありませんでした。",
     "learner": "zh"
    },
    {
     "wrong": "彼が来るはずがなくです。",
     "why": "なくです 不合法；否定句末用 ありません／ない。",
     "fix": "彼が来るはずがありません。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "plain-form",
    "inference",
    "negative"
   ],
   "register_note": "中性；口语也可「はずない」，书面用「はずがない」。",
