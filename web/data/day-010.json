  {
   "id": "G0018",
   "pattern": "な形容词 否定／过去／で",
   "meaning_zh": "不…／曾…／而…（な形变形）",
   "connection": "静か→静かではない／静かだった／静かで",
   "usage": "词干 + ではない(否定)、だった(过去简体)、で(中顿)",
   "register_note": "な形容词否定/过去口语用 じゃない/だった，书面用 ではない/であった。",
   "examples": [
    {
     "ja": "ここは静かではありません。",
     "zh": "这里不安静。",
     "vocab_ids": [
      "V0136"
     ]
    },
    {
     "ja": "昨日は元気でした。",
     "zh": "昨天很精神。",
     "vocab_ids": [
      "V0025",
      "V0135"
     ]
    }
   ],
   "prerequisites": [
    "G0016"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "静かくないです。",
     "why": "把い形容词的 〜くない 套到な形容词；中文「不安静」无词类提示",
     "fix": "静かではありません。",
     "learner": "zh"
    },
    {
     "wrong": "元気だったです。",
     "why": "「だった」已含过去，再叠加 です 成双重礼貌/时态",
     "fix": "元気でした。",
     "learner": "zh"
    }
   ],
