 "grammar": [
  {
   "id": "G0244",
   "pattern": "〜かどうか",
   "meaning_zh": "是否…",
   "connection": "动词普通形／い形容词／な形容词／名词 + かどうか",
   "usage": "把是非疑问句嵌入句中，表示不确定或需要确认。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "明日行けるかどうか、まだ分かりません。",
     "zh": "明天能不能去，我还不知道。"
    },
    {
     "ja": "この服が似合うかどうか、ちょっと着てみます。",
     "zh": "这件衣服合不合适，我试穿一下。"
    },
    {
     "ja": "そのレストランがおいしいかどうか、友達に聞いてみよう。",
     "zh": "那家餐厅好不好吃，问问朋友吧。"
    }
   ],
   "prerequisites": [
    "G0058"
   ],
   "compare": [
    {
     "id": "G0245",
     "diff": "かどうか 用于是非疑问，か 用于含疑问词的疑问"
    }
   ],
   "common_errors": [
    {
     "wrong": "明日行けるかどうかを、まだ分かりません。",
     "why": "分かる 的对象用 が 或直接提示，不用 を",
     "fix": "明日行けるかどうか、まだ分かりません。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-인지 아닌지",
   "ko_diff": "韩语 -인지 아닌지 与 かどうか 对应；但日语 かどうか 不能与疑问词同用，韩语 인지 아닌지 的限制相同，需注意。",
   "notes": "",
   "tags": [
    "question"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0245",
   "pattern": "〜か（embedded question）",
   "meaning_zh": "（嵌入）什么…、哪里…",
   "connection": "疑问词 + …普通形 + か",
   "usage": "把含疑问词的问句嵌入句中作宾语或主语，句末不用疑问助词。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "会議が何時に始まるか、教えてください。",
     "zh": "请告诉我会议几点开始。"
    },
    {
     "ja": "どこで財布をなくしたか、覚えていません。",
     "zh": "我不记得在哪里丢了钱包。"
    },
    {
     "ja": "誰が窓を割ったか、知っていますか。",
     "zh": "你知道是谁打破了窗户吗？"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0244",
     "diff": "か 接疑问词构成嵌入疑问，かどうか 用于是非疑问"
    }
   ],
   "common_errors": [
    {
     "wrong": "会議が何時に始まるかどうか、教えてください。",
     "why": "何時 是疑问词，只能用「か」，不能再用「かどうか」",
     "fix": "会議が何時に始まるか、教えてください。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-인지",
   "ko_diff": "韩语 -인지 与嵌入疑问的 か 对应，但韩语疑问词位置较自由；日语嵌入句必须用普通形，且句末不再加 か。",
