    {
     "ja": "どこで財布をなくしたか、覚えていません。",
     "zh": "我不记得在哪里丢了钱包。"
    },
    {
     "ja": "誰が窓を割ったか、知っていますか。",
     "zh": "你知道是谁打破了窗户吗？"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
