 "grammar": [
  {
   "id": "G0090",
   "pattern": "Vた形 + ところで",
   "meaning_zh": "即使…也（不会有预期结果）",
   "connection": "動詞た形 + ところで；后项多为否定或无意义的结果",
   "usage": "表示即使前项成立，后项也不会改变；常与「無駄だ／変わらない／〜ない」呼应。",
   "examples": [
    {
     "ja": "今更謝ったところで、間に合いません。",
     "zh": "事到如今再道歉也来不及了。",
     "vocab_ids": [
      "V0166"
     ]
    },
    {
     "ja": "何度説明したところで、彼は分からないでしょう。",
     "zh": "即使说明多少次，他也不会明白吧。",
     "vocab_ids": [
      "V0170",
      "V0124"
     ]
    }
   ],
   "prerequisites": [
    "G0021",
    "G0023"
   ],
   "compare": [
    {
     "id": "G0075",
     "diff": "のに 是“明明…却”带不满；ところで 是“即使…也没用”，后项多否定。"
    }
   ],
   "common_errors": [
    {
     "wrong": "何度説明するところで、彼は理解しないでしょう。",
     "why": "ところで（即使）接た形，不接辞书形；中文“即使说明”直译用原形。",
     "fix": "何度説明したところで、彼は理解しないでしょう。",
     "learner": "zh"
    },
    {
     "wrong": "今更謝るたところで、間に合いません。",
     "why": "た形是「謝った」，不是「謝るた」；中文按原形硬加た。",
     "fix": "今更謝ったところで、間に合いません。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "ta-form",
    "concession",
    "negative"
   ],
   "register_note": "书面/口语均可；语气偏消极。",
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "source_ids": [
    "S000"
   ],
   "ko_equiv": "-아/어도 / -더라도",
   "ko_diff": "韩语让步用아/어도，强调用더라도；日语ところで后项必为否定性结果，韩语无此限制。"
  },
  {
   "id": "G0091",
   "pattern": "普通形 + ものだから / もので",
   "meaning_zh": "因为…（所以…）；由于…",
   "connection": "動詞・い形 普通形 + ものだから；な形・名詞 + な/だ + ものだから；もので 更书面",
   "usage": "用于说明原因，常带辩解/道歉语气；后项多为自己的行为或请求，不用于客观叙述自然现象。",
   "examples": [
    {
     "ja": "朝寝坊したものだから、電車に遅れました。",
     "zh": "因为睡过头，所以没赶上电车。",
     "vocab_ids": [
      "V0060",
      "V0165"
     ]
    },
    {
     "ja": "日本語が分からないものですから、ゆっくり話してください。",
     "zh": "因为我不懂日语，请说慢一点。",
     "vocab_ids": [
      "V0081",
      "V0114"
     ]
    }
   ],
   "prerequisites": [
    "G0023",
    "G0037"
   ],
   "compare": [
    {
     "id": "G0037",
     "diff": "から/ので 是普通因果；ものだから 带主观辩解/道歉，语气更强。"
    }
   ],
   "common_errors": [
    {
     "wrong": "忙しいだものだから、行けません。",
     "why": "い形「忙しい」后不能加 だ；ものだから 直接接普通形。中文“因为忙”直译容易保留“是”。",
     "fix": "忙しいものだから、行けません。",
     "learner": "zh"
    },
    {
     "wrong": "忙しいなものだから、行けません。",
     "why": "い形「忙しい」后不加 な；な 只接な形/名词。",
     "fix": "忙しいものだから、行けません。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "plain-form",
    "reason",
    "excuse"
   ],
   "register_note": "口语中常用于解释/辩解；客观因果用 から/ので。",
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "source_ids": [
    "S000"
   ],
   "ko_equiv": "-는 바람에 / -기 때문에",
   "ko_diff": "韩语辩解多用는 바람에(多坏事)或기 때문에；日语ものだから带撒娇式辩解，韩语靠语调体现。"
  }
 ],
