  {
   "id": "G0255",
   "pattern": "〜へ",
   "meaning_zh": "往…；朝…",
   "connection": "名词（场所／方向）+ へ（读作 e）",
   "usage": "表示移动的方向，常与行く、来る、帰る等搭配。",
   "register_note": "口语与书面通用；书面语中 へ 更常见。",
   "examples": [
    {
     "ja": "夏休みに北海道へ行きます。",
     "zh": "暑假我要去北海道。"
    },
    {
     "ja": "来週、国へ帰ります。",
     "zh": "下周回国。"
    },
    {
     "ja": "どこへ行きますか。",
     "zh": "你去哪里？"
    }
   ],
   "prerequisites": [
    "G0011"
   ],
   "compare": [
    {
     "id": "G0251",
     "diff": "へ 强调方向，に 强调到达点"
    }
   ],
   "common_errors": [
    {
     "wrong": "夏休みに北海道へを行きます。",
     "why": "へ 后不能再加 を",
     "fix": "夏休みに北海道へ行きます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "로/으로（방향）",
   "ko_diff": "韩语 로/으로 与 へ 对应，随收音换形；日语 へ 读作 e，写法固定，不随名词变化。",
   "notes": "",
