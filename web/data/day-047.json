 "grammar": [
  {
   "id": "G0189",
   "pattern": "〜てくれる",
   "meaning_zh": "（别人）为我做…",
   "connection": "动词て形 + くれる（对长辈用 くださる）",
   "usage": "用于他人为说话人或我方做事，含有感谢语气。",
   "register_note": "口语与书面通用；礼貌体用「くださる」。",
   "examples": [
    {
     "ja": "友達が引っ越しを手伝ってくれた。",
     "zh": "朋友帮我搬了家。"
    },
    {
     "ja": "父が駅まで車で送ってくれました。",
     "zh": "父亲开车把我送到了车站。"
    },
    {
     "ja": "母が毎朝お弁当を作ってくれます。",
     "zh": "母亲每天早上给我做便当。"
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [
    {
     "id": "G0190",
     "diff": "てくれる 的受益者是我方，てもらう 以我为主语叙述受惠"
    }
   ],
   "common_errors": [
    {
     "wrong": "友達に引っ越しを手伝ってくれた。",
     "why": "くれる 的施益者是主语，要用 が 标记；に 会把它标成接受者",
     "fix": "友達が引っ越しを手伝ってくれた。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아/어 주다",
   "ko_diff": "韩语同样用 -아/어 주다，但日语 てくれる 的施益者必须作主语用 が；韩语靠语境，主语可省略。",
   "notes": "",
   "tags": [
    "giving-receiving"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0190",
   "pattern": "〜てもらう",
   "meaning_zh": "请别人为我做…；得到…",
   "connection": "动词て形 + もらう（施益者用 に/から 标记）",
   "usage": "以接受者为主语，叙述从他人那里得到帮助。",
   "register_note": "口语与书面通用；谦让体用「いただく」。",
   "examples": [
    {
     "ja": "先輩にレポートを見てもらった。",
     "zh": "我请学长帮我看了报告。"
    },
    {
     "ja": "友達に写真を撮ってもらった。",
     "zh": "我请朋友帮我拍了照片。"
    },
    {
     "ja": "分からないところを先生に説明してもらいました。",
     "zh": "不懂的地方我请老师讲解了一遍。"
    }
   ],
   "prerequisites": [
    "G0020",
    "G0009"
   ],
   "compare": [
    {
     "id": "G0189",
     "diff": "てもらう 的主语是接受者，てくれる 的主语是施益者"
    }
   ],
   "common_errors": [
    {
     "wrong": "私は先輩にレポートを見てくれた。",
     "why": "主语是「私」时不能用 くれる；应改用 もらう",
