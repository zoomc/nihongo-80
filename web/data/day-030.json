 "grammar": [
  {
   "id": "G0271",
   "pattern": "〜と〜とどちらが",
   "meaning_zh": "…和…哪个更…？",
   "connection": "名词 + と + 名词 + とどちらが + 形容词 + か",
   "usage": "用于两者之间比较提问，回答用「〜の方が」。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "コーヒーと紅茶とどちらが好きですか。",
     "zh": "咖啡和红茶你更喜欢哪个？"
    },
    {
     "ja": "電車とバスとどちらが安いですか。",
     "zh": "电车和公交车哪个便宜？"
    },
    {
     "ja": "「山と海とどちらがいいですか。」「海の方がいいです。」",
     "zh": "“山和海你更喜欢哪个？”“海更好。”"
    }
   ],
   "prerequisites": [
    "G0034"
   ],
   "compare": [
    {
     "id": "G0272",
     "diff": "どちらが 用于两者，一番 用于三者以上"
    }
   ],
   "common_errors": [
    {
     "wrong": "コーヒーと紅茶がどちらが好きですか。",
     "why": "比较的两个对象用 と 并列，疑问部分用 どちらが",
     "fix": "コーヒーと紅茶とどちらが好きですか。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "A와 B 중 어느 쪽이",
   "ko_diff": "韩语用 와/과 중 어느 쪽이，日语用 と〜とどちらが；韩语需加 중，日语靠 どちら 本身表两者。",
   "notes": "",
