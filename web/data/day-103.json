 "grammar": [
  {
   "id": "G0118",
   "pattern": "〜によると / 〜によれば",
   "meaning_zh": "据…说",
   "connection": "名词 + によると／によれば（句末须有传闻表达）",
   "usage": "引出消息来源，句末接「そうだ／らしい／ということだ」。",
   "register_note": "口语书面均可，「によれば」更书面。",
   "examples": [
    {
     "ja": "天気予報によると、週末は大雪になるそうだ。",
     "zh": "据天气预报，周末会下大雪。"
    },
    {
     "ja": "ニュースによれば、事故の原因はまだ分かっていないらしい。",
     "zh": "据新闻说，事故原因似乎还不清楚。"
    },
    {
     "ja": "姉の話によると、あのレストランは予約がないと入れないということだ。",
     "zh": "听姐姐说，那家餐厅不预约进不去。"
    }
   ],
   "prerequisites": [
    "G0043"
   ],
   "compare": [
    {
     "id": "G0117",
     "diff": "によると 引出传闻来源，によって 表主体、原因或依据。"
    }
   ],
   "common_errors": [
    {
     "wrong": "天気予報によって、週末は大雪になるそうだ。",
     "why": "表示传闻来源要用「によると／によれば」，「によって」表手段或原因，不能引出消息来源。",
     "fix": "天気予報によると",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-에 따르면",
   "ko_diff": "韩语「-에 따르면」同样要求句末有传闻标记；日语「によると」必须与「そうだ/らしい」呼应，韩语可与多种转述形式搭配。",
   "notes": "",
   "tags": [
    "hearsay"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0119",
   "pattern": "〜ばかりでなく",
   "meaning_zh": "不仅…而且…",
   "connection": "普通形 + ばかりでなく；ナ形容词 + な + ばかりでなく；名词 + ばかりでなく",
   "usage": "追加同类或更高层次的事项，后项多带「も」。",
   "register_note": "书面语色彩，演讲和文章中常见。",
   "examples": [
    {
     "ja": "この映画は子どもばかりでなく、大人も楽しめる。",
     "zh": "这部电影不仅孩子爱看，大人也能享受。"
    },
    {
     "ja": "新しいスマホは画面が大きいばかりでなく、電池も長持ちする。",
     "zh": "新手机不仅屏幕大，电池也耐用。"
    },
    {
     "ja": "運動は体にいいばかりでなく、ストレスを減らす効果もある。",
     "zh": "运动不仅对身体好，还有减压的效果。"
    }
   ],
   "prerequisites": [
    "G0093"
   ],
   "compare": [
    {
     "id": "G0120",
     "diff": "ばかりでなく 与 だけでなく 意思相近，前者更书面、更郑重。"
    }
   ],
   "common_errors": [
    {
     "wrong": "新しいスマホは画面が大きばかりでなく、電池も長持ちする。",
     "why": "い形容词要保留辞书形「大きい」再接「ばかりでなく」，不能去掉「い」。",
     "fix": "画面が大きいばかりでなく",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
