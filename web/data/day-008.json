 "grammar": [
  {
   "id": "G0014",
   "pattern": "（场所）に ～ がある / いる",
   "meaning_zh": "（某地）有…",
   "connection": "場所 + に + 物/人 + が + ある／いる",
   "usage": "存在句：无生命用 ある，有生命用 いる；主体用 が",
   "register_note": "ある/いる 口语书面通用；郑重场合可用 ございます。",
   "examples": [
    {
     "ja": "部屋に猫がいます。",
     "zh": "房间里有猫。",
     "vocab_ids": [
      "V0045",
      "V0098"
     ]
    },
    {
     "ja": "駅の前に店があります。",
     "zh": "车站前有店。",
     "vocab_ids": [
      "V0041",
      "V0049",
      "V0042"
     ]
    }
   ],
   "prerequisites": [
    "G0007",
    "G0009"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "部屋に猫があります。",
     "why": "猫是有生命，用 いる；中文「有」不分 animate，日语 ある/いる 必须分",
     "fix": "部屋に猫がいます。",
     "learner": "zh"
    },
    {
     "wrong": "部屋に 猫を います。",
     "why": "存在主体用 が，不是 を",
     "fix": "部屋に猫がいます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "sentence",
    "existence"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "에 ~ 이/가 있다 / 계시다",
   "ko_diff": "韩语存在动词不分有无生命，一律있다，敬语用계시다；日语必须分ある/いる。"
  },
  {
   "id": "G0015",
   "pattern": "い形容词（～い です）",
   "meaning_zh": "…（い形容词谓语）",
   "connection": "い形容詞 + です",
   "usage": "い形容词作谓语，礼貌体直接加 です，不再加 だ",
   "register_note": "い形容词礼貌体口语书面都自然；简体结句去 です。",
   "examples": [
    {
     "ja": "この本は高いです。",
     "zh": "这本书贵。",
     "vocab_ids": [
      "V0080",
      "V0125"
     ]
    }
   ],
   "prerequisites": [
    "G0001"
   ],
   "compare": [
    {
     "id": "G0016",
     "diff": "い形容词以 い 结尾、连体直接修饰；な形容词词干+です、连体加 な"
    }
   ],
   "common_errors": [
    {
     "wrong": "本は高いだ。",
     "why": "い形容词后不能接 だ；「です」已是礼貌体，中文「是」诱发了 だ",
     "fix": "本は高いです。",
     "learner": "zh"
    },
    {
     "wrong": "高い な 本",
     "why": "い形容词连体直接接名词，不要加 な",
     "fix": "高い本",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "adjective"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "형용사 어간 + 다 / -아·어요",
   "ko_diff": "韩语形容词作谓语要加终结词尾，敬语靠어요/습니다；日语い形直接加です。"
  }
 ],
