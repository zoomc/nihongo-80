 "listening": false,
 "grammar": [
  {
   "id": "G0152",
   "pattern": "〜ごとに",
   "meaning_zh": "每…；每隔…",
   "connection": "名词 + ごとに；动词辞书形 + ごとに",
   "usage": "表示以某单位等间隔重复，或“每一个都各自不同”。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "このバスは十五分ごとに出ています。",
     "zh": "这趟公交每十五分钟一班。"
    },
    {
     "ja": "季節ごとに、店の飾りが変わる。",
     "zh": "每个季节店里的装饰都会变。"
    },
    {
     "ja": "一回使うごとにポイントがたまるカードです。",
     "zh": "这是每用一次就积分的卡。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0151",
     "diff": "ごとに 侧重等间隔、逐个，たびに 侧重“每当发生某事”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "このバスは十五分おきごとに出ています。",
     "why": "「おき」与「ごと」都表间隔，不能叠加，二者择一。",
     "fix": "十五分ごとに",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-마다",
   "ko_diff": "십 분마다 对照 十分ごとに；一人ごとに 则可对照 한 사람마다。名词后直接加 ごとに；重复动作也可以用 たびに。",
   "notes": "",
   "tags": [
    "time",
    "quantity"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜고토니"
  },
  {
   "id": "G0153",
   "pattern": "〜最中に",
   "meaning_zh": "正当…的时候",
   "connection": "动词ている + 最中に；名词 + の + 最中に",
   "usage": "表示某动作正值高潮时另一事突然发生，多含妨碍意味。",
   "register_note": "口语书面均可，语气较郑重。",
   "examples": [
    {
     "ja": "大事な会議の最中に、携帯電話が鳴ってしまった。",
     "zh": "正开重要会议时，手机响了。"
    },
    {
     "ja": "料理をしている最中に、停電になった。",
     "zh": "正做饭时停电了。"
    },
    {
     "ja": "今、試験の最中だから、廊下では静かにしてください。",
     "zh": "现在正在考试，请在走廊保持安静。"
    }
   ],
   "prerequisites": [
    "G0089"
   ],
   "compare": [
    {
     "id": "G0133",
     "diff": "ところに 是“正要、正在时”，最中に 强调“正做到一半”，妨碍感更强。"
    }
   ],
   "common_errors": [
    {
     "wrong": "大事な会議最中に、携帯電話が鳴ってしまった。",
     "why": "「最中」是名词，接名词要加「の」，说「会議の最中に」。",
     "fix": "会議の最中に",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-는 중에",
   "ko_diff": "회의 중에 전화가 왔다 对照 会議の最中に電話が来た。最中 特别强调「正当中」，常接意外插进来的事，但也可平静叙述正在发生什么。",
   "notes": "",
   "tags": [
    "time",
    "simultaneity"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "pattern_kana": "〜さいちゅうに",
   "ko_pron": "〜사이추우니"
  },
  {
   "id": "G0154",
   "pattern": "〜ついでに",
   "meaning_zh": "顺便…",
   "connection": "动词辞书形/た形 + ついでに；名词 + の + ついでに",
   "usage": "表示利用做某事的机会，顺便再做另一件事。",
   "register_note": "口语为主。",
   "examples": [
    {
     "ja": "郵便局へ行くついでに、この手紙も出してきてくれる？",
     "zh": "你去邮局的话，顺便帮我把这封信寄了好吗？"
    },
    {
     "ja": "京都へ出張したついでに、昔の友達に会ってきた。",
     "zh": "去京都出差时，顺便见了老朋友。"
    },
    {
     "ja": "買い物のついでに、図書館に本を返した。",
     "zh": "买东西时顺便把书还给了图书馆。"
    }
   ],
   "prerequisites": [
    "G0087"
   ],
   "compare": [
    {
     "id": "G0151",
     "diff": "たびに 是“每次必做”，ついでに 是“顺手多做一件”，不具反复性。"
    }
   ],
   "common_errors": [
    {
     "wrong": "京都へ出張するのついでに、昔の友達に会ってきた。",
     "why": "ついでに 前接辞书形或た形；只有名词才加 の，如 出張のついでに。",
     "fix": "出張したついでに",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-는 김에",
   "ko_diff": "韩语「-는 김에」同样表“顺便”，与「ついでに」对应；但日语可接名词+の，韩语只接动词。",
   "notes": "",
   "tags": [
    "simultaneity",
    "addition"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜쓰이데니"
  }
