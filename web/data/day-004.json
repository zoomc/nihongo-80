 "grammar": [
  {
   "id": "G0006",
   "pattern": "N の N",
   "meaning_zh": "…的…；所属/修饰",
   "connection": "名詞 + の + 名詞",
   "usage": "连体修饰、所属、同位；中文「的」的对应，但不可滥用",
   "register_note": "の 口语书面通用；不要把所有中文「的」都机械译成 の。",
   "examples": [
    {
     "ja": "私の本です。",
     "zh": "是我的书。",
     "vocab_ids": [
      "V0001",
      "V0080"
     ]
    },
    {
     "ja": "日本語の先生です。",
     "zh": "是日语老师。",
     "vocab_ids": [
      "V0081",
      "V0079"
     ]
    }
   ],
   "prerequisites": [
    "G0001"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "私は本です。",
     "why": "该用 の 表所属却用 は；中文「我的书」直译成「我 是 书」",
     "fix": "私の本です。",
     "learner": "zh"
    },
    {
     "wrong": "静かな の 部屋",
     "why": "な形容词连体用 な，不叠加 の",
     "fix": "静かな部屋",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "particle"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "N의 N",
   "ko_diff": "韩语의多表所属，口语常省略；修饰关系更常用名词直接并列，使用范围比日语の窄。"
  },
  {
   "id": "G0007",
   "pattern": "が（主语／新信息／存在主体）",
   "meaning_zh": "…（主语/新信息/存在主体/能力对象）",
   "connection": "名詞 + が + 動詞／形容詞",
   "usage": "表主语、新信息、疑问词主语、存在主体、能力/好恶对象",
   "register_note": "が 口语书面通用；疑问词作主语时必须用 が。",
   "examples": [
    {
     "ja": "猫がいます。",
     "zh": "有猫。",
     "vocab_ids": [
      "V0098"
     ]
    },
    {
     "ja": "誰が来ますか。",
     "zh": "谁来？",
     "vocab_ids": [
      "V0104"
     ]
    }
   ],
   "prerequisites": [
    "G0001"
   ],
   "compare": [
    {
     "id": "G0001",
     "diff": "は 提示主题/旧信息，が 提示主语/新信息/排他"
    }
   ],
   "common_errors": [
    {
     "wrong": "私がは学生です。",
     "why": "が 与 は 不能叠加；自我介绍用 は 提示主题，が 标记新信息焦点（如「誰が学生ですか」→「私が学生です」），两者分工不同。",
     "fix": "私は学生です。",
     "learner": "zh"
    },
    {
     "wrong": "猫をいます。",
     "why": "存在/自动词主体用 が，不是宾语 を",
     "fix": "猫がいます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "particle"
   ],
   "source_ids": [
