 "grammar": [
  {
   "id": "G0082",
   "pattern": "普通形 + わりに(は) / N + に しては",
   "meaning_zh": "（相较…）却…；按…来说倒是…",
   "connection": "動詞・い形 普通形 / 名詞＋の + わりに；名詞 + にしては；后项是与前项预期不符的评价",
   "usage": "以某标准为参照，结果出乎意料；わりに 偏「付出/程度与结果不匹配」，にしては 偏「以该身份/条件而论」",
   "register_note": "わりに/にしては 口语书面通用，带评价语气。",
   "examples": [
    {
     "ja": "たくさん食べたわりに、太りませんでした。",
     "zh": "吃了那么多却没胖。",
     "vocab_ids": [
      "V0101"
     ]
    },
    {
     "ja": "初心者にしては、上手に作りましたね。",
     "zh": "作为初学者，做得挺不错呢。",
     "vocab_ids": [
      "V0179",
      "V0130"
     ]
    }
   ],
   "prerequisites": [
    "G0023",
    "G0016",
    "G0075"
   ],
   "compare": [
    {
     "id": "G0075",
     "diff": "のに 是单纯逆接（意外/遗憾）；わりに/にしては 是「与某个基准相比」的评价，含比较"
    },
    {
     "id": "G0034",
     "diff": "より/ほうが 是两者直接比较；わりに 是「相对预期」的落差评价"
    }
   ],
   "common_errors": [
    {
     "wrong": "初心者にしてはは上手です",
     "why": "にしては 已含 は，不叠加；中文「作为初学者」直译堆 は 错",
     "fix": "初心者にしては上手です。",
     "learner": "zh"
    },
    {
     "wrong": "勉強したわりに、合格しました",
     "why": "わりに 后项须是「与预期相反」的结果；「努力了所以考上」顺理成章，用 わりに 不自然；中文「按…来说」直译不看落差",
     "fix": "勉強したわりに、合格できませんでした。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "plain-form",
    "comparison",
    "evaluation",
    "concession"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-에 비해 / -치고는",
   "ko_diff": "韩语에 비해表相较，치고는表按…来说；日语わりに偏不匹配，にしては偏身份标准。"
  },
  {
   "id": "G0083",
   "pattern": "V ます形(去ます) + かねない / かねる",
   "meaning_zh": "难保不会…、恐怕会…／难以…、不便…",
   "connection": "動詞 ます形 去 ます + かねない／かねる；かねる 按一段动词变形（かねます／かねた）",
   "usage": "かねない 是「有可能（多指坏结果）」的负面推测；かねる 是「（因立场/情理）难以做到」，常用于委婉拒绝「〜しかねます」",
   "register_note": "かねない/かねる 偏书面商务，かねます 是委婉拒绝的礼貌表达。",
   "examples": [
    {
     "ja": "このままでは事故になりかねません。",
     "zh": "这样下去难保会出事故。",
     "vocab_ids": [
      "V0256",
      "V0110"
     ]
    },
    {
     "ja": "ご期待に沿いかねますので、ご了承ください。",
     "zh": "恕难满足您的期待，敬请谅解。",
     "vocab_ids": [
      "V0169"
     ]
    }
   ],
   "prerequisites": [
    "G0019",
    "G0023"
   ],
   "compare": [
    {
     "id": "G0045",
     "diff": "かもしれない 是中性「也许」；かねない 专指「可能发生坏事」，带担忧"
    },
    {
     "id": "G0024",
     "diff": "可能形 表能力/条件；かねる 表「因情理上不便而难做」，不是能力"
    }
   ],
   "common_errors": [
    {
     "wrong": "事故になるかねません。",
     "why": "必须接 ます形去ます（なり），不能用辞书形 なる；中文「难保会出事故」直译错",
     "fix": "事故になりかねません。",
     "learner": "zh"
    },
    {
     "wrong": "雨が降りかねます。（想说恐怕会下雨）",
     "why": "「恐怕会（坏事）」是 かねない（降りかねない）；かねる 是「难以做」，中文直译把两形搞反",
     "fix": "雨が降りかねません。",
     "learner": "zh"
    },
    {
     "wrong": "かねない／かねる 都接 辞书形",
     "why": "【疑点】两形意义相反（负面推测 vs 难以做到）却同接 ます形，本条合并讲授，建议拆分二次核实，故标 needs_review",
     "fix": "均接 ます形去ます：降りかねない／お受けしかねます",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "masu-form",
    "inference",
    "refusal",
    "needs_review",
    "polite"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-(으)ㄹ 수도 있다 / -기 어렵다",
   "ko_diff": "韩语ㄹ 수도 있다表恐怕会(坏结果)，委婉拒绝用하기 어렵습니다；かねる的立场限制韩语须另加说明。"
  }
 ],
