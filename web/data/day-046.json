 "grammar": [
  {
   "id": "G0063",
   "pattern": "Vます形(去ます)/い形(去い)/な形词干 + すぎる",
   "meaning_zh": "过于…；…得过头",
   "connection": "動詞ます形去ます、い形容词去 い、な形容词/名词 词干 + すぎる；すぎる 按一段动词变形",
   "usage": "超过适度；な形/名词直接接（静かすぎる／甘すぎる），不加 な；食べすぎる 是复合动词",
   "register_note": "すぎる 口语通用，带主观评价。",
   "examples": [
    {
     "ja": "食べすぎてお腹が痛いです。",
     "zh": "吃多了肚子疼。",
     "vocab_ids": [
      "V0101"
     ]
    },
    {
     "ja": "この靴は高すぎます。",
     "zh": "这鞋太贵了。",
     "vocab_ids": [
      "V0125"
     ]
    }
   ],
   "prerequisites": [
    "G0019",
    "G0015",
    "G0016"
   ],
   "compare": [
    {
     "id": "G0062",
     "diff": "やすい/にくい 表难易；すぎる 表程度过头"
    },
    {
     "id": "G0034",
     "diff": "より/ほうが 是两者比较；すぎる 是超过标准"
    }
   ],
   "common_errors": [
    {
     "wrong": "食べるすぎます。",
     "why": "必须接 ます形去ます（食べ），不能用辞书形；中文「吃太多」直译错",
     "fix": "食べすぎます。",
     "learner": "zh"
    },
    {
     "wrong": "静かなすぎます。",
     "why": "な形接 すぎる 用词干 静か，去掉 な；中文「太安静」直译保留 な 错",
     "fix": "静かすぎます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "tags": [
    "masu-form",
    "excess",
    "i-adj",
    "na-adj"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "너무 / -기에는 너무",
   "ko_diff": "韩语너무是副词，直接修饰谓语；日语すぎる是后缀，须接词干，且可单独作谓语。"
  },
  {
   "id": "G0188",
   "pattern": "〜てあげる",
   "meaning_zh": "为别人做…（施惠）",
   "connection": "动词て形 + あげる（对长辈用 さしあげる）",
   "usage": "表示说话人为他人做事，带有施恩语气，对上级需换敬语形式。",
   "register_note": "口语常用；直接对长辈说「〜てあげる」显得居高临下，宜用「〜てさしあげる」或委婉说法。",
   "examples": [
    {
     "ja": "妹の宿題を手伝ってあげました。",
     "zh": "我帮妹妹做了作业。"
    },
    {
     "ja": "道に迷っている人に、駅までの行き方を教えてあげた。",
     "zh": "我给迷路的人指了去车站的路。"
    },
    {
     "ja": "重そうだね。持ってあげようか。",
     "zh": "看起来好重啊，要我帮你拿吗？"
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [
    {
     "id": "G0189",
     "diff": "てあげる 是我为别人做，てくれる 是别人为我做"
    }
   ],
   "common_errors": [
    {
     "wrong": "妹の宿題を手伝うてあげました。",
     "why": "手伝う 的て形是「手伝って」，「うて」不是正确的活用",
     "fix": "妹の宿題を手伝ってあげました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
