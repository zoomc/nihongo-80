 "grammar": [
  {
   "id": "G0195",
   "pattern": "〜ておく",
   "meaning_zh": "预先…好；…着（保持状态）",
   "connection": "动词て形 + おく（口语缩约 とく）",
   "usage": "表示为将来做准备而提前做某事，或做完后保持该状态。",
   "register_note": "口语与书面通用；「とく」为口语缩约。",
   "examples": [
    {
     "ja": "旅行の前に、ホテルを予約しておきます。",
     "zh": "旅行前我会先把酒店订好。"
    },
    {
     "ja": "パーティーのために、飲み物を冷やしておいた。",
     "zh": "为了聚会，我提前把饮料冰好了。"
    },
    {
     "ja": "エアコンはつけておいてください。",
     "zh": "请让空调一直开着。"
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [
    {
     "id": "G0194",
     "diff": "ておく 是事先准备，てしまう 是完成或遗憾"
    }
   ],
   "common_errors": [
    {
     "wrong": "旅行の前に、ホテルを予約しでおきます。",
     "why": "する 的て形是「して」，不是「しで」",
     "fix": "旅行の前に、ホテルを予約しておきます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아/어 두다",
   "ko_diff": "韩语 -아/어 두다 也表预先做好并保持状态，对应度很高；日语口语缩约 とく 在韩语中没有同类的音变形式。",
   "notes": "",
   "tags": [
    "purpose",
    "state"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜테오쿠"
  },
  {
   "id": "G0196",
   "pattern": "〜てみる",
   "meaning_zh": "试着做…（看看效果）",
   "connection": "动词て形 + みる",
   "usage": "表示尝试做某事以了解结果或感受，常用于第一次尝试。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "このシャツ、着てみてもいいですか。",
     "zh": "这件衬衫可以试穿一下吗？"
    },
    {
     "ja": "新しくできたラーメン屋に行ってみた。",
     "zh": "我去新开的拉面店尝了尝。"
    },
    {
     "ja": "日本の料理を自分で作ってみたいです。",
     "zh": "我想自己试着做日本菜。"
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [
    {
     "id": "G0195",
     "diff": "てみる 是尝试，ておく 是预先准备"
    }
   ],
   "common_errors": [
    {
     "wrong": "このシャツ、着ってみてもいいですか。",
     "why": "着る 是上一段动词，て形是「着て」，不是「着って」",
     "fix": "このシャツ、着てみてもいいですか。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아/어 보다",
   "ko_diff": "입어 보다 对照 着てみる，都是先尝试再说。补助动词相当于日语的 みる，练习时写成平假名。",
   "notes": "",
   "tags": [
    "attempt"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜테미루"
  },
  {
   "id": "G0197",
   "pattern": "〜てある",
   "meaning_zh": "…着（有意为之的结果状态）",
   "connection": "他动词て形 + ある；结果状态常用 が，已完成的准备可用 を。",
   "usage": "表示某人有意做了某事后，其结果状态一直保留，主语多为物。",
   "register_note": "口语与书面通用；与自动词的「ている」相对。",
   "examples": [
    {
     "ja": "入り口に地図がはってあります。",
     "zh": "入口处贴着一张地图。"
    },
    {
     "ja": "テーブルの上にお皿が並べてあった。",
     "zh": "桌上摆着盘子。"
    },
    {
     "ja": "ビールなら冷蔵庫に入れてあるよ。",
     "zh": "啤酒的话，我放在冰箱里了。"
    }
   ],
   "prerequisites": [
    "G0020",
    "G0027"
   ],
   "compare": [
    {
     "id": "G0027",
     "diff": "てある 强调人为结果状态，ている 可表动作进行或自然状态"
    }
   ],
   "common_errors": [
    {
     "wrong": "机に本が置くてあります。",
     "why": "置く 的て形是 置いて；てある 表示人为弄好后一直保持的状态。",
     "fix": "机に本が置いてあります。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아/어 있다",
   "ko_diff": "韩语 -아/어 있다 可表状态持续，但不像日语 てある 那样明确区分他动词与自动词；日语用 が 提示结果主体，韩语用 이/가。",
   "notes": "「地図が貼ってある」は结果状态的常见说法；「地図を貼ってある」也可表示已经做好的准备，不应一概判错。",
   "tags": [
    "state",
    "result"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "needs_review",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜테아루"
  },
  {
   "id": "G0198",
   "pattern": "〜とき",
   "meaning_zh": "…的时候",
   "connection": "动词普通形／い形容词／な形容词+な／名词+の + とき",
   "usage": "表示某一动作或状态发生的时间，前后主语可以不同。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "子どものとき、よく川で泳ぎました。",
     "zh": "我小时候经常在河里游泳。"
    },
    {
     "ja": "日本へ行くとき、新しいかばんを買いました。",
     "zh": "去日本之前，我买了一个新包。"
    },
    {
     "ja": "日本へ行ったとき、友達にお土産を買いました。",
     "zh": "去日本的时候，我在当地给朋友买了礼物。"
    }
   ],
   "prerequisites": [
    "G0023",
    "G0006"
   ],
   "compare": [
    {
     "id": "G0222",
     "diff": "とき 是名词性时间从句，たら 还含条件与先后关系"
    }
   ],
   "common_errors": [
    {
     "wrong": "子どもののとき、よく川で泳ぎました。",
     "why": "名词修饰名词只用「の」，不能叠用两个 の",
     "fix": "子どものとき、よく川で泳ぎました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-(으)ㄹ 때 / -았/었을 때",
   "ko_diff": "京都へ行くとき 可指去之前或正在去的阶段；京都へ行ったとき 把到过京都作为后事的时间背景。韩语 갈 때／갔을 때 也有这一区别。",
   "notes": "",
