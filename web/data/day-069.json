 "grammar": [
  {
   "id": "G0233",
   "pattern": "〜ように（purpose）",
   "meaning_zh": "为了…；以便…",
   "connection": "动词辞书形／动词ない形 + ように",
   "usage": "表示为了使某种状态实现，前接多为非意志动词或可能形。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "後ろの人にも聞こえるように、大きな声で話してください。",
     "zh": "请大声说，好让后面的人也听得见。"
    },
    {
     "ja": "忘れないように、手にメモを書いた。",
     "zh": "为了不忘，我把笔记写在手上。"
    },
    {
     "ja": "かぜをひかないように、暖かくして寝てください。",
     "zh": "睡觉时请保暖，别感冒了。"
    }
   ],
   "prerequisites": [
    "G0023",
    "G0022"
   ],
   "compare": [
    {
     "id": "G0232",
     "diff": "ように 多接非意志状态，ために 接意志动词"
    }
   ],
   "common_errors": [
    {
     "wrong": "後ろの人にも聞こえるために、大きな声で話してください。",
     "why": "聞こえる 是非意志动词，不能接 ために，要用 ように",
     "fix": "後ろの人にも聞こえるように、大きな声で話してください。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-도록",
   "ko_diff": "韩语 -도록 与 ように 对应，且同样可接非意志动词；日语 ために 只能接意志动词，这一点韩语 -기 위해 的限制更严。",
   "notes": "",
   "tags": [
    "purpose"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0064",
   "pattern": "V辞書形 / Vない形 + ように する",
   "meaning_zh": "努力做到…／设法不…（有意识地做）",
   "connection": "動詞 辞書形／ない形 + ように + する；する 按 サ変 变形（ようにしています／ようにした）",
   "usage": "表示意志性的努力或习惯；与 〜ようになる（G0048，自然变成）相对，关键在有无人的意志",
   "register_note": "ようにする 口语书面通用，表努力或习惯。",
   "examples": [
    {
     "ja": "毎日野菜を食べるようにしています。",
     "zh": "我尽量每天吃蔬菜。",
     "vocab_ids": [
      "V0029",
      "V0057",
      "V0101"
     ]
    },
    {
     "ja": "寝る前にスマホを見ないようにしています。",
     "zh": "睡前尽量不看手机。",
     "vocab_ids": [
      "V0105",
      "V0049",
      "V0027"
     ]
    }
   ],
   "prerequisites": [
    "G0023",
    "G0022",
    "G0048"
   ],
   "compare": [
    {
     "id": "G0048",
     "diff": "ようになる 是「（自然而然）变得…」；ようにする 是「有意识地做到…」"
    },
    {
     "id": "G0035",
     "diff": "〜に する 是把…变成/选成；ようにする 是努力做到某动作"
    }
   ],
   "common_errors": [
    {
     "wrong": "毎日走るようになりました。",
     "why": "想表达「我坚持每天跑步」应用 ようにする（意志努力）；ようになる 是自然变化，中文「坚持」直译易混",
     "fix": "毎日走るようにしています。",
     "learner": "zh"
    },
    {
     "wrong": "遅刻するようにしてください。",
     "why": "「请别迟到」须用 ない形 遅刻しないように；中文「请做到…」直译用肯定形意思反了",
     "fix": "遅刻しないようにしてください。",
     "learner": "zh"
    }
   ],
