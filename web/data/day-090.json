 "grammar": [
  {
   "id": "G0234",
   "pattern": "〜ようにする",
   "meaning_zh": "尽量…；设法做到…",
   "connection": "动词辞书形／动词ない形 + ようにする",
   "usage": "表示有意识地努力维持某种做法或状态，常与「ている」表习惯。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "毎日野菜を食べるようにしています。",
     "zh": "我尽量每天都吃蔬菜。"
    },
    {
     "ja": "これからは遅刻しないようにします。",
     "zh": "今后我会注意不再迟到。"
    },
    {
     "ja": "寝る前にスマホを見ないようにしている。",
     "zh": "我尽量睡前不看手机。"
    }
   ],
   "prerequisites": [
    "G0064"
   ],
   "compare": [
    {
     "id": "G0235",
     "diff": "ようにする 是主观努力，ようになる 是状态自然变化"
    }
   ],
   "common_errors": [
    {
     "wrong": "毎日野菜を食べるようにしっています。",
     "why": "ようにする 的持续形是「ようにしている」，不是「しっている」",
     "fix": "毎日野菜を食べるようにしています。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-도록 하다",
   "ko_diff": "늦지 않도록 하고 있다 对照 遅れないようにしている，表达有意识地维持。ようにする 也可以用于一次调整，如 明日は遅れないようにする。",
   "notes": "",
   "tags": [
    "attempt",
    "intention"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜요우니스루"
  },
  {
   "id": "G0241",
   "pattern": "〜はずだ",
   "meaning_zh": "应该…；按理说…",
   "connection": "动词普通形／い形容词 + はずだ；な形容词+な／名词+の + はずだ",
   "usage": "根据事实或逻辑推断理应如此，语气较有把握。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "荷物は明日届くはずです。",
     "zh": "包裹应该明天到。"
    },
    {
     "ja": "彼は十年もアメリカに住んでいたから、英語が上手なはずだ。",
     "zh": "他在美国住了十年，英语应该很好。"
    },
    {
     "ja": "おかしいな。かぎはここに置いたはずなのに。",
     "zh": "奇怪，我明明把钥匙放在这里的。"
    }
   ],
   "prerequisites": [
    "G0053"
   ],
   "compare": [
    {
     "id": "G0242",
     "diff": "はずだ 是理应如此，はずがない 是绝不可能"
    }
   ],
   "common_errors": [
    {
     "wrong": "彼は十年もアメリカに住んでいたから、英語が上手のはずだ。",
     "why": "な形容词接 はずだ 要用「な」，不是「の」",
     "fix": "彼は十年もアメリカに住んでいたから、英語が上手なはずだ。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-(으)ㄹ 것이다",
   "ko_diff": "韩语 -(으)ㄹ 것이다 既可表推测也可表意志，日语 はずだ 只表基于根据的推断，不含意志；两者不能完全对应。",
   "notes": "",
   "tags": [
    "conjecture"
   ],
   "source_ids": [
