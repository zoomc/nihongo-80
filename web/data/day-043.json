 "grammar": [
  {
   "id": "G0229",
   "pattern": "〜て（reason）",
   "meaning_zh": "因为…（造成某种状态）",
   "connection": "动词て形／い形容词去い+くて／な形容词・名词+で",
   "usage": "用て形连接原因与结果，后项多为感情、状态或不能控制的结果。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "ニュースを聞いて、びっくりしました。",
     "zh": "听到那个消息，我吓了一跳。"
    },
    {
     "ja": "このスープは熱くて、飲めません。",
     "zh": "这汤太烫了，喝不了。"
    },
    {
     "ja": "かぜで学校を休みました。",
     "zh": "因为感冒，我请假没去学校。"
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [
    {
     "id": "G0228",
     "diff": "て 的原因句后项多为状态，ので 可接意志性表达"
    }
   ],
   "common_errors": [
    {
     "wrong": "このスープは熱いで、飲めません。",
     "why": "い形容词用「くて」，不是「いで」",
     "fix": "このスープは熱くて、飲めません。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아서/어서",
   "ko_diff": "韩语 -아서/어서 与 て 的原因用法对应，但日语 て 形还可表并列、先后，功能更多；韩语需靠上下文或另加连接词。",
   "notes": "",
   "tags": [
    "reason"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜테"
  },
  {
   "id": "G0230",
   "pattern": "〜し",
   "meaning_zh": "既…又…；而且…",
   "connection": "动词普通形／い形容词 + し；な形容词・名词 + だ + し",
   "usage": "列举两个以上理由或特征，暗示还有其他，后项多为综合判断。",
   "register_note": "口语常用；书面也可。",
   "examples": [
    {
     "ja": "この部屋は広いし、駅から近いし、とても気に入っています。",
     "zh": "这个房间又宽敞，离车站又近，我很喜欢。"
    },
    {
     "ja": "今日は雨だし、疲れているし、どこにも行きたくない。",
     "zh": "今天又下雨，人又累，哪儿都不想去。"
    },
    {
     "ja": "もう遅いし、そろそろ帰ろうか。",
     "zh": "时间也不早了，我们差不多回去吧。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0232",
     "diff": "し 并列理由，ために 表单一目的或原因"
    }
   ],
   "common_errors": [
    {
     "wrong": "この部屋は広いだし、駅から近いだし、とても気に入っています。",
     "why": "い形容词直接接 し，不加 だ",
     "fix": "この部屋は広いし、駅から近いし、とても気に入っています。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-고",
   "ko_diff": "韩语 -고 可并列理由，但语气中性；日语 し 暗示「还有别的理由」，主观色彩更强，韩语常需加 -기도 하고 才接近。",
   "notes": "",
   "tags": [
    "reason",
