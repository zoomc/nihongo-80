 "grammar": [
  {
   "id": "G0059",
   "pattern": "普通形 + んです / のだ",
   "meaning_zh": "（是）因为…；其实是…（说明/强调语气）",
   "connection": "動詞・い形 普通形 + んです；な形・名詞 + な + んです；礼貌体 んです，简体 のだ／んだ",
   "usage": "解释原因、背景或强调；回答 どうして 时用；口语用 んです，书面/简体用 のだ",
   "register_note": "んです 口语解释语气强；书面叙述用 のだ/のである。",
   "examples": [
    {
     "ja": "遅くなってすみません。電車が遅れたんです。",
     "zh": "抱歉迟到了，是电车晚点了。",
     "vocab_ids": [
      "V0165",
      "V0060"
     ]
    },
    {
     "ja": "この店は高いんですか。",
     "zh": "这家店（是）很贵吗？",
     "vocab_ids": [
      "V0042",
      "V0125"
     ]
    }
   ],
   "prerequisites": [
    "G0023",
    "G0001"
   ],
   "compare": [
    {
     "id": "G0001",
     "diff": "は N です 只是判断句；んです 追加「说明/解释」语气"
    }
   ],
   "common_errors": [
    {
     "wrong": "電車が遅れたです。",
     "why": "普通形过去 た 不能直接接 です；中文「晚点了」直译错，须 た＋んです",
     "fix": "電車が遅れたんです。",
     "learner": "zh"
    },
    {
     "wrong": "彼は学生んです。",
     "why": "名词/な形＋んです 必须插入 な；中文「是学生」直译漏 な",
     "fix": "彼は学生なんです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "tags": [
    "explanation",
    "plain-form",
    "copula"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-거든요 / -는데요 / -잖아요",
   "ko_diff": "韩语说明语气由거든요、는데요、잖아요等分担；日语んです一形统合，须按语境选择。"
  },
  {
   "id": "G0060",
   "pattern": "N に Vて ほしい / Vないで ほしい",
   "meaning_zh": "希望（别人）做…／希望别…",
   "connection": "動詞 て形 + ほしい；否定 ない形 + で + ほしい；动作主体用 に（或 が）",
   "usage": "てほしい 表说话人希望某事发生，动作主体可以是他人或自然事物；对人直接提出要求时要考虑关系与礼貌程度。",
   "register_note": "てほしい 对平辈或下级用；对上级改用 G0073。",
   "examples": [
    {
     "ja": "もう少し待ってほしいです。",
     "zh": "希望（你）再等一下。",
     "vocab_ids": [
      "V0140",
      "V0116"
     ]
    },
    {
     "ja": "大きな声で話さないでほしいです。",
     "zh": "希望别大声说话。",
     "vocab_ids": [
      "V0127",
      "V0114"
     ]
    }
   ],
   "prerequisites": [
    "G0020",
    "G0022",
    "G0033"
   ],
   "compare": [
    {
     "id": "G0031",
     "diff": "〜たい 是说话人自己想做；〜てほしい 是希望别人做，主体用 に"
    },
    {
     "id": "G0026",
     "diff": "〜てください 是普通请求；对长辈用 ていただけませんか 更礼貌，てほしい 不宜直说"
    }
   ],
   "common_errors": [
    {
     "wrong": "私は映画を見てほしいです。",
     "why": "「我想看」应用 見たい；てほしい 是希望别人做，中文「想」不分主体易错",
     "fix": "映画が見たいです。",
     "learner": "zh"
    },
    {
     "wrong": "先生に待ってほしいです。",
     "why": "对长辈直接说 てほしい 失礼，中文「希望老师等一下」直译不得体",
     "fix": "先生に少しお待ちいただけませんか。",
     "learner": "zh"
    }
   ],
