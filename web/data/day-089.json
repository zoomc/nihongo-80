 "grammar": [
  {
   "id": "G0086",
   "pattern": "V辞書形 / Nの + たびに",
   "meaning_zh": "每当…就…；每次…都…",
   "connection": "動詞辞書形 + たびに；名詞 + の + たびに（する名詞可直接 するたびに）",
   "usage": "表示每次发生前项时，后项都随之发生；后项多为反复出现的习惯或自然结果，不用一次性的命令、请求。",
   "examples": [
    {
     "ja": "大阪へ出張するたびに、この店に寄ります。",
     "zh": "每次去大阪出差，都会来这家店。",
     "vocab_ids": [
      "V0279",
      "V0042"
     ]
    },
    {
     "ja": "会議のたびに、資料を準備します。",
     "zh": "每次开会都准备资料。",
     "vocab_ids": [
      "V0244",
      "V0272"
     ]
    }
   ],
   "prerequisites": [
    "G0023",
    "G0006"
   ],
   "compare": [
    {
     "id": "G0077",
     "diff": "につれて 表示随时间逐渐变化，是一个连续过程；たびに 表示每次事件反复发生。"
    }
   ],
   "common_errors": [
    {
     "wrong": "大阪へ出張するのたびに、この店に寄ります。",
     "why": "辞书形后接 たびに 不加 の；の 只能接名词。中文“每次去…”直译容易多写の。",
     "fix": "大阪へ出張するたびに、この店に寄ります。",
     "learner": "zh"
    },
    {
     "wrong": "会議のたびにで、資料を準備します。",
     "why": "たびに 后不接 で；中文“在每次会议上”直译容易加 で。",
     "fix": "会議のたびに、資料を準備します。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "plain-form",
    "frequency",
    "habit"
   ],
   "register_note": "中性偏书面，口语也可；后项不用命令/请求。",
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "source_ids": [
    "S000"
   ],
   "ko_equiv": "-(으)ㄹ 때마다",
   "ko_diff": "韩语때마다表每当，接名词或动词定语形；日语たびに只接辞书形或の，后项限制更严。"
  },
  {
   "id": "G0087",
   "pattern": "V辞書形 / Vた形 / Nの + ついでに",
   "meaning_zh": "顺便…；借…之便…",
   "connection": "動詞辞書形/た形 + ついでに；名詞 + の + ついでに",
   "usage": "做主要事情时，顺便做另一件次要事情；次要动作通常耗时短、顺路。",
   "examples": [
    {
     "ja": "駅へ行くついでに、切符を買いました。",
     "zh": "去车站时顺便买了车票。",
     "vocab_ids": [
      "V0041",
      "V0065"
     ]
    },
    {
     "ja": "資料を届けるついでに、部長に挨拶しました。",
     "zh": "送资料时顺便向部长打了招呼。",
     "vocab_ids": [
      "V0272",
      "V0168"
     ]
    }
   ],
   "prerequisites": [
    "G0023",
    "G0019"
   ],
   "compare": [
    {
     "id": "G0086",
     "diff": "たびに 是每次反复；ついでに 是一次性的顺带行为，主次分明。"
    }
   ],
   "common_errors": [
    {
     "wrong": "駅へ行くのついでに、切符を買いました。",
     "why": "辞书形后接 ついでに 不加 の；の 只能接名词。",
     "fix": "駅へ行くついでに、切符を買いました。",
     "learner": "zh"
    },
    {
     "wrong": "駅へ行くついでにで、切符を買いました。",
     "why": "ついでに 后不接 で；中文“顺便”直译加 で。",
     "fix": "駅へ行くついでに、切符を買いました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "plain-form",
    "incidental",
    "daily"
   ],
   "register_note": "口语/书面均可；要分清主要目的与顺便动作。",
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "source_ids": [
