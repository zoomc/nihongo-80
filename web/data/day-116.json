 "grammar": [
  {
   "id": "G0144",
   "pattern": "〜に関して / 〜に関する",
   "meaning_zh": "关于…；就…",
   "connection": "名词 + に関して；名词 + に関する／に関しての + 名词",
   "usage": "引出话题，语气比「について」正式、郑重。",
   "register_note": "书面语为主，公文和商务文书常用。",
   "examples": [
    {
     "ja": "新しいサービスに関してご質問がある方は、受付までどうぞ。",
     "zh": "对新服务有疑问的人，请到前台咨询。"
    },
    {
     "ja": "彼は日本の歴史に関する本をたくさん持っている。",
     "zh": "他有很多关于日本历史的书。"
    },
    {
     "ja": "事故の原因に関しては、現在調査中です。",
     "zh": "关于事故原因，目前正在调查。"
    }
   ],
   "prerequisites": [
    "G0076"
   ],
   "compare": [
    {
     "id": "G0116",
     "diff": "に関して 更正式、范围更大，について 更日常。"
    }
   ],
   "common_errors": [
    {
     "wrong": "この問題に関するの資料です。",
     "why": "修饰名词用「に関する資料」或「に関しての資料」。",
     "fix": "この問題に関する資料です。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-에 관해서",
   "ko_diff": "韩语「-에 관해서」表示关于；修饰名词时日语可用「に関する」或「に関しての」，韩语可用「-에 관한」。",
   "notes": "",
   "tags": [
    "topic",
    "formal"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "needs_review",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0145",
   "pattern": "〜に比べて",
   "meaning_zh": "与…相比",
   "connection": "名词 + に比べて；动词辞书形 + のに比べて",
   "usage": "拿两个对象作比较，指出差异。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "今年の夏は、去年に比べてずいぶん涼しい。",
     "zh": "今年夏天比去年凉快得多。"
    },
    {
     "ja": "都会に比べて、田舎は家賃が安い。",
     "zh": "和城市相比，乡下房租便宜。"
    },
    {
     "ja": "電車で行くのに比べて、車で行くと三十分ほど長くかかる。",
     "zh": "和坐电车去相比，开车要多花三十分钟左右。"
    }
   ],
   "prerequisites": [
    "G0034"
   ],
   "compare": [
    {
     "id": "G0034",
     "diff": "より 是简单的比较基准，に比べて 明示“对比之下”，更强调差异。"
    }
   ],
   "common_errors": [
    {
     "wrong": "今年の夏は、去年を比べてずいぶん涼しい。",
     "why": "比较基准用「に比べて」或「と比べて」，「を比べて」不合法。",
     "fix": "去年に比べて",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
