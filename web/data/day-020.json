     "zh": "我们一起去车站吧。"
    },
    {
     "ja": "きのうは夜11時まで勉強しました。",
     "zh": "昨天我学习到晚上十一点。"
    }
   ],
   "prerequisites": [
    "G0013"
   ],
   "compare": [
