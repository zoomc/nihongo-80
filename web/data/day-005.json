  {
   "id": "G0008",
   "pattern": "を（宾语／移动经过）",
   "meaning_zh": "把…（标宾语）",
   "connection": "名詞 + を + 他動詞",
   "usage": "标动作直接宾语；也表移动经过的场所（空を飛ぶ）",
   "register_note": "を 口语书面通用；移动经过用法偏书面描写。",
   "examples": [
    {
     "ja": "ご飯を食べます。",
     "zh": "吃饭。",
     "vocab_ids": [
      "V0051",
      "V0101"
     ]
    }
   ],
   "prerequisites": [
    "G0001"
   ],
   "compare": [
    {
     "id": "G0009",
     "diff": "を 标动作对象，に 标归着点/时点；「去学校」易混成 学校を行く"
    }
   ],
   "common_errors": [
    {
     "wrong": "ご飯が食べます。",
     "why": "他动词宾语用 を；中文「饭」是主语感觉，直译成 が 错",
     "fix": "ご飯を食べます。",
     "learner": "zh"
    },
    {
     "wrong": "学校を 行きます。",
     "why": "「行く」表移动方向用 に/へ，を 表经过（道を歩く），不能混",
     "fix": "学校へ行きます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
