 "grammar": [
  {
   "id": "G0004",
   "pattern": "N も",
   "meaning_zh": "…也…",
   "connection": "名詞 + も（替代 は/が/を）",
   "usage": "表同类追加；替代格助词，不与 は 叠加",
   "register_note": "も 口语书面通用；强调「也」时替代 は/が，不与 は 叠加。",
   "examples": [
    {
     "ja": "私も学生です。",
     "zh": "我也是学生。",
     "vocab_ids": [
      "V0001",
      "V0078"
     ]
    }
   ],
   "prerequisites": [
    "G0001"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "私はも学生です。",
     "why": "「も」本身已含「也」，要替换 は，不能 は+も 并存",
     "fix": "私も学生です。",
     "learner": "zh"
    },
    {
     "wrong": "私を学生です。",
     "why": "误把 も 写成 を；「也」不是宾语标记",
     "fix": "私も学生です。",
     "learner": "zh"
    }
   ],
