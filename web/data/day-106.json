 "grammar": [
  {
   "id": "G0125",
   "pattern": "〜ような / 〜ように（like）",
   "meaning_zh": "像…一样；如同…",
   "connection": "名词 + の + ような/ように；普通形 + ような/ように",
   "usage": "举出相似例子、比喻，或表示“按照…的方式”。",
   "register_note": "口语书面均可，比「みたい」正式。",
   "examples": [
    {
     "ja": "私も、あなたのような優しい看護師になりたいです。",
     "zh": "我也想成为像你这样温柔的护士。"
    },
    {
     "ja": "先生が言ったように、この文法はテストによく出る。",
     "zh": "正如老师所说，这个语法考试常考。"
    },
    {
     "ja": "東京のような大きな都市では、家賃がとても高い。",
     "zh": "在东京这样的大城市，房租很贵。"
    }
   ],
   "prerequisites": [
    "G0044"
   ],
   "compare": [
    {
     "id": "G0061",
     "diff": "みたい 是口语版，ような/ように 更正式，接续也更严格。"
    }
   ],
   "common_errors": [
    {
     "wrong": "東京のよう大きな都市では、家賃がとても高い。",
     "why": "名词后接「ような」须保留「な」，「よう大きな」不合法。",
     "fix": "東京のような大きな都市",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
