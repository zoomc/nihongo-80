 "grammar": [
  {
   "id": "G0117",
   "pattern": "〜によって / 〜による",
   "meaning_zh": "由…；由于…；因…而异",
   "connection": "名词 + によって；名词 + による + 名词",
   "usage": "表被动句的动作主体、原因手段，或“依…而不同”。",
   "register_note": "书面语为主，正式文章常用。",
   "examples": [
    {
     "ja": "この橋は、有名な建築家によって設計された。",
     "zh": "这座桥是由著名建筑师设计的。"
    },
    {
     "ja": "台風による被害は、まだ正確には分かっていない。",
     "zh": "台风造成的损失还没有准确查明。"
    },
    {
     "ja": "国によって、食事のマナーはずいぶん違う。",
     "zh": "餐桌礼仪因国家不同而差别很大。"
    }
   ],
   "prerequisites": [
    "G0055"
   ],
   "compare": [
    {
     "id": "G0118",
     "diff": "によって 表主体、原因或依据，によると 只表传闻来源。"
    }
   ],
   "common_errors": [
    {
     "wrong": "台風によっての被害は、まだ正確には分かっていない。",
     "why": "修饰名词要用「による」，「によっての」不合法。",
     "fix": "台風による被害",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-에 의해서",
   "ko_diff": "韩语「-에 의해서」主要用于被动主体；日语还能表原因和“因…而异”，韩语后者要用「-에 따라」。",
   "notes": "",
   "tags": [
    "means",
    "reason",
    "voice"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0118",
   "pattern": "〜によると / 〜によれば",
   "meaning_zh": "据…说",
   "connection": "名词 + によると／によれば（句末须有传闻表达）",
   "usage": "引出消息来源，句末接「そうだ／らしい／ということだ」。",
   "register_note": "口语书面均可，「によれば」更书面。",
   "examples": [
    {
     "ja": "天気予報によると、週末は大雪になるそうだ。",
     "zh": "据天气预报，周末会下大雪。"
    },
    {
     "ja": "ニュースによれば、事故の原因はまだ分かっていないらしい。",
     "zh": "据新闻说，事故原因似乎还不清楚。"
    },
    {
     "ja": "姉の話によると、あのレストランは予約がないと入れないということだ。",
     "zh": "听姐姐说，那家餐厅不预约进不去。"
    }
   ],
   "prerequisites": [
    "G0043"
   ],
   "compare": [
    {
     "id": "G0117",
     "diff": "によると 引出传闻来源，によって 表主体、原因或依据。"
    }
   ],
   "common_errors": [
    {
     "wrong": "天気予報によって、週末は大雪になるそうだ。",
     "why": "表示传闻来源要用「によると／によれば」，「によって」表手段或原因，不能引出消息来源。",
     "fix": "天気予報によると",
     "learner": "zh"
    }
   ],
