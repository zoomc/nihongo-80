 "grammar": [
  {
   "id": "G0164",
   "pattern": "〜てばかりいる",
   "meaning_zh": "老是…；一味…",
   "connection": "动词て形 + ばかりいる",
   "usage": "表示反复做同一件事，含批评或不满。",
   "register_note": "口语为主。",
   "examples": [
    {
     "ja": "弟は休みの日、ゲームをしてばかりいる。",
     "zh": "弟弟一放假就光玩游戏。"
    },
    {
     "ja": "泣いてばかりいないで、どうしたのか話してごらん。",
     "zh": "别光哭，说说到底怎么了。"
    },
    {
     "ja": "休みの間、寝てばかりいたら、かえって疲れてしまった。",
     "zh": "假期光睡觉，反倒更累了。"
    }
   ],
   "prerequisites": [
    "G0068"
   ],
   "compare": [
    {
     "id": "G0068",
     "diff": "ばかり 可接名词、数量表限定，てばかりいる 专表反复做某动作且含责难。"
    }
   ],
   "common_errors": [
    {
     "wrong": "弟は休みの日、ゲームをするばかりいる。",
     "why": "「ばかりいる」前接て形「して」，不能用辞书形。",
     "fix": "ゲームをしてばかりいる",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-기만 하다",
   "ko_diff": "영상만 본다 可对照 動画ばかり見る。加 てばかりいる 后更凸显这一行为持续或反复，是否批评要看语气和上下文。",
   "notes": "",
   "tags": [
    "tendency",
    "criticism",
    "limitation"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜테바카리이루"
  },
  {
   "id": "G0165",
   "pattern": "〜ばいい",
   "meaning_zh": "…就行；…才好",
   "connection": "动词ば形 + いい；い形容词ければ + いい",
   "usage": "表“这样做就够了”的建议，或用「ばいいのに」表遗憾、愿望。",
   "register_note": "口语为主。",
   "examples": [
    {
     "ja": "「この書類、どこに出せばいいですか。」「二階の受付に出してください。」",
     "zh": "“这份文件交到哪里好？”“请交到二楼前台。”"
    },
    {
     "ja": "分からないことがあったら、遠慮しないで私に聞けばいいよ。",
     "zh": "有不懂的尽管问我，不用客气。"
    },
    {
     "ja": "明日、雨が降らなければいいんだけど。",
     "zh": "明天要是不下雨就好了。"
    }
   ],
   "prerequisites": [
    "G0025"
   ],
   "compare": [
    {
     "id": "G0105",
     "diff": "ことだ 是较强的忠告，ばいい 更轻，只指出“这样做即可”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "分からないことがあったら、遠慮しないで私に聞くばいいよ。",
     "why": "「ばいい」前接ば形「聞けば」，辞书形加「ば」不合法。",
     "fix": "聞けばいいよ",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-면 된다",
   "ko_diff": "韩语「-면 된다」与「ばいい」对应；但日语「ばいいのに」可表惋惜、责备，韩语要用「-면 좋을 텐데」。",
   "notes": "",
   "tags": [
    "advice",
    "suggestion",
    "wish"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜바이이"
  },
  {
   "id": "G0166",
   "pattern": "〜場合（は）",
   "meaning_zh": "在…情况下",
   "connection": "动词普通形/い形容词/ナ形容词な/名词の + 場合（は）",
   "usage": "预设某种情况并说明应对办法，语气客观、正式。",
   "register_note": "书面语为主，通知和规章常用。",
   "examples": [
    {
     "ja": "雨の場合は、試合は中止になります。",
     "zh": "下雨的话，比赛取消。"
    },
    {
     "ja": "カードをなくした場合は、すぐに銀行に連絡してください。",
     "zh": "卡丢了的话，请马上联系银行。"
    },
    {
     "ja": "予約の時間に遅れる場合は、お電話でお知らせください。",
     "zh": "如果会晚于预约时间，请打电话通知我们。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0025",
     "diff": "たら/ば 是日常条件句，場合 更正式，且只用于需要应对的具体情况。"
    }
   ],
   "common_errors": [
    {
     "wrong": "雨場合、試合は中止になります。",
     "why": "名词接「場合」要加「の」，说「雨の場合」。",
     "fix": "雨の場合は",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-는 경우",
   "ko_diff": "韩语「-는 경우」与「場合」对应；但日语「場合」偏书面、用于预设应对，日常口语多用「たら」。",
   "notes": "",
