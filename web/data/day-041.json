 "grammar": [
  {
   "id": "G0221",
   "pattern": "〜ば",
   "meaning_zh": "如果…",
   "connection": "五段词尾改え段 + ば；一段去 る + れば；い形容词去 い + ければ；な形容词／名词用 なら 或 であれば。",
   "usage": "表示假定条件，后项多为自然结果、建议或请求。",
   "register_note": "口语与书面通用；书面条件句常用。",
   "examples": [
    {
     "ja": "この道をまっすぐ行けば、駅に着きます。",
     "zh": "沿着这条路一直走，就会到车站。"
    },
    {
     "ja": "安ければ、買いたいです。",
     "zh": "如果便宜的话，我想买。"
    },
    {
     "ja": "分からないことがあれば、いつでも聞いてください。",
     "zh": "有不懂的地方，请随时问我。"
    }
   ],
   "prerequisites": [
    "G0025"
   ],
   "compare": [
    {
     "id": "G0222",
     "diff": "ば 偏重假定条件，たら 还可表先后与发现"
    }
   ],
   "common_errors": [
    {
     "wrong": "安いければ、買いたいです。",
     "why": "い形容词说“如果…”是去掉 い 加 ければ：安ければ。",
     "fix": "安ければ、買いたいです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-(으)면",
   "ko_diff": "싸면 사겠다 对照 安ければ買う。形容词状态作条件时，后项完全可以是意志；若是同一人先完成动作再接受指令，常用 着いたら電話して。",
   "notes": "",
   "tags": [
    "condition"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜바"
  },
  {
   "id": "G0222",
   "pattern": "〜たら",
   "meaning_zh": "如果…；…之后",
   "connection": "动词た形 + ら；い形容词去い+かったら；な形容词・名词+だったら",
   "usage": "表示假定条件，或前项完成后发生后项，口语中最常用。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "駅に着いたら、電話してください。",
     "zh": "到了车站，请给我打电话。"
    },
    {
     "ja": "もし明日雨だったら、家で映画を見よう。",
     "zh": "如果明天下雨，我们就在家看电影吧。"
    },
    {
     "ja": "暑かったら、窓を開けてもいいですよ。",
     "zh": "如果热的话，可以打开窗户。"
    }
   ],
   "prerequisites": [
    "G0021",
    "G0025"
   ],
   "compare": [
    {
     "id": "G0221",
     "diff": "たら 可表假定与先后，ば 偏重纯条件"
    }
   ],
   "common_errors": [
    {
     "wrong": "もし明日雨たら、家で映画を見よう。",
     "why": "名词和な形容词要用「だったら」，不能直接接 たら",
     "fix": "もし明日雨だったら、家で映画を見よう。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-(으)면 / -았/었더니",
   "ko_diff": "韩语 -(으)면 表条件，-았/었더니 表前项完成后的发现；日语 たら 一个形式兼表两者，使用范围更广。",
   "notes": "",
   "tags": [
    "condition",
    "time"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
