 "grammar": [
  {
   "id": "G0269",
   "pattern": "〜より",
   "meaning_zh": "比…",
   "connection": "名词 + より",
   "usage": "表示比较的基准，常与「の方が」呼应。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "今日はきのうより寒いです。",
     "zh": "今天比昨天冷。"
    },
    {
     "ja": "電車はバスより速いです。",
     "zh": "电车比公交车快。"
    },
    {
     "ja": "兄は父より背が高いです。",
     "zh": "哥哥比父亲高。"
    }
   ],
   "prerequisites": [
    "G0034"
   ],
   "compare": [
    {
     "id": "G0270",
     "diff": "より 标比较基准，の方が 标较优的一方"
    }
   ],
   "common_errors": [
    {
     "wrong": "今日はきのうよりが寒いです。",
     "why": "より 后不加 が",
     "fix": "今日はきのうより寒いです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "보다",
   "ko_diff": "韩语 보다 与 より 对应，位置在比较对象后；日语 より 后直接接形容词，韩语 보다 后也直接接，语序相近。",
   "notes": "",
   "tags": [
    "particle",
    "comparison"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
