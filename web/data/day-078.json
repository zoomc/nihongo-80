 "grammar": [
  {
   "id": "G0055",
   "pattern": "～によって / ～について / ～にとって",
   "meaning_zh": "因…而异／关于…／对…来说",
   "connection": "名詞 + によって／について／にとって",
   "usage": "によって 表「因…而不同/依据/手段被动」、について「关于」、にとって「对…而言（评价）」",
   "notes": "によって/について/にとって 三者的细微语感与部分教材归类待二次核实；例句与释义按通用辞书用法给出。",
   "register_note": "によって/について/にとって 偏正式书面，口语也用 について。",
   "examples": [
    {
     "ja": "人によって意見が違います。",
     "zh": "意见因人而异。",
     "vocab_ids": [
      "V0077"
     ]
    },
    {
     "ja": "日本語について話します。",
     "zh": "谈谈日语。",
     "vocab_ids": [
      "V0081",
      "V0114"
     ]
    },
    {
     "ja": "私にとって、日本語は難しいです。",
     "zh": "对我来说日语很难。",
     "vocab_ids": [
      "V0001",
      "V0081",
      "V0132"
     ]
    }
   ],
   "prerequisites": [
    "G0009",
    "G0006"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "私について、日本語は難しいです",
     "why": "「对…来说」用 にとって，について 是「关于」，中文「对」易混",
     "fix": "私にとって、日本語は難しいです。",
     "learner": "zh"
    },
    {
     "wrong": "人にとって 意見が違います",
     "why": "「因…而异」用 によって，にとって 是评价立场",
     "fix": "人によって意見が違います。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "particle"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-에 따라 / -에 대해 / -에게",
   "ko_diff": "韩语에 따라表依据或随…而异，에 대해关于，에게表评价对象，三者分工比日语清楚。"
  },
  {
   "id": "G0065",
   "pattern": "V辞書形/Vない形 + ことに する / なる",
   "meaning_zh": "（自己）决定…／（结果）定为…、将要…",
   "connection": "動詞 普通形 + ことに + する（主观决定）/ なる（客观决定、自然结果）；する・なる 可变形",
   "usage": "ことにする 是说话人做决定；ことになる 是外部/组织决定或事态发展结果，与本人意志无关",
   "register_note": "ことにする/なる 口语书面通用，注意决定来自本人还是外部。",
   "examples": [
    {
     "ja": "禁煙することにしました。",
     "zh": "我决定戒烟了。",
     "vocab_ids": [
      "V0161"
     ]
    },
    {
     "ja": "来月から転勤することになりました。",
     "zh": "定下下个月起调职了。",
     "vocab_ids": [
      "V0030",
      "V0243"
     ]
    }
   ],
   "prerequisites": [
    "G0023",
    "G0022",
    "G0035"
   ],
   "compare": [
    {
     "id": "G0064",
     "diff": "ようにする 是持续努力/习惯；ことにする 是一次性「做出决定」"
    },
    {
     "id": "G0035",
     "diff": "〜に する 是把…变成/选成；ことにする 是「决定做某动作」"
    }
   ],
   "common_errors": [
    {
     "wrong": "禁煙することになりました。（自己决定时）",
     "why": "自己下的决定用 ことにする；ことになる 是外部/客观决定，中文「我决定」直译易错",
     "fix": "禁煙することにしました。",
