 "grammar": [
  {
   "id": "G0248",
   "pattern": "〜が（subject）",
   "meaning_zh": "…是主语；提示新信息",
   "connection": "名词 + が",
   "usage": "指出动作主体或新信息，疑问词作主语时必须用 が。",
   "register_note": "口语与书面通用；书面语中 が 的连接用法更多。",
   "examples": [
    {
     "ja": "雨が降っています。",
     "zh": "下雨了。"
    },
    {
     "ja": "だれが窓を開けましたか。",
     "zh": "谁打开了窗户？"
    },
    {
     "ja": "私が行きます。",
     "zh": "我去。"
    }
   ],
   "prerequisites": [
    "G0007"
   ],
   "compare": [
    {
     "id": "G0247",
     "diff": "が 提示新信息或焦点，は 提示已知主题"
    }
   ],
   "common_errors": [
    {
     "wrong": "だれは窓を開けましたか。",
     "why": "疑问词作主语必须用 が，不能用 は",
     "fix": "だれが窓を開けましたか。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "이/가（주어·신정보）",
   "ko_diff": "韩语 이/가 同样标新信息主语；日语疑问词主语强制用 が，韩语疑问词后也强制 이/가，这点相近，差别在日语 は 的对比用法更重。",
   "notes": "",
   "tags": [
    "particle"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0249",
   "pattern": "〜を",
   "meaning_zh": "…是宾语；经过的场所",
   "connection": "名词 + を（读作 o）",
   "usage": "标记动作的直接对象，或移动经过、离开的场所。",
   "register_note": "口语与书面通用；书面语中常与汉语句式混用需注意。",
   "examples": [
    {
     "ja": "毎朝パンを食べます。",
     "zh": "每天早上吃面包。"
    },
    {
     "ja": "姉は新しいかばんを買いました。",
     "zh": "姐姐买了一个新包。"
    },
    {
     "ja": "公園を散歩しました。",
     "zh": "在公园散了步。"
    }
   ],
   "prerequisites": [
    "G0008"
   ],
   "compare": [
    {
     "id": "G0256",
     "diff": "を 标对象或经过场所，で 标动作发生场所"
    }
   ],
   "common_errors": [
    {
     "wrong": "公園に散歩しました。",
     "why": "散歩する 的经过场所用 を，に 表示到达点",
     "fix": "公園を散歩しました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "을/를（목적어）",
   "ko_diff": "韩语 을/를 只标宾语；日语 を 还标移动经过的场所（公園を歩く），韩语此处用 를 或 에서，需单独记。",
