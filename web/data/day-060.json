 "grammar": [
  {
   "id": "G0215",
   "pattern": "〜せられる / 〜させられる",
   "meaning_zh": "被迫做…",
   "connection": "五段动词未然形+せられる（口语 される）；一段动词未然形+させられる",
   "usage": "表示不情愿地被迫做某事，含有受害或无奈的语气。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "子どものころ、母に毎日ピアノを練習させられた。",
     "zh": "小时候母亲每天逼我练钢琴。"
    },
    {
     "ja": "駅で三十分も待たされました。",
     "zh": "我在车站被迫等了三十分钟。"
    },
    {
     "ja": "会社の飲み会で歌を歌わされた。",
     "zh": "公司聚会上我被逼着唱了歌。"
    }
   ],
   "prerequisites": [
    "G0049",
    "G0050"
   ],
   "compare": [
    {
     "id": "G0214",
     "diff": "使役受身 是被迫做，使役 是让别人做"
    }
   ],
   "common_errors": [
    {
     "wrong": "駅で三十分も待たせられました。",
     "why": "待つ 的使役受身是「待たされる」，不是「待たせられる」",
     "fix": "駅で三十分も待たされました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-게 시킴을 당하다",
   "ko_diff": "韩语没有专门的使役被动词尾，通常说 -하도록 강요받다 或 -게 되다；日语有固定的使役受身活用，语气更强调被迫。",
   "notes": "",
   "tags": [
    "voice",
    "conjugation"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0216",
   "pattern": "〜おう / 〜よう",
   "meaning_zh": "…吧；我要…",
   "connection": "五段动词词尾改お段+う；一段动词去る+よう；する→しよう；来る→来よう",
   "usage": "表示提议、劝诱或说话人自己的意志，口语中常用于自言自语。",
   "register_note": "普通体；礼貌体用「〜ましょう」。",
   "examples": [
    {
     "ja": "疲れたね。少し休もう。",
     "zh": "累了吧，稍微休息一下吧。"
    },
    {
     "ja": "週末、一緒に映画を見ようよ。",
     "zh": "周末一起去看电影吧。"
    },
    {
     "ja": "よし、今日から毎日日記を書こう。",
     "zh": "好，从今天起我每天写日记。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
