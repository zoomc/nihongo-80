 "grammar": [
  {
   "id": "G0060",
   "pattern": "N に Vて ほしい / Vないで ほしい",
   "meaning_zh": "希望（别人）做…／希望别…",
   "connection": "動詞 て形 + ほしい；否定 ない形 + で + ほしい；动作主体用 に（或 が）",
   "usage": "对他人的愿望；不能用于自己（自己用 〜たい G0031）；也不直接对长辈说 てほしい（改用 G0073）",
   "register_note": "てほしい 对平辈或下级用；对上级改用 G0073。",
   "examples": [
    {
     "ja": "もう少し待ってほしいです。",
     "zh": "希望（你）再等一下。",
     "vocab_ids": [
      "V0140",
      "V0116"
     ]
    },
    {
     "ja": "大きな声で話さないでほしいです。",
     "zh": "希望别大声说话。",
     "vocab_ids": [
      "V0127",
      "V0114"
     ]
    }
   ],
   "prerequisites": [
    "G0020",
    "G0022",
    "G0033"
   ],
   "compare": [
    {
     "id": "G0031",
     "diff": "〜たい 是说话人自己想做；〜てほしい 是希望别人做，主体用 に"
    },
    {
     "id": "G0026",
     "diff": "〜てください 是普通请求；对长辈用 ていただけませんか 更礼貌，てほしい 不宜直说"
    }
   ],
   "common_errors": [
    {
     "wrong": "私は映画を見てほしいです。",
     "why": "「我想看」应用 見たい；てほしい 是希望别人做，中文「想」不分主体易错",
     "fix": "映画が見たいです。",
     "learner": "zh"
    },
    {
     "wrong": "先生に待ってほしいです。",
     "why": "对长辈直接说 てほしい 失礼，中文「希望老师等一下」直译不得体",
     "fix": "先生に少しお待ちいただけませんか。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "tags": [
    "te-form",
    "desire",
    "request",
    "polite"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-아/어 주기를 바라다",
   "ko_diff": "韩语希望别人做用주기를 바라다，对长辈须加시；日语てほしい不宜直接对长辈说。"
  },
  {
   "id": "G0061",
   "pattern": "名詞/な形词干 + みたい(だ/な/に)",
   "meaning_zh": "好像…；像…一样（口语推量/比喻）",
   "connection": "名詞 + みたい（不加 の）；な形 词干 + みたい；動詞/い形 普通形 + みたい；みたいな＋名／みたいに＋動",
   "usage": "口语版 〜ようだ（G0044）；比 らしい/そう 更随意；比喻用 まるで…みたい",
   "register_note": "みたい 口语随意，正式书面改用 ようだ。",
   "examples": [
    {
     "ja": "彼は元気じゃないみたいです。",
     "zh": "他好像不太精神。",
     "vocab_ids": [
      "V0074",
      "V0135"
     ]
    },
    {
     "ja": "今日は春みたいに暖かいです。",
     "zh": "今天暖和得像春天。",
     "vocab_ids": [
      "V0023",
      "V0133"
     ]
    }
   ],
   "prerequisites": [
    "G0016",
    "G0023"
   ],
   "compare": [
    {
     "id": "G0044",
     "diff": "ようだ 更书面，名词要接 の ようだ；みたい 是口语，名词直接接"
    },
    {
     "id": "G0043",
     "diff": "そうです 样态是「看上去就要/显得」；みたい 是推量/比喻"
    }
   ],
   "common_errors": [
    {
     "wrong": "彼は学生のみたいです。",
     "why": "名词接 みたい 不加 の（ようだ 才要 の）；中文「像是学生」直译加 の 错",
     "fix": "彼は学生みたいです。",
     "learner": "zh"
    },
    {
     "wrong": "彼女はモデルみたいなきれいです。",
     "why": "修饰动词/形容词用 みたいに，修饰名词用 みたいな；中文「像…一样漂亮」直译错用 みたいな",
     "fix": "彼女はモデルみたいにきれいです。",
     "learner": "zh"
    }
   ],
