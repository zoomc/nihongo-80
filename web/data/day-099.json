 "grammar": [
  {
   "id": "G0107",
   "pattern": "〜ことにしている",
   "meaning_zh": "习惯上…；坚持…",
   "connection": "动词辞书形/ない形 + ことにしている",
   "usage": "说明自己有意保持的习惯或规矩，主语多为第一人称。",
   "register_note": "口语书面均可，正式场合用「ことにしております」。",
   "examples": [
    {
     "ja": "健康のために、週に三回はジムに通うことにしている。",
     "zh": "为了健康，我规定自己每周去三次健身房。"
    },
    {
     "ja": "夜十時以降は、スマホを見ないことにしています。",
     "zh": "我规定晚上十点以后不看手机。"
    },
    {
     "ja": "父は、給料日には家族を外食に連れていくことにしている。",
     "zh": "父亲一到发薪日就带家人出去吃饭。"
    }
   ],
   "prerequisites": [
    "G0065"
   ],
   "compare": [
    {
     "id": "G0108",
     "diff": "ことにしている 是个人主动定的习惯，ことになっている 是外部规定的规则。"
    }
   ],
   "common_errors": [
    {
     "wrong": "健康のために、週に三回ジムに通いことにしている。",
     "why": "「ことにしている」前接辞书形「通う」，不能接ます形词干「通い」。",
     "fix": "通うことにしている",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-기로 하고 있다",
   "ko_diff": "韩语「-기로 하다」多指一次性决定；日语「ことにしている」用「ている」表长期坚持，韩语要靠「-곤 한다」才接近。",
   "notes": "",
   "tags": [
    "decision",
    "tendency"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0108",
   "pattern": "〜ことになっている",
   "meaning_zh": "规定…；按理…",
   "connection": "动词辞书形/ない形 + ことになっている",
   "usage": "陈述集体规定、既定安排或社会惯例，不由个人意志决定。",
   "register_note": "口语书面均可，通知和规章中常见。",
   "examples": [
    {
     "ja": "この寮では、夜十一時までに戻ることになっている。",
     "zh": "这栋宿舍规定晚上十一点前必须回来。"
    },
    {
     "ja": "来月から大阪の支社で働くことになっています。",
     "zh": "安排我从下个月起去大阪分公司工作。"
    },
    {
     "ja": "図書館の中では、飲み物を飲んではいけないことになっている。",
     "zh": "图书馆规定里面不能喝饮料。"
    }
   ],
   "prerequisites": [
    "G0065"
   ],
   "compare": [
    {
     "id": "G0107",
     "diff": "ことになっている 是外部规定，ことにしている 是自己定的规矩。"
    }
   ],
   "common_errors": [
    {
     "wrong": "この寮では、夜十一時までに戻ることになっているです。",
     "why": "「ことになっている」是普通体，礼貌说法是「ことになっています」。",
     "fix": "戻ることになっています",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-기로 되어 있다",
   "ko_diff": "韩语「-기로 되어 있다」同样表既定安排；但日语还能暗示“规定如此、实际未必”，带距离感，韩语较少这层含义。",
