 "grammar": [
  {
   "id": "G0154",
   "pattern": "〜ついでに",
   "meaning_zh": "顺便…",
   "connection": "动词辞书形/た形 + ついでに；名词 + の + ついでに",
   "usage": "表示利用做某事的机会，顺便再做另一件事。",
   "register_note": "口语为主。",
   "examples": [
    {
     "ja": "郵便局へ行くついでに、この手紙も出してきてくれる？",
     "zh": "你去邮局的话，顺便帮我把这封信寄了好吗？"
    },
    {
     "ja": "京都へ出張したついでに、昔の友達に会ってきた。",
     "zh": "去京都出差时，顺便见了老朋友。"
    },
    {
     "ja": "買い物のついでに、図書館に本を返した。",
     "zh": "买东西时顺便把书还给了图书馆。"
    }
   ],
   "prerequisites": [
    "G0087"
   ],
   "compare": [
    {
     "id": "G0151",
     "diff": "たびに 是“每次必做”，ついでに 是“顺手多做一件”，不具反复性。"
    }
   ],
   "common_errors": [
    {
     "wrong": "京都へ出張するのついでに、昔の友達に会ってきた。",
     "why": "动词直接接「ついでに」，只有名词才加「の」。",
     "fix": "出張したついでに",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-는 김에",
   "ko_diff": "韩语「-는 김에」同样表“顺便”，与「ついでに」对应；但日语可接名词+の，韩语只接动词。",
   "notes": "",
   "tags": [
    "simultaneity",
    "addition"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0155",
   "pattern": "〜おかげで",
   "meaning_zh": "多亏…；托…的福",
   "connection": "动词普通形/い形容词/ナ形容词な/名词の + おかげで",
   "usage": "表示因某原因得到好结果，含感谢语气。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "先輩が手伝ってくれたおかげで、仕事が早く終わった。",
     "zh": "多亏前辈帮忙，工作很快就做完了。"
    },
    {
     "ja": "薬が効いたおかげで、熱が下がった。",
     "zh": "多亏药效，烧退了。"
    },
    {
     "ja": "駅が近いおかげで、雨の日も楽に通勤できる。",
     "zh": "幸好离车站近，下雨天通勤也轻松。"
    }
   ],
   "prerequisites": [
    "G0054"
   ],
   "compare": [
    {
     "id": "G0156",
     "diff": "おかげで 引出好结果并表感谢，せいで 引出坏结果并含责备。"
    }
   ],
   "common_errors": [
    {
     "wrong": "駅が近いのおかげで、雨の日も楽に通勤できる。",
     "why": "い形容词直接接「おかげで」，只有名词才加「の」。",
     "fix": "駅が近いおかげで",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-덕분에",
   "ko_diff": "韩语「-덕분에」与「おかげで」对应；但日语还能用于讽刺（「おかげで遅れた」），韩语同样可以，需靠上下文判断。",
