 "listening": false,
 "grammar": [
  {
   "id": "G0114",
   "pattern": "〜一方で",
   "meaning_zh": "一方面…；同时…",
   "connection": "普通形 + 一方で；ナ形容词 + な + 一方で；名词 + である + 一方で",
   "usage": "并列同一事物的两个侧面，或表两件事同时进行。",
   "register_note": "书面语为主，论述文常用。",
   "examples": [
    {
     "ja": "インターネットは便利な一方で、危険な面もある。",
     "zh": "互联网很方便，另一方面也有危险的一面。"
    },
    {
     "ja": "この会社は給料が高い一方で、休みがとても少ない。",
     "zh": "这家公司工资高，但休假很少。"
    },
    {
     "ja": "彼女は会社で働く一方で、夜は大学院に通っている。",
     "zh": "她一边在公司上班，晚上一边读研究生。"
    }
   ],
   "prerequisites": [
    "G0085"
   ],
   "compare": [
    {
     "id": "G0113",
     "diff": "一方だ 是单向变化，一方で 是对比两面或并行两事。"
    }
   ],
   "common_errors": [
    {
     "wrong": "インターネットは便利だ一方で、危険な面もある。",
     "why": "な形容词接 一方で 用 な：便利な一方で。",
     "fix": "便利な一方で",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-는 반면에",
   "ko_diff": "韩语「-는 반면에」只表对比；日语「一方で」还能表“同时进行的两件事”，范围更宽。",
   "notes": "",
   "tags": [
    "contrast",
    "simultaneity"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "pattern_kana": "〜いっぽうで",
   "ko_pron": "〜이뽀우데"
  },
  {
   "id": "G0115",
   "pattern": "〜に対して",
   "meaning_zh": "对…；与…相对",
   "connection": "名词 + に対して（针对、相对）；对比两个判断时，动词、い形普通形 + のに対して，な形 + なのに対して，名词 + なのに対して／であるのに対して。",
   "usage": "表动作或态度的对象，也用于前后对比。",
   "register_note": "口语书面均可，对比用法偏书面。",
   "examples": [
    {
     "ja": "お客様に対して、そんな言い方をしてはいけない。",
     "zh": "对客人不能那么说话。"
    },
    {
     "ja": "新しい税金に対する反対の声が高まっている。",
     "zh": "反对新税的声音越来越大。"
    },
    {
     "ja": "東京は晴れているのに対して、大阪は朝から大雨だ。",
     "zh": "东京是晴天，而大阪从早上就下大雨。"
    }
   ],
   "prerequisites": [
    "G0076"
   ],
   "compare": [
    {
     "id": "G0141",
     "diff": "に対して 表对象或对比，にとって 表“从某人立场看”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "東京は晴れているに対して、大阪は朝から大雨だ。",
     "why": "动词小句后接对比的 に対して，要用 のに対して。",
     "fix": "晴れているのに対して",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "…에게 / …에 대해 / 반면에",
   "ko_diff": "人に対して失礼だ 可对应 사람에게 무례하다。要对比前后情况时，用 のに対して，对照 -는 반면에。",
   "notes": "",
   "tags": [
    "relation",
    "contrast"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "pattern_kana": "〜にたいして",
   "ko_pron": "〜니타이시테"
  },
  {
   "id": "G0116",
   "pattern": "〜について",
   "meaning_zh": "关于…",
   "connection": "名词 + について；名词 + についての + 名词",
   "usage": "指出谈话、思考或调查的主题。",
   "register_note": "口语书面均可，比「に関して」日常。",
   "examples": [
    {
     "ja": "今日の授業では、日本の食文化について話し合いました。",
     "zh": "今天的课上我们讨论了日本饮食文化。"
    },
    {
     "ja": "新しい商品についての質問は、こちらのメールアドレスまでお送りください。",
     "zh": "关于新产品的疑问请发到这个邮箱。"
    },
    {
     "ja": "その事件について、警察はまだ何も発表していない。",
     "zh": "关于那起事件，警方还没有任何发布。"
    }
   ],
   "prerequisites": [
    "G0055"
   ],
   "compare": [
    {
     "id": "G0144",
     "diff": "について 日常通用，に関して 更正式、更书面。"
    }
   ],
   "common_errors": [
    {
     "wrong": "今日の授業では、日本の食文化をについて話し合いました。",
     "why": "について 本身已含助词作用，不能再叠 を。",
     "fix": "食文化について",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-에 대해서",
   "ko_diff": "회의에 대해 이야기하다 对照 会議について話す；회의에 관한 자료 对照 会議についての資料。修饰日语名词时，について 后要接 の。",
   "notes": "",
   "tags": [
    "topic",
