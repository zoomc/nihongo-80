 "grammar": [
  {
   "id": "G0231",
   "pattern": "〜けど / 〜けれども",
   "meaning_zh": "但是…；虽然…",
   "connection": "句子普通形 + けど／けれども（礼貌体可直接接）",
   "usage": "表示转折，或用来缓和语气、引出请求与铺垫。",
   "register_note": "けど 口语；けれども 较正式。",
   "examples": [
    {
     "ja": "この店は高いけど、おいしい。",
     "zh": "这家店贵，但很好吃。"
    },
    {
     "ja": "すみません、駅に行きたいんですけど、どう行けばいいですか。",
     "zh": "不好意思，我想去车站，请问怎么走？"
    },
    {
     "ja": "何度も電話したけれども、誰も出なかった。",
     "zh": "我打了好几次电话，但没人接。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0226",
     "diff": "けど 中性转折，のに 带不满"
    }
   ],
   "common_errors": [
    {
     "wrong": "この店は高いだけど、おいしい。",
     "why": "い形容词接 けど 不加 だ",
     "fix": "この店は高いけど、おいしい。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-지만",
   "ko_diff": "韩语 -지만 与 けど 对应，但日语 けど 还可放在句末缓和语气、引出下文；韩语 -지만 一般不能这样独立使用。",
   "notes": "",
   "tags": [
    "contrast",
    "casual"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0232",
   "pattern": "〜ために",
   "meaning_zh": "为了…；因为…",
   "connection": "动词辞书形／动词た形 + ために；名词 + の + ために",
   "usage": "前接意志动词表目的，前接名词或过去形表原因，后者较书面。",
   "register_note": "书面语常用；口语目的多用「ように」。",
   "examples": [
    {
     "ja": "日本の大学に入るために、毎日勉強しています。",
     "zh": "为了考进日本的大学，我每天学习。"
    },
    {
     "ja": "家族のために、一生懸命働いている。",
     "zh": "我为了家人拼命工作。"
    },
    {
     "ja": "大雪のために、電車が止まりました。",
     "zh": "因为大雪，电车停运了。"
    }
   ],
   "prerequisites": [
    "G0023",
    "G0006"
   ],
   "compare": [
    {
     "id": "G0233",
     "diff": "ために 前接意志动词，ように 多接非意志状态"
    }
   ],
   "common_errors": [
    {
     "wrong": "大雪のためで、電車が止まりました。",
     "why": "名词接 ために 用「の」，不是「で」",
     "fix": "大雪のために、電車が止まりました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-기 위해(서) / 때문에",
   "ko_diff": "韩语 -기 위해(서) 表目的，때문에 表原因，两者形式不同；日语 ために 一个形式兼表目的与原因，需靠前接成分判断。",
