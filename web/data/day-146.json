  },
  {
   "id": "G0350",
   "pattern": "〜もかまわず",
   "pattern_kana": "",
   "meaning_zh": "不顾…",
   "ko_equiv": "…에 아랑곳하지 않고 / …도 신경 쓰지 않고",
   "connection": "名词 + もかまわず / 动词普通形 + の + もかまわず",
   "usage": "",
   "ko_diff": "实际行动无视某个后果或外界的看法。名词可直接接「も」，动词小句先用「の」名词化。",
   "examples": [
    {
     "ja": "彼女は人目もかまわず、駅のホームで大声で泣いた。",
     "en": "She cried out loud on the station platform, not caring who was watching.",
     "zh": "她不顾旁人的目光，在车站站台上放声大哭。"
    },
    {
     "ja": "服が汚れるのもかまわず、子どもたちは泥の中で遊び続けた。",
     "en": "The children kept playing in the mud without caring that their clothes were getting dirty.",
     "zh": "孩子们不管衣服会不会弄脏，继续在泥地里玩。"
    }
   ],
