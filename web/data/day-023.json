  {
   "id": "G0272",
   "pattern": "〜の中で〜が一番",
   "meaning_zh": "在…中最…",
   "connection": "名词（范围）+ の中で + 名词 + が一番 + 形容词",
   "usage": "在三个以上的人或事物中选出程度最高者。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "果物の中でりんごが一番好きです。",
     "zh": "水果里我最喜欢苹果。"
    },
    {
     "ja": "クラスの中でだれが一番背が高いですか。",
     "zh": "班里谁最高？"
    },
    {
     "ja": "家族の中で父が一番早く起きます。",
     "zh": "家里父亲起得最早。"
    }
   ],
   "prerequisites": [
    "G0034"
   ],
   "compare": [
    {
     "id": "G0271",
     "diff": "一番 用于三者以上，どちらが 用于两者"
    }
   ],
   "common_errors": [
    {
