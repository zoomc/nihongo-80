 "grammar": [
  {
   "id": "G0275",
   "pattern": "〜ではありません / 〜じゃない",
   "meaning_zh": "不是…",
   "connection": "名词／な形容词 + ではありません（礼貌）／じゃない（普通）",
   "usage": "否定判断句，礼貌体用 ではありません，口语用 じゃない。",
   "register_note": "ではありません 礼貌正式；じゃない 口语。",
   "examples": [
    {
     "ja": "私は先生ではありません。学生です。",
     "zh": "我不是老师，是学生。"
    },
    {
     "ja": "今日は休みじゃない。",
     "zh": "今天不是休息日。"
    },
    {
     "ja": "この町はあまりにぎやかではありません。",
     "zh": "这个镇不太热闹。"
    }
   ],
   "prerequisites": [
    "G0002"
   ],
   "compare": [
    {
     "id": "G0273",
     "diff": "ではありません 是否定礼貌体，です 是肯定礼貌体"
    }
   ],
   "common_errors": [
    {
     "wrong": "私は先生ではありませんだ。",
     "why": "ではありません 已是完整否定，不能再加 だ",
     "fix": "私は先生ではありません。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "아니다 / 아닙니다",
   "ko_diff": "韩语 아니다 是独立形容词，需接 이/가（학생이 아닙니다）；日语 ではありません 直接接名词，不用助词，这是常见差异。",
   "notes": "",
   "tags": [
    "copula",
    "negation"
   ],
   "source_ids": [
    "S900"
   ],
