 "grammar": [
  {
   "id": "G0219",
   "pattern": "〜な（prohibition）",
   "meaning_zh": "不许…；别…",
   "connection": "动词辞书形 + な",
   "usage": "表示强烈的禁止，多用于告示、男性口语或紧急提醒。",
   "register_note": "粗鲁；告示中常见，对长辈不宜使用。",
   "examples": [
    {
     "ja": "危ないから、この川では泳ぐな。",
     "zh": "这里很危险，不要在这条河里游泳。"
    },
    {
     "ja": "もう泣くな。大丈夫だよ。",
     "zh": "别哭了，没事的。"
    },
    {
     "ja": "壁に「ここにごみを捨てるな」と書いてある。",
     "zh": "墙上写着“请勿在此倒垃圾”。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0029",
     "diff": "な 是强烈禁止，てはいけない 是规则性不许"
    }
   ],
   "common_errors": [
    {
     "wrong": "危ないから、この川では泳がないな。",
     "why": "禁止形是辞书形+な，不是ない形+な",
     "fix": "危ないから、この川では泳ぐな。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-지 마라",
   "ko_diff": "韩语 -지 마라 与禁止形对应，语气同样强硬；日语禁止形只接辞书形，韩语则接词干，接续方式不同。",
   "notes": "",
