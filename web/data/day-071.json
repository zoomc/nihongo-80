 "grammar": [
  {
   "id": "G0236",
   "pattern": "〜てほしい",
   "meaning_zh": "希望（别人）做…",
   "connection": "动词て形 + ほしい；动词ない形 + でほしい",
   "usage": "表示说话人希望他人做某事，动作主体用 に 标记。",
   "register_note": "口语与书面通用；直接对上级使用略显强加，宜婉转。",
   "examples": [
    {
     "ja": "もう少しゆっくり話してほしいです。",
     "zh": "我希望你说得再慢一点。"
    },
    {
     "ja": "この話は誰にも言わないでほしい。",
     "zh": "这件事我希望你不要告诉任何人。"
    },
    {
     "ja": "早く春が来てほしいなあ。",
     "zh": "真希望春天快点来啊。"
    }
   ],
   "prerequisites": [
    "G0020",
    "G0033"
   ],
   "compare": [
    {
     "id": "G0237",
     "diff": "てほしい 是希望别人做，たがる 是别人想做"
    }
   ],
   "common_errors": [
    {
     "wrong": "もう少しゆっくり話すほしいです。",
     "why": "ほしい 前接て形，不是辞书形",
     "fix": "もう少しゆっくり話してほしいです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아/어 주기를 바라다",
   "ko_diff": "韩语 -아/어 주기를 바라다 与 てほしい 对应，但更正式；日语 てほしい 可直接用于日常请求，语气比韩语表达更随意。",
   "notes": "",
   "tags": [
    "desire",
    "request"
   ],
