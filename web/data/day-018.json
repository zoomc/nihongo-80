 "grammar": [
  {
   "id": "G0041",
   "pattern": "～たり ～たり する",
   "meaning_zh": "又…又…／时而…时而…",
   "connection": "動詞た形 + り + 動詞た形 + り + する",
   "usage": "列举代表性动作/状态；句末必须 する 收尾",
   "register_note": "たりたりする 口语叙事常用，书面列举也可。",
   "examples": [
    {
     "ja": "休みの日は、本を読んだり音楽を聞いたりします。",
     "zh": "休息日看看书、听听音乐。",
