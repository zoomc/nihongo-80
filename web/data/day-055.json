 "grammar": [
  {
   "id": "G0205",
   "pattern": "〜すぎる",
   "meaning_zh": "过于…；…过头",
   "connection": "动词ます形去ます／い形容词去い／な形容词词干 + すぎる",
   "usage": "表示程度超过适当范围，常带负面评价。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "ゆうべ飲みすぎて、頭が痛い。",
     "zh": "昨晚喝多了，头好痛。"
    },
    {
     "ja": "この靴は私には大きすぎます。",
     "zh": "这双鞋对我来说太大了。"
    },
    {
     "ja": "この問題は簡単すぎて、つまらない。",
     "zh": "这道题太简单了，很无聊。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0206",
     "diff": "すぎる 表程度过度，方 表做法"
    }
   ],
   "common_errors": [
    {
     "wrong": "この靴は私には大きいすぎます。",
     "why": "い形容词接 すぎる 要去掉 い：大きすぎる",
     "fix": "この靴は私には大きすぎます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "너무 …하다",
   "ko_diff": "韩语用「너무」+形容词，位置在词前；日语 すぎる 是后缀，接在词干后，且可用于动词（食べすぎる），韩语需说 너무 많이 먹다。",
