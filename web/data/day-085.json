 "grammar": [
  {
   "id": "G0078",
   "pattern": "N + に 基づいて / を もとに / どおり(に)",
   "meaning_zh": "基于…／以…为依据／按照…",
   "connection": "名詞 + に基づいて（依据资料/规则/数据）；名詞 + をもとに（以…为素材/基础）；名詞 + どおり(に)（照原样、按预定）",
   "usage": "书面；に基づいて 偏「依据权威来源」，をもとに 偏「以…为材料加工」，どおり 偏「不改动地照做」",
   "register_note": "に基づいて/をもとに/どおり 书面正式，口语少用。",
   "examples": [
    {
     "ja": "調査結果に基づいて、報告書を作成しました。",
     "zh": "依据调查结果写成了报告。",
     "vocab_ids": [
      "V0208",
      "V0247"
     ]
    },
    {
     "ja": "予定どおりに、会議を始めます。",
     "zh": "按预定开始会议。",
     "vocab_ids": [
      "V0186",
      "V0244",
      "V0160"
     ]
    }
   ],
   "prerequisites": [
    "G0009",
    "G0006",
    "G0023"
   ],
   "compare": [
    {
     "id": "G0055",
     "diff": "によって 表原因/手段；に基づいて 表「以…为根据/来源」"
    },
    {
     "id": "G0077",
     "diff": "に伴って 是伴随变化；に基づいて 是静态依据，无变化义"
    }
   ],
   "common_errors": [
    {
     "wrong": "資料に基づいてに書きました。",
     "why": "に基づいて 已含 に，不再叠 に；中文「基于资料」直译叠加助词错",
     "fix": "資料に基づいて書きました。",
     "learner": "zh"
    },
    {
     "wrong": "アンケート結果をに基づいて改善します。",
     "why": "に基づいて 前用 に（結果に基づいて），もとに 才用 を；中文「以…为基础」直译混了 を 与 に",
     "fix": "アンケート結果に基づいて改善します。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
