 "grammar": [
  {
   "id": "G0143",
   "pattern": "〜にしても",
   "meaning_zh": "即使…；就算是…",
   "connection": "动词普通形/名词 + にしても",
   "usage": "先承认前项成立，再指出后项仍不受影响，含不满或让步。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "忙しかったにしても、電話一本ぐらいできたでしょう。",
     "zh": "就算再忙，至少也能打个电话吧。"
    },
    {
     "ja": "冗談にしても、そんな言い方はひどいよ。",
     "zh": "就算是开玩笑，那种说法也太过分了。"
    },
    {
     "ja": "引っ越すにしても、来年の春以降になると思います。",
     "zh": "就算要搬家，我想也要等到明年春天以后。"
    }
   ],
   "prerequisites": [
    "G0025"
   ],
   "compare": [
    {
     "id": "G0168",
     "diff": "としても 是纯粹的“即使”，にしても 常带“就算…也该…”的责备。"
    }
   ],
   "common_errors": [
    {
     "wrong": "忙しかったのにしても、電話一本ぐらいできたでしょう。",
     "why": "「にしても」直接接普通形，不能加「の」。",
     "fix": "忙しかったにしても",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-다고 해도",
   "ko_diff": "韩语「-다고 해도」与「にしても」对应；但日语常隐含责备，韩语语气更中性，需靠上下文补出不满。",
   "notes": "",
   "tags": [
    "concession"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0144",
   "pattern": "〜に関して / 〜に関する",
   "meaning_zh": "关于…；就…",
   "connection": "名词 + に関して；名词 + に関する + 名词",
   "usage": "引出话题，语气比「について」正式、郑重。",
   "register_note": "书面语为主，公文和商务文书常用。",
   "examples": [
    {
     "ja": "新しいサービスに関してご質問がある方は、受付までどうぞ。",
     "zh": "对新服务有疑问的人，请到前台咨询。"
    },
    {
     "ja": "彼は日本の歴史に関する本をたくさん持っている。",
     "zh": "他有很多关于日本历史的书。"
    },
    {
     "ja": "事故の原因に関しては、現在調査中です。",
     "zh": "关于事故原因，目前正在调查。"
    }
   ],
   "prerequisites": [
    "G0076"
   ],
   "compare": [
    {
     "id": "G0116",
     "diff": "に関して 更正式、范围更大，について 更日常。"
    }
   ],
   "common_errors": [
    {
     "wrong": "彼は日本の歴史に関しての本をたくさん持っている。",
     "why": "修饰名词要用「に関する」，「に関しての」不合法。",
     "fix": "歴史に関する本",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
