  },
  {
   "id": "G0249",
   "pattern": "〜を",
   "meaning_zh": "…是宾语；经过的场所",
   "connection": "名词 + を（读作 o）",
   "usage": "标记动作的直接对象，或移动经过、离开的场所。",
   "register_note": "口语与书面通用；书面语中常与汉语句式混用需注意。",
   "examples": [
    {
     "ja": "毎朝パンを食べます。",
     "zh": "每天早上吃面包。"
    },
    {
     "ja": "姉は新しいかばんを買いました。",
     "zh": "姐姐买了一个新包。"
    },
    {
     "ja": "公園を散歩しました。",
     "zh": "在公园散了步。"
    }
   ],
   "prerequisites": [
    "G0008"
