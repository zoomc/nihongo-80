 "grammar": [
  {
   "id": "G0175",
   "pattern": "〜くせに",
   "meaning_zh": "明明…却…",
   "connection": "动词普通形/い形容词/ナ形容词な/名词の + くせに",
   "usage": "表示前后矛盾，带明显责备、轻视或不满。",
   "register_note": "口语为主，正式场合不宜。",
   "examples": [
    {
     "ja": "自分では何もしないくせに、人の仕事には文句ばかり言う。",
     "zh": "自己什么都不干，却老是对别人的工作挑毛病。"
    },
    {
     "ja": "知っているくせに、どうして教えてくれなかったの？",
     "zh": "你明明知道，为什么不告诉我？"
    },
    {
     "ja": "弟は体が大きいくせに、小さな虫をこわがる。",
     "zh": "弟弟个子那么大，却怕小虫子。"
    }
   ],
   "prerequisites": [
    "G0081"
   ],
   "compare": [
    {
     "id": "G0075",
     "diff": "のに 只表逆接、含遗憾，くせに 一定带责难和轻蔑。"
    }
   ],
   "common_errors": [
    {
     "wrong": "体が大きいのくせに、小さな虫を怖がる。",
     "why": "い形容词直接接 くせに。表示身份的名词才加 の，如 大人のくせに。",
     "fix": "体が大きいくせに、小さな虫を怖がる。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-(으)ㄴ/는 주제에",
   "ko_diff": "알면서도 모르는 척한다 较中性；说 知っているくせに 则明确带责备，可对照 아는 주제에。客观写作或向不熟的人说话时常用 のに 等较中性的表达。",
   "notes": "",
   "tags": [
    "concession",
    "criticism"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜쿠세니"
  },
  {
   "id": "G0176",
   "pattern": "〜から〜にかけて",
   "meaning_zh": "从…到…期间",
   "connection": "名词 + から + 名词 + にかけて",
   "usage": "表示时间或空间上大致的范围，边界较模糊。",
   "register_note": "书面语为主，天气预报和报道常见。",
   "examples": [
    {
     "ja": "今夜から明日の朝にかけて、強い雨が降るでしょう。",
     "zh": "今晚到明天早上预计会有强降雨。"
    },
    {
     "ja": "関東から東北にかけての広い地域で、強い揺れが観測された。",
     "zh": "从关东到东北的广大地区观测到了强烈摇晃。"
    },
    {
     "ja": "この花は、三月から四月にかけてきれいに咲く。",
     "zh": "这种花从三月到四月开得很美。"
    }
   ],
   "prerequisites": [
    "G0013"
   ],
   "compare": [
    {
     "id": "G0013",
     "diff": "から〜まで 边界明确，から〜にかけて 范围模糊、偏书面。"
    }
   ],
   "common_errors": [
    {
     "wrong": "今夜から明日の朝までにかけて、強い雨が降るでしょう。",
     "why": "「から〜にかけて」中间不再用「まで」，两种句式不能混用。",
     "fix": "今夜から明日の朝にかけて",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-에서 -에 걸쳐",
   "ko_diff": "韩语「-에서 -에 걸쳐」与「から〜にかけて」对应，都偏书面；日语中间不能插「まで」。",
   "notes": "",
   "tags": [
    "range",
    "time"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜카라〜니카케테"
  },
  {
   "id": "G0177",
   "pattern": "〜ぶり",
   "meaning_zh": "隔了…才；…的样子",
   "connection": "表示时间间隔：期间名词 + ぶり，如 五年ぶり；表示做事的样子：名词或动词词干 + ぶり，如 仕事ぶり、話しぶり。",
   "usage": "表隔了多久才做某事，或某动作、状态呈现的样子。",
   "register_note": "口语书面均可，「〜ぶりに」多用于久别重逢。",
   "examples": [
    {
     "ja": "五年ぶりに高校の友達に会って、話が止まらなかった。",
     "zh": "隔了五年见到高中同学，话停不下来。"
    },
    {
     "ja": "久しぶりですね。お元気でしたか。",
     "zh": "好久不见了，您一向可好？"
    },
    {
     "ja": "新入社員の仕事ぶりを見て、部長は安心したようだ。",
     "zh": "看到新员工的工作表现，部长似乎放心了。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0151",
     "diff": "たびに 表“每次”，ぶり 表“隔了多久才一次”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "五年ぶりにに友達と会いました。",
     "why": "ぶりに已有に，不再重复。",
     "fix": "五年ぶりに友達と会いました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-만에",
   "ko_diff": "韩语「-만에」与「ぶりに」对应；但日语「ぶり」还能接动词词干表“…的样子」（仕事ぶり），韩语不能直译。",
