 "grammar": [
  {
   "id": "G0187",
   "pattern": "あげる / くれる / もらう",
   "meaning_zh": "给…；别人给我…；从…得到",
   "connection": "给予者 は/が 接受者 に 物 を あげる；给予者 が 我方 に 物 を くれる；接受者 は 给予者 に/から 物 を もらう",
   "usage": "按给与方向和视角选择：我给别人用あげる，别人给我用くれる，我收到用もらう。",
   "register_note": "口语与书面通用；对长辈给予用「さしあげる」，从长辈处得到用「いただく」。",
   "examples": [
    {
     "ja": "私は弟に古いゲームをあげた。",
     "zh": "我把旧的游戏机给了弟弟。"
    },
    {
     "ja": "姉が誕生日にかわいいかばんをくれました。",
     "zh": "姐姐在我生日时送了我一个可爱的包。"
    },
    {
     "ja": "友達から旅行のおみやげをもらった。",
     "zh": "我收到了朋友旅行带回来的特产。"
    }
   ],
   "prerequisites": [
    "G0009",
    "G0008"
   ],
   "compare": [
    {
     "id": "G0188",
     "diff": "あげる 是物品的授受，てあげる 是动作的授受"
    },
    {
     "id": "G0189",
     "diff": "くれる 的给予者是他人，接受者是我方"
    }
   ],
   "common_errors": [
    {
     "wrong": "私は弟に古いゲームをくれた。",
     "why": "くれる 的给予者必须是他人，不能是「私」；我给别人要用 あげる",
     "fix": "私は弟に古いゲームをあげた。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "주다 / 받다",
   "ko_diff": "韩语 주다 不分方向，日语必须按「谁给谁」区分 あげる／くれる；韩语 받다 对应 もらう，但日语 もらう 的来源可用 に 或 から。",
   "notes": "",
   "tags": [
    "giving-receiving"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0188",
   "pattern": "〜てあげる",
   "meaning_zh": "为别人做…（施惠）",
   "connection": "动词て形 + あげる（对长辈用 さしあげる）",
   "usage": "表示说话人为他人做事，带有施恩语气，对上级需换敬语形式。",
   "register_note": "口语常用；直接对长辈说「〜てあげる」显得居高临下，宜用「〜てさしあげる」或委婉说法。",
   "examples": [
    {
     "ja": "妹の宿題を手伝ってあげました。",
     "zh": "我帮妹妹做了作业。"
    },
    {
     "ja": "道に迷っている人に、駅までの行き方を教えてあげた。",
     "zh": "我给迷路的人指了去车站的路。"
    },
    {
     "ja": "重そうだね。持ってあげようか。",
     "zh": "看起来好重啊，要我帮你拿吗？"
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [
    {
     "id": "G0189",
     "diff": "てあげる 是我为别人做，てくれる 是别人为我做"
    }
   ],
   "common_errors": [
    {
     "wrong": "妹の宿題を手伝うてあげました。",
     "why": "手伝う 的て形是「手伝って」，「うて」不是正确的活用",
     "fix": "妹の宿題を手伝ってあげました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아/어 주다",
   "ko_diff": "韩语 -아/어 주다 不区分谁受益，日语 てあげる 明确表示我方施惠；对长辈直接使用会显得失礼，韩语则靠敬语尾调整。",
