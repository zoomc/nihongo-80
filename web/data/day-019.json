 "grammar": [
  {
   "id": "G0260",
   "pattern": "〜や",
   "meaning_zh": "…和…等（部分列举）",
   "connection": "名词 + や + 名词（部分列举）",
   "usage": "列举若干代表性事物，暗示还有其他，常与「など」呼应。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "机の上に本や雑誌があります。",
     "zh": "桌子上有书、杂志等。"
    },
    {
     "ja": "スーパーで肉や野菜を買いました。",
     "zh": "我在超市买了肉、蔬菜等。"
    }
   ],
   "prerequisites": [
    "G0012"
   ],
   "compare": [
    {
     "id": "G0258",
     "diff": "や 部分列举，と 全部列举"
    }
   ],
   "common_errors": [
    {
     "wrong": "机の上に本や雑誌とがあります。",
     "why": "部分列举不用 と 收尾，可用「など」",
     "fix": "机の上に本や雑誌などがあります。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "나/이나",
   "ko_diff": "책이나 잡지 같은 것 对照 本や雑誌など，表示举些例子；要表达「书或杂志中选一个」，韩语还可用 이나，日语换成 本か雑誌。",
   "notes": "",
   "tags": [
    "particle",
    "example"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜야"
  },
  {
   "id": "G0262",
   "pattern": "〜も",
   "meaning_zh": "也…；（否定）也不…",
   "connection": "名词 + も",
   "usage": "表示同类追加，否定句中与前后 も 呼应表示「既不…也不…」。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "私も学生です。",
     "zh": "我也是学生。"
    },
    {
     "ja": "兄はサッカーも好きです。",
     "zh": "哥哥也喜欢足球。"
    },
    {
     "ja": "肉も魚も食べません。",
     "zh": "我既不吃肉也不吃鱼。"
    }
   ],
   "prerequisites": [
    "G0004"
   ],
   "compare": [
    {
     "id": "G0247",
     "diff": "も 表追加，は 表主题"
    }
   ],
   "common_errors": [
    {
     "wrong": "私もは学生です。",
     "why": "も 已含提示作用，不能与 は 叠用",
     "fix": "私も学生です。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "도",
   "ko_diff": "韩语 도 与 も 对应，且同样可叠用于否定并列（고기도 생선도）；日语 も 可顶替 は／が／を，韩语 도 也顶替主宾格助词。",
   "notes": "",
   "tags": [
    "particle",
    "addition"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜모"
  },
  {
   "id": "G0263",
   "pattern": "〜の（possessive）",
   "meaning_zh": "…的…",
   "connection": "名词 + の + 名词",
   "usage": "表示所属、属性、材料或同位关系，修饰名词时用 の。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "これは私のかさです。",
     "zh": "这是我的伞。"
    },
    {
     "ja": "日本語の先生はとてもやさしいです。",
     "zh": "日语老师非常温柔。"
    },
    {
     "ja": "駅の近くに新しい店があります。",
     "zh": "车站附近有一家新店。"
    }
   ],
   "prerequisites": [
    "G0006"
   ],
   "compare": [
    {
     "id": "G0247",
     "diff": "の 连接名词，は 提示主题"
    }
   ],
   "common_errors": [
    {
     "wrong": "これは私がかさです。",
     "why": "所属关系用 の，が 会变成主语标记",
     "fix": "これは私のかさです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "의",
   "ko_diff": "韩语 의 与 の 对应，但口语中 의 常省略；日语 の 不能省略，且还可代替名词（私の）。",
   "notes": "",
