  {
   "id": "G0152",
   "pattern": "〜ごとに",
   "meaning_zh": "每…；每隔…",
   "connection": "名词 + ごとに；动词辞书形 + ごとに",
   "usage": "表示以某单位等间隔重复，或“每一个都各自不同”。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "このバスは十五分ごとに出ています。",
     "zh": "这趟公交每十五分钟一班。"
    },
    {
     "ja": "季節ごとに、店の飾りが変わる。",
     "zh": "每个季节店里的装饰都会变。"
    },
    {
     "ja": "一回使うごとにポイントがたまるカードです。",
     "zh": "这是每用一次就积分的卡。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0151",
     "diff": "ごとに 侧重等间隔、逐个，たびに 侧重“每当发生某事”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "このバスは十五分おきごとに出ています。",
     "why": "「おき」与「ごと」都表间隔，不能叠加，二者择一。",
     "fix": "十五分ごとに",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
