 "grammar": [
  {
   "id": "G0028",
   "pattern": "～て から",
   "meaning_zh": "…之后（再）…",
   "connection": "動詞て形 + から",
   "usage": "强调动作先后顺序；「〜た から」是原因，形近义异",
   "register_note": "てから 日常会话常用，书面叙事也可。",
   "examples": [
    {
     "ja": "ご飯を食べてから、学校へ行きます。",
     "zh": "吃完饭后去学校。",
     "vocab_ids": [
