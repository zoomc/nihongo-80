 "grammar": [
  {
   "id": "G0197",
   "pattern": "〜てある",
   "meaning_zh": "…着（有意为之的结果状态）",
   "connection": "他动词て形 + ある；结果状态常用 が，已完成的准备可用 を。",
   "usage": "表示某人有意做了某事后，其结果状态一直保留，主语多为物。",
   "register_note": "口语与书面通用；与自动词的「ている」相对。",
   "examples": [
    {
     "ja": "入り口に地図がはってあります。",
     "zh": "入口处贴着一张地图。"
    },
    {
     "ja": "テーブルの上にお皿が並べてあった。",
     "zh": "桌上摆着盘子。"
    },
    {
     "ja": "ビールなら冷蔵庫に入れてあるよ。",
     "zh": "啤酒的话，我放在冰箱里了。"
    }
   ],
   "prerequisites": [
    "G0020",
    "G0027"
   ],
   "compare": [
    {
     "id": "G0027",
     "diff": "てある 强调人为结果状态，ている 可表动作进行或自然状态"
    }
   ],
   "common_errors": [
    {
     "wrong": "机に本が置くてあります。",
     "why": "置く的て形是置いて。",
     "fix": "机に本が置いてあります。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아/어 있다",
   "ko_diff": "韩语 -아/어 있다 可表状态持续，但不像日语 てある 那样明确区分他动词与自动词；日语用 が 提示结果主体，韩语用 이/가。",
   "notes": "「地図が貼ってある」は结果状态的常见说法；「地図を貼ってある」也可表示已经做好的准备，不应一概判错。",
   "tags": [
    "state",
    "result"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "needs_review",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0198",
   "pattern": "〜とき",
   "meaning_zh": "…的时候",
   "connection": "动词普通形／い形容词／な形容词+な／名词+の + とき",
   "usage": "表示某一动作或状态发生的时间，前后主语可以不同。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "子どものとき、よく川で泳ぎました。",
     "zh": "我小时候经常在河里游泳。"
    },
    {
     "ja": "日本へ行くとき、新しいかばんを買いました。",
     "zh": "去日本之前，我买了一个新包。"
    },
    {
     "ja": "日本へ行ったとき、友達にお土産を買いました。",
     "zh": "去日本的时候，我在当地给朋友买了礼物。"
    }
   ],
   "prerequisites": [
    "G0023",
    "G0006"
   ],
   "compare": [
    {
     "id": "G0222",
     "diff": "とき 是名词性时间从句，たら 还含条件与先后关系"
    }
   ],
   "common_errors": [
    {
     "wrong": "子どもののとき、よく川で泳ぎました。",
     "why": "名词修饰名词只用「の」，不能叠用两个 の",
