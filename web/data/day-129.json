 "grammar": [
  {
   "id": "G0165",
   "pattern": "〜ばいい",
   "meaning_zh": "…就行；…才好",
   "connection": "动词ば形 + いい；い形容词ければ + いい",
   "usage": "表“这样做就够了”的建议，或用「ばいいのに」表遗憾、愿望。",
   "register_note": "口语为主。",
   "examples": [
    {
     "ja": "「この書類、どこに出せばいいですか。」「二階の受付に出してください。」",
     "zh": "“这份文件交到哪里好？”“请交到二楼前台。”"
    },
    {
     "ja": "分からないことがあったら、遠慮しないで私に聞けばいいよ。",
     "zh": "有不懂的尽管问我，不用客气。"
    },
    {
     "ja": "明日、雨が降らなければいいんだけど。",
     "zh": "明天要是不下雨就好了。"
    }
   ],
   "prerequisites": [
    "G0025"
   ],
   "compare": [
    {
     "id": "G0105",
     "diff": "ことだ 是较强的忠告，ばいい 更轻，只指出“这样做即可”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "分からないことがあったら、遠慮しないで私に聞くばいいよ。",
     "why": "「ばいい」前接ば形「聞けば」，辞书形加「ば」不合法。",
     "fix": "聞けばいいよ",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-면 된다",
   "ko_diff": "韩语「-면 된다」与「ばいい」对应；但日语「ばいいのに」可表惋惜、责备，韩语要用「-면 좋을 텐데」。",
