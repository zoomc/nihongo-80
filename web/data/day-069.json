  },
  {
   "id": "G0235",
   "pattern": "〜ようになる",
   "meaning_zh": "变得能…；开始…",
   "connection": "动词辞书形／动词ない形 + ようになる",
   "usage": "表示能力、习惯或状态经过变化达到新阶段。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "練習して、自転車に乗れるようになりました。",
     "zh": "练习之后，我学会骑自行车了。"
    },
    {
     "ja": "日本に来てから、朝ご飯を食べるようになった。",
     "zh": "来日本以后，我开始吃早饭了。"
    },
    {
     "ja": "赤ちゃんが少しずつ話せるようになってきた。",
     "zh": "我家宝宝渐渐会说话了。"
    }
   ],
   "prerequisites": [
    "G0048"
   ],
   "compare": [
    {
     "id": "G0234",
     "diff": "ようになる 是状态变化，ようにする 是主观努力"
    }
   ],
   "common_errors": [
    {
     "wrong": "日本に来てから、朝ご飯を食べるようにになった。",
     "why": "ようになる 前接辞书形直接连接，不用「に」",
     "fix": "日本に来てから、朝ご飯を食べるようになった。",
     "learner": "zh"
    }
   ],
