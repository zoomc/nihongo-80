 "grammar": [
  {
   "id": "G0002",
   "pattern": "N は N ではありません / じゃない",
   "meaning_zh": "…不是…",
   "connection": "名词 + ではありません／じゃありません（礼貌体）；名词 + ではない／じゃない（普通体）",
   "usage": "名词谓语的非过去否定，按场合选礼貌体或普通体。",
   "register_note": "礼貌否定用于正式或一般场合；口语可用 じゃない/じゃありません，书面可用 ではない。",
   "examples": [
    {
     "ja": "私は先生ではありません。",
     "zh": "我不是老师。",
     "vocab_ids": [
      "V0001",
      "V0079"
     ]
    }
   ],
   "prerequisites": [
    "G0001"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "私は先生ないです。",
     "why": "“不是”要用 ではありません（口语 じゃない），不能只留 ない。少了 では，听起来像“老师＋没有”。",
     "fix": "私は先生ではありません。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "sentence",
    "copula"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "needs_review",
   "provenance": "self_reviewed",
   "ko_equiv": "이/가 아닙니다",
   "ko_diff": "학생이 아닙니다、의사가 아닙니다 按收音选 이/가。日语名词后直接接 ではありません，熟人间常说 じゃない。",
   "ko_pron": "N 와 N 데와아리마센 / 자나이"
  },
  {
   "id": "G0003",
   "pattern": "N は N でした",
   "meaning_zh": "…（过去）是…",
   "connection": "名詞 + は + 名詞 + でした",
   "usage": "判断句过去式，礼貌体",
   "register_note": "礼貌体过去判断，叙述过去身份或状态；简体为 だった。",
   "examples": [
    {
     "ja": "昨日は日曜日でした。",
     "zh": "昨天是周日。",
     "vocab_ids": [
      "V0025",
      "V0037"
     ]
    }
   ],
   "prerequisites": [
    "G0001"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "昨日は日曜日だったです。",
     "why": "名词句的客气过去是 でした；だった 是它的简体形，两个不能叠在一起。",
     "fix": "昨日は日曜日でした。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "sentence",
    "copula",
    "tense"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "이었습니다 / 였습니다",
   "ko_diff": "韩语过去按有无收音选이었/였，且分层级；日语でした只有一形，无收音条件。",
   "ko_pron": "N 와 N 데시타"
  },
  {
   "id": "G0004",
   "pattern": "N も",
   "meaning_zh": "…也…",
   "connection": "名詞 + も（替代 は/が/を）",
   "usage": "表同类追加；替代格助词，不与 は 叠加",
   "register_note": "も 口语书面通用；强调「也」时替代 は/が，不与 は 叠加。",
   "examples": [
    {
     "ja": "私も学生です。",
     "zh": "我也是学生。",
     "vocab_ids": [
      "V0001",
      "V0078"
     ]
    }
   ],
   "prerequisites": [
    "G0001"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "私はも学生です。",
     "why": "「も」本身就含“也”，要把 は 换掉，不能写成 は＋も。",
     "fix": "私も学生です。",
     "learner": "zh"
    },
    {
     "wrong": "私を学生です。",
     "why": "「も」不是宾格助词，写不成 を。“我也…”就是 私も。",
     "fix": "私も学生です。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "particle"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "needs_review",
   "provenance": "self_reviewed",
   "ko_equiv": "도",
   "ko_diff": "韩语 도 和日语 も 都可表示追加，常替换主格或宾格助词；叠加其他助词须按具体语境判断。",
   "ko_pron": "N 모"
  }
 ],
