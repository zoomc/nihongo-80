     "zh": "暑假我打算去北海道旅行。"
    },
    {
     "ja": "今日はお酒を飲まないつもりです。",
     "zh": "今天我不打算喝酒。"
    },
    {
     "ja": "大学を出たら、どうするつもりですか。",
     "zh": "大学毕业后你打算做什么？"
    }
   ],
   "prerequisites": [
    "G0023",
    "G0022"
   ],
   "compare": [
