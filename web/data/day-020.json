 "grammar": [
  {
   "id": "G0250",
   "pattern": "〜に（time）",
   "meaning_zh": "在…（某时点）",
   "connection": "名词（时间）+ に",
   "usage": "表示动作发生的具体时点，常与年月日、星期、时刻搭配。",
   "register_note": "口语与书面通用；「今日／明日／毎日」等相对时间后不加 に。",
   "examples": [
    {
     "ja": "毎朝7時に起きます。",
     "zh": "每天早上七点起床。"
    },
    {
     "ja": "日曜日に友達と会います。",
     "zh": "星期天和朋友见面。"
    },
    {
     "ja": "8月に国へ帰ります。",
     "zh": "八月回国。"
    }
   ],
   "prerequisites": [
    "G0009"
   ],
   "compare": [
    {
     "id": "G0251",
     "diff": "に 表时点或到达点，へ 强调方向"
    }
   ],
   "common_errors": [
    {
     "wrong": "明日に友達と会います。",
     "why": "「明日」等相对时间词后一般不加 に",
     "fix": "明日、友達と会います。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "에（시간）",
   "ko_diff": "韩语时点可用 에，日语具体时点常用 に；两种语言的相对时间词是否加助词都需看实际用法，不可机械对应。",
   "notes": "",
   "tags": [
    "particle",
    "time"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "needs_review",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0251",
   "pattern": "〜に（destination）",
   "meaning_zh": "去／来／回…（目的地）",
   "connection": "名词（场所）+ に + 行く／来る／帰る",
   "usage": "表示移动的到达点，常与行く、来る、帰る等移动动词搭配。",
   "register_note": "口语与书面通用；与 へ 多可互换。",
   "examples": [
    {
     "ja": "毎日バスで学校に行きます。",
     "zh": "每天坐公交车去学校。"
    },
    {
     "ja": "夜10時に家に帰りました。",
     "zh": "晚上十点回到家。"
    },
    {
     "ja": "来月、姉が日本に来ます。",
     "zh": "下个月姐姐要来日本。"
    }
   ],
   "prerequisites": [
    "G0009"
   ],
   "compare": [
    {
     "id": "G0255",
     "diff": "に 强调到达点，へ 强调方向"
    }
   ],
   "common_errors": [
    {
     "wrong": "毎日バスで学校を行きます。",
     "why": "行く 的目的地用 に 或 へ，不用 を（を 表经过）",
     "fix": "毎日バスで学校に行きます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "에（도착점）",
   "ko_diff": "韩语 에 与 に 对应；但韩语 가다 的目的地也可用 로，日语 へ 与之相近，に 更强调到达。",
