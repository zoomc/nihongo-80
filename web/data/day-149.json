 "grammar": [
  {
   "id": "G0241",
   "pattern": "〜はずだ",
   "meaning_zh": "应该…；按理说…",
   "connection": "动词普通形／い形容词 + はずだ；な形容词+な／名词+の + はずだ",
   "usage": "根据事实或逻辑推断理应如此，语气较有把握。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "荷物は明日届くはずです。",
     "zh": "包裹应该明天到。"
    },
    {
     "ja": "彼は十年もアメリカに住んでいたから、英語が上手なはずだ。",
     "zh": "他在美国住了十年，英语应该很好。"
    },
    {
     "ja": "おかしいな。かぎはここに置いたはずなのに。",
     "zh": "奇怪，我明明把钥匙放在这里的。"
    }
   ],
   "prerequisites": [
    "G0053"
   ],
   "compare": [
    {
     "id": "G0242",
     "diff": "はずだ 是理应如此，はずがない 是绝不可能"
    }
   ],
   "common_errors": [
    {
     "wrong": "彼は十年もアメリカに住んでいたから、英語が上手のはずだ。",
     "why": "な形容词接 はずだ 要用「な」，不是「の」",
     "fix": "彼は十年もアメリカに住んでいたから、英語が上手なはずだ。",
     "learner": "zh"
    }
   ],
