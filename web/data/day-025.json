 "grammar": [
  {
   "id": "G0260",
   "pattern": "〜や",
   "meaning_zh": "…和…等（部分列举）",
   "connection": "名词 + や + 名词（部分列举）",
   "usage": "列举若干代表性事物，暗示还有其他，常与「など」呼应。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "机の上に本や雑誌があります。",
     "zh": "桌子上有书、杂志等。"
    },
    {
     "ja": "スーパーで肉や野菜を買いました。",
     "zh": "我在超市买了肉、蔬菜等。"
    }
   ],
   "prerequisites": [
    "G0012"
   ],
   "compare": [
    {
     "id": "G0258",
     "diff": "や 部分列举，と 全部列举"
    }
   ],
   "common_errors": [
    {
     "wrong": "机の上に本や雑誌とがあります。",
     "why": "部分列举不用 と 收尾，可用「など」",
     "fix": "机の上に本や雑誌などがあります。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "나/이나",
   "ko_diff": "韩语 나/이나 表选择或部分列举，与 や 接近；但韩语还可表示「或者」，日语 や 只表列举，不表选择。",
   "notes": "",
   "tags": [
    "particle",
    "example"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0262",
   "pattern": "〜も",
   "meaning_zh": "也…；（否定）也不…",
   "connection": "名词 + も",
   "usage": "表示同类追加，否定句中与前后 も 呼应表示「既不…也不…」。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "私も学生です。",
     "zh": "我也是学生。"
    },
    {
     "ja": "兄はサッカーも好きです。",
     "zh": "哥哥也喜欢足球。"
    },
    {
     "ja": "肉も魚も食べません。",
     "zh": "我既不吃肉也不吃鱼。"
    }
   ],
   "prerequisites": [
    "G0004"
   ],
   "compare": [
    {
     "id": "G0247",
     "diff": "も 表追加，は 表主题"
    }
   ],
   "common_errors": [
    {
     "wrong": "私もは学生です。",
     "why": "も 已含提示作用，不能与 は 叠用",
     "fix": "私も学生です。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "도",
   "ko_diff": "韩语 도 与 も 对应，且同样可叠用于否定并列（고기도 생선도）；日语 も 可顶替 は／が／を，韩语 도 也顶替主宾格助词。",
