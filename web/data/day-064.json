 "listening": false,
 "grammar": [
  {
   "id": "G0111",
   "pattern": "〜ようとする",
   "meaning_zh": "想要…；正要…",
   "connection": "动词意志形 + とする（否定形：ようとしない）",
   "usage": "表示尝试做某动作，或动作即将发生的瞬间。",
   "register_note": "口语书面均可；「ようとしない」常含批评。",
   "examples": [
    {
     "ja": "ドアを開けようとしたが、鍵がかかっていて開かなかった。",
     "zh": "我想开门，但锁着打不开。"
    },
    {
     "ja": "家を出ようとしたとき、急に雨が降り出した。",
     "zh": "正要出门时，突然下起雨来。"
    },
    {
     "ja": "弟は何度注意しても、部屋を片付けようとしない。",
     "zh": "弟弟不管怎么提醒，都不肯收拾房间。"
    }
   ],
   "prerequisites": [
    "G0067"
   ],
   "compare": [
    {
     "id": "G0064",
     "diff": "ようにする 是“设法养成”，ようとする 是“试图做、即将做”，动作性更强。"
    }
   ],
   "common_errors": [
    {
     "wrong": "ドアを開けますようとしたが、鍵がかかっていた。",
     "why": "ようとする 前接 開けよう 这种“打算”形，不能插 ます。",
     "fix": "開けようとした",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-(으)려고 하다 / -(으)려던 참이다",
   "ko_diff": "韩语「-려고 하다」也表意图，但“正要…的瞬间”日语说「ようとしたとき」，韩语多用「-려던 참에」，形式不同。",
   "notes": "",
   "tags": [
    "attempt",
    "intention"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜요우토스루"
  },
  {
   "id": "G0112",
   "pattern": "〜そうにない / 〜そうもない",
   "meaning_zh": "看样子不会…；不像会…",
   "connection": "动词ます形词干 + そうにない／そうもない",
   "usage": "从现状判断某事难以实现，是样态「そうだ」的否定。",
   "register_note": "口语书面均可；「そうもない」更书面。",
   "examples": [
    {
     "ja": "この雨は、夕方までやみそうにない。",
     "zh": "这场雨看样子到傍晚也停不了。"
    },
    {
     "ja": "仕事が多すぎて、今日中には終わりそうもない。",
     "zh": "工作太多，今天之内看样子做不完。"
    },
    {
     "ja": "こんなにたくさんの料理、二人では食べきれそうにないね。",
     "zh": "这么多菜，两个人看样子吃不完。"
    }
   ],
   "prerequisites": [
    "G0043"
   ],
   "compare": [
    {
     "id": "G0045",
     "diff": "かもしれない 是可能性推测，そうにない 是凭外观判断“不会”，方向相反。"
    }
   ],
   "common_errors": [
    {
     "wrong": "この雨は、夕方までやむそうにない。",
     "why": "そうにない 前接ます形词干 やみ，やむそう 不成立。",
     "fix": "やみそうにない",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-(으)ㄹ 것 같지 않다",
   "ko_diff": "韩语没有专门对应，常说「-ㄹ 것 같지 않다」；日语「そうにない」依据眼前迹象，主观判断色彩更强。",
   "notes": "",
   "tags": [
    "conjecture",
    "negation",
    "possibility"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜소우니나이 / 〜소우모나이"
  },
  {
   "id": "G0113",
   "pattern": "〜一方だ",
   "meaning_zh": "一直…；越来越…",
   "connection": "动词辞书形 + 一方だ",
   "usage": "表示某变化只朝一个方向持续发展，多用于负面趋势。",
   "register_note": "书面语为主，新闻报道常见。",
   "examples": [
    {
     "ja": "この町の人口は、減る一方だ。",
     "zh": "这个镇的人口一直在减少。"
    },
    {
     "ja": "物価は上がる一方なのに、給料は全然上がらない。",
     "zh": "物价一个劲上涨，工资却完全不涨。"
    },
    {
     "ja": "勉強をさぼっていたら、成績は下がる一方だった。",
     "zh": "一直偷懒，成绩就一路下滑。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0057",
     "diff": "ていく/くる 只表方向，一方だ 强调单向变化持续不止，语气更重。"
    }
   ],
   "common_errors": [
    {
     "wrong": "この町の人口は、減り一方だ。",
     "why": "一方だ 前接辞书形 減る，不接ます形词干 減り。",
     "fix": "減る一方だ",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "계속 …하다 / 점점 더 …해지다",
   "ko_diff": "물가가 계속 오르다 可对照 物価は上がる一方だ，后者强调走势只向上涨一侧。-기만 하다 常说一个人只做某事，适合对照 てばかりいる。",
   "notes": "",
   "tags": [
    "change",
