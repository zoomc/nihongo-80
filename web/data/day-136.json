 "grammar": [
  {
   "id": "G0175",
   "pattern": "〜くせに",
   "meaning_zh": "明明…却…",
   "connection": "动词普通形/い形容词/ナ形容词な/名词の + くせに",
   "usage": "表示前后矛盾，带明显责备、轻视或不满。",
   "register_note": "口语为主，正式场合不宜。",
   "examples": [
    {
     "ja": "自分では何もしないくせに、人の仕事には文句ばかり言う。",
     "zh": "自己什么都不干，却老是对别人的工作挑毛病。"
    },
    {
     "ja": "知っているくせに、どうして教えてくれなかったの？",
     "zh": "你明明知道，为什么不告诉我？"
    },
    {
     "ja": "弟は体が大きいくせに、小さな虫をこわがる。",
     "zh": "弟弟个子那么大，却怕小虫子。"
    }
   ],
   "prerequisites": [
    "G0081"
   ],
   "compare": [
    {
     "id": "G0075",
     "diff": "のに 只表逆接、含遗憾，くせに 一定带责难和轻蔑。"
    }
   ],
   "common_errors": [
    {
     "wrong": "弟は体が大きいのくせに、小さな虫をこわがる。",
     "why": "い形容词直接接「くせに」，不能加「の」。",
     "fix": "体が大きいくせに",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-ㄴ 주제에",
   "ko_diff": "韩语「-ㄴ 주제에」与「くせに」一样带强烈贬义，对应度很高；但日语语气更冲，正式场合须换「のに」。",
   "notes": "",
   "tags": [
    "concession",
    "criticism"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
