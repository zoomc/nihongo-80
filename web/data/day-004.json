 "grammar": [
  {
   "id": "G0006",
   "pattern": "N の N",
   "meaning_zh": "…的…；所属/修饰",
   "connection": "名詞 + の + 名詞",
   "usage": "连体修饰、所属、同位；中文「的」的对应，但不可滥用",
   "register_note": "の 口语书面通用；不要把所有中文「的」都机械译成 の。",
   "examples": [
    {
     "ja": "私の本です。",
     "zh": "是我的书。",
     "vocab_ids": [
