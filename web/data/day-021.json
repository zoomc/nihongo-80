 "listening": false,
 "grammar": [
  {
   "id": "G0266",
   "pattern": "〜か（question）",
   "meaning_zh": "…吗？（疑问）",
   "connection": "句子（礼貌体／普通体）+ か",
   "usage": "在句末加か构成疑问，实际语调会随语境、句型和说话方式变化。",
   "register_note": "口语与书面通用；普通体疑问多用升调，不加 か。",
   "examples": [
    {
     "ja": "これはあなたのかばんですか。",
     "zh": "这是你的包吗？"
    },
    {
     "ja": "朝ご飯を食べましたか。",
     "zh": "你吃早饭了吗？"
    },
    {
     "ja": "トイレはどこですか。",
     "zh": "洗手间在哪里？"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0244",
     "diff": "か 构成直接疑问，かどうか 是嵌入疑问"
    }
   ],
   "common_errors": [
    {
     "wrong": "朝ご飯を食べましたかです。",
     "why": "疑问助词 か 后不能再加 です",
     "fix": "朝ご飯を食べましたか。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "-까? / -니?",
   "ko_diff": "역이에요? 可用语调问问题。日语礼貌体教材句常用 駅ですか；普通体常问 駅？ 或 駅なの？，直接用 か 会因语气而显得较硬。",
   "notes": "",
   "tags": [
    "particle",
    "question"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "needs_review",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜카"
  },
  {
   "id": "G0267",
   "pattern": "〜ね",
   "meaning_zh": "…吧；…啊（寻求认同）",
   "connection": "句子 + ね",
   "usage": "用于确认对方也有同感，或缓和语气、寻求同意。",
   "register_note": "口语；正式书面语少用。",
   "examples": [
    {
     "ja": "今日は暑いですね。",
     "zh": "今天真热啊。"
    },
    {
     "ja": "このケーキ、おいしいですね。",
     "zh": "这个蛋糕很好吃吧。"
    },
    {
     "ja": "明日のテストは10時からですね。",
     "zh": "明天的考试是十点开始吧？"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0268",
     "diff": "ね 寻求同意，よ 提供新信息"
    }
   ],
   "common_errors": [
    {
     "wrong": "明日のテストは10時からだねです。",
     "why": "ね 放在结尾，后面不能再加 です。",
     "fix": "明日のテストは10時からですね。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "-죠? / -네요",
   "ko_diff": "따뜻하죠? 对照 暖かいですね；따뜻하네요 对照发现后感叹的 暖かいですね。ね 也可只缓和语气，需听实际语调。",
   "notes": "",
   "tags": [
    "particle"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜네"
  },
  {
   "id": "G0268",
   "pattern": "〜よ",
   "meaning_zh": "…哦；…呀（告知、强调）",
   "connection": "句子 + よ",
   "usage": "用于告诉对方不知道的信息，或强调自己的判断，语气较强。",
   "register_note": "口语；对上级使用需注意语气。",
   "examples": [
    {
     "ja": "このラーメンはとてもおいしいですよ。",
     "zh": "这拉面很好吃哦。"
    },
    {
     "ja": "かさを忘れていますよ。",
     "zh": "你忘了带伞哦。"
    },
    {
     "ja": "明日はテストがありますよ。",
     "zh": "明天有考试哦。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0267",
     "diff": "よ 提供新信息，ね 寻求同意"
    }
   ],
   "common_errors": [
    {
     "wrong": "このラーメンはとてもおいしいよです。",
     "why": "よ 放在结尾，后面不能加 です。",
     "fix": "このラーメンはとてもおいしいですよ。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "-요 / -거든요",
   "ko_diff": "韩语 -요 是礼貌尾，不专门表告知；日语 よ 明确提示新信息，韩语需靠 -거든요 或语调表达。",
   "notes": "",
