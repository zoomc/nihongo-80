 "grammar": [
  {
   "id": "G0177",
   "pattern": "〜ぶり",
   "meaning_zh": "隔了…才；…的样子",
   "connection": "期间名词 + ぶり；动词ます形词干 + ぶり",
   "usage": "表隔了多久才做某事，或某动作、状态呈现的样子。",
   "register_note": "口语书面均可，「〜ぶりに」多用于久别重逢。",
   "examples": [
    {
     "ja": "五年ぶりに高校の友達に会って、話が止まらなかった。",
     "zh": "隔了五年见到高中同学，话停不下来。"
    },
    {
     "ja": "久しぶりですね。お元気でしたか。",
     "zh": "好久不见了，您一向可好？"
    },
    {
     "ja": "新入社員の仕事ぶりを見て、部長は安心したようだ。",
     "zh": "看到新员工的工作表现，部长似乎放心了。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0151",
     "diff": "たびに 表“每次”，ぶり 表“隔了多久才一次”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "五年ぶりにに友達と会いました。",
     "why": "ぶりに已有に，不再重复。",
     "fix": "五年ぶりに友達と会いました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-만에",
   "ko_diff": "韩语「-만에」与「ぶりに」对应；但日语「ぶり」还能接动词词干表“…的样子」（仕事ぶり），韩语不能直译。",
   "notes": "",
