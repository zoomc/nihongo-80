 "grammar": [
  {
   "id": "G0303",
   "pattern": "〜ないことには",
   "pattern_kana": "",
   "meaning_zh": "如果不…就无法…",
   "ko_equiv": "하지 않으면 …할 수 없다",
   "connection": "动词ない形／い形容词くない形＋ことには；名词／な形容词＋でない＋ことには",
   "usage": "",
   "ko_diff": "否定条件是不可省略的前提，后项多为无法判断、无法推进。名词或形容动词可用「でないことには」。",
   "examples": [
    {
     "ja": "実際に会って話してみないことには、どんな人か分からない。",
     "en": "You can't tell what someone is like unless you actually meet and talk to them.",
     "zh": "不亲自见面聊一聊，就不知道对方是什么样的人。"
    },
    {
     "ja": "社長の許可が出ないことには、このプロジェクトは始められない。",
     "en": "We can't start this project unless the president gives permission.",
     "zh": "没有社长批准，这个项目就启动不了。"
    }
   ],
   "tags": [
    "condition",
    "negation"
   ],
   "jlpt": "N2",
   "prerequisites": [],
   "compare": [],
   "common_errors": [
    {
     "wrong": "許可が出ることには、始められない",
     "why": "ないことには 整体是“不…就不能…”，前面要用ない形：出ないことには。",
     "fix": "許可が出ないことには、始められない",
     "learner": "ko"
    }
   ],
   "source_ids": [],
   "source_ref": "nai-koto-ni-wa",
   "review_status": "ai_draft",
   "provenance": "openjlpt_adapted",
   "ko_pron": "〜나이코토니와"
  },
  {
   "id": "G0304",
   "pattern": "〜ことは〜が",
   "pattern_kana": "",
   "meaning_zh": "…倒是…，不过…",
   "ko_equiv": "하기는 하지만 / …하기는 하다",
   "connection": "前后重复同一谓语，如 読んだことは読んだが／近いことは近いが／便利なことは便利だが",
   "usage": "",
   "ko_diff": "前后重复同一谓语表示有限让步。形容动词是「便利なことは便利だが」，前半修饰「こと」，后半作谓语。",
   "examples": [
    {
     "ja": "あの映画、見たことは見たけど、途中で寝てしまった。",
     "en": "I did watch that movie, but I fell asleep halfway through.",
     "zh": "那部电影我看倒是看了，可中途睡着了。"
    },
    {
     "ja": "この部屋は広いことは広いが、駅からかなり遠い。",
     "en": "This apartment is spacious, sure, but it's quite far from the station.",
     "zh": "这个房间宽敞倒是宽敞，可离车站很远。"
    }
   ],
   "tags": [
    "concession",
    "emphasis"
   ],
   "jlpt": "N2",
   "prerequisites": [],
   "compare": [],
   "common_errors": [
    {
     "wrong": "便利だことは便利だが",
     "why": "便利 修饰 こと 用 な：便利なことは便利だが。",
     "fix": "便利なことは便利だが",
     "learner": "ko"
    }
   ],
