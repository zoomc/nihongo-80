 "grammar": [
  {
   "id": "G0184",
   "pattern": "〜だらけ",
   "meaning_zh": "满是…；净是…",
   "connection": "名词 + だらけ",
   "usage": "表示某物上布满不好的东西，或充满负面事物。",
   "register_note": "口语书面均可，多含负面评价。",
   "examples": [
    {
     "ja": "子どもたちは、泥だらけになって帰ってきた。",
     "zh": "孩子们回来时满身是泥。"
    },
    {
     "ja": "急いで書いたレポートは、間違いだらけだった。",
     "zh": "赶着写出来的报告错误百出。"
    },
    {
     "ja": "引っ越したばかりで、部屋はまだ段ボールだらけだ。",
     "zh": "刚搬完家，房间里还堆满了纸箱。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0183",
     "diff": "気味 是轻微迹象，だらけ 是大量布满，程度相反。"
    }
   ],
   "common_errors": [
    {
     "wrong": "急いで書いたレポートは、間違いのだらけだった。",
     "why": "「だらけ」直接接名词，不加「の」。",
     "fix": "間違いだらけだった",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-투성이",
   "ko_diff": "韩语「-투성이」常带负面色彩；日语「だらけ」也常用于负面事物，并可接抽象名词，如「間違いだらけ」。",
