 "grammar": [
  {
   "id": "G0076",
   "pattern": "N + に 対して / に 関して",
   "meaning_zh": "对…（针对对象/对比）／关于…（书面）",
   "connection": "名詞 + に対して（动作/态度的对象，或「与此相对」的对比）；名詞 + に関して（＝について 的书面语）",
   "usage": "に対して 后接对人/物的动作、态度或对比；に関して 多用于正式文书、新闻",
   "register_note": "に対して/に関して 偏正式书面，口语寒暄也可。",
   "examples": [
    {
     "ja": "先生に対して失礼なことを言いました。",
     "zh": "对老师说了失礼的话。",
     "vocab_ids": [
      "V0079",
      "V0114"
     ]
    },
    {
     "ja": "この問題に関して、後ほど報告します。",
     "zh": "关于这个问题稍后汇报。",
     "vocab_ids": [
      "V0247",
      "V0019"
     ]
    }
   ],
   "prerequisites": [
    "G0006",
    "G0009",
    "G0055"
   ],
   "compare": [
    {
     "id": "G0055",
     "diff": "について 是「关于（内容）」口语通用；に関して 更书面；に対して 是「朝向对象/对比」不是谈内容"
    },
    {
     "id": "G0009",
     "diff": "に 只标对象；に対して 强调「针对该对象采取行动/态度」"
    }
   ],
   "common_errors": [
    {
     "wrong": "先生に対してに失礼しました。",
     "why": "に対して 已含 に，不再叠 に；中文「对老师」直译叠加助词错",
     "fix": "先生に対して失礼しました。",
     "learner": "zh"
    },
    {
     "wrong": "環境問題について対して議論します。",
     "why": "「关于…讨论」用 について/に関して 即可，叠 に対して 语义混乱；中文「对…关于」直译堆砌",
     "fix": "環境問題に関して議論します。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "particle",
    "target",
    "formal",
    "topic"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-에 대해 / -에 관해",
   "ko_diff": "韩语에 대해表针对，에 관해表关于，二者都可书面；日语に対して还表对比，韩语须用에 비해。"
  },
  {
   "id": "G0077",
   "pattern": "N / V辞書形 + に 伴って / に つれて / に 従って",
   "meaning_zh": "随着…（前项变化，后项也跟着变化）",
   "connection": "名詞 + に／動詞 辞書形 + に + 伴って・つれて・従って；后项须是变化动词（増える／変わる／高くなる 等）",
   "usage": "书面，表伴随变化；につれて/に従って 偏比例变化，に伴って 偏伴随发生（常带同时性）",
   "register_note": "に伴って/につれて/に従って 书面语，新闻报告常用。",
   "examples": [
    {
     "ja": "気温が上がるにつれて、売上が増えます。",
     "zh": "随着气温升高，销量增加。",
     "vocab_ids": [
      "V0097",
      "V0125",
      "V0110"
     ]
    },
    {
     "ja": "技術の進歩に伴って、仕事のやり方が変わりました。",
     "zh": "随着技术进步，工作方式变了。",
     "vocab_ids": [
      "V0252",
      "V0085",
      "V0242"
     ]
    }
   ],
   "prerequisites": [
    "G0009",
    "G0023",
    "G0055"
   ],
   "compare": [
    {
     "id": "G0055",
     "diff": "によって 表「因…而（因果/手段/被动主体）」；に伴って 表「随着…同步变化」"
    },
    {
     "id": "G0035",
     "diff": "〜くなる/に なる 是结果变化本身；に伴って 是把两个变化连起来的接续"
    }
   ],
   "common_errors": [
    {
     "wrong": "気温が上がるにつれて、ビールがおいしいです。",
     "why": "后项须是变化（増える／高くなる），静态形容词 おいしい 不接；中文「随着…很…」直译错",
     "fix": "気温が上がるにつれて、ビールが売れるようになります。",
     "learner": "zh"
    },
    {
     "wrong": "気温の上がるにつれて",
     "why": "につれて 前接动词用 辞书形（上がる），名词才用 気温の上昇に；中文「气温的升高」直译混名词化",
     "fix": "気温が上がるにつれて、…",
     "learner": "zh"
    }
   ],
