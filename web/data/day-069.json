 "grammar": [
  {
   "id": "G0233",
   "pattern": "〜ように（purpose）",
   "meaning_zh": "为了…；以便…",
   "connection": "动词辞书形／动词ない形 + ように",
   "usage": "表示为了使某种状态实现，前接多为非意志动词或可能形。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "後ろの人にも聞こえるように、大きな声で話してください。",
     "zh": "请大声说，好让后面的人也听得见。"
    },
    {
     "ja": "忘れないように、手にメモを書いた。",
     "zh": "为了不忘，我把笔记写在手上。"
    },
    {
     "ja": "かぜをひかないように、暖かくして寝てください。",
     "zh": "睡觉时请保暖，别感冒了。"
    }
   ],
   "prerequisites": [
    "G0023",
    "G0022"
   ],
   "compare": [
    {
     "id": "G0232",
     "diff": "ように 多接非意志状态，ために 接意志动词"
    }
   ],
   "common_errors": [
    {
     "wrong": "後ろの人にも聞こえるために、大きな声で話してください。",
     "why": "聞こえる 是非意志动词，不能接 ために，要用 ように",
     "fix": "後ろの人にも聞こえるように、大きな声で話してください。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-도록",
   "ko_diff": "韩语 -도록 与 ように 对应，且同样可接非意志动词；日语 ために 只能接意志动词，这一点韩语 -기 위해 的限制更严。",
   "notes": "",
   "tags": [
    "purpose"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
