  {
   "id": "G0232",
   "pattern": "〜ために",
   "meaning_zh": "为了…；因为…",
   "connection": "动词辞书形／动词た形 + ために；名词 + の + ために",
   "usage": "前接意志动词表目的，前接名词或过去形表原因，后者较书面。",
   "register_note": "书面语常用；口语目的多用「ように」。",
   "examples": [
    {
     "ja": "日本の大学に入るために、毎日勉強しています。",
     "zh": "为了考进日本的大学，我每天学习。"
    },
    {
     "ja": "家族のために、一生懸命働いている。",
     "zh": "我为了家人拼命工作。"
    },
    {
     "ja": "大雪のために、電車が止まりました。",
     "zh": "因为大雪，电车停运了。"
    }
   ],
