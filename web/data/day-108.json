  {
   "id": "G0126",
   "pattern": "まるで〜ようだ",
   "meaning_zh": "简直像…一样",
   "connection": "まるで + 名词 + の + ようだ；まるで + 普通形 + ようだ",
   "usage": "用夸张比喻描述强烈的相似感，常与「まるで」呼应。",
   "register_note": "口语书面均可，文学描写中常见。",
   "examples": [
    {
     "ja": "この部屋は広くて明るくて、まるでホテルのようだ。",
     "zh": "这个房间又大又亮，简直像宾馆一样。"
    },
    {
     "ja": "久しぶりに会った友達は、まるで別人のように変わっていた。",
     "zh": "久别重逢的朋友变了个样，简直像另一个人。"
    },
    {
     "ja": "三月なのに、今日はまるで真夏のように暑い。",
     "zh": "才三月，今天却热得像盛夏一样。"
    }
   ],
   "prerequisites": [
    "G0044"
   ],
   "compare": [
    {
     "id": "G0125",
     "diff": "ような 可举实例，まるで〜ようだ 只用于夸张比喻，语气更强。"
    }
   ],
   "common_errors": [
    {
     "wrong": "この部屋は広くて明るくて、まるでホテルようだ。",
     "why": "名词接「ようだ」要加「の」，「ホテルようだ」不合法。",
     "fix": "ホテルのようだ",
     "learner": "zh"
    }
