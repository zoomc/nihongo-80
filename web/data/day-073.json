 "grammar": [
  {
   "id": "G0120",
   "pattern": "〜だけでなく",
   "meaning_zh": "不仅…而且…",
   "connection": "普通形 + だけでなく；な形容词可接词干（上手だけでなく）或 な；名词直接接",
   "usage": "追加事项，后项常用「も」，是口语化的“不仅…而且”。",
   "register_note": "口语书面均可，比「ばかりでなく」随意。",
   "examples": [
    {
     "ja": "この店は料理がおいしいだけでなく、値段も安い。",
     "zh": "这家店不仅菜好吃，价格也便宜。"
    },
    {
     "ja": "地震の後、水だけでなく電気も止まってしまった。",
     "zh": "地震后不仅停水，连电也停了。"
    },
    {
     "ja": "彼女は歌が上手なだけでなく、自分で曲も作っている。",
     "zh": "她不仅唱得好，还自己作曲。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0119",
     "diff": "だけでなく 口语通用，ばかりでなく 更书面、更郑重。"
    }
   ],
   "common_errors": [
    {
     "wrong": "日本語だけなくて、中国語も話します。",
     "why": "だけでなく 不能写成 だけなくて。",
     "fix": "日本語だけでなく、中国語も話します。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-뿐만 아니라",
   "ko_diff": "韩语「-뿐만 아니라」也可表示追加；日语な形容词既可见词干直接接「だけでなく」，也可用「なだけでなく」，应按实际表达判断。",
   "notes": "",
   "tags": [
    "addition"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "needs_review",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜다케데나쿠"
  },
  {
   "id": "G0138",
   "pattern": "〜さえ〜ば",
   "meaning_zh": "只要…就…",
   "connection": "名词 + さえ + ば形；动词ます形词干 + さえ + すれば；动词て形 + さえ + いれば",
   "usage": "表示只要满足这一条件，其余都不成问题。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "このアプリさえあれば、どこでも日本語の勉強ができる。",
     "zh": "只要有这个应用，在哪儿都能学日语。"
    },
    {
     "ja": "時間さえあれば、もっと旅行に行きたいんですが。",
     "zh": "只要有时间，我还想多去旅行。"
    },
    {
     "ja": "薬を飲んで寝てさえいれば、すぐに治りますよ。",
     "zh": "只要吃了药好好躺着，很快就会好。"
    }
   ],
   "prerequisites": [
    "G0080",
    "G0025"
   ],
   "compare": [
    {
     "id": "G0137",
     "diff": "さえ 单举极端例，さえ〜ば 构成“只要…就”的条件句。"
    }
   ],
   "common_errors": [
    {
     "wrong": "このアプリさえあってば、どこでも日本語の勉強ができる。",
     "why": "さえ 后面接ば形 あれば，あってば 不成立。",
     "fix": "さえあれば",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-기만 하면",
   "ko_diff": "韩语「-기만 하면」与「さえ〜ば」对应；但日语「さえ」位置固定在各成分后，韩语统一贴在动词后，语序处理不同。",
   "notes": "",
   "tags": [
    "condition",
    "emphasis"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
