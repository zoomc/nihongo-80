 "grammar": [
  {
   "id": "G0136",
   "pattern": "〜くらい / 〜ぐらい（extent）",
   "meaning_zh": "到…地步；至少…",
   "connection": "普通形 + くらい／ぐらい；名词 + くらい",
   "usage": "表程度之高，或举最低限度的例子表“至少”。",
   "register_note": "口语为主，比「ほど」随意。",
   "examples": [
    {
     "ja": "おなかが痛くて、歩けないくらいだった。",
     "zh": "肚子疼得几乎走不动。"
    },
    {
     "ja": "隣の部屋の音楽がうるさくて、自分の声も聞こえないぐらいだ。",
     "zh": "隔壁音乐太吵，连自己的声音都听不见。"
    },
    {
     "ja": "自分の部屋ぐらい、自分で掃除しなさい。",
     "zh": "至少自己的房间自己打扫。"
    }
   ],
   "prerequisites": [
    "G0034"
   ],
   "compare": [
    {
     "id": "G0135",
     "diff": "くらい 可用于“最低限度”，ほど 不能；程度上 ほど 更强、更书面。"
    }
   ],
   "common_errors": [
    {
     "wrong": "おなかが痛くて、歩けないのくらいだった。",
     "why": "动词、い形容词直接接「くらい」，不加「の」。",
     "fix": "歩けないくらいだった",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-ㄹ 정도로",
   "ko_diff": "韩语「-ㄹ 정도로」对应程度用法；“至少”韩语要说「적어도」，日语用「くらい」一并承担，范围更宽。",
   "notes": "",
   "tags": [
    "degree",
    "emphasis"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0137",
   "pattern": "〜さえ",
   "meaning_zh": "连…都…",
   "connection": "名词 + さえ／でさえ／にさえ",
   "usage": "举出极端例子，暗示其他更不用说，多与否定呼应。",
   "register_note": "口语书面均可，书面更常用「すら」。",
   "examples": [
    {
     "ja": "忙しくて、昼ご飯を食べる時間さえなかった。",
     "zh": "忙得连吃午饭的时间都没有。"
    },
    {
     "ja": "こんな簡単な問題は、小学生でさえ解ける。",
     "zh": "这么简单的问题，连小学生都会。"
    },
    {
     "ja": "彼女は親友にさえ本当のことを話さなかった。",
     "zh": "她连最好的朋友都没说实话。"
    }
   ],
   "prerequisites": [
    "G0080"
   ],
   "compare": [
    {
     "id": "G0139",
     "diff": "さえ 举极端例暗示其他，こそ 是“正是…”的强调，方向不同。"
    }
   ],
   "common_errors": [
    {
     "wrong": "忙しくて、昼ご飯を食べる時間がさえなかった。",
     "why": "「さえ」可替换「が」「を」，不能与「が」叠加，应说「時間さえなかった」。",
     "fix": "時間さえなかった",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-조차",
   "ko_diff": "韩语「-조차」多与否定呼应，这点与「さえ」相近；但日语「さえ」还能构成「さえ〜ば」条件句，韩语要用「-기만 하면」。",
   "notes": "",
   "tags": [
