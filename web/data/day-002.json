 "grammar": [
  {
   "id": "G0002",
   "pattern": "N は N ではありません / じゃない",
   "meaning_zh": "…不是…",
   "connection": "名詞 + は + 名詞 + ではありません（口语 じゃない）",
   "usage": "判断句否定，礼貌体",
   "register_note": "礼貌否定用于正式或一般场合；口语可用 じゃない/じゃありません，书面可用 ではない。",
   "examples": [
    {
     "ja": "私は先生ではありません。",
     "zh": "我不是老师。",
     "vocab_ids": [
      "V0001",
      "V0079"
     ]
    }
   ],
   "prerequisites": [
    "G0001"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "私は先生ないです。",
     "why": "把「ではありません」拆成「ない＋です」，中文「不是」直译导致词类错误；「じゃありません」是合法的口语礼貌否定，不在纠错范围。",
     "fix": "私は先生ではありません。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "sentence",
    "copula"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "needs_review",
   "provenance": "self_reviewed",
   "ko_equiv": "이/가 아닙니다",
   "ko_diff": "韩语否定用이/가 아니다，助词随收音变化；日语では可缩成じゃ，韩语无对应缩略。"
  },
  {
   "id": "G0003",
   "pattern": "N は N でした",
   "meaning_zh": "…（过去）是…",
   "connection": "名詞 + は + 名詞 + でした",
   "usage": "判断句过去式，礼貌体",
   "register_note": "礼貌体过去判断，叙述过去身份或状态；简体为 だった。",
   "examples": [
    {
     "ja": "昨日は日曜日でした。",
     "zh": "昨天是周日。",
     "vocab_ids": [
      "V0025",
      "V0037"
     ]
    }
   ],
   "prerequisites": [
    "G0001"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "昨日は日曜日です。",
     "why": "时间词「昨日」要求过去，中文「是」无时态变化易漏 でした",
     "fix": "昨日は日曜日でした。",
     "learner": "zh"
    },
    {
     "wrong": "昨日は日曜日だったです。",
     "why": "「だった」是简体过去，不能再接 です",
     "fix": "昨日は日曜日でした。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "sentence",
    "copula",
    "tense"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "이었습니다 / 였습니다",
   "ko_diff": "韩语过去按有无收音选이었/였，且分层级；日语でした只有一形，无收音条件。"
  }
 ],
