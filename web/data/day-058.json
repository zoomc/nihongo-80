 "grammar": [
  {
   "id": "G0211",
   "pattern": "〜ことになる",
   "meaning_zh": "决定…；结果变成…",
   "connection": "动词辞书形／动词ない形 + ことになる",
   "usage": "表示由集体、他人或客观情况决定的结果，不含说话人的主动意志。",
   "register_note": "口语与书面通用；「ことになっている」表示既定规定。",
   "examples": [
    {
     "ja": "来年の春から、名古屋の店で働くことになりました。",
     "zh": "定下来从明年春天起在名古屋的店工作。"
    },
    {
     "ja": "今度の日曜日、クラスのみんなでバーベキューをすることになった。",
     "zh": "这个星期天全班决定一起去烧烤。"
    },
    {
     "ja": "友達の結婚式で、私がスピーチをすることになりました。",
     "zh": "结果由我在朋友的婚礼上致辞。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0210",
     "diff": "ことになる 是客观决定，ことにする 是主观决定"
    }
   ],
   "common_errors": [
    {
     "wrong": "来年の春から、名古屋の店で働くことになるでした。",
     "why": "ことになる 的过去礼貌形是「ことになりました」",
     "fix": "来年の春から、名古屋の店で働くことになりました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-게 되다",
   "ko_diff": "韩语 -게 되다 也与 ことになる 对应，但日语 ことになる 强调「被决定」的过程，韩语 게 되다 还可表能力或状态的自然变化。",
   "notes": "",
   "tags": [
    "decision",
    "result"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0212",
   "pattern": "〜える / 〜られる（potential）",
   "meaning_zh": "能…；会…",
   "connection": "五段动词词尾改え段+る；一段动词去る+られる；する→できる；来る→来られる",
   "usage": "表示能力或条件允许，可能形的宾语常用 が。",
   "register_note": "口语与书面通用；口语中一段动词常省略ら（食べれる）。",
   "examples": [
    {
     "ja": "私は漢字が二百ぐらい読めます。",
     "zh": "我能读大约两百个汉字。"
    },
    {
     "ja": "兄は辛い料理が食べられない。",
     "zh": "我哥哥吃不了辣的菜。"
    },
    {
     "ja": "明日のパーティーに来られますか。",
     "zh": "你能来明天的聚会吗？"
    }
   ],
   "prerequisites": [
    "G0024"
   ],
   "compare": [
    {
