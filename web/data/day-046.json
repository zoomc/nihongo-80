 "grammar": [
  {
   "id": "G0243",
   "pattern": "〜んです / 〜のです",
   "meaning_zh": "（解释）是…的；因为…",
   "connection": "动词普通形／い形容词 + んです；な形容词+な／名词+な + んです",
   "usage": "用于说明原因、补充背景，或向对方寻求解释，口语色彩强。",
   "register_note": "口语；书面用「のです／のである」。",
   "examples": [
    {
     "ja": "どうしたんですか。顔色が悪いですよ。",
     "zh": "怎么了？你脸色不太好。"
    },
    {
     "ja": "すみません、遅れました。電車が止まっていたんです。",
     "zh": "对不起我迟到了，因为电车停运了。"
    },
    {
     "ja": "日本語で手紙を書きたいんですが、手伝ってくれませんか。",
     "zh": "我想用日语写封信，你能帮我吗？"
    }
   ],
   "prerequisites": [
    "G0059"
   ],
   "compare": [
    {
     "id": "G0228",
     "diff": "んです 是会话中的解释说明，ので 是客观原因连接"
    }
   ],
   "common_errors": [
    {
     "wrong": "電車が止まっていたのだです。",
     "why": "のだ 接礼貌体是「のです」，不能作「のだです」",
     "fix": "電車が止まっていたんです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-ㄴ/는 것이다 / -거든요",
   "ko_diff": "韩语 -거든요 与 んです 的解释语气接近，但日语 んです 还可用于提问求解释；韩语 거든요 只用于陈述。",
   "notes": "",
   "tags": [
    "reason",
    "emphasis"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜ㄴ데스 / 〜노데스"
  },
  {
   "id": "G0244",
   "pattern": "〜かどうか",
   "meaning_zh": "是否…",
   "connection": "动词、い形容词普通形 + かどうか；名词、な形容词非过去肯定词干直接接，或用 なのかどうか。",
   "usage": "把是非疑问句嵌入句中，表示不确定或需要确认。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "明日行けるかどうか、まだ分かりません。",
     "zh": "明天能不能去，我还不知道。"
    },
    {
     "ja": "この服が似合うかどうか、ちょっと着てみます。",
     "zh": "这件衣服合不合适，我试穿一下。"
    },
    {
     "ja": "そのレストランがおいしいかどうか、友達に聞いてみよう。",
     "zh": "那家餐厅好不好吃，问问朋友吧。"
    }
   ],
   "prerequisites": [
    "G0058"
   ],
   "compare": [
    {
     "id": "G0245",
     "diff": "かどうか 用于是非疑问，か 用于含疑问词的疑问"
    }
   ],
   "common_errors": [
    {
     "wrong": "明日行けるかどうかを、まだ分かりません。",
     "why": "分かる 的对象用 が 或直接提示，不用 を",
     "fix": "明日行けるかどうか、まだ分かりません。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-인지 아닌지",
   "ko_diff": "오는지 아닌지 对照 来るかどうか，장소가 맞는지 对照 場所が合っているかどうか。有 どこ、誰 等疑问词时，用单独的 か 嵌入问句。",
   "notes": "",
   "tags": [
    "question"
   ],
   "source_ids": [
