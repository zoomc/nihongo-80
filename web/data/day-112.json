 "grammar": [
  {
   "id": "G0133",
   "pattern": "〜ところに / 〜ところへ / 〜ところを",
   "meaning_zh": "正当…的时候",
   "connection": "动词辞书形/ている/た形 + ところに／ところへ／ところを",
   "usage": "表示某动作正要发生或正在进行时，被另一事打断。",
   "register_note": "口语书面均可；「ところを」多接被动，表“被撞见”。",
   "examples": [
    {
     "ja": "出かけようとしているところに、友達から電話がかかってきた。",
     "zh": "正要出门时，朋友打来了电话。"
    },
    {
     "ja": "みんなで君の話をしているところへ、ちょうど君が来た。",
     "zh": "我们正说你呢，你就来了。"
    },
    {
     "ja": "授業中にスマホを見ているところを、先生に見られてしまった。",
     "zh": "上课看手机被老师看见了。"
    }
   ],
   "prerequisites": [
    "G0069"
   ],
   "compare": [
    {
     "id": "G0069",
     "diff": "ところだ 结句表时态阶段，ところに/を 是接续成分，引出打断的事。"
    }
   ],
   "common_errors": [
    {
     "wrong": "出かけるのところに、友達から電話がかかってきた。",
     "why": "「ところ」前接动词时不能加「の」，「のところ」只接名词。",
     "fix": "出かけるところに",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-려는 참에",
   "ko_diff": "韩语常用「-려는 참에」表“正要做时”；日语按「に/へ/を」区分打断方式，韩语没有这种分工。",
   "notes": "",
   "tags": [
    "time"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0134",
   "pattern": "〜ば〜ほど",
   "meaning_zh": "越…越…",
   "connection": "动词ば形 + 同一动词辞书形 + ほど；い形容词ければ + い形容词 + ほど；ナ形容词なら + ナ形容词な + ほど",
   "usage": "表示随着前项程度加深，后项程度也随之变化。",
   "register_note": "口语书面均可，谚语中常见。",
   "examples": [
    {
     "ja": "日本語は、勉強すればするほど面白くなる。",
     "zh": "日语越学越有意思。"
    },
    {
     "ja": "スマホの画面は大きければ大きいほど見やすいが、持ち歩くのは大変だ。",
     "zh": "手机屏幕越大越容易看，但带着走很麻烦。"
    },
    {
     "ja": "部屋が静かなら静かなほど、よく眠れる。",
     "zh": "房间越安静，睡得越好。"
    }
   ],
   "prerequisites": [
    "G0079"
   ],
   "compare": [
    {
     "id": "G0135",
     "diff": "ほど 单表程度，ば〜ほど 表“程度随之递增”的联动关系。"
    }
   ],
   "common_errors": [
    {
     "wrong": "日本語は、勉強するすればするほど面白くなる。",
     "why": "前项必须用ば形「すれば」，「するすれば」不合法。",
     "fix": "勉強すればするほど",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-면 -ㄹ수록",
   "ko_diff": "韩语「-ㄹ수록」一个形式即可；日语要把同一词重复两次（すればするほど），形式负担更重。",
