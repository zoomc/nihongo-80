 "grammar": [
  {
   "id": "G0131",
   "pattern": "〜まま",
   "meaning_zh": "就那样…；保持着…",
   "connection": "动词た形/ない形 + まま；い形容词 + まま；ナ形容词 + な + まま；名词 + の + まま",
   "usage": "表示某状态保持不变地进行另一动作。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "エアコンをつけたまま寝てしまい、風邪をひいた。",
     "zh": "开着空调就睡着了，结果感冒了。"
    },
    {
     "ja": "この町は、私が子どもだったころのままだ。",
     "zh": "这个镇子还和我小时候一样。"
    },
    {
     "ja": "靴のまま部屋に入らないでください。",
     "zh": "请不要穿着鞋进房间。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0132",
     "diff": "まま 是状态持续不变，うちに 是在某状态持续期间发生变化。"
    }
   ],
   "common_errors": [
    {
     "wrong": "エアコンをつけるまま寝てしまい、風邪をひいた。",
     "why": "表示状态持续要用「た形 + まま」，「つけるまま」不合法。",
     "fix": "つけたまま",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-ㄴ 채로",
   "ko_diff": "韩语「-ㄴ 채로」与「まま」很接近；但日语可接名词「〜のまま」，韩语没有对应形式，要改说「그대로」。",
   "notes": "",
   "tags": [
    "state",
    "manner"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0132",
   "pattern": "〜うちに",
   "meaning_zh": "趁着…；在…过程中",
   "connection": "动词辞书形/ている/ない形 + うちに；い形容词 + うちに；ナ形容词 + な + うちに；名词 + の + うちに",
   "usage": "表示在某状态持续期间做某事，或期间不知不觉发生变化。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "若いうちに、いろいろな国を旅行したほうがいい。",
     "zh": "趁年轻多去几个国家旅行比较好。"
    },
    {
     "ja": "スープが冷めないうちに、どうぞ召し上がってください。",
     "zh": "请趁汤还没凉快喝吧。"
    },
    {
     "ja": "音楽を聞いているうちに、いつの間にか眠ってしまった。",
     "zh": "听着音乐，不知不觉就睡着了。"
    }
   ],
   "prerequisites": [
    "G0088"
   ],
   "compare": [
    {
     "id": "G0131",
     "diff": "うちに 强调“期限之前”或“不知不觉”，まま 强调状态原样不变。"
    }
   ],
   "common_errors": [
    {
     "wrong": "若いのうちに、いろいろな国を旅行したほうがいい。",
     "why": "い形容词直接接「うちに」，不加「の」。",
     "fix": "若いうちに",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-는 동안에",
   "ko_diff": "韩语「-는 동안에」只表时间范围；日语「うちに」还含“趁还没变、赶在期限前”的语感。",
