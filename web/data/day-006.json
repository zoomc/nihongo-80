 "grammar": [
  {
   "id": "G0010",
   "pattern": "で（动作场所／手段／材料／原因）",
   "meaning_zh": "在…／用…／因为…",
   "connection": "名詞 + で",
   "usage": "表动作场所、手段/工具/交通、材料、原因",
   "register_note": "で 口语书面通用，表场所、手段、材料、原因。",
   "examples": [
    {
     "ja": "図書館で勉強します。",
     "zh": "在图书馆学习。",
     "vocab_ids": [
      "V0044",
      "V0082"
     ]
    },
    {
     "ja": "電車で行きます。",
     "zh": "坐电车去。",
     "vocab_ids": [
      "V0060",
      "V0103"
     ]
    }
   ],
   "prerequisites": [
    "G0001"
   ],
   "compare": [
    {
     "id": "G0009",
     "diff": "で 强调「在此做某事」，に 强调「存在于此/到达于此」"
    }
   ],
   "common_errors": [
    {
     "wrong": "図書館に 勉強します。",
     "why": "动作场所用 で；中文「在图书馆」的「在」一律误译成 に",
     "fix": "図書館で勉強します。",
     "learner": "zh"
    },
    {
     "wrong": "電車を 行きます。",
     "why": "交通工具用 で（手段），不是宾语 を；乗る 才用 に",
     "fix": "電車で行きます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "particle"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "에서 / (으)로",
   "ko_diff": "韩语动作场所用에서，手段材料用(으)로；日语で一形统合，学习者易混。"
  },
  {
   "id": "G0011",
   "pattern": "へ（移动方向）",
   "meaning_zh": "往／向…",
   "connection": "名詞 + へ + 移動動詞",
   "usage": "表移动方向，读 e 不读 he；侧重方向，に 侧重到达点",
   "register_note": "へ 偏书面或郑重，口语更多用 に。",
   "examples": [
    {
     "ja": "明日、学校へ行きます。",
     "zh": "明天去学校。",
     "vocab_ids": [
      "V0024",
      "V0039",
      "V0103"
     ]
    }
   ],
   "prerequisites": [
    "G0009"
   ],
   "compare": [
    {
     "id": "G0009",
     "diff": "へ 强调朝向，に 强调到达/归着；两者可换但语感不同"
    }
   ],
   "common_errors": [
    {
     "wrong": "学校へ 行きます（へ 读 he）",
     "why": "助词「へ」在此读 e，不读罗马字 he；中文无此音便",
     "fix": "学校へ行きます。（へ 读 e）",
     "learner": "zh"
    },
    {
     "wrong": "学校を 行きます。",
     "why": "移动方向用 へ/に，を 是宾语或经过",
     "fix": "学校へ行きます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
