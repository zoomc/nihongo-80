 "listening": false,
 "grammar": [
  {
   "id": "G0191",
   "pattern": "〜てくださる / 〜ていただく",
   "meaning_zh": "（尊长）为我做…；蒙…为我做",
   "connection": "动词て形 + くださる／いただく（尊敬语／谦让语）",
   "usage": "长辈或上级为自己做事时，用くださる表尊敬，用いただく表谦逊。",
   "register_note": "正式场合、商务与书面语；日常对平辈不用。",
   "examples": [
    {
     "ja": "先生が私の作文を直してくださいました。",
     "zh": "老师为我修改了作文。"
    },
    {
     "ja": "ホテルの方に、おいしい店を教えていただきました。",
     "zh": "酒店的工作人员告诉我一家好吃的店。"
    },
    {
     "ja": "今日は来ていただいて、ありがとうございました。",
     "zh": "今天承蒙您光临，非常感谢。"
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [
    {
     "id": "G0189",
     "diff": "くださる 是くれる 的尊敬语"
    },
    {
     "id": "G0190",
     "diff": "いただく 是もらう 的谦让语"
    }
   ],
   "common_errors": [
    {
     "wrong": "先生が私の作文を直していただきました。",
     "why": "いただく 的主语是接受者「私」，不能以「先生が」作主语",
     "fix": "先生に私の作文を直していただきました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아/어 주시다",
   "ko_diff": "-아/어 주시다 可译两种表达。先生が送ってくださった 以做事的老师作主语；私は先生に送っていただいた 以承蒙帮助的人作主语。",
   "notes": "",
   "tags": [
    "giving-receiving",
    "honorific",
    "humble"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜테쿠다사루 / 〜테이타다쿠"
  },
  {
   "id": "G0192",
   "pattern": "〜ていく",
   "meaning_zh": "…去；从现在起继续…",
   "connection": "动词て形 + いく（ていく）",
   "usage": "表示动作由近及远，或某种变化从现在向未来持续。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "雨が降りそうだから、傘を持っていきます。",
     "zh": "好像要下雨，我带伞去。"
    },
    {
     "ja": "これからもっと寒くなっていくでしょう。",
     "zh": "今后大概会越来越冷吧。"
    },
    {
     "ja": "時間があるなら、お茶を飲んでいきませんか。",
     "zh": "有时间的话，喝杯茶再走好吗？"
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [
    {
     "id": "G0193",
     "diff": "ていく 指向未来或远去，てくる 指向过去或靠近"
    }
   ],
   "common_errors": [
    {
     "wrong": "時間があるなら、お茶を飲んでいくませんか。",
     "why": "「いく」的礼貌否定是「いきません」，不能结合成「いくません」",
     "fix": "時間があるなら、お茶を飲んでいきませんか。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아/어 가다",
   "ko_diff": "韩语 -아/어 가다 也表远离或持续，但日语 ていく 还常表示变化向未来展开，韩语更多用 -아/어 질 것이다 等复合表达。",
   "notes": "",
   "tags": [
    "change",
    "sequence"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜테이쿠"
  },
  {
   "id": "G0193",
   "pattern": "〜てくる",
   "meaning_zh": "…来；一直…到现在；开始…",
   "connection": "动词て形 + くる（てくる）",
   "usage": "表示动作由远及近，或变化从过去累积到现在、开始出现。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "ちょっとコンビニに行ってきます。",
     "zh": "我去一下便利店就回来。"
    },
    {
     "ja": "日本語が少しずつ分かってきた。",
     "zh": "我渐渐能听懂日语了。"
    },
    {
     "ja": "おなかがすいてきた。",
     "zh": "我开始觉得饿了。"
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [
    {
     "id": "G0192",
     "diff": "てくる 指向说话人方向或至今的变化，ていく 指向未来或远去"
    }
   ],
   "common_errors": [
    {
     "wrong": "ちょっとコンビニに行ってきります。",
     "why": "「くる」的礼貌形是「きます」，不是「きります」",
     "fix": "ちょっとコンビニに行ってきます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아/어 오다",
   "ko_diff": "韩语 -아/어 오다 表靠近或持续至今，与 てくる 相近；但日语 てくる 还可表「顺路做某事再回来」，韩语需用 다녀오다 等动词。",
   "notes": "",
   "tags": [
    "change",
    "sequence"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜테쿠루"
  },
  {
   "id": "G0194",
   "pattern": "〜てしまう / 〜ちゃう",
   "meaning_zh": "…完了；不小心…；结果…",
   "connection": "动词て形 + しまう（口语缩约 ちゃう／じゃう）",
   "usage": "表示动作彻底完成，或对意外、遗憾的结果带有惋惜语气。",
   "register_note": "「しまう」口语书面均可；「ちゃう」限口语。",
   "examples": [
    {
     "ja": "電車に傘を忘れてしまいました。",
     "zh": "我把伞忘在电车上了。"
    },
    {
     "ja": "この本はおもしろくて、一晩で読んでしまった。",
     "zh": "这本书太有趣，我一晚上就读完了。"
    },
    {
     "ja": "あ、ケーキを全部食べちゃった。",
     "zh": "啊，我把蛋糕全吃光了。"
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [
    {
     "id": "G0195",
     "diff": "てしまう 强调完成或遗憾，ておく 强调预先准备"
    }
   ],
   "common_errors": [
    {
     "wrong": "電車に傘を忘れでしまいました。",
     "why": "忘れる 的て形是「忘れて」，不是「忘れで」",
     "fix": "電車に傘を忘れてしまいました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아/어 버리다",
   "ko_diff": "다 해 버렸다 可以是完成，也可以有释然或懊恼。しまう 也是如此。口语中 てしまう→ちゃう，でしまう→じゃう，如 読んじゃった。",
   "notes": "",
   "tags": [
