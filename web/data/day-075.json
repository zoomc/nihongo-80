 "grammar": [
  {
   "id": "G0143",
   "pattern": "〜にしても",
   "meaning_zh": "即使…；就算是…",
   "connection": "动词普通形／名词 + にしても；名词化的 の + にしても 也可用",
   "usage": "先承认前项成立，再指出后项仍不受影响，含不满或让步。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "忙しかったにしても、電話一本ぐらいできたでしょう。",
     "zh": "就算再忙，至少也能打个电话吧。"
    },
    {
     "ja": "冗談にしても、そんな言い方はひどいよ。",
     "zh": "就算是开玩笑，那种说法也太过分了。"
    },
    {
     "ja": "引っ越すにしても、来年の春以降になると思います。",
     "zh": "就算要搬家，我想也要等到明年春天以后。"
    }
   ],
   "prerequisites": [
    "G0025"
   ],
   "compare": [
    {
     "id": "G0168",
     "diff": "としても 是纯粹的“即使”，にしても 常带“就算…也该…”的责备。"
    }
   ],
   "common_errors": [
    {
     "wrong": "雨にしてもも、出かけます。",
     "why": "にしても已有も，不叠加第二个も。",
     "fix": "雨にしても、出かけます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-다고 해도",
   "ko_diff": "韩语「-다고 해도」与「にしても」对应；但日语常隐含责备，韩语语气更中性，需靠上下文补出不满。",
   "notes": "",
   "tags": [
    "concession"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "needs_review",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜니시테모"
  },
  {
   "id": "G0144",
   "pattern": "〜に関して / 〜に関する",
   "meaning_zh": "关于…；就…",
   "connection": "名词 + に関して；名词 + に関する／に関しての + 名词",
   "usage": "引出话题，语气比「について」正式、郑重。",
   "register_note": "书面语为主，公文和商务文书常用。",
   "examples": [
    {
     "ja": "新しいサービスに関してご質問がある方は、受付までどうぞ。",
     "zh": "对新服务有疑问的人，请到前台咨询。"
    },
    {
     "ja": "彼は日本の歴史に関する本をたくさん持っている。",
     "zh": "他有很多关于日本历史的书。"
    },
    {
     "ja": "事故の原因に関しては、現在調査中です。",
     "zh": "关于事故原因，目前正在调查。"
    }
   ],
   "prerequisites": [
    "G0076"
   ],
   "compare": [
    {
     "id": "G0116",
     "diff": "に関して 更正式、范围更大，について 更日常。"
    }
   ],
   "common_errors": [
    {
     "wrong": "この問題に関するの資料です。",
     "why": "修饰名词用「に関する資料」或「に関しての資料」。",
     "fix": "この問題に関する資料です。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-에 관해서",
   "ko_diff": "韩语「-에 관해서」表示关于；修饰名词时日语可用「に関する」或「に関しての」，韩语可用「-에 관한」。",
   "notes": "",
   "tags": [
    "topic",
    "formal"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "needs_review",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "pattern_kana": "〜にかんして / 〜にかんする",
   "ko_pron": "〜니칸시테 / 〜니칸스루"
  },
  {
   "id": "G0145",
   "pattern": "〜に比べて",
   "meaning_zh": "与…相比",
   "connection": "名词 + に比べて；动词辞书形 + のに比べて",
   "usage": "拿两个对象作比较，指出差异。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "今年の夏は、去年に比べてずいぶん涼しい。",
     "zh": "今年夏天比去年凉快得多。"
    },
    {
     "ja": "都会に比べて、田舎は家賃が安い。",
     "zh": "和城市相比，乡下房租便宜。"
    },
    {
     "ja": "電車で行くのに比べて、車で行くと三十分ほど長くかかる。",
     "zh": "和坐电车去相比，开车要多花三十分钟左右。"
    }
   ],
   "prerequisites": [
    "G0034"
   ],
   "compare": [
    {
     "id": "G0034",
     "diff": "より 是简单的比较基准，に比べて 明示“对比之下”，更强调差异。"
    }
   ],
   "common_errors": [
    {
     "wrong": "今年の夏は、去年を比べてずいぶん涼しい。",
     "why": "比较的基准用 に（去年に比べて）；を 只用在「AとBを比べる」这种把两样东西都当宾语的句子里。",
     "fix": "今年の夏は、去年に比べてずいぶん涼しい。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-에 비해서",
   "ko_diff": "名词用 작년에 비해／去年に比べて。想比一整件事时，日语常先用 の 把前面从句名词化，再接 に比べて。",
   "notes": "",
   "tags": [
    "comparison"
   ],
