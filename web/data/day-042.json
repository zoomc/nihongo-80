 "grammar": [
  {
   "id": "G0225",
   "pattern": "〜ても / 〜でも",
   "meaning_zh": "即使…也…",
   "connection": "动词て形+も；い形容词去い+くても；な形容词・名词+でも",
   "usage": "表示让步条件，前项成立也不影响后项结论。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "雨が降っても、試合はあります。",
     "zh": "即使下雨，比赛也照常进行。"
    },
    {
     "ja": "いくら練習しても、なかなか上手になりません。",
     "zh": "无论怎么练习，就是不见进步。"
    },
    {
     "ja": "日曜日でも、この店は開いています。",
     "zh": "即使是星期天，这家店也开着。"
    }
   ],
   "prerequisites": [
    "G0020",
    "G0029"
   ],
   "compare": [
    {
     "id": "G0226",
     "diff": "ても 是让步条件，のに 含出乎意料的不满"
    }
   ],
   "common_errors": [
    {
     "wrong": "日曜日ても、この店は開いています。",
     "why": "名词要用「でも」，不能直接接 ても",
     "fix": "日曜日でも、この店は開いています。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아/어도",
   "ko_diff": "贵也买可说 비싸도 산다／高くても買う。名词「即便周末」则是 주말이어도／週末でも，韩语名词前后也有自己的接续。",
   "notes": "",
   "tags": [
    "concession",
    "condition"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜테모 / 〜데모"
  },
  {
   "id": "G0226",
   "pattern": "〜のに（although）",
   "meaning_zh": "明明…却…",
   "connection": "动词普通形／い形容词 + のに；な形容词+な／名词+な + のに",
   "usage": "表示与预期相反，带有意外、不满或惋惜的语气。",
   "register_note": "口语与书面通用；语气主观，正式报告少用。",
   "examples": [
    {
     "ja": "一生懸命勉強したのに、試験に落ちてしまった。",
     "zh": "我明明拼命学习了，考试却没通过。"
    },
    {
     "ja": "日曜日なのに、会社に行かなければならない。",
     "zh": "明明是星期天，却必须去公司。"
    },
    {
     "ja": "約束したのに、彼は来なかった。",
     "zh": "他明明答应了，却没有来。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0231",
     "diff": "のに 含不满与意外，けど 只是中性转折"
    }
   ],
   "common_errors": [
    {
     "wrong": "日曜日ののに、会社に行かなければならない。",
     "why": "名词接 のに 直接加 な，不用 の",
     "fix": "日曜日なのに、会社に行かなければならない。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-는데도",
   "ko_diff": "늦었는데도 안 졸리다 对照 遅いのに眠くない。日语把 のに 留在句末时可表达遗憾；韩语会用 …는데、…는데도! 等省略后文，语气看场合。",
   "notes": "",
   "tags": [
    "concession",
    "criticism"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜노니"
  },
  {
   "id": "G0227",
   "pattern": "〜のに（purpose）",
   "meaning_zh": "用于…；做…需要",
   "connection": "动词辞书形 + のに（用途・所需）；名词 + に",
   "usage": "表示某物的用途，或做某事所需的时间、金钱，常与「便利／かかる」搭配。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "このかばんは旅行に行くのに便利です。",
     "zh": "这个包旅行时很方便。"
    },
    {
     "ja": "家から駅まで歩くのに二十分かかります。",
     "zh": "从家走到车站需要二十分钟。"
    },
    {
     "ja": "引っ越しするのに十万円ぐらいかかった。",
     "zh": "搬家花了大约十万日元。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0232",
     "diff": "のに 接用途或所需，ために 接目的"
    }
   ],
   "common_errors": [
    {
     "wrong": "家から駅まで歩くのに二十分をかかります。",
     "why": "かかる 表示所需时间时用「二十分かかる」，不用 を",
     "fix": "家から駅まで歩くのに二十分かかります。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-는 데",
   "ko_diff": "韩语 -는 데 与用途、所需的 のに 对应（걷는 데 20분 걸린다）；日语 のに 与转折的 のに 同形，韩语则用 데 区分。",
   "notes": "",
   "tags": [
    "purpose"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜노니"
  },
  {
   "id": "G0228",
   "pattern": "〜ので",
   "meaning_zh": "因为…；由于…",
   "connection": "动词普通形／い形容词 + ので；な形容词+な／名词+な + ので",
   "usage": "表示客观原因，语气比から柔和，常用于说明情况或道歉。",
   "register_note": "口语与书面通用；比から礼貌、客观。",
   "examples": [
    {
     "ja": "頭が痛いので、今日は早く帰ります。",
     "zh": "我头疼，今天早点回去。"
    },
    {
     "ja": "明日はテストなので、今夜は勉強します。",
     "zh": "明天有考试，今晚要学习。"
    },
    {
     "ja": "道がこんでいたので、少し遅れました。",
     "zh": "路上很堵，所以稍微迟到了。"
    }
   ],
   "prerequisites": [
    "G0023",
    "G0037"
   ],
   "compare": [
    {
     "id": "G0231",
     "diff": "ので 表客观原因，けど 表转折"
    }
   ],
   "common_errors": [
    {
     "wrong": "明日はテストだので、今夜は勉強します。",
     "why": "名词接 ので 要用「な」，不用「だ」",
     "fix": "明日はテストなので、今夜は勉強します。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아서/어서",
   "ko_diff": "韩语 -아서/어서 与 ので 都表客观原因，但日语 ので 可接意志、请求，韩语 -아서/어서 后项一般不能是命令、劝诱。",
