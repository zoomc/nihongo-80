 "grammar": [
  {
   "id": "G0263",
   "pattern": "〜の（possessive）",
   "meaning_zh": "…的…",
   "connection": "名词 + の + 名词",
   "usage": "表示所属、属性、材料或同位关系，修饰名词时用 の。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "これは私のかさです。",
     "zh": "这是我的伞。"
    },
    {
     "ja": "日本語の先生はとてもやさしいです。",
     "zh": "日语老师非常温柔。"
    },
    {
     "ja": "駅の近くに新しい店があります。",
     "zh": "车站附近有一家新店。"
    }
   ],
   "prerequisites": [
    "G0006"
   ],
   "compare": [
    {
     "id": "G0247",
     "diff": "の 连接名词，は 提示主题"
    }
   ],
   "common_errors": [
    {
     "wrong": "これは私がかさです。",
     "why": "所属关系用 の，が 会变成主语标记",
     "fix": "これは私のかさです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "의",
   "ko_diff": "韩语 의 与 の 对应，但口语中 의 常省略；日语 の 不能省略，且还可代替名词（私の）。",
   "notes": "",
