 "grammar": [
  {
   "id": "G0001",
   "pattern": "N は N です",
   "meaning_zh": "…是…",
   "connection": "名詞 + は + 名詞 + です",
   "usage": "判断句，介绍身份/事物，礼貌体",
   "register_note": "礼貌体判断句，用于自我介绍、说明身份；简体语境用 だ/である。",
   "examples": [
    {
     "ja": "私は学生です。",
     "zh": "我是学生。",
     "vocab_ids": [
      "V0001",
      "V0078"
     ]
    },
    {
     "ja": "これは本です。",
     "zh": "这是书。",
     "vocab_ids": [
      "V0080"
     ]
    }
   ],
   "prerequisites": [],
   "compare": [],
   "common_errors": [
    {
     "wrong": "私は学生だです。",
     "why": "「だ」和「です」都表示“是”，一句话只留一个。中文没有这层变化，容易两个都写。",
     "fix": "私は学生です。",
     "learner": "zh"
    },
    {
     "wrong": "私は 学生 です（は 读 ha）",
     "why": "「は」当助词用时读 wa，不读 ha。中文母语者容易照字面读成 ha。",
     "fix": "私は学生です。（は 读 wa）",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "sentence",
    "copula"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "입니다 / 이에요",
   "ko_diff": "은/는 标主题。학생입니다、의사입니다 在正式礼貌体同用 입니다；日常礼貌体按有无收音选 이에요／예요。日语句末统一用 です。",
   "ko_pron": "N 와 N 데스"
  },
  {
   "id": "G0261",
   "pattern": "〜か（or）",
   "meaning_zh": "…或…",
   "connection": "名词 + か + 名词",
   "usage": "表示两个以上选项中的选择，可用于陈述或疑问。",
