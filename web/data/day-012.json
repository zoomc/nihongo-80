 "grammar": [
  {
   "id": "G0031",
   "pattern": "～たい / ～たがる",
   "meaning_zh": "想（做）…／（第三人称）想…",
   "connection": "动词ます形去 ます + たい／たがる；描述眼前持续表现出来的愿望常用 たがっている",
   "usage": "たい 通常用于说话人愿望或询问对方；叙述他人外显愿望常用 たがる，也可通过引用、传闻等交代他人愿望。",
   "register_note": "たい 表说话人愿望，口语常见；第三人称叙述用 たがる。",
   "examples": [
    {
     "ja": "水が飲みたいです。",
     "zh": "想喝水。",
     "vocab_ids": [
      "V0053",
      "V0102"
     ]
    },
    {
     "ja": "映画が見たいです。",
     "zh": "想看电影。",
     "vocab_ids": [
      "V0099",
      "V0105"
     ]
    }
   ],
   "prerequisites": [
    "G0019"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "飲みたいだ。",
     "why": "たい 按い形容词变化，结句用 です（飲みたいです），不能加 だ。",
     "fix": "飲みたいです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "desire"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "needs_review",
   "provenance": "self_reviewed",
   "ko_equiv": "-고 싶다 / -고 싶어 하다",
   "ko_diff": "韩语常用 -고 싶다 表自己愿望、询问对方或转述内容；观察他人的愿望常用 -고 싶어 하다。日语也须按叙述视角选择。",
   "ko_pron": "～타이 / ～타가루"
  },
  {
   "id": "G0032",
   "pattern": "～ましょう / ～ませんか",
   "meaning_zh": "（一起）…吧／要不要…？",
   "connection": "動詞ます形（去ます） + ましょう／ませんか",
   "usage": "ましょう 表提议/意志；ませんか 是委婉邀约",
   "register_note": "ましょう/ませんか 是礼貌提议，通用；对上级用 ませんか 更稳妥。",
   "examples": [
    {
     "ja": "一緒に映画を見ませんか。",
     "zh": "一起看电影好吗？",
     "vocab_ids": [
      "V0099",
      "V0105"
     ]
    },
    {
     "ja": "そろそろ帰りましょう。",
     "zh": "差不多回去吧。",
     "vocab_ids": [
      "V0122"
     ]
    }
   ],
   "prerequisites": [
    "G0019"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "映画を見るましょう。",
     "why": "ましょう 接ます形词干（見ましょう），不接辞书形 見る。",
     "fix": "映画を見ましょう。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "invitation"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "needs_review",
   "provenance": "self_reviewed",
   "ko_equiv": "-(으)ㅂ시다 / -(으)ㄹ까요? / 같이 …하지 않을래요?",
   "ko_diff": "같이 갈까요? 可对照 一緒に行きませんか。ましょう 是提出一起做，ませんか 把决定留给对方。单说 行きませんか 在合适语境里是邀请。",
   "ko_pron": "～마쇼우 / ～마센카"
  },
  {
   "id": "G0033",
   "pattern": "～が ほしい",
   "meaning_zh": "想要（某物）",
   "connection": "名詞 + が + ほしい（です）",
   "usage": "表说话人想要某物；对象用 が，不是 を；第三人称用 ほしがる",
   "register_note": "ほしい 口语常见；正式请求可用 いただきたい。",
   "examples": [
    {
     "ja": "新しいパソコンがほしいです。",
     "zh": "想要新电脑。",
     "vocab_ids": [
      "V0129",
      "V0088"
     ]
    }
   ],
   "prerequisites": [
    "G0007"
   ],
   "compare": [
    {
     "id": "G0031",
     "diff": "ほしい 想要「物」+が；たい 想要「做动作」，两者对象不同"
    }
   ],
   "common_errors": [
    {
     "wrong": "パソコンを ほしいです。",
     "why": "ほしい 的对象用 が（パソコンがほしい），不用 を。",
     "fix": "パソコンがほしいです。",
     "learner": "zh"
    },
    {
     "wrong": "ほしいだ。",
     "why": "ほしい 是い形容词型，结句加 です，不加 だ。",
     "fix": "ほしいです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
