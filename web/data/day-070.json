 "grammar": [
  {
   "id": "G0129",
   "pattern": "〜気がする",
   "meaning_zh": "感觉…；总觉得…",
   "connection": "普通形 + 気がする；ナ形容词 + な + 気がする；名词 + の + ような + 気がする",
   "usage": "表达模糊的直觉或主观感觉，把握不大。",
   "register_note": "口语为主，书面也可。",
   "examples": [
    {
     "ja": "この人とは、どこかで会ったことがある気がする。",
     "zh": "总觉得在哪儿见过这个人。"
    },
    {
     "ja": "今日は何か、いいことがありそうな気がする。",
     "zh": "今天总觉得会有好事发生。"
    },
    {
     "ja": "ドアの鍵をかけ忘れたような気がして、家に戻った。",
     "zh": "觉得好像忘了锁门，就回家了一趟。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0045",
     "diff": "かもしれない 是客观可能性判断，気がする 只是主观感觉，依据更弱。"
    }
   ],
   "common_errors": [
    {
     "wrong": "今日は何か変気がする。",
     "why": "な形容词接 気がする 要加 な：変な気がする。",
     "fix": "変な気がする",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-(으)ㄴ/는 것 같다 / …한 느낌이 들다",
   "ko_diff": "「好像在哪儿见过」可说 어디선가 본 것 같다，对照 どこかで会った気がする。気がする 常把它说成自己的隐约感觉。",
   "notes": "",
   "tags": [
    "conjecture",
    "emotion"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "pattern_kana": "〜きがする",
   "ko_pron": "〜키가스루"
  },
  {
   "id": "G0130",
   "pattern": "〜ずに",
   "meaning_zh": "不…就…；没…而…",
   "connection": "动词ない形词干 + ずに（する→せずに）",
   "usage": "表示在不做某动作的状态下做另一动作，书面色彩强。",
   "register_note": "书面语为主，口语多说「ないで」。",
   "examples": [
    {
     "ja": "けさは朝ご飯を食べずに家を出た。",
     "zh": "今天早上没吃早饭就出门了。"
    },
    {
     "ja": "辞書を使わずに、この新聞記事が読めますか。",
     "zh": "你能不用词典读懂这篇报道吗？"
    },
    {
     "ja": "彼は誰にも相談せずに、会社を辞めてしまった。",
     "zh": "他没跟任何人商量就辞职了。"
    }
   ],
   "prerequisites": [
    "G0022"
   ],
   "compare": [
    {
     "id": "G0020",
     "diff": "ないで 是口语形式，ずに 更书面；する 要变「せずに」。"
    }
   ],
   "common_errors": [
    {
     "wrong": "彼は誰にも相談しずに、会社を辞めてしまった。",
     "why": "する 的 ずに 形式是 せずに。",
     "fix": "相談せずに",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-지 않고",
   "ko_diff": "-지 않고 对照 ないで／ずに。ずに 常见于较正式的叙述，普通会话也能用。する 是例外，写 せずに。",
   "notes": "",
   "tags": [
    "negation",
    "manner",
    "written"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜즈니"
  },
  {
   "id": "G0131",
   "pattern": "〜まま",
   "meaning_zh": "就那样…；保持着…",
   "connection": "动词た形/ない形 + まま；い形容词 + まま；ナ形容词 + な + まま；名词 + の + まま",
   "usage": "表示某状态保持不变地进行另一动作。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "エアコンをつけたまま寝てしまい、風邪をひいた。",
     "zh": "开着空调就睡着了，结果感冒了。"
    },
    {
     "ja": "この町は、私が子どもだったころのままだ。",
     "zh": "这个镇子还和我小时候一样。"
    },
    {
     "ja": "靴のまま部屋に入らないでください。",
     "zh": "请不要穿着鞋进房间。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0132",
     "diff": "まま 是状态持续不变，うちに 是在某状态持续期间发生变化。"
    }
   ],
   "common_errors": [
    {
     "wrong": "エアコンをつけるまま寝てしまい、風邪をひいた。",
     "why": "表示状态一直持续，要用 た形＋まま：つけたまま。",
     "fix": "つけたまま",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-ㄴ 채로",
   "ko_diff": "韩语「-ㄴ 채로」与「まま」很接近；但日语可接名词「〜のまま」，韩语没有对应形式，要改说「그대로」。",
   "notes": "",
