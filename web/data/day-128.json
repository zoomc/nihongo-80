 "grammar": [
  {
   "id": "G0164",
   "pattern": "〜てばかりいる",
   "meaning_zh": "老是…；一味…",
   "connection": "动词て形 + ばかりいる",
   "usage": "表示反复做同一件事，含批评或不满。",
   "register_note": "口语为主。",
   "examples": [
    {
     "ja": "弟は休みの日、ゲームをしてばかりいる。",
     "zh": "弟弟一放假就光玩游戏。"
    },
    {
     "ja": "泣いてばかりいないで、どうしたのか話してごらん。",
     "zh": "别光哭，说说到底怎么了。"
    },
    {
     "ja": "休みの間、寝てばかりいたら、かえって疲れてしまった。",
     "zh": "假期光睡觉，反倒更累了。"
    }
   ],
   "prerequisites": [
    "G0068"
   ],
   "compare": [
    {
     "id": "G0068",
     "diff": "ばかり 可接名词、数量表限定，てばかりいる 专表反复做某动作且含责难。"
    }
   ],
   "common_errors": [
    {
     "wrong": "弟は休みの日、ゲームをするばかりいる。",
     "why": "「ばかりいる」前接て形「して」，不能用辞书形。",
     "fix": "ゲームをしてばかりいる",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-기만 하다",
   "ko_diff": "韩语「-기만 하다」只表“只做某事”，不带褒贬；日语「てばかりいる」几乎总含批评。",
