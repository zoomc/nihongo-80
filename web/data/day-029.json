 "grammar": [
  {
   "id": "G0050",
   "pattern": "使役形（～せる／させる）",
   "meaning_zh": "让／使…（做）",
   "connection": "五段 う段→あ段+せる；一段 去る+させる；カ変 来させる；サ変 させる",
   "usage": "表使役/强制/允许；他动词句使役对象用 に，自动词句用 を",
   "register_note": "使役口语书面通用；使役敬语需另学。",
   "examples": [
    {
     "ja": "先生は学生に本を読ませました。",
     "zh": "老师让学生读书。",
     "vocab_ids": [
      "V0079",
      "V0078",
      "V0080",
      "V0113"
     ]
    }
   ],
   "prerequisites": [
    "G0022",
    "G0023"
   ],
   "compare": [
    {
     "id": "G0049",
     "diff": "使役 〜せる/させる 表「让」，受身 〜られる 表「被」，形近义反"
    }
   ],
   "common_errors": [
    {
     "wrong": "先生は学生を本を読ませました。",
     "why": "句子里已经有 を（本を），使役对象改用 に（学生に），不能两个 を。",
     "fix": "先生は学生に本を読ませました。",
     "learner": "zh"
    },
    {
     "wrong": "読みさせました",
     "why": "五段动词的使役是 あ段＋せる：読む→読ませる，不是 読み＋させる。",
     "fix": "読ませました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "tags": [
    "voice",
    "causative"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-게 하다 / -시키다",
   "ko_diff": "시키다 与 -게 하다 都可以理解使役；日语需再判断使役对象的助词。句中已有被读的内容を 时，让谁读用 人に。",
   "ko_pron": ""
  },
