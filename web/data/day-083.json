 "grammar": [
  {
   "id": "G0078",
   "pattern": "N + に 基づいて / を もとに / どおり(に)",
   "meaning_zh": "基于…／以…为依据／按照…",
   "connection": "名詞 + に基づいて（依据资料/规则/数据）；名詞 + をもとに（以…为素材/基础）；名詞 + どおり(に)（照原样、按预定）",
   "usage": "书面；に基づいて 偏「依据权威来源」，をもとに 偏「以…为材料加工」，どおり 偏「不改动地照做」",
   "register_note": "に基づいて/をもとに/どおり 书面正式，口语少用。",
   "examples": [
    {
     "ja": "調査結果に基づいて、報告書を作成しました。",
     "zh": "依据调查结果写成了报告。",
     "vocab_ids": [
      "V0208",
      "V0247"
     ]
    },
    {
     "ja": "予定どおりに、会議を始めます。",
     "zh": "按预定开始会议。",
     "vocab_ids": [
      "V0186",
      "V0244",
      "V0160"
     ]
    }
   ],
   "prerequisites": [
    "G0009",
    "G0006",
    "G0023"
   ],
   "compare": [
    {
     "id": "G0055",
     "diff": "によって 表原因/手段；に基づいて 表「以…为根据/来源」"
    },
    {
     "id": "G0077",
     "diff": "に伴って 是伴随变化；に基づいて 是静态依据，无变化义"
    }
   ],
   "common_errors": [
    {
     "wrong": "資料に基づいてに書きました。",
     "why": "に基づいて 已含 に，不再叠 に；中文「基于资料」直译叠加助词错",
     "fix": "資料に基づいて書きました。",
     "learner": "zh"
    },
    {
     "wrong": "アンケート結果をに基づいて改善します。",
     "why": "に基づいて 前用 に（結果に基づいて），もとに 才用 を；中文「以…为基础」直译混了 を 与 に",
     "fix": "アンケート結果に基づいて改善します。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "particle",
    "basis",
    "formal",
    "source"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-에 근거해 / -을 바탕으로 / -대로",
   "ko_diff": "韩语에 근거해表依据、을 바탕으로表以…为基础、대로表按照，与日语三形基本对应。"
  },
  {
   "id": "G0079",
   "pattern": "V ば形 + 同一動詞 辞書形 + ほど",
   "meaning_zh": "越…越…",
   "connection": "動詞 条件形(ば) + 同じ動詞 辞書形 + ほど；い形 ければ＋い形＋ほど；な形 なら＋な形＋ほど",
   "usage": "前后同词重复，表成正比变化；常与 ますます 呼应",
   "register_note": "ば…ほど 偏书面说明，口语也用。",
   "examples": [
    {
     "ja": "練習すればするほど、上手になります。",
     "zh": "越练越熟练。",
     "vocab_ids": [
      "V0172",
      "V0179",
      "V0110"
     ]
    },
    {
     "ja": "値段が高ければ高いほど、売れにくくなります。",
     "zh": "价格越贵越难卖。",
     "vocab_ids": [
      "V0125",
      "V0110"
     ]
    }
   ],
   "prerequisites": [
    "G0025",
    "G0038",
    "G0023"
   ],
   "compare": [
    {
     "id": "G0038",
     "diff": "条件形使い分け 是单句条件；ば…ほど 是同词重复表比例变化"
    },
    {
     "id": "G0077",
     "diff": "に伴って/につれて 是「A 变 B 也变」；ば…ほど 是「A 程度越高 B 程度越高」成正比"
    }
   ],
   "common_errors": [
    {
     "wrong": "練習すれば、上手になります。",
     "why": "这是普通条件句，不含「越…越…」；中文「越练越好」直译丢 ほど 错",
     "fix": "練習すればするほど上手になります。",
     "learner": "zh"
    },
    {
     "wrong": "高いば高いほど",
     "why": "い形 ば形 是 高ければ（去 い＋ければ），不是 高い＋ば；中文无变形按汉字直译错",
     "fix": "高ければ高いほど、…",
     "learner": "zh"
    }
   ],
