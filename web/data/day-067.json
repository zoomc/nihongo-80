 "grammar": [
  {
   "id": "G0229",
   "pattern": "〜て（reason）",
   "meaning_zh": "因为…（造成某种状态）",
   "connection": "动词て形／い形容词去い+くて／な形容词・名词+で",
   "usage": "用て形连接原因与结果，后项多为感情、状态或不能控制的结果。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "ニュースを聞いて、びっくりしました。",
     "zh": "听到那个消息，我吓了一跳。"
    },
    {
     "ja": "このスープは熱くて、飲めません。",
     "zh": "这汤太烫了，喝不了。"
    },
    {
     "ja": "かぜで学校を休みました。",
     "zh": "因为感冒，我请假没去学校。"
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [
    {
     "id": "G0228",
     "diff": "て 的原因句后项多为状态，ので 可接意志性表达"
    }
   ],
   "common_errors": [
    {
     "wrong": "このスープは熱いで、飲めません。",
     "why": "い形容词用「くて」，不是「いで」",
     "fix": "このスープは熱くて、飲めません。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아서/어서",
   "ko_diff": "韩语 -아서/어서 与 て 的原因用法对应，但日语 て 形还可表并列、先后，功能更多；韩语需靠上下文或另加连接词。",
   "notes": "",
   "tags": [
    "reason"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
