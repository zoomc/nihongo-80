 "grammar": [
  {
   "id": "G0254",
   "pattern": "〜に（frequency）",
   "meaning_zh": "每…（几次）",
   "connection": "数量词 + に + 数量词（回数）",
   "usage": "表示在一段时间内做某事的频率，如「一日に二回」。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "一週間に二回、プールで泳ぎます。",
     "zh": "我一周在游泳池游两次。"
    },
    {
     "ja": "母は一日に二回、犬の散歩をします。",
     "zh": "母亲一天遛两次狗。"
    },
    {
     "ja": "一年に一度、家族で旅行します。",
     "zh": "我们一年全家旅行一次。"
    }
   ],
   "prerequisites": [
    "G0009"
   ],
   "compare": [
    {
