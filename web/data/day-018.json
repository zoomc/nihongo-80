  {
   "id": "G0258",
   "pattern": "〜と（and）",
   "meaning_zh": "…和…（全部列举）",
   "connection": "名词 + と + 名词（全部列举）",
   "usage": "连接名词列举，可说「AとB」，也可在并列成分后重复と，如「AとBとが」。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "かばんの中にペンとノートがあります。",
     "zh": "包里有笔和笔记本。"
    },
    {
     "ja": "朝ご飯にパンとたまごを食べました。",
     "zh": "早饭吃了面包和鸡蛋。"
    },
    {
     "ja": "父と母は銀行で働いています。",
     "zh": "父亲和母亲在银行工作。"
    }
   ],
   "prerequisites": [
    "G0012"
   ],
   "compare": [
    {
     "id": "G0260",
     "diff": "と 全部列举，や 部分列举"
    }
   ],
   "common_errors": [
    {
     "wrong": "かばんにペンととノートがあります。",
