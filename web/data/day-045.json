 "grammar": [
  {
   "id": "G0237",
   "pattern": "〜たがる",
   "meaning_zh": "（第三人称）想做…",
   "connection": "动词ます形去ます + たがる",
   "usage": "たがる 通常描述他人表现出的愿望，也可在客观回顾自己的习惯或心理时使用；直接表达当下自己的愿望通常用 たい。",
   "register_note": "口语与书面通用；第一人称愿望用「たい」。",
   "examples": [
    {
     "ja": "子どもたちは外で遊びたがっている。",
     "zh": "孩子们想在室外玩。"
    },
    {
     "ja": "弟はいつも私のゲームをやりたがる。",
     "zh": "弟弟总是想玩我的游戏。"
    },
    {
     "ja": "犬が散歩に行きたがっています。",
     "zh": "狗想出去散步。"
    }
   ],
   "prerequisites": [
    "G0031"
   ],
   "compare": [
    {
     "id": "G0238",
     "diff": "たがる 接动词表想做，がる 接形容词表感觉"
    }
   ],
   "common_errors": [
    {
     "wrong": "弟は遊ぶたがっています。",
     "why": "たがる前用ます形词干「遊び」，不用辞书形「遊ぶ」。",
     "fix": "弟は遊びたがっています。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-고 싶어 하다",
   "ko_diff": "韩语常用 -고 싶어 하다 描述他人表现出的愿望；日语たがる同样关注外显表现，人称选择需结合语境。",
   "notes": "",
   "tags": [
    "desire"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "needs_review",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜타가루"
  },
  {
   "id": "G0238",
   "pattern": "〜がる",
   "meaning_zh": "（第三人称）显得…；表现出…",
   "connection": "い形容词去い／な形容词词干 + がる",
   "usage": "把形容词变成动词，表示他人表现出的感觉或欲求。",
   "register_note": "口语与书面通用；第一人称不用。",
   "examples": [
    {
     "ja": "妹は暗い所を怖がる。",
     "zh": "妹妹怕黑的地方。"
    },
    {
     "ja": "祖母は孫に会えなくて寂しがっている。",
     "zh": "奶奶见不到孙子，感到很寂寞。"
    },
    {
     "ja": "息子は新しい自転車をほしがっている。",
     "zh": "儿子想要一辆新自行车。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0237",
     "diff": "がる 接形容词表第三人的感觉，たがる 接动词表想做"
    }
   ],
   "common_errors": [
    {
     "wrong": "妹は暗い所を怖いがります。",
     "why": "い形容词接がる时去掉词尾い，怖い变为怖がる。",
     "fix": "妹は暗い所を怖がります。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-아/어 하다",
   "ko_diff": "韩语可用 -아/어 하다 描述他人表现出的情绪，如 무서워하다；日语がる通常描述外显表现，也可客观回顾自己的倾向。",
   "notes": "",
   "tags": [
    "emotion",
    "appearance"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "needs_review",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜가루"
  },
  {
   "id": "G0239",
   "pattern": "〜かもしれない",
   "meaning_zh": "也许…；可能…",
   "connection": "动词、い形容词普通形 + かもしれない；名词、な形容词的非过去肯定词干直接接。",
   "usage": "表示不确定的推测，可能性低于だろう。",
   "register_note": "口语与书面通用；礼貌体「かもしれません」。",
   "examples": [
    {
     "ja": "午後から雨が降るかもしれません。",
     "zh": "下午可能会下雨。"
    },
    {
     "ja": "かぎがない。電車の中で落としたかもしれない。",
     "zh": "钥匙不见了，可能掉在电车上了。"
    },
    {
     "ja": "その話は本当かもしれない。",
     "zh": "那个说法可能是真的。"
    }
   ],
   "prerequisites": [
    "G0045"
   ],
   "compare": [
    {
     "id": "G0240",
     "diff": "かもしれない 把握较小，だろう 把握较大"
    }
   ],
   "common_errors": [
    {
     "wrong": "午後から雨が降るかもません。",
     "why": "かもしれない 的礼貌形是「かもしれません」",
     "fix": "午後から雨が降るかもしれません。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-(으)ㄹ지도 모르다",
   "ko_diff": "선생님일지도 모른다 对照 先生かもしれない。韩语名词前后可出现 -이다 的活用形式，日语别在 先生 后多加 だ。",
   "notes": "",
   "tags": [
    "possibility",
    "conjecture"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜카모시레나이"
  },
  {
   "id": "G0240",
   "pattern": "〜だろう",
   "meaning_zh": "大概…吧",
   "connection": "动词、い形容词普通形 + だろう；名词、な形容词的非过去肯定词干 + だろう。",
   "usage": "表示说话人的推测，把握较大，口语常用。",
   "register_note": "普通体；礼貌体用「でしょう」。",
   "examples": [
    {
     "ja": "明日はたぶん晴れるだろう。",
     "zh": "明天大概会晴吧。"
    },
    {
     "ja": "彼女はもう家に着いただろう。",
     "zh": "她大概已经到家了吧。"
    },
    {
     "ja": "この問題は子どもには難しいだろうと思います。",
     "zh": "我觉得这个问题对孩子来说大概太难了。"
    }
   ],
   "prerequisites": [
    "G0045"
   ],
   "compare": [
    {
     "id": "G0239",
     "diff": "だろう 把握较大，かもしれない 把握较小"
    }
   ],
   "common_errors": [
    {
     "wrong": "明日はたぶん晴れるでしょうだ。",
     "why": "でしょう 已是礼貌断定，不能再加 だ",
     "fix": "明日はたぶん晴れるでしょう。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-(으)ㄹ 것이다 / -겠다",
   "ko_diff": "韩语 -(으)ㄹ 것이다 与 だろう 对应，-겠다 更偏主观意志或推测；日语 だろう 只表推测，不表意志。",
