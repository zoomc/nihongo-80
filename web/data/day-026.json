 "grammar": [
  {
   "id": "G0263",
   "pattern": "〜の（possessive）",
   "meaning_zh": "…的…",
   "connection": "名词 + の + 名词",
   "usage": "表示所属、属性、材料或同位关系，修饰名词时用 の。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "これは私のかさです。",
     "zh": "这是我的伞。"
    },
    {
     "ja": "日本語の先生はとてもやさしいです。",
     "zh": "日语老师非常温柔。"
    },
    {
     "ja": "駅の近くに新しい店があります。",
     "zh": "车站附近有一家新店。"
    }
   ],
   "prerequisites": [
    "G0006"
   ],
   "compare": [
    {
     "id": "G0247",
     "diff": "の 连接名词，は 提示主题"
    }
   ],
   "common_errors": [
    {
     "wrong": "これは私がかさです。",
     "why": "所属关系用 の，が 会变成主语标记",
     "fix": "これは私のかさです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "의",
   "ko_diff": "韩语 의 与 の 对应，但口语中 의 常省略；日语 の 不能省略，且还可代替名词（私の）。",
   "notes": "",
   "tags": [
    "particle"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0264",
   "pattern": "〜から（from）",
   "meaning_zh": "从…（起点）",
   "connection": "名词 + から（起点）",
   "usage": "表示时间或场所的起点，常与「まで」呼应。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "授業は9時からです。",
     "zh": "课从九点开始。"
    },
    {
     "ja": "学校から駅まで歩きます。",
     "zh": "我从学校走到车站。"
    },
    {
     "ja": "私はブラジルから来ました。",
     "zh": "我来自巴西。"
    }
   ],
   "prerequisites": [
    "G0013"
   ],
   "compare": [
    {
     "id": "G0265",
     "diff": "から 表起点，まで 表终点"
    }
   ],
   "common_errors": [
    {
     "wrong": "学校から駅までに歩きます。",
     "why": "まで 表终点，后接动词时不再加 に",
     "fix": "学校から駅まで歩きます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "ko_equiv": "부터 / 에서",
   "ko_diff": "韩语时间起点用 부터，场所起点用 에서；日语 から 两者通用，范围更宽。",
