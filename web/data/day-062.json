     "diff": "なさい 比命令形柔和，用于上对下"
    }
   ],
   "common_errors": [
    {
     "wrong": "もう九時よ。早く寝ろなさい。",
     "why": "なさい 接ます形去ます，不能与命令形叠用",
     "fix": "もう九時よ。早く寝なさい。",
     "learner": "zh"
    }
