 "grammar": [
  {
   "id": "G0181",
   "pattern": "〜向き / 〜向け",
   "meaning_zh": "适合…；面向…",
   "connection": "名词 + 向き（だ／の／な）；名词 + 向け（だ／の／に）",
   "usage": "「向き」表“适合某类人”，「向け」表“以某类人为对象制作”。",
   "register_note": "口语书面均可，商品说明常见。",
   "examples": [
    {
     "ja": "この料理は作り方が簡単なので、初心者向きだ。",
     "zh": "这道菜做法简单，适合初学者。"
    },
    {
     "ja": "この雑誌は、若い女性向けに作られている。",
     "zh": "这本杂志是面向年轻女性制作的。"
    },
    {
     "ja": "子ども向けの番組だが、大人が見ても十分楽しめる。",
     "zh": "这是给孩子看的节目，大人看也很有趣。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0140",
     "diff": "として 表身份资格，向け 表“以…为对象”，都接名词但功能不同。"
    }
   ],
   "common_errors": [
    {
     "wrong": "これは初心者向きのな本です。",
     "why": "向き 修饰名词用 向きの（初心者向きの本），不要写成 のな。",
     "fix": "これは初心者向きの本です。",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "…에 알맞다 / …용",
   "ko_diff": "초보자에게 알맞다 对照 初心者向き；초보자용 对照 初心者向け。前者评价适不适合，后者说明为谁设计，实际使用对象可能重合。",
   "notes": "",
   "tags": [
    "purpose",
    "relation"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "needs_review",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "pattern_kana": "〜むき / 〜むけ",
   "ko_pron": "〜무키 / 〜무케"
  },
  {
   "id": "G0182",
   "pattern": "〜がち",
   "meaning_zh": "容易…；动不动就…",
   "connection": "动词ます形词干/名词 + がち",
   "usage": "表示容易出现某种不太好的倾向，多含消极评价。",
   "register_note": "书面语为主，报道中常见。",
   "examples": [
    {
     "ja": "冬になると、つい家にこもりがちになる。",
     "zh": "一到冬天，就容易闷在家里。"
    },
    {
     "ja": "娘は小さいころ病気がちだったが、今はとても元気だ。",
     "zh": "女儿小时候常生病，现在很健康。"
    },
    {
     "ja": "一人暮らしだと、野菜が不足しがちです。",
     "zh": "一个人生活，容易蔬菜摄入不足。"
    }
   ],
   "prerequisites": [
    "G0095"
   ],
   "compare": [
    {
     "id": "G0183",
     "diff": "がち 是“容易出现的倾向”，気味 是“已经有了一点那种迹象”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "冬になると、つい家にこもるがちになる。",
     "why": "「がち」前接ます形词干「こもり」，不能接辞书形。",
     "fix": "こもりがちになる",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-기 쉽다",
   "ko_diff": "韩语「-기 쉽다」中性，好坏都可用；日语「がち」几乎只用于消极倾向，且偏书面。",
   "notes": "",
   "tags": [
    "tendency"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜가치"
  },
  {
   "id": "G0183",
   "pattern": "〜気味",
   "meaning_zh": "有点…；稍有…迹象",
   "connection": "名词/动词ます形词干 + 気味",
   "usage": "表示已经出现某种轻微、不太好的迹象。",
   "register_note": "口语书面均可，书面偏多。",
   "examples": [
    {
     "ja": "少し風邪気味なので、今日は早めに帰ります。",
     "zh": "有点感冒，今天早点回去。"
    },
    {
     "ja": "最近、仕事が忙しくて疲れ気味だ。",
     "zh": "最近工作忙，有点累。"
    },
    {
     "ja": "人手が足りず、工事は予定より遅れ気味だ。",
     "zh": "人手不足，工程有点滞后。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0182",
     "diff": "気味 是“已有轻微迹象”，がち 是“容易反复出现的倾向”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "少し風邪の気味なので、今日は早めに帰ります。",
     "why": "「気味」直接接名词或动词词干，不加「の」。",
     "fix": "風邪気味なので",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "약간 … 기운이 있다 / 조금 …한 편이다",
   "ko_diff": "감기 기운이 있다 很接近 風邪気味だ。疲れ気味 可译 요즘 조금 피곤한 편이다。気味 通常说眼下有一点某种迹象，がち 则说反复出现的倾向。",
