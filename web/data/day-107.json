 "grammar": [
  {
   "id": "G0123",
   "pattern": "〜っぽい",
   "meaning_zh": "有点…；容易…；带…色",
   "connection": "名词/动词ます形词干/い形容词词干 + っぽい",
   "usage": "口语中表“带有某种倾向或感觉”，多含轻微负面评价。",
   "register_note": "口语为主，正式文章少用。",
   "examples": [
    {
