   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-는데도 / -지만 / -라고는 해도",
   "ko_diff": "韩语责备用는데도，中性让步用지만，话虽如此用라고는 해도；くせに的轻蔑靠语调。"
  }
