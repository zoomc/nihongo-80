 "grammar": [
  {
   "id": "G0080",
   "pattern": "N(＋助詞) + さえ／こそ／すら；V ば形 前 + さえ…ば",
   "meaning_zh": "甚至…／只要…就／正是…／连…都",
   "connection": "さえ/すら 取代 が・を 或接在助词后（にさえ／でさえ）；さえ…ば 用 条件形(ば)；こそ 强调主语/原因（〜からこそ）",
   "usage": "さえ 举极端例表「连…都/甚至」；さえ…ば 表「只要满足这一项就够」；こそ 强调「正是」；すら 文言、更消极",
   "register_note": "さえ/こそ 口语书面通用，すら 偏文言。",
   "examples": [
    {
     "ja": "忙しくて、昼ご飯を食べる時間さえありません。",
     "zh": "忙得连吃午饭的时间都没有。",
     "vocab_ids": [
      "V0131",
      "V0027",
      "V0022"
     ]
    },
    {
     "ja": "これさえあれば、大丈夫です。",
     "zh": "只要有这个就没问题。",
     "vocab_ids": [
      "V0182",
      "V0108"
     ]
    },
    {
     "ja": "今こそ頑張るときです。",
     "zh": "现在正是努力的时候。",
     "vocab_ids": [
      "V0022"
     ]
    }
   ],
   "prerequisites": [
    "G0004",
    "G0025",
    "G0007"
   ],
   "compare": [
    {
     "id": "G0004",
     "diff": "も 是普通并列/类推；さえ 是举出极端一例「连…都」，语气更强"
    },
    {
     "id": "G0038",
     "diff": "条件形 单句；さえ…ば 强调「仅此一项条件即可」"
    }
   ],
   "common_errors": [
    {
     "wrong": "時間さえがありません。",
     "why": "さえ 已取代 が/を，不再叠 が；中文「连时间都没有」直译保留 が 错",
     "fix": "時間さえありません。",
     "learner": "zh"
    },
    {
     "wrong": "こそ／さえ／すら 可任意互换",
     "why": "【疑点】三者语感与接续不同（こそ 强调、さえ 举极端、すら 偏文言消极），本条合并讲授，建议拆分二次核实，故标 needs_review",
     "fix": "按语境分别使用：今こそ／時間さえ／名前すら",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "tags": [
    "particle",
    "emphasis",
    "conditional",
    "needs_review"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "needs_review",
   "provenance": "self_reviewed",
   "ko_equiv": "-조차 / -야말로 / -마저",
   "ko_diff": "韩语조차表连…都(多否定)、마저表连…也(消极)、야말로表正是，分工比日语さえ/すら细。",
   "notes": "「さえ…ば」は条件を強調する形。「これさえあるなら」も文脈により使えるため誤りとしない。"
  },
  {
   "id": "G0081",
   "pattern": "普通形 + くせに / ものの / とはいえ",
   "meaning_zh": "明明…却（责备）／虽然…但是／虽说…然而",
   "connection": "くせに：动词／い形普通形、な形容词 + な、名词 + の；ものの：普通形；とはいえ：名词或普通形 + とはいえ",
   "usage": "くせに 带强烈责备/轻蔑（对人不满）；ものの 是中性书面让步；とはいえ 是「话虽如此」，常修正前句",
   "register_note": "くせに 口语情绪强；ものの/とはいえ 偏书面。",
   "examples": [
    {
     "ja": "知っているくせに、教えてくれませんでした。",
     "zh": "明明知道却不告诉我。",
     "vocab_ids": [
      "V0124",
      "V0121"
     ]
    },
    {
     "ja": "買ったものの、使っていません。",
     "zh": "虽然买了却没在用。",
     "vocab_ids": [
      "V0106",
      "V0022"
     ]
    },
    {
     "ja": "高いとはいえ、品質はいいです。",
     "zh": "虽说贵，质量倒不错。",
     "vocab_ids": [
      "V0125"
     ]
    }
   ],
   "prerequisites": [
    "G0023",
    "G0016",
    "G0075"
   ],
   "compare": [
    {
     "id": "G0075",
     "diff": "のに 只是意外/遗憾；くせに 带明显责备、轻蔑，语气更重，不能对长辈用"
    },
    {
     "id": "G0037",
     "diff": "から/ので 顺接；ものの/とはいえ 是让步逆接，方向相反"
    }
   ],
   "common_errors": [
    {
     "wrong": "先生は知っているくせに、教えてくれませんでした。",
     "why": "くせに 带责备/轻蔑，对老师用极失礼；中文「明明…却」直译不看对象错",
     "fix": "先生はご存じなのに、教えてくださいませんでした。",
     "learner": "zh"
    },
    {
     "wrong": "子供だくせに、…",
     "why": "名词接 くせに 通常用「の」，例如「子供のくせに」；な形容词则用「な」。",
     "fix": "子供のくせに、…",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
