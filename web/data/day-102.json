 "grammar": [
  {
   "id": "G0113",
   "pattern": "〜一方だ",
   "meaning_zh": "一直…；越来越…",
   "connection": "动词辞书形 + 一方だ",
   "usage": "表示某变化只朝一个方向持续发展，多用于负面趋势。",
   "register_note": "书面语为主，新闻报道常见。",
   "examples": [
    {
     "ja": "この町の人口は、減る一方だ。",
     "zh": "这个镇的人口一直在减少。"
    },
    {
     "ja": "物価は上がる一方なのに、給料は全然上がらない。",
     "zh": "物价一个劲上涨，工资却完全不涨。"
    },
    {
     "ja": "勉強をさぼっていたら、成績は下がる一方だった。",
     "zh": "一直偷懒，成绩就一路下滑。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0057",
     "diff": "ていく/くる 只表方向，一方だ 强调单向变化持续不止，语气更重。"
    }
   ],
   "common_errors": [
    {
     "wrong": "この町の人口は、減り一方だ。",
     "why": "「一方だ」前接辞书形「減る」，不能接ます形词干「減り」。",
     "fix": "減る一方だ",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-기만 한다",
   "ko_diff": "韩语「-기만 한다」偏“只做某事”；日语「一方だ」专指程度单向加剧，常带忧虑，韩语更常说「계속 -고 있다」。",
   "notes": "",
   "tags": [
    "change",
    "tendency"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0114",
   "pattern": "〜一方で",
   "meaning_zh": "一方面…；同时…",
   "connection": "普通形 + 一方で；ナ形容词 + な + 一方で；名词 + である + 一方で",
   "usage": "并列同一事物的两个侧面，或表两件事同时进行。",
   "register_note": "书面语为主，论述文常用。",
   "examples": [
    {
     "ja": "インターネットは便利な一方で、危険な面もある。",
     "zh": "互联网很方便，另一方面也有危险的一面。"
    },
    {
     "ja": "この会社は給料が高い一方で、休みがとても少ない。",
     "zh": "这家公司工资高，但休假很少。"
    },
    {
     "ja": "彼女は会社で働く一方で、夜は大学院に通っている。",
     "zh": "她一边在公司上班，晚上一边读研究生。"
    }
   ],
   "prerequisites": [
    "G0085"
   ],
   "compare": [
    {
     "id": "G0113",
     "diff": "一方だ 是单向变化，一方で 是对比两面或并行两事。"
    }
   ],
   "common_errors": [
    {
     "wrong": "インターネットは便利だ一方で、危険な面もある。",
     "why": "ナ形容词接「一方で」要用「な」，「便利だ一方で」不合法。",
     "fix": "便利な一方で",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-는 반면에",
   "ko_diff": "韩语「-는 반면에」只表对比；日语「一方で」还能表“同时进行的两件事”，范围更宽。",
