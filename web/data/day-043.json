 "grammar": [
  {
   "id": "G0058",
   "pattern": "普通形 + か どうか",
   "meaning_zh": "是否…；…还是不…",
   "connection": "動詞/い形 普通形 + かどうか；名詞・な形 词干 + かどうか（不加 だ/な）；疑问词问句不用 かどうか",
   "usage": "把是非疑问嵌入句中，作 分かる／調べる／決める／聞く 等的内容；整体可当名词用（が／を／は）",
   "register_note": "かどうか 口语书面通用，把疑问嵌入句中。",
   "examples": [
    {
     "ja": "行けるかどうか、まだ分かりません。",
     "zh": "还不知道能不能去。",
     "vocab_ids": [
      "V0103",
      "V0124"
     ]
    },
    {
     "ja": "彼が来るかどうか、聞いてみます。",
     "zh": "我去问问他来不来。",
     "vocab_ids": [
      "V0074",
      "V0104",
      "V0115"
     ]
    }
   ],
   "prerequisites": [
    "G0023",
    "G0012"
   ],
   "compare": [
    {
     "id": "G0036",
     "diff": "〜と 思う 引用陈述内容；かどうか 嵌入「是否」疑问"
    }
   ],
   "common_errors": [
    {
     "wrong": "行くかどうかを分かりません。",
     "why": "「分かる」的对象用 が，中文「知道是否…」直译加 を 错",
     "fix": "行くかどうか分かりません。",
     "learner": "zh"
    },
    {
     "wrong": "便利だかどうか調べます。",
     "why": "な形/名词接 かどうか 去掉 だ；中文「是否方便」直译保留 だ 错",
     "fix": "便利かどうか調べます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "tags": [
    "embedded-question",
    "plain-form",
    "particle"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-는지 / -(으)ㄴ지",
   "ko_diff": "韩语嵌入疑问用는지，按词性变인지；日语かどうか固定，且不能直接接名词。"
  },
  {
   "id": "G0059",
   "pattern": "普通形 + んです / のだ",
   "meaning_zh": "（是）因为…；其实是…（说明/强调语气）",
   "connection": "動詞・い形 普通形 + んです；な形・名詞 + な + んです；礼貌体 んです，简体 のだ／んだ",
   "usage": "解释原因、背景或强调；回答 どうして 时用；口语用 んです，书面/简体用 のだ",
   "register_note": "んです 口语解释语气强；书面叙述用 のだ/のである。",
   "examples": [
    {
     "ja": "遅くなってすみません。電車が遅れたんです。",
     "zh": "抱歉迟到了，是电车晚点了。",
     "vocab_ids": [
      "V0165",
      "V0060"
     ]
    },
    {
     "ja": "この店は高いんですか。",
     "zh": "这家店（是）很贵吗？",
     "vocab_ids": [
      "V0042",
      "V0125"
     ]
    }
   ],
   "prerequisites": [
    "G0023",
    "G0001"
   ],
   "compare": [
    {
     "id": "G0001",
     "diff": "は N です 只是判断句；んです 追加「说明/解释」语气"
    }
   ],
   "common_errors": [
    {
     "wrong": "電車が遅れたです。",
     "why": "普通形过去 た 不能直接接 です；中文「晚点了」直译错，须 た＋んです",
     "fix": "電車が遅れたんです。",
     "learner": "zh"
    },
    {
     "wrong": "彼は学生んです。",
     "why": "名词/な形＋んです 必须插入 な；中文「是学生」直译漏 な",
     "fix": "彼は学生なんです。",
     "learner": "zh"
    }
   ],
