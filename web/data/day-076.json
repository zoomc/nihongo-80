 "grammar": [
  {
   "id": "G0244",
   "pattern": "〜かどうか",
   "meaning_zh": "是否…",
   "connection": "动词普通形／い形容词／な形容词／名词 + かどうか",
   "usage": "把是非疑问句嵌入句中，表示不确定或需要确认。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
     "ja": "明日行けるかどうか、まだ分かりません。",
     "zh": "明天能不能去，我还不知道。"
    },
    {
     "ja": "この服が似合うかどうか、ちょっと着てみます。",
     "zh": "这件衣服合不合适，我试穿一下。"
    },
    {
     "ja": "そのレストランがおいしいかどうか、友達に聞いてみよう。",
     "zh": "那家餐厅好不好吃，问问朋友吧。"
    }
   ],
   "prerequisites": [
    "G0058"
   ],
   "compare": [
    {
     "id": "G0245",
     "diff": "かどうか 用于是非疑问，か 用于含疑问词的疑问"
    }
   ],
   "common_errors": [
    {
     "wrong": "明日行けるかどうかを、まだ分かりません。",
     "why": "分かる 的对象用 が 或直接提示，不用 を",
     "fix": "明日行けるかどうか、まだ分かりません。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-인지 아닌지",
   "ko_diff": "韩语 -인지 아닌지 与 かどうか 对应；但日语 かどうか 不能与疑问词同用，韩语 인지 아닌지 的限制相同，需注意。",
   "notes": "",
   "tags": [
    "question"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0245",
