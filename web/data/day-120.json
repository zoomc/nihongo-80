 "grammar": [
  {
   "id": "G0152",
   "pattern": "〜ごとに",
   "meaning_zh": "每…；每隔…",
   "connection": "名词 + ごとに；动词辞书形 + ごとに",
   "usage": "表示以某单位等间隔重复，或“每一个都各自不同”。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "このバスは十五分ごとに出ています。",
     "zh": "这趟公交每十五分钟一班。"
    },
    {
     "ja": "季節ごとに、店の飾りが変わる。",
     "zh": "每个季节店里的装饰都会变。"
    },
    {
     "ja": "一回使うごとにポイントがたまるカードです。",
     "zh": "这是每用一次就积分的卡。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0151",
     "diff": "ごとに 侧重等间隔、逐个，たびに 侧重“每当发生某事”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "このバスは十五分おきごとに出ています。",
     "why": "「おき」与「ごと」都表间隔，不能叠加，二者择一。",
     "fix": "十五分ごとに",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-마다",
   "ko_diff": "韩语「-마다」兼表“每”和“每隔”；日语要区分「ごとに」（每）与「おきに」（每隔）。",
   "notes": "",
   "tags": [
    "time",
    "quantity"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0153",
   "pattern": "〜最中に",
   "meaning_zh": "正当…的时候",
   "connection": "动词ている + 最中に；名词 + の + 最中に",
   "usage": "表示某动作正值高潮时另一事突然发生，多含妨碍意味。",
   "register_note": "口语书面均可，语气较郑重。",
   "examples": [
    {
     "ja": "大事な会議の最中に、携帯電話が鳴ってしまった。",
     "zh": "正开重要会议时，手机响了。"
    },
    {
     "ja": "料理をしている最中に、停電になった。",
     "zh": "正做饭时停电了。"
    },
    {
     "ja": "今、試験の最中だから、廊下では静かにしてください。",
     "zh": "现在正在考试，请在走廊保持安静。"
    }
   ],
   "prerequisites": [
    "G0089"
   ],
   "compare": [
    {
     "id": "G0133",
     "diff": "ところに 是“正要、正在时”，最中に 强调“正做到一半”，妨碍感更强。"
    }
   ],
   "common_errors": [
    {
     "wrong": "大事な会議最中に、携帯電話が鳴ってしまった。",
     "why": "「最中」是名词，接名词要加「の」，说「会議の最中に」。",
     "fix": "会議の最中に",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-는 중에",
   "ko_diff": "韩语「-는 중에」只表“进行中”；日语「最中に」还隐含“被打断、扫兴”的语感。",
