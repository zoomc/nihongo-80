 "grammar": [
  {
   "id": "G0026",
   "pattern": "～て ください",
   "meaning_zh": "请（做）…",
   "connection": "動詞て形 + ください",
   "usage": "礼貌请求；否定禁止用 ないでください",
   "register_note": "てください 对平辈、下级或店员可用；对上级改用 G0073。",
   "examples": [
    {
     "ja": "本を読んでください。",
     "zh": "请读书。",
     "vocab_ids": [
      "V0080",
      "V0113"
     ]
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "読みてください。",
     "why": "「読む」て形是 読んで（拨音便），不是 読みて",
     "fix": "読んでください。",
     "learner": "zh"
    },
    {
     "wrong": "読んでください です。",
     "why": "「ください」已是请求体，不再加 です",
     "fix": "読んでください。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "request"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-아/어 주세요",
   "ko_diff": "韩语请求用주세요，含「给」义；对长辈用주시겠어요，日语てください无敬语分层。"
  },
  {
   "id": "G0027",
   "pattern": "～て いる",
   "meaning_zh": "正在…／…着（结果状态）",
   "connection": "動詞て形 + いる",
   "usage": "进行、反复、结果状态；自动词他动词结果不同",
   "register_note": "ている 口语书面通用，进行与结果状态都常见。",
   "examples": [
    {
     "ja": "今、ご飯を食べています。",
     "zh": "正在吃饭。",
     "vocab_ids": [
      "V0022",
      "V0051",
      "V0101"
     ]
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [
    {
     "id": "G0051",
     "diff": "〜ている 是「持续/状态」补助；〜てみる/しまう/おく 是另一组补助用法"
    }
   ],
   "common_errors": [
    {
     "wrong": "ご飯を食べて あります",
     "why": "他动词+てある 表人为结果，「正在吃」用 ている；中文无此对立",
     "fix": "ご飯を食べています。",
     "learner": "zh"
    },
    {
     "wrong": "食べって います。",
     "why": "「食べる」て形 食べて，促音便误用",
     "fix": "食べています。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "aspect"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
