 "grammar": [
  {
   "id": "G0185",
   "pattern": "〜切る / 〜切れない",
   "meaning_zh": "…完；…不了",
   "connection": "动词ます形词干 + 切る／切れない",
   "usage": "表把动作彻底做完，或“多到做不完、做不到”。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "三時間かけて、長い小説を最後まで読み切った。",
     "zh": "花了三个小时，把那本长篇小说读完了。"
    },
    {
     "ja": "注文しすぎて、料理を食べ切れなかった。",
     "zh": "点得太多，菜没能吃完。"
    },
    {
     "ja": "山の上では、数え切れないほどの星が見えた。",
     "zh": "山顶上看得见数不清的星星。"
    }
   ],
   "prerequisites": [
    "G0024"
   ],
   "compare": [
    {
     "id": "G0084",
     "diff": "得る 表“有可能”，切る 表“做到最后”，前者是可能性，后者是完成度。"
    }
   ],
   "common_errors": [
    {
     "wrong": "注文しすぎて、料理を食べ切りなかった。",
     "why": "表“吃不完”要用可能形「切れない」；「切りない」不是合法形式，也不能表无法完成。",
     "fix": "食べ切れなかった",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-아/어 내다",
   "ko_diff": "韩语完成用「-아/어 내다」，日常更常说「다 -다」；日语「切る」强调“彻底做到最后”，还引申出“断然”的语感。",
   "notes": "",
