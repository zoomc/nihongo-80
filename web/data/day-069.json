 "grammar": [
  {
   "id": "G0126",
   "pattern": "まるで〜ようだ",
   "meaning_zh": "简直像…一样",
   "connection": "まるで + 名词 + の + ようだ；まるで + 普通形 + ようだ",
   "usage": "用夸张比喻描述强烈的相似感，常与「まるで」呼应。",
   "register_note": "口语书面均可，文学描写中常见。",
   "examples": [
    {
     "ja": "この部屋は広くて明るくて、まるでホテルのようだ。",
     "zh": "这个房间又大又亮，简直像宾馆一样。"
    },
    {
     "ja": "久しぶりに会った友達は、まるで別人のように変わっていた。",
     "zh": "久别重逢的朋友变了个样，简直像另一个人。"
    },
    {
     "ja": "三月なのに、今日はまるで真夏のように暑い。",
     "zh": "才三月，今天却热得像盛夏一样。"
    }
   ],
   "prerequisites": [
    "G0044"
   ],
   "compare": [
    {
     "id": "G0125",
     "diff": "ような 可举实例，まるで〜ようだ 只用于夸张比喻，语气更强。"
    }
   ],
   "common_errors": [
    {
     "wrong": "この部屋は広くて明るくて、まるでホテルようだ。",
     "why": "名词接 ようだ 要加 の：ホテルのようだ。",
     "fix": "ホテルのようだ",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "마치 -ㄴ 것 같다",
   "ko_diff": "韩语「마치」与日语「まるで」一样起强调作用；但韩语比喻常用「-처럼」，日语「ようだ」是断定结句，句法位置不同。",
   "notes": "",
   "tags": [
    "comparison",
    "appearance"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "마루데〜요우다"
  },
  {
   "id": "G0127",
   "pattern": "〜に違いない",
   "meaning_zh": "一定…；肯定…",
   "connection": "普通形 + に違いない；名词 + に違いない（不加「だ」）",
   "usage": "依据某些迹象做很有把握的推断，语气比「だろう」强。",
   "register_note": "口语书面均可，书面感稍强。",
   "examples": [
    {
     "ja": "隣の家は何日も電気が消えている。家族で旅行に出かけたに違いない。",
     "zh": "隔壁好几天没亮灯，一家人肯定出去旅行了。"
    },
    {
     "ja": "こんなに人が並んでいるんだから、この店のラーメンはおいしいに違いない。",
     "zh": "排这么多人，这家店的拉面一定好吃。"
    },
    {
     "ja": "この手紙の字は、父の字に違いない。",
     "zh": "这封信的字迹肯定是父亲的。"
    }
   ],
   "prerequisites": [
    "G0070"
   ],
   "compare": [
    {
     "id": "G0128",
     "diff": "に違いない 是有根据的推断，に決まっている 更像“明摆着”，语气更硬。"
    }
   ],
   "common_errors": [
    {
     "wrong": "この手紙の字は、父の字だに違いない。",
     "why": "名词直接接 に違いない，不加 だ。",
     "fix": "父の字に違いない",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-임에 틀림없다",
   "ko_diff": "韩语「-임에 틀림없다」同样表强推断；但日语名词后不加「だ」，韩语要加「임」，这是最容易出错的地方。",
   "notes": "",
   "tags": [
    "conjecture",
    "emphasis"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "pattern_kana": "〜にちがいない",
   "ko_pron": "〜니치가이나이"
  },
  {
   "id": "G0128",
   "pattern": "〜に決まっている",
   "meaning_zh": "必然…；肯定…",
   "connection": "普通形 + に決まっている；名词 + に決まっている",
   "usage": "表示“按理必然如此”，带“这还用说”的强硬语气。",
   "register_note": "口语为主，争论和断定场合常见。",
   "examples": [
    {
     "ja": "練習もしないで試合に出たら、負けるに決まっている。",
     "zh": "不练习就上场比赛，肯定输。"
    },
    {
     "ja": "一人で富士山に登るなんて、お母さんが心配するに決まってるでしょう。",
     "zh": "一个人去爬富士山，妈妈肯定担心。"
    },
    {
     "ja": "そんなうまい話、うそに決まっているよ。",
     "zh": "那么好的事，肯定是骗人的。"
    }
   ],
   "prerequisites": [
    "G0070"
   ],
   "compare": [
    {
     "id": "G0127",
     "diff": "に違いない 靠迹象推断，に決まっている 靠道理断定，语气更强硬。"
    }
   ],
   "common_errors": [
    {
     "wrong": "そんなうまい話、うそだに決まっているよ。",
     "why": "名词直接接 に決まっている，不加 だ。",
     "fix": "うそに決まっている",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "분명 …하다 / 틀림없이 …할 거다",
   "ko_diff": "분명 잊어버렸을 거야 对照 忘れているに決まっている，是说话人很有把握的断言。-기 마련이다 陈述一般规律，用途不同。",
