 "grammar": [
  {
   "id": "G0209",
   "pattern": "〜予定",
   "meaning_zh": "预定…；计划…",
   "connection": "动词辞书形 + 予定だ；名词 + の + 予定だ",
   "usage": "表示已安排好的日程或计划，语气比つもり更客观。",
   "register_note": "口语与书面通用；商务、通知中常用。",
   "examples": [
    {
     "ja": "来月、大阪に引っ越す予定です。",
     "zh": "下个月我预定搬到大阪。"
    },
    {
     "ja": "会議は三時に終わる予定です。",
     "zh": "会议预定三点结束。"
    },
    {
     "ja": "出発は朝八時の予定です。",
     "zh": "出发时间定在早上八点。"
    }
   ],
   "prerequisites": [
    "G0023",
    "G0006"
   ],
   "compare": [
    {
     "id": "G0208",
     "diff": "予定 是客观日程，つもり 是个人意图"
    }
   ],
   "common_errors": [
    {
     "wrong": "来月、大阪に引っ越すの予定です。",
     "why": "动词接 予定 直接用辞书形，不用 の；名词才用 の",
     "fix": "来月、大阪に引っ越す予定です。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-(으)ㄹ 예정이다",
   "ko_diff": "韩语 예정이다 与 予定 基本对应，但日语 予定 可直接接名词（予定通り），韩语则需 예정대로。",
   "notes": "",
