 "grammar": [
  {
   "id": "G0068",
   "pattern": "N / Vた形 / V辞書形 / Vて + ばかり",
   "meaning_zh": "刚…；净是…、只…；一味…",
   "connection": "名詞 + ばかり；動詞 た形 + ばかり（刚做完）；辞書形 + ばかり（只等/只剩）；て形 + ばかり いる（光顾着做）",
   "usage": "多义：①刚…②净/只③一味做；数量或程度超出预期，常带负面语感",
   "register_note": "ばかり 口语高频，多义需靠语境判断。",
   "examples": [
    {
     "ja": "日本に来たばかりです。",
     "zh": "刚来日本不久。",
     "vocab_ids": [
      "V0104",
      "V0081"
     ]
    },
    {
     "ja": "彼はゲームばかりしています。",
     "zh": "他光打游戏。",
     "vocab_ids": [
      "V0074",
      "V0027"
     ]
    },
    {
     "ja": "この店は値段ばかり高くて、味は普通です。",
     "zh": "这家店光价格贵，味道一般。",
     "vocab_ids": [
      "V0042",
      "V0125"
     ]
    }
   ],
   "prerequisites": [
    "G0021",
    "G0023",
    "G0006"
   ],
   "compare": [
    {
     "id": "G0027",
     "diff": "ている 表进行；てばかりいる 强调「净顾着做别的都不做」"
    },
    {
     "id": "G0042",
     "diff": "たことがある 是既往经验；たばかり 是「刚刚做完」，时间上很近"
    }
   ],
   "common_errors": [
    {
     "wrong": "日本に来るばかりです。",
     "why": "「刚来」用 た形 来たばかり，不能用辞书形；中文「刚」直译不体现 た 易错",
     "fix": "日本に来たばかりです。",
     "learner": "zh"
    },
    {
     "wrong": "野菜ばかりを食べています。",
     "why": "「ばかり」提示对象时 を/が 常被取代或省略，叠 を 不自然；中文「光吃蔬菜」直译保留 を 生硬",
     "fix": "野菜ばかり食べています。",
     "learner": "zh"
    }
   ],
