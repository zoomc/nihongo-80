 "grammar": [
  {
   "id": "G0102",
   "pattern": "〜ものではない",
   "meaning_zh": "不该…；不可以…",
   "connection": "动词辞书形 + ものではない",
   "usage": "从道理或教养上劝诫对方不要做某事，语气较说教。",
   "register_note": "书面语色彩；口语多说「もんじゃない」。",
   "examples": [
    {
     "ja": "人の失敗を笑うものではない。",
     "zh": "不该嘲笑别人的失败。"
    },
    {
     "ja": "出された食べ物を残すものじゃないよ。",
     "zh": "别人端上来的饭菜不该剩下。"
    },
    {
     "ja": "夜遅くに人の家に電話をかけるものではありません。",
     "zh": "不该深夜往别人家里打电话。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0101",
     "diff": "ものだ 讲“应当”，ものではない 讲“不该”，是同一形式的是非两面。"
    }
   ],
   "common_errors": [
    {
     "wrong": "人の失敗を笑ってものではない。",
     "why": "「ものではない」前接辞书形，不能接て形。",
     "fix": "笑うものではない",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-는 것이 아니다",
   "ko_diff": "韩语「-는 것이 아니다」多为客观否定；日语「ものではない」带明显劝诫和教养色彩，语气更重。",
   "notes": "",
   "tags": [
    "advice",
    "prohibition"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0103",
   "pattern": "〜もの / 〜もん",
   "meaning_zh": "因为…嘛（撒娇辩解）",
   "connection": "普通形 + もの／もん（多与「だって」呼应）",
   "usage": "口语中为自己辩解或撒娇，孩子和女性用得较多。",
   "register_note": "仅限亲密的日常口语，正式场合不用。",
   "examples": [
    {
     "ja": "「どうして食べないの？」「だって、ピーマン嫌いなんだもん。」",
     "zh": "“怎么不吃？”“因为我不喜欢青椒嘛。”"
    },
    {
     "ja": "一人で行けるよ。もう子どもじゃないもん。",
     "zh": "我一个人能去，我已经不是小孩了嘛。"
    },
    {
     "ja": "ケーキ、全部食べちゃった。だって、すごくおいしかったんだもん。",
     "zh": "蛋糕我全吃光了。因为实在太好吃了嘛。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0091",
     "diff": "ものだから 是较完整的说明理由，もん 更短、更撒娇，多用于辩解。"
    }
   ],
   "common_errors": [
    {
     "wrong": "本日は欠席いたします。熱があるもんですから。",
     "why": "「もん」是亲昵撒娇的口语辩解，正式致歉场合语体明显不符。",
     "fix": "熱がございますので、欠席いたします。",
     "learner": "zh",
     "register_ack": true
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-니까(요)",
   "ko_diff": "韩语「-니까(요)」只表原因，不带撒娇色彩；日语「もん」几乎总带“我也有苦衷”的辩解语气，只用于亲近关系。",
