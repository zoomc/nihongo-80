  {
   "id": "G0311",
   "pattern": "〜次第",
   "pattern_kana": "〜しだい",
   "meaning_zh": "一…就立即…",
   "ko_equiv": "…하는 대로 / …하자마자",
   "connection": "ます词干 + 次第 / 名词 + 次第",
   "usage": "",
   "ko_diff": "常用于联络安排，前项尚未发生，发生后立刻执行后项。接ます词干「届き次第」，也有较正式的「到着次第」。",
   "examples": [
    {
     "ja": "詳しい日程が決まり次第、皆様にご連絡いたします。",
     "en": "We will contact everyone as soon as the detailed schedule is decided.",
     "zh": "详细日程一确定，我们就通知各位。"
    },
    {
     "ja": "資料が届き次第、内容を確認してお返事します。",
     "en": "As soon as the materials arrive, I'll check them and get back to you.",
     "zh": "材料一送到，我就核对内容并回复。"
    }
   ],
   "tags": [
    "time",
    "sequence",
    "formal"
   ],
   "jlpt": "N2",
   "prerequisites": [],
   "compare": [],
   "common_errors": [
