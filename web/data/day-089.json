 "grammar": [
  {
   "id": "G0184",
   "pattern": "〜だらけ",
   "meaning_zh": "满是…；净是…",
   "connection": "名词 + だらけ",
   "usage": "表示某物上布满不好的东西，或充满负面事物。",
   "register_note": "口语书面均可，多含负面评价。",
   "examples": [
    {
     "ja": "子どもたちは、泥だらけになって帰ってきた。",
     "zh": "孩子们回来时满身是泥。"
    },
    {
     "ja": "急いで書いたレポートは、間違いだらけだった。",
     "zh": "赶着写出来的报告错误百出。"
    },
    {
     "ja": "引っ越したばかりで、部屋はまだ段ボールだらけだ。",
     "zh": "刚搬完家，房间里还堆满了纸箱。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0183",
     "diff": "気味 是轻微迹象，だらけ 是大量布满，程度相反。"
    }
   ],
   "common_errors": [
    {
     "wrong": "急いで書いたレポートは、間違いのだらけだった。",
     "why": "「だらけ」直接接名词，不加「の」。",
     "fix": "間違いだらけだった",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-투성이",
   "ko_diff": "韩语「-투성이」常带负面色彩；日语「だらけ」也常用于负面事物，并可接抽象名词，如「間違いだらけ」。",
   "notes": "",
   "tags": [
    "quantity",
    "state"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "needs_review",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜다라케"
  },
  {
   "id": "G0185",
   "pattern": "〜切る / 〜切れない",
   "meaning_zh": "…完；…不了",
   "connection": "动词ます形词干 + 切る／切れない",
   "usage": "表把动作彻底做完，或“多到做不完、做不到”。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "三時間かけて、長い小説を最後まで読み切った。",
     "zh": "花了三个小时，把那本长篇小说读完了。"
    },
    {
     "ja": "注文しすぎて、料理を食べ切れなかった。",
     "zh": "点得太多，菜没能吃完。"
    },
    {
     "ja": "山の上では、数え切れないほどの星が見えた。",
     "zh": "山顶上看得见数不清的星星。"
    }
   ],
   "prerequisites": [
    "G0024"
   ],
   "compare": [
    {
     "id": "G0084",
     "diff": "得る 表“有可能”，切る 表“做到最后”，前者是可能性，后者是完成度。"
    }
   ],
   "common_errors": [
    {
     "wrong": "注文しすぎて、料理を食べ切りなかった。",
     "why": "表“吃不完”要用可能形「切れない」；「切りない」不是合法形式，也不能表无法完成。",
     "fix": "食べ切れなかった",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "끝까지 다 …하다 / 다 …하지 못하다",
   "ko_diff": "食べ切る 可对照 다 먹다；食べ切れない 对照 다 못 먹다。否定「完全做不到」时要用 〜切れる 的否定，而非只把 〜切る 变否定。",
   "notes": "",
   "tags": [
    "completion",
    "ability"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "pattern_kana": "〜きる / 〜きれない",
   "ko_pron": "〜키루 / 〜키레나이"
  },
  {
   "id": "G0186",
   "pattern": "〜かける",
   "meaning_zh": "…了一半；刚要…",
   "connection": "动词ます形词干 + かける；动词ます形词干 + かけの + 名词",
   "usage": "表动作做到一半或刚开始就中断。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "読みかけの本が、机の上に置いてある。",
     "zh": "桌上放着一本读到一半的书。"
    },
    {
     "ja": "彼女は何か言いかけたが、そのまま黙ってしまった。",
     "zh": "她话说到一半，又沉默了。"
    },
    {
     "ja": "この花は枯れかけていたが、水をやったら元気になった。",
     "zh": "这花本来有点枯萎，浇了水就精神了。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0185",
     "diff": "切る 表彻底做完，かける 表只做了一半，完成度相反。"
    }
   ],
   "common_errors": [
    {
     "wrong": "読みかけるの本が、机の上に置いてある。",
     "why": "修饰名词要用「〜かけの」，「かけるの」不合法。",
     "fix": "読みかけの本",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-다 말다",
   "ko_diff": "韩语「-다 말다」表“做到一半就停”，与「かける」对应；但日语还能表“刚开始、眼看要”，韩语要用「-려다」，含义更宽。",
   "notes": "",
