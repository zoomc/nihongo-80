     "vocab_ids": [
      "V0125"
     ]
    }
   ],
   "prerequisites": [
    "G0019",
    "G0015",
    "G0016"
   ],
   "compare": [
    {
     "id": "G0062",
     "diff": "やすい/にくい 表难易；すぎる 表程度过头"
    },
    {
     "id": "G0034",
     "diff": "より/ほうが 是两者比较；すぎる 是超过标准"
    }
   ],
   "common_errors": [
    {
     "wrong": "食べるすぎます。",
     "why": "必须接 ます形去ます（食べ），不能用辞书形；中文「吃太多」直译错",
     "fix": "食べすぎます。",
     "learner": "zh"
    },
    {
