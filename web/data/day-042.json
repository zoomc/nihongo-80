 "grammar": [
  {
   "id": "G0056",
   "pattern": "N が V(他動詞)て ある",
   "meaning_zh": "（人为地）已经…着；事先做好了…",
   "connection": "他動詞 て形 + ある；原来的 を 宾语改由 が 提示（N が …てある）",
   "usage": "表示某人有意为之、结果留存至今的状态，常用于准备已完成；不接自动词",
   "register_note": "てある 偏书面说明状态，口语也用。",
   "examples": [
    {
     "ja": "机の上に本が置いてあります。",
     "zh": "桌上放着书（事先摆好的）。",
     "vocab_ids": [
      "V0080",
      "V0047"
     ]
    },
    {
     "ja": "ホテルの予約がしてあります。",
     "zh": "酒店已经（事先）订好了。",
     "vocab_ids": [
      "V0187",
      "V0092"
     ]
    }
   ],
   "prerequisites": [
    "G0020",
    "G0027"
   ],
   "compare": [
    {
     "id": "G0027",
     "diff": "ている 表进行或自然结果状态（多接自动词）；てある 表人为做完后的结果（接他动词，宾语改 が）"
    }
   ],
   "common_errors": [
    {
     "wrong": "机に本を置いてあります。",
     "why": "てある 接他动词时原来的 を 宾语要改成 が；中文「放着书」直译保留 を 错",
     "fix": "机に本が置いてあります。",
     "learner": "zh"
    },
    {
     "wrong": "ドアが開いてあります。",
     "why": "「開く」是自动词，自动词不能接 てある（应用 ている）；中文「开着」不区分自他",
     "fix": "ドアが開いています。（人为打开并保持则 開けてあります）",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "tags": [
    "te-form",
    "aspect",
    "result",
    "transitivity"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-아/어 있다",
   "ko_diff": "韩语结果状态用아/어 있다，不强调人为施事；日语てある暗示某人有意为之，语感不同。"
  },
  {
   "id": "G0057",
   "pattern": "Vて + いく / くる",
   "meaning_zh": "…下去／…起来（趋势）；去…再来／…过来（移动）",
   "connection": "動詞 て形 + いく／くる；いく・くる 按五段/カ変变形（ていきます／てきました）",
   "usage": "空间：做完某动作后去/来；时间：状态从现在向将来（いく）或从过去向现在（くる）变化",
   "register_note": "ていく/くる 口语书面通用，谈空间或时间趋势。",
   "examples": [
    {
     "ja": "これからも日本語を勉強していきます。",
     "zh": "今后也会继续学下去。",
     "vocab_ids": [
      "V0081",
      "V0082"
     ]
    },
    {
     "ja": "雨が降ってきました。",
     "zh": "下起雨来了。",
     "vocab_ids": [
      "V0118",
      "V0096"
     ]
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [
    {
     "id": "G0027",
     "diff": "ている 表状态持续/进行；ていく・てくる 表变化趋势或动作方向"
    }
   ],
   "common_errors": [
    {
     "wrong": "これから勉強しています。",
     "why": "中文「学下去」易误用 ている；向将来延续应用 〜ていく",
     "fix": "これからも勉強していきます。",
     "learner": "zh"
    },
    {
     "wrong": "雨が降っていきました。",
     "why": "「下起雨来（到现在）」方向是 〜てくる 而非 ていく；中文「起来了」不区分方向",
     "fix": "雨が降ってきました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
