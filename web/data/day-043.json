 "grammar": [
  {
   "id": "G0057",
   "pattern": "Vて + いく / くる",
   "meaning_zh": "…下去／…起来（趋势）；去…再来／…过来（移动）",
   "connection": "動詞 て形 + いく／くる；いく・くる 按五段/カ変变形（ていきます／てきました）",
   "usage": "空间：做完某动作后去/来；时间：状态从现在向将来（いく）或从过去向现在（くる）变化",
   "register_note": "ていく/くる 口语书面通用，谈空间或时间趋势。",
   "examples": [
    {
     "ja": "これからも日本語を勉強していきます。",
     "zh": "今后也会继续学下去。",
     "vocab_ids": [
      "V0081",
      "V0082"
     ]
    },
    {
     "ja": "雨が降ってきました。",
     "zh": "下起雨来了。",
     "vocab_ids": [
      "V0118",
      "V0096"
     ]
    }
   ],
   "prerequisites": [
    "G0020"
   ],
   "compare": [
    {
     "id": "G0027",
     "diff": "ている 表状态持续/进行；ていく・てくる 表变化趋势或动作方向"
    }
   ],
   "common_errors": [
    {
     "wrong": "これから勉強しています。",
     "why": "中文「学下去」易误用 ている；向将来延续应用 〜ていく",
     "fix": "これからも勉強していきます。",
     "learner": "zh"
    },
    {
     "wrong": "雨が降っていきました。",
     "why": "「下起雨来（到现在）」方向是 〜てくる 而非 ていく；中文「起来了」不区分方向",
     "fix": "雨が降ってきました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "tags": [
    "te-form",
    "direction",
    "aspect"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "self_reviewed",
   "provenance": "self_reviewed",
   "ko_equiv": "-아/어 가다 / -아·어 오다",
   "ko_diff": "韩语가다/오다补助同样表时间趋势，以说话人为基准；与日语いく/くる方向基准相近。"
  },
  {
   "id": "G0058",
   "pattern": "普通形 + か どうか",
   "meaning_zh": "是否…；…还是不…",
   "connection": "動詞/い形 普通形 + かどうか；名詞・な形 词干 + かどうか（不加 だ/な）；疑问词问句不用 かどうか",
   "usage": "把是非疑问嵌入句中，作 分かる／調べる／決める／聞く 等的内容；整体可当名词用（が／を／は）",
   "register_note": "かどうか 口语书面通用，把疑问嵌入句中。",
   "examples": [
    {
     "ja": "行けるかどうか、まだ分かりません。",
     "zh": "还不知道能不能去。",
     "vocab_ids": [
      "V0103",
      "V0124"
     ]
    },
    {
     "ja": "彼が来るかどうか、聞いてみます。",
     "zh": "我去问问他来不来。",
     "vocab_ids": [
      "V0074",
      "V0104",
      "V0115"
     ]
    }
   ],
   "prerequisites": [
    "G0023",
    "G0012"
   ],
   "compare": [
    {
     "id": "G0036",
     "diff": "〜と 思う 引用陈述内容；かどうか 嵌入「是否」疑问"
    }
   ],
   "common_errors": [
    {
     "wrong": "行くかどうかを分かりません。",
     "why": "「分かる」的对象用 が，中文「知道是否…」直译加 を 错",
     "fix": "行くかどうか分かりません。",
     "learner": "zh"
    },
    {
     "wrong": "便利だかどうか調べます。",
     "why": "な形/名词接 かどうか 去掉 だ；中文「是否方便」直译保留 だ 错",
     "fix": "便利かどうか調べます。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
