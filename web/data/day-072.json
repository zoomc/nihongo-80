 "grammar": [
  {
   "id": "G0135",
   "pattern": "〜ほど",
   "meaning_zh": "到了…的程度",
   "connection": "普通形 + ほど；名词 + ほど",
   "usage": "举出极端例子说明程度之高，常与「〜ない」呼应表最高级。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "昨日は、立っていられないほど疲れていた。",
     "zh": "昨天累得站都站不住。"
    },
    {
     "ja": "試験に合格したと聞いて、涙が出るほどうれしかった。",
     "zh": "听说考试合格，高兴得流下眼泪。"
    },
    {
     "ja": "このあたりは、夜になると怖いほど静かだ。",
     "zh": "这一带到了晚上静得让人害怕。"
    }
   ],
   "prerequisites": [
    "G0034"
   ],
   "compare": [
    {
     "id": "G0136",
     "diff": "ほど 偏书面、程度更强，くらい 更口语，还可表“最低限度”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "このあたりは、夜になると怖いなほど静かだ。",
     "why": "い形容词直接接 ほど，不加 な。",
     "fix": "怖いほど",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-ㄹ 정도로",
   "ko_diff": "韩语「-ㄹ 정도로」与「ほど」基本对应；但日语「ほど」还用于「〜ほど〜ない」比较句，韩语要用「-만큼」。",
   "notes": "",
   "tags": [
    "degree"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜호도"
  },
  {
   "id": "G0136",
   "pattern": "〜くらい / 〜ぐらい（extent）",
   "meaning_zh": "到…地步；至少…",
   "connection": "普通形 + くらい／ぐらい；名词 + くらい",
   "usage": "表程度之高，或举最低限度的例子表“至少”。",
   "register_note": "口语为主，比「ほど」随意。",
   "examples": [
    {
     "ja": "おなかが痛くて、歩けないくらいだった。",
     "zh": "肚子疼得几乎走不动。"
    },
    {
     "ja": "隣の部屋の音楽がうるさくて、自分の声も聞こえないぐらいだ。",
     "zh": "隔壁音乐太吵，连自己的声音都听不见。"
    },
    {
     "ja": "自分の部屋ぐらい、自分で掃除しなさい。",
     "zh": "至少自己的房间自己打扫。"
    }
   ],
   "prerequisites": [
    "G0034"
   ],
   "compare": [
    {
     "id": "G0135",
     "diff": "くらい 可用于“最低限度”，ほど 不能；程度上 ほど 更强、更书面。"
    }
   ],
   "common_errors": [
    {
     "wrong": "おなかが痛くて、歩けないのくらいだった。",
     "why": "动词、い形容词直接接 くらい，不加 の。",
     "fix": "歩けないくらいだった",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-(으)ㄹ 정도로",
   "ko_diff": "울 것 같을 정도로 무서웠다 对照 泣きそうなくらい怖かった。数字后的 くらい 表大约，语气里表示程度的 くらい 常跟 ほど 接近。",
   "notes": "",
   "tags": [
    "degree",
    "emphasis"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜쿠라이 / 〜구라이"
  },
  {
   "id": "G0137",
   "pattern": "〜さえ",
   "meaning_zh": "连…都…",
   "connection": "名词 + さえ／でさえ／にさえ",
   "usage": "挑出一个意外、极端或本应容易满足的例子，强调「连……都」。",
   "register_note": "口语书面均可，书面更常用「すら」。",
   "examples": [
    {
     "ja": "忙しくて、昼ご飯を食べる時間さえなかった。",
     "zh": "忙得连吃午饭的时间都没有。"
    },
    {
     "ja": "こんな簡単な問題は、小学生でさえ解ける。",
     "zh": "这么简单的问题，连小学生都会。"
    },
    {
     "ja": "彼女は親友にさえ本当のことを話さなかった。",
     "zh": "她连最好的朋友都没说实话。"
    }
   ],
   "prerequisites": [
    "G0080"
   ],
   "compare": [
    {
     "id": "G0139",
     "diff": "さえ 举极端例暗示其他，こそ 是“正是…”的强调，方向不同。"
    }
   ],
   "common_errors": [
    {
     "wrong": "忙しくて、昼ご飯を食べる時間がさえなかった。",
     "why": "さえ 取代 が／を，不能说 時間がさえ。",
     "fix": "時間さえなかった",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-조차",
   "ko_diff": "-조차 对照「连…都」，如 이름조차 잊었다／名前さえ忘れた。后面是 ば 时，さえ 又可限定最低条件。",
   "notes": "",
