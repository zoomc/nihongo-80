   ],
   "compare": [
    {
     "id": "G0068",
     "diff": "たばかり 强调「做完没多久」的主观感觉（可隔数日）；たところ 是「刚刚、此刻」的客观时点"
    },
    {
     "id": "G0027",
     "diff": "ている 只说进行；ているところ 强调「恰好此刻正在」这个节骨眼"
    }
   ],
   "common_errors": [
    {
