 "grammar": [
  {
   "id": "G0155",
   "pattern": "〜おかげで",
   "meaning_zh": "多亏…；托…的福",
   "connection": "动词普通形/い形容词/ナ形容词な/名词の + おかげで",
   "usage": "表示因某原因得到好结果，含感谢语气。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "先輩が手伝ってくれたおかげで、仕事が早く終わった。",
     "zh": "多亏前辈帮忙，工作很快就做完了。"
    },
    {
     "ja": "薬が効いたおかげで、熱が下がった。",
     "zh": "多亏药效，烧退了。"
    },
    {
     "ja": "駅が近いおかげで、雨の日も楽に通勤できる。",
     "zh": "幸好离车站近，下雨天通勤也轻松。"
    }
   ],
   "prerequisites": [
    "G0054"
   ],
   "compare": [
    {
     "id": "G0156",
     "diff": "おかげで 引出好结果并表感谢，せいで 引出坏结果并含责备。"
    }
   ],
   "common_errors": [
    {
     "wrong": "駅が近いのおかげで、雨の日も楽に通勤できる。",
     "why": "い形容词直接接「おかげで」，只有名词才加「の」。",
     "fix": "駅が近いおかげで",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-덕분에",
   "ko_diff": "韩语「-덕분에」与「おかげで」对应；但日语还能用于讽刺（「おかげで遅れた」），韩语同样可以，需靠上下文判断。",
   "notes": "",
   "tags": [
    "reason",
    "result",
    "emotion"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0156",
   "pattern": "〜せいで",
   "meaning_zh": "都怪…；因为…",
   "connection": "动词普通形/い形容词/ナ形容词な/名词の + せいで",
   "usage": "表示因某原因导致坏结果，常含责备或推卸语气。",
   "register_note": "口语为主，正式场合少用。",
   "examples": [
    {
     "ja": "電車が遅れたせいで、面接に遅刻してしまった。",
     "zh": "因为电车晚点，面试迟到了。"
    },
    {
     "ja": "夜中に犬がうるさかったせいで、ほとんど眠れなかった。",
     "zh": "都怪半夜狗叫得厉害，几乎没睡着。"
    },
    {
     "ja": "私が道を間違えたせいで、みんなを待たせてしまった。",
     "zh": "是我带错路，让大家等了很久。"
    }
   ],
   "prerequisites": [
    "G0054"
   ],
   "compare": [
    {
     "id": "G0155",
     "diff": "せいで 只引坏结果、含责难，おかげで 引好结果、含感谢。"
    }
   ],
   "common_errors": [
    {
     "wrong": "電車が遅れたのせいで、面接に遅刻してしまった。",
     "why": "动词直接接「せいで」，只有名词才加「の」。",
     "fix": "遅れたせいで",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-때문에",
   "ko_diff": "韩语「-때문에」中性，好坏结果都可用；日语「せいで」专用于坏结果并带责难，不能随便替换「おかげで」。",
