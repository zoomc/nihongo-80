 "grammar": [
  {
   "id": "G0119",
   "pattern": "〜ばかりでなく",
   "meaning_zh": "不仅…而且…",
   "connection": "普通形 + ばかりでなく；ナ形容词 + な + ばかりでなく；名词 + ばかりでなく",
   "usage": "追加同类或更高层次的事项，后项多带「も」。",
   "register_note": "书面语色彩，演讲和文章中常见。",
   "examples": [
    {
     "ja": "この映画は子どもばかりでなく、大人も楽しめる。",
     "zh": "这部电影不仅孩子爱看，大人也能享受。"
    },
    {
     "ja": "新しいスマホは画面が大きいばかりでなく、電池も長持ちする。",
     "zh": "新手机不仅屏幕大，电池也耐用。"
    },
    {
     "ja": "運動は体にいいばかりでなく、ストレスを減らす効果もある。",
     "zh": "运动不仅对身体好，还有减压的效果。"
    }
   ],
   "prerequisites": [
    "G0093"
   ],
   "compare": [
    {
     "id": "G0120",
     "diff": "ばかりでなく 与 だけでなく 意思相近，前者更书面、更郑重。"
    }
   ],
   "common_errors": [
    {
     "wrong": "新しいスマホは画面が大きばかりでなく、電池も長持ちする。",
     "why": "い形容词要保留辞书形「大きい」再接「ばかりでなく」，不能去掉「い」。",
     "fix": "画面が大きいばかりでなく",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-뿐만 아니라",
   "ko_diff": "韩语「-뿐만 아니라」与日语几乎完全对应；但日语后项习惯加「も」，韩语可省，容易漏掉「も」。",
   "notes": "",
   "tags": [
    "addition"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
