 "grammar": [
  {
   "id": "G0140",
   "pattern": "〜として",
   "meaning_zh": "作为…；以…身份",
   "connection": "名词 + として；名词 + としての + 名词",
   "usage": "表示身份、资格、立场或名义。",
   "register_note": "口语书面均可。",
   "examples": [
    {
     "ja": "兄は、エンジニアとしてアメリカの会社で働いている。",
     "zh": "哥哥作为工程师在美国公司工作。"
    },
    {
     "ja": "この町は、温泉地として有名です。",
     "zh": "这个镇作为温泉地很有名。"
    },
    {
     "ja": "社会人としての責任を持って行動してください。",
     "zh": "请以社会人的责任感行事。"
    }
   ],
   "prerequisites": [],
   "compare": [
    {
     "id": "G0141",
     "diff": "として 表身份资格，にとって 表“从某人角度看”。"
    }
   ],
   "common_errors": [
    {
     "wrong": "兄は、エンジニアのとしてアメリカの会社で働いている。",
     "why": "「として」直接接名词，不加「の」；修饰名词时才用「としての」。",
     "fix": "エンジニアとして",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-로서",
   "ko_diff": "韩语「-로서」表资格，与「として」对应；但韩语另有「-로써」表手段，日语「として」不表手段，切勿混用。",
   "notes": "",
   "tags": [
    "standpoint",
    "relation"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0141",
   "pattern": "〜にとって",
   "meaning_zh": "对…来说",
   "connection": "名词 + にとって；名词 + にとっての + 名词",
   "usage": "表示从某人或某组织的立场看待某事的价值或影响。",
   "register_note": "口语书面均可，评论和致辞常见。",
   "examples": [
    {
     "ja": "私にとって、家族は何よりも大切なものです。",
     "zh": "对我来说，家人比什么都重要。"
    },
    {
     "ja": "このあたりの坂道は、お年寄りにとってはかなり大変だ。",
     "zh": "这一带的坡道对老年人来说相当吃力。"
    },
    {
     "ja": "留学は、彼にとっていい経験になったようだ。",
     "zh": "留学对他来说似乎是一段好经历。"
    }
   ],
   "prerequisites": [
    "G0055"
   ],
   "compare": [
    {
     "id": "G0115",
     "diff": "にとって 表立场，に対して 表对象或对比。"
    }
   ],
   "common_errors": [
    {
     "wrong": "私をとって、家族は何よりも大切なものです。",
     "why": "固定形式是「にとって」，不能换成「をとって」（那是“拿我来…”的意思）。",
     "fix": "私にとって",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
