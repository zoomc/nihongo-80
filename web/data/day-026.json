  {
   "id": "G0264",
   "pattern": "〜から（from）",
   "meaning_zh": "从…（起点）",
   "connection": "名词 + から（起点）",
   "usage": "表示时间或场所的起点，常与「まで」呼应。",
   "register_note": "口语与书面通用。",
   "examples": [
    {
