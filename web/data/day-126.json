 "grammar": [
  {
   "id": "G0161",
   "pattern": "〜てしょうがない / 〜てしかたがない",
   "meaning_zh": "…得不得了",
   "connection": "动词て形/い形容词くて/ナ形容词で + しょうがない（しかたがない）",
   "usage": "表某种感觉或情绪强烈到无法抑制，多用于生理、心理感受。",
   "register_note": "口语为主，「しかたがない」稍正式。",
   "examples": [
    {
     "ja": "昨日あまり寝ていないので、眠くてしょうがない。",
     "zh": "昨晚几乎没睡，困得不行。"
    },
    {
     "ja": "来週の旅行が楽しみでしかたがない。",
     "zh": "对下周的旅行期待得不得了。"
    },
    {
     "ja": "一人暮らしを始めたばかりのころは、家族のことが気になってしかたがなかった。",
     "zh": "刚开始一个人住时，特别惦记家人。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0162",
     "diff": "てしょうがない 偏口语、适用范围广，てたまらない 程度更强、更书面。"
    }
   ],
   "common_errors": [
    {
     "wrong": "昨日あまり寝ていないので、眠いでしょうがない。",
     "why": "い形容词接「しょうがない」要用「〜くて」，「眠いで」不合法。",
     "fix": "眠くてしょうがない",
     "learner": "zh"
    }
   ],
   "jlpt": "N3",
   "ko_equiv": "-아서 견딜 수 없다",
   "ko_diff": "韩语「-아서 견딜 수 없다」偏“难以忍受”的强烈表达；日语「てしょうがない」也可用于轻微感受，程度可轻可重。",
   "notes": "",
   "tags": [
    "emotion",
    "degree"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0"
  },
  {
   "id": "G0162",
   "pattern": "〜てたまらない",
   "meaning_zh": "…得受不了；非常…",
   "connection": "动词て形/い形容词くて/ナ形容词で + たまらない",
   "usage": "表某种感情或感觉强烈到难以忍受，书面感比「しょうがない」强。",
   "register_note": "口语书面均可，文章中也常见。",
   "examples": [
    {
     "ja": "この部屋はエアコンがなくて、暑くてたまらない。",
     "zh": "这个房间没空调，热得受不了。"
    },
    {
     "ja": "三年ぶりに国の家族に会えるので、うれしくてたまらない。",
     "zh": "三年没见家人，高兴得不得了。"
    },
    {
     "ja": "試合に負けたのが悔しくてたまらなかった。",
     "zh": "比赛输了，懊悔得不行。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0161",
     "diff": "てたまらない 程度更重、更书面，てしょうがない 更口语、可用于轻微感受。"
    }
   ],
   "common_errors": [
    {
     "wrong": "この部屋はエアコンがなくて、暑いでたまらない。",
     "why": "い形容词接「たまらない」要用「〜くて」，「暑いで」不合法。",
     "fix": "暑くてたまらない",
