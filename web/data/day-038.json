 "grammar": [
  {
   "id": "G0210",
   "pattern": "〜ことにする",
   "meaning_zh": "决定…",
   "connection": "动词辞书形／动词ない形 + ことにする",
   "usage": "表示说话人自己主动做出决定，强调主观选择。",
   "register_note": "口语与书面通用；「ことにしている」表示习惯性决定。",
   "examples": [
    {
     "ja": "健康のために、毎朝歩くことにした。",
     "zh": "为了健康，我决定每天早上散步。"
    },
    {
     "ja": "高かったので、買わないことにしました。",
     "zh": "因为太贵，我决定不买了。"
    },
    {
     "ja": "もう遅いから、タクシーで帰ることにしよう。",
     "zh": "已经很晚了，就坐出租车回去吧。"
    }
   ],
   "prerequisites": [
    "G0023",
    "G0022"
   ],
   "compare": [
    {
     "id": "G0211",
     "diff": "ことにする 是主观决定，ことになる 是客观结果或他人决定"
    }
   ],
   "common_errors": [
    {
     "wrong": "健康のために、毎朝歩きことにした。",
     "why": "ことにする 前接辞书形，不是ます形去ます",
     "fix": "健康のために、毎朝歩くことにした。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-기로 하다",
   "ko_diff": "韩语 -기로 하다 与 ことにする 对应，但日语 ことにしている 可表持续的习惯，韩语 -기로 하고 있다 较少这样用。",
   "notes": "",
   "tags": [
    "decision"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜코토니스루"
  },
  {
   "id": "G0211",
   "pattern": "〜ことになる",
   "meaning_zh": "决定…；结果变成…",
   "connection": "动词辞书形／动词ない形 + ことになる",
   "usage": "表示由集体、他人或客观情况决定的结果，不含说话人的主动意志。",
   "register_note": "口语与书面通用；「ことになっている」表示既定规定。",
   "examples": [
    {
     "ja": "来年の春から、名古屋の店で働くことになりました。",
     "zh": "定下来从明年春天起在名古屋的店工作。"
    },
    {
     "ja": "今度の日曜日、クラスのみんなでバーベキューをすることになった。",
     "zh": "这个星期天全班决定一起去烧烤。"
    },
    {
     "ja": "友達の結婚式で、私がスピーチをすることになりました。",
     "zh": "结果由我在朋友的婚礼上致辞。"
    }
   ],
   "prerequisites": [
    "G0023"
   ],
   "compare": [
    {
     "id": "G0210",
     "diff": "ことになる 是客观决定，ことにする 是主观决定"
    }
   ],
   "common_errors": [
    {
     "wrong": "来年の春から、名古屋の店で働くことになるでした。",
     "why": "ことになる 的过去礼貌形是「ことになりました」",
     "fix": "来年の春から、名古屋の店で働くことになりました。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-기로 정해지다 / -게 되다",
   "ko_diff": "-게 되다 范围很广。日语 働くことになった 像「公司决定这么安排」，働けるようになった 则是从做不到变成能工作。",
   "notes": "",
   "tags": [
    "decision",
    "result"
   ],
   "source_ids": [
    "S900"
   ],
   "review_status": "ai_draft",
   "provenance": "OpenJLPT CC-BY-SA-4.0",
   "license": "CC-BY-SA-4.0",
   "ko_pron": "〜코토니나루"
  },
  {
   "id": "G0212",
   "pattern": "〜える / 〜られる（potential）",
   "meaning_zh": "能…；会…",
   "connection": "五段动词词尾改え段+る；一段动词去る+られる；する→できる；来る→来られる",
   "usage": "表示能力或条件允许，可能形的宾语常用 が。",
   "register_note": "口语与书面通用；口语中一段动词常省略ら（食べれる）。",
   "examples": [
    {
     "ja": "私は漢字が二百ぐらい読めます。",
     "zh": "我能读大约两百个汉字。"
    },
    {
     "ja": "兄は辛い料理が食べられない。",
     "zh": "我哥哥吃不了辣的菜。"
    },
    {
     "ja": "明日のパーティーに来られますか。",
     "zh": "你能来明天的聚会吗？"
    }
   ],
   "prerequisites": [
    "G0024"
   ],
   "compare": [
    {
     "id": "G0213",
     "diff": "可能形 表能力，受身形 表被动，二者形式相近"
    }
   ],
   "common_errors": [
    {
     "wrong": "明日のパーティーに来られですか。",
     "why": "可能形接礼貌体要加 ます：来られますか",
     "fix": "明日のパーティーに来られますか。",
     "learner": "zh"
    }
   ],
   "jlpt": "N4",
   "ko_equiv": "-(으)ㄹ 수 있다",
   "ko_diff": "韩语用 -(으)ㄹ 수 있다 表能力，与日语可能形对应；但日语可能形是动词活用，韩语是句尾构式，且日语宾语常改用 が。",
   "notes": "",
