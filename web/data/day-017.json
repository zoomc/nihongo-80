 "grammar": [
  {
   "id": "G0034",
   "pattern": "比较（より／ほうが／ほど）",
   "meaning_zh": "比…／不如…",
   "connection": "A は B より ～；A より B の ほうが ～；A は B ほど ～ない",
   "usage": "比较句三式；「ほど＋否定」表「不如…那么」",
   "register_note": "比较句口语书面通用。",
   "examples": [
    {
     "ja": "電車よりバスのほうが安いです。",
     "zh": "公交比电车便宜。",
     "vocab_ids": [
      "V0060",
      "V0061",
      "V0126"
     ]
    },
    {
     "ja": "今日は昨日ほど寒くないです。",
     "zh": "今天没昨天冷。",
     "vocab_ids": [
      "V0023",
      "V0025",
      "V0133"
     ]
    }
   ],
   "prerequisites": [
    "G0007",
    "G0015"
   ],
   "compare": [],
   "common_errors": [
    {
     "wrong": "電車はバスのほうが安いです。",
     "why": "比较句式杂糅：用 ほうが 时基准用 より，不能 は…ほうが 并用",
     "fix": "電車よりバスのほうが安いです。",
     "learner": "zh"
    },
    {
     "wrong": "今日は昨日ほど寒いです。",
     "why": "「ほど」配否定才表比较；肯定 寒い 语义反了",
     "fix": "今日は昨日ほど寒くないです。",
     "learner": "zh"
    }
   ],
   "jlpt": "N5",
   "tags": [
    "comparison"
   ],
   "source_ids": [
    "S000"
   ],
   "review_status": "needs_review",
   "provenance": "self_reviewed",
   "ko_equiv": "A가 B보다 + 형용사",
   "ko_diff": "韩语可用 보다 表比较基准；「没昨天冷」可说 어제보다 춥지 않다，也可用 만큼 与否定表达。"
  },
  {
   "id": "G0040",
